              <ProtectedString name="Source">-- WorldService: spawning after data loads, verified world unlocks and safe travel.
-- The current world is session state (player attribute "World"); everyone starts at home.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local WorldConfig = require(Shared.WorldConfig)
local Net = require(script.Parent.Net)
local ProfileService = require(script.Parent.ProfileService)
local FlightService = require(script.Parent.FlightService)
local Analytics = require(script.Parent.Analytics)

local WorldService = {}

local UNLOCKS = {
	CloudtopCircuit = GameConfig.World2Unlock,
	NebulaWilds = GameConfig.World3Unlock,
}
WorldService.Unlocks = UNLOCKS

function WorldService.spawnCFrame(worldId: string): CFrame
	local world = WorldConfig.ById[worldId] or WorldConfig.ById[WorldConfig.Home]
	local o, s = world.origin, world.hub.spawn
	local position = Vector3.new(o[1] + s[1], o[2] + s[2] + 3, o[3] + s[3])
	return CFrame.lookAt(position, Vector3.new(o[1], position.Y, o[3]))
end

local function placeCharacter(player: Player)
	local character = player.Character
	if character then
		character:PivotTo(WorldService.spawnCFrame(player:GetAttribute("World")))
	end
end

local function spawnPlayer(player: Player)
	if not player.Parent then
		return
	end
	local ok, err = pcall(player.LoadCharacterAsync, player)
	if not ok then
		warn("[World] LoadCharacterAsync failed: " .. tostring(err))
	end
end

function WorldService.travel(player: Player, worldId: string): (boolean, string?)
	local data = ProfileService.get(player)
	if not WorldConfig.ById[worldId] then
		return false, "Unknown world"
	end
	if not data.UnlockedWorlds[worldId] then
		return false, "World locked"
	end
	if FlightService.isFlying(player) then
		return false, "Land first!"
	end
	if player:GetAttribute("World") == worldId then
		return true, nil
	end
	player:SetAttribute("Traveling", true)
	player:SetAttribute("World", worldId)
	placeCharacter(player)
	task.delay(0.6, function()
		if player.Parent then
			player:SetAttribute("Traveling", false)
		end
	end)
	return true, nil
end

function WorldService.init()
	ProfileService.onLoaded(function(player)
		player:SetAttribute("World", WorldConfig.Home)
		player.CharacterAdded:Connect(function(character)
			-- Respawns always return to the current world's hub
			task.defer(function()
				if character.Parent then
					character:PivotTo(WorldService.spawnCFrame(player:GetAttribute("World")))
				end
			end)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if humanoid then
				humanoid.Died:Connect(function()
					task.delay(3, spawnPlayer, player)
				end)
			end
		end)
		spawnPlayer(player)
	end)

	Net.handle("UnlockWorld", function(player, worldId)
		local rule = type(worldId) == "string" and UNLOCKS[worldId]
		if not rule then
			return { ok = false, msg = "Unknown world" }
		end
		local data = ProfileService.get(player)
		if data.UnlockedWorlds[worldId] then
			return { ok = false, msg = "Already unlocked" }
		end
		if (data.BestDistanceByWorld[rule.bestWorld] or 0) &lt; rule.best then
			return { ok = false, msg = `Fly {rule.best} studs in {WorldConfig.ById[rule.bestWorld].name} first` }
		end
		if not ProfileService.spend(player, "StarCoins", rule.cost) then
			return { ok = false, msg = "Not enough Star Coins" }
		end
		data.UnlockedWorlds[worldId] = true
		ProfileService.mark(player, "UnlockedWorlds")
		Analytics.funnel(player, "world_unlock")
		return { ok = true }
	end, 2, 3)

	Net.handle("Travel", function(player, worldId)
		if type(worldId) ~= "string" then
			return { ok = false }
		end
		local ok, msg = WorldService.travel(player, worldId)
		return { ok = ok, msg = msg }
	end, 2, 3)
end

return WorldService
