          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <string name="Name">Flight</string>
          <BinaryString name="SerializedOverrides" />
          <int64 name="SourceAssetId">-1</int64>
          <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
          <UniqueId name="UniqueId">038c44eb3ebffb0c0af64a9d000003fa</UniqueId>
          <ProtectedString name="Source">--!strict
-- Flight: server-authoritative launches on the shared FlightSim.
-- Client sends only: aim session + angle + its observed power-marker value, and short
-- inputs (boost / tap / steer). Distance, rings, bounces and Star Coins are decided here.
-- Remotes: Flight.Aim() Flight.Fire(session, angle, marker) Flight.Cancel()
--          Flight.Input(id, kind, value?)  (listen)
-- Pushes:  Flight.Event (all clients), Flight.Results (owner), Flight.Snap (unreliable, all)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))
local Signal = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Signal"))
local Game = ReplicatedStorage:WaitForChild("Game")
local GameConfig = require(Game:WaitForChild("GameConfig")) :: any
local WorldConfig = require(Game:WaitForChild("WorldConfig")) :: any
local FlightSim = require(Game:WaitForChild("FlightSim")) :: any
local Pets = require(Game:WaitForChild("PetDefinitions")) :: any
local LF = ServerScriptService:WaitForChild("LihFolk")
local PlayerData = require(LF:WaitForChild("PlayerData"))
local Currency = require(LF:WaitForChild("Currency"))
local Inventory = require(LF:WaitForChild("Inventory"))
local GameState = require(script.Parent.GameState)

local T = Net.T
local F = GameConfig.Flight

local Flight = {}
Flight.Finished = Signal.new() -- (player, summary)

type Aim = { session: number, start: number, period: number }

local aims: { [Player]: Aim } = {}
local flights: { [Player]: any } = {}
local nextId = 0
local nextAimId = 0
local riderService: any = nil
function Flight.SetRiderService(service: any) riderService = service end
local snapTimer = 0
local eventPush: Net.Push? = nil
local resultsPush: Net.Push? = nil
local snapPush: Net.Push? = nil

local function currentWorld(player: Player)
	return WorldConfig.ById[player:GetAttribute("World") or WorldConfig.Home] or WorldConfig.ById[WorldConfig.Home]
end

function Flight.InvalidateAim(player: Player)
	aims[player] = nil
	if riderService then riderService.SetAiming(player, false) end
end

function Flight.CanLaunch(player: Player): boolean
	if player:GetAttribute("Traveling") then return false end
	local world = currentWorld(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health &lt;= 0 then return false end
	local cannon = Vector3.new(world.origin[1], world.origin[2] + 3, world.origin[3] - 12)
	return (root.Position - cannon).Magnitude &lt;= 45
end

function Flight.IsFlying(player: Player): boolean
	return flights[player] ~= nil
end

-- The equipped monster: inventory uid + species + saved progress.
function Flight.Equipped(player: Player): (string?, string, number)
	local uid = Inventory.GetEquipped(player)[1]
	local unique = uid and Inventory.GetUnique(player, uid)
	local data = GameState.Get(player)
	if not uid or not unique or not data then
		return nil, Pets.Starter, 1
	end
	return uid, unique.Item, GameState.Monster(data, uid).Level
end

-- Ping-pong marker check: accept the client's value only if the server's own marker
-- passed it inside the player's latency window; otherwise use the server's value.
function Flight.VerifyMarker(player: Player, aim: Aim, claimed: number): number
	local now = workspace:GetServerTimeNow()
	local lag = math.clamp(player:GetNetworkPing() * 1.2 + 0.12, 0.12, 0.6)
	for i = 0, 24 do
		local t = now - aim.start - lag * (i / 24)
		if math.abs(GameConfig.markerAt(t, aim.period) - claimed) &lt;= 0.03 then
			return claimed
		end
	end
	return GameConfig.markerAt(now - aim.start - lag / 2, aim.period)
end

local function paramsFor(player: Player, data, timing: string, angle: number)
	local _, petId, level = Flight.Equipped(player)
	local def = Pets.ById[petId]
	return {
		speed = GameConfig.launchSpeed(data.TrainingLevel, data.CannonLevel, Pets.speedBonus(petId, level, GameConfig.PetLevel.SpeedPerLevel), F.Timing[timing]),
		angle = math.clamp(angle, F.MinAngle, F.MaxAngle),
		boostLevel = data.BoostLevel,
		bounceLevel = data.BounceLevel,
		magnetLevel = data.MagnetLevel,
		petBounce = if def then def.bounceBonus else 0,
	}
end

local function worldPoint(world, x: number, y: number, z: number): Vector3
	return Vector3.new(world.origin[1] + x, world.origin[2] + y, world.origin[3] + z)
end

-- Starts a flight (Fire handler and the Studio test hook).
function Flight.Start(player: Player, timing: string, angle: number)
	local data = GameState.Get(player)
	if not data or flights[player] or not Flight.CanLaunch(player) then
		return nil
	end
	if riderService then
		local mounted = riderService.Mount(player)
		if not mounted then return nil end
		riderService.SetAiming(player, false)
	end
	local world = currentWorld(player)
	local uid, petId = Flight.Equipped(player)
	local meta = uid and GameState.Monster(data, uid)
	local params = paramsFor(player, data, timing, angle)
	nextId += 1
	local focus = Instance.new("Part")
	focus.Name = "FlightFocus"
	focus.Anchored = true
	focus.CanCollide = false
	focus.CanQuery = false
	focus.CanTouch = false
	focus.Transparency = 1
	focus.Size = Vector3.one
	focus.Position = worldPoint(world, world.muzzle[1], world.muzzle[2], world.muzzle[3])
	focus.Parent = workspace:FindFirstChild("ActiveFlights") or workspace
	local flight = {
		id = nextId,
		world = world,
		state = FlightSim.new(world, params),
		timing = timing,
		uid = uid,
		petId = petId,
		mutation = if meta then meta.Mutation else "Normal",
		focus = focus,
		granted = false,
		started = workspace:GetServerTimeNow(),
	}
	flights[player] = flight
	player.ReplicationFocus = focus -- StreamingEnabled: stream the course around the monster
	player:SetAttribute("Flying", true)
	if eventPush then
		eventPush:FireAll("start", {
			owner = player.UserId,
			id = flight.id,
			world = world.id,
			params = params,
			timing = timing,
			petId = petId,
			mutation = flight.mutation,
			start = flight.started,
		})
	end
	return flight
end

local function cleanup(player: Player, flight)
	if flights[player] == flight then
		flights[player] = nil
	end
	if flight.focus then
		flight.focus:Destroy()
		flight.focus = nil
	end
	if player.Parent then
		player.ReplicationFocus = nil
		player:SetAttribute("Flying", false)
	end
end

-- Rewards exactly once per flight id. `releasing` is the detached profile when the
-- player is leaving (PlayerData.Get already returns nil then): write into it directly,
-- synchronously, before PlayerData takes the final save snapshot.
local function complete(player: Player, flight, releasing: PlayerData.Profile?)
	if flight.granted then
		return
	end
	flight.granted = true
	cleanup(player, flight)
	local data = if releasing then releasing.Data.Game else GameState.Get(player)
	if not data then
		return
	end
	local s = flight.state
	local world = flight.world
	local distance = FlightSim.distance(s)
	local combo = GameConfig.comboFor(s.ringCount, s.perfectBounces, flight.timing == "Perfect")
	local coins = GameConfig.coinsFor(distance, combo, 0)
	local previous = data.Best[world.id] or 0
	if distance &gt; previous then
		data.Best[world.id] = distance
	end
	data.Launches += 1
	data.TotalDistance += distance
	if releasing then
		local balances = releasing.Data.Currency.Balances
		balances.StarCoins = math.min((balances.StarCoins or 0) + coins, 1e15)
		local earned = releasing.Data.Currency.Earned
		earned.StarCoins = math.min((earned.StarCoins or 0) + coins, 1e15)
		releasing.Dirty = true
	else
		Currency.Add(player, "StarCoins", coins, "flight")
	end

	-- Monster XP (capped server-side)
	local petXp = GameConfig.petXpFor(distance)
	local levelUp = false
	local owned = if releasing then flight.uid ~= nil and releasing.Data.Inventory.Uniques[flight.uid] ~= nil else flight.uid ~= nil and Inventory.GetUnique(player, flight.uid) ~= nil
	if owned and flight.uid then
		local meta = GameState.Monster(data, flight.uid)
		if meta.Level &lt; GameConfig.PetLevel.Max then
			meta.Xp += petXp
			while meta.Level &lt; GameConfig.PetLevel.Max and meta.Xp &gt;= GameConfig.petXpForLevel(meta.Level) do
				meta.Xp -= GameConfig.petXpForLevel(meta.Level)
				meta.Level += 1
				levelUp = true
			end
		end
	end
	if not releasing then
		GameState.Changed(player)
	end

	local summary = {
		id = flight.id,
		world = world.id,
		distance = distance,
		best = math.max(previous, distance),
		newRecord = distance &gt; previous and previous &gt; 0,
		firstRecord = distance &gt; previous and previous == 0,
		coins = coins,
		combo = combo,
		rings = s.ringCount,
		bounces = s.bounces,
		perfectBounces = s.perfectBounces,
		timing = flight.timing,
		boosted = s.boosted,
		finished = s.endReason == "finish",
		petXp = petXp,
		petLevelUp = levelUp,
	}
	Flight.Finished:Fire(player, summary)
	if resultsPush and player.Parent then
		resultsPush:Fire(player, summary)
	end
	if eventPush then
		eventPush:FireAll("ended", { owner = player.UserId, id = flight.id })
	end
end

-- Ends a flight with no reward (death, travel, reset, player cancel).
function Flight.Cancel(player: Player, reason: string)
	local flight = flights[player]
	if not flight then
		return
	end
	flight.granted = true
	cleanup(player, flight)
	if eventPush then
		eventPush:FireAll("ended", { owner = player.UserId, id = flight.id, cancelled = true, reason = reason })
	end
end

-- Disconnect: finish the flight without further input and grant once into the
-- releasing profile. Runs synchronously inside PlayerData.Releasing (no yields).
local function recoverOnRelease(player: Player, profile: PlayerData.Profile)
	local flight = flights[player]
	if not flight then
		return
	end
	local guard = 0
	while flight.state.phase ~= "DONE" and guard &lt; 4000 do
		guard += 1
		FlightSim.advance(flight.state, flight.world, F.Step)
	end
	complete(player, flight, profile)
end

local function step(dt: number)
	for player, flight in flights do
		local events = FlightSim.advance(flight.state, flight.world, dt)
		for _, e in events do
			if e.kind ~= "end" and eventPush then
				eventPush:FireAll("event", { owner = player.UserId, id = flight.id, kind = e.kind, index = e.index, perfect = e.perfect, x = e.x, y = e.y, z = e.z })
			end
		end
		local s = flight.state
		-- Simulation catch-up is bounded, but the wall-clock lifetime must also be bounded.
		if workspace:GetServerTimeNow() - flight.started &gt;= F.MaxDuration and s.phase ~= "DONE" then
			s.phase = "DONE"; s.endReason = "timeout"
		end
		if flight.focus then
			flight.focus.Position = worldPoint(flight.world, s.x, s.y, s.z)
			local velocity = Vector3.new(s.vx, s.vy, s.vz)
			if riderService then
				local direction = if velocity.Magnitude &gt; .01 then velocity.Unit else Vector3.new(0,0,1)
				riderService.SetFlightPose(player, CFrame.lookAt(flight.focus.Position, flight.focus.Position + direction))
			end
		end
		if s.phase == "DONE" then
			complete(player, flight)
		end
	end
	snapTimer += dt
	if snapTimer &gt;= 1 / F.SnapshotRate then
		snapTimer = 0
		local rows = {}
		for player, flight in flights do
			local s = flight.state
			table.insert(rows, {
				player.UserId,
				flight.id,
				math.floor(s.t * 1000) / 1000,
				math.floor(s.x * 10) / 10,
				math.floor(s.y * 10) / 10,
				math.floor(s.z * 10) / 10,
				math.floor(s.vx * 10) / 10,
				math.floor(s.vy * 10) / 10,
				math.floor(s.vz * 10) / 10,
			})
		end
		if #rows &gt; 0 and snapPush then
			snapPush:FireAll(rows)
		end
	end
end

function Flight.ApplyInput(player: Player, id: number, kind: string, value: number?)
	local flight = flights[player]
	if not flight or flight.id ~= id then
		return
	end
	local s = flight.state
	if kind == "boost" then
		if FlightSim.boost(s) and eventPush then
			eventPush:FireAll("event", { owner = player.UserId, id = flight.id, kind = "boost" })
		end
	elseif kind == "tap" then
		-- Latency grace so a tap on the visible contact still counts
		local grace = math.clamp(player:GetNetworkPing(), 0, 0.15)
		s.perfectUntil += grace
		local perfect = FlightSim.tapBounce(s)
		s.perfectUntil -= grace
		if perfect and eventPush then
			eventPush:FireAll("event", { owner = player.UserId, id = flight.id, kind = "perfectBounce", x = s.x, y = s.y, z = s.z })
		end
	elseif kind == "steer" and value then
		FlightSim.setSteer(s, value)
	end
end

function Flight.Init()
	eventPush = Net.Push("Flight.Event")
	resultsPush = Net.Push("Flight.Results")
	snapPush = Net.PushUnreliable("Flight.Snap")

	Net.Handle("Flight.Aim", {
		rate = { burst = 3, perSecond = 1 },
		args = {},
		handler = function(player: Player): Net.Result
			local data = GameState.Get(player)
			if not data then
				return Net.fail("NotReady")
			end
			if flights[player] then return Net.fail("Flying") end
			if not Flight.CanLaunch(player) then return Net.fail("NearCannon") end
			nextAimId += 1
			local aim = {
				session = nextAimId,
				start = workspace:GetServerTimeNow(),
				period = if data.Settings.slowTiming then F.MarkerPeriodSlow else F.MarkerPeriod,
			}
			aims[player] = aim
			if riderService then riderService.SetAiming(player, true) end
			task.delay(F.AimTimeout + .1, function()
				if aims[player] == aim then Flight.InvalidateAim(player) end
			end)
			return Net.ok({ session = aim.session, start = aim.start, period = aim.period })
		end,
	})

	Net.Handle("Flight.Fire", {
		rate = { burst = 2, perSecond = 1 },
		args = { T.integer(1, 1e9), T.number(F.MinAngle, F.MaxAngle), T.number(0, 1) },
		handler = function(player: Player, session: number, angle: number, marker: number): Net.Result
			local aim = aims[player]
			if not aim or aim.session ~= session then
				return Net.fail("NoAim")
			end
			Flight.InvalidateAim(player)
			if not Flight.CanLaunch(player) then return Net.fail("NearCannon") end
			if workspace:GetServerTimeNow() - aim.start &gt; F.AimTimeout then
				return Net.fail("Expired")
			end
			local timing = GameConfig.timingFor(Flight.VerifyMarker(player, aim, marker))
			local flight = Flight.Start(player, timing, angle)
			if not flight then
				return Net.fail("Busy")
			end
			return Net.ok({ id = flight.id, timing = timing })
		end,
	})

	Net.Handle("Flight.Cancel", {
		rate = { burst = 2, perSecond = 1 },
		args = {},
		handler = function(player: Player): Net.Result
			Flight.InvalidateAim(player)
			Flight.Cancel(player, "player")
			return Net.ok()
		end,
	})

	Net.Listen("Flight.Input", {
		rate = { burst = 30, perSecond = 20 },
		args = { T.integer(1, 1e9), T.oneOf({ "boost", "tap", "steer" }), T.optional(T.number(-1, 1)) },
		handler = Flight.ApplyInput,
	})

	RunService.Heartbeat:Connect(step)
	PlayerData.Releasing:Connect(recoverOnRelease)

	local function cancelIfStillHere(player: Player, reason: string)
		local flight = flights[player]
		task.delay(0.1, function()
			-- leaving players are handled by recoverOnRelease (reward granted once)
			if player.Parent and flights[player] == flight then
				Flight.Cancel(player, reason)
			end
		end)
	end
	local function watch(player: Player)
		player.CharacterRemoving:Connect(function()
			aims[player] = nil
			cancelIfStillHere(player, "character")
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player: Player)
		aims[player] = nil
	end)
end

return Flight
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <Content name="LinkedSource">
            <null />
          </Content>
          <ProtectedString name="Source">--!strict
-- GameState: the "Game" profile slice (upgrades, training, worlds, records, monster
-- progress, settings) and its coalesced push to the owning client.
-- Same shape as the LihFolk services: register the slice in Init, mutate synchronously,
-- then MarkDirty + push.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))
local Game = ReplicatedStorage:WaitForChild("Game")
local GameConfig = require(Game:WaitForChild("GameConfig")) :: any
local WorldConfig = require(Game:WaitForChild("WorldConfig")) :: any
local PlayerData = require(ServerScriptService:WaitForChild("LihFolk"):WaitForChild("PlayerData"))

export type MonsterMeta = { Level: number, Xp: number, Mutation: string, Unlocked: { [string]: boolean } }

local GameState = {}

local statePush: Net.Push? = nil
local pending: { [Player]: boolean } = {}

local function makeDefault()
	local best = {}
	for _, world in WorldConfig.List do
		best[world.id] = 0
	end
	local settings = {}
	for key, value in GameConfig.DefaultSettings do
		settings[key] = value
	end
	return {
		CannonLevel = 0,
		BoostLevel = 1,
		BounceLevel = 0,
		MagnetLevel = 0,
		TrainingLevel = 1,
		TrainingXP = 0,
		Unlocked = { [WorldConfig.Home] = true },
		Best = best,
		Launches = 0,
		TotalDistance = 0,
		Monsters = {} :: { [string]: MonsterMeta },
		Discovered = {},
		StarterGiven = false,
		Tutorial = 0,
		Settings = settings,
	}
end

function GameState.Get(player: Player): { [string]: any }?
	local profile = PlayerData.Get(player)
	return if profile then profile.Data.Game else nil
end

-- Monster progress for an inventory uid, created on first use.
function GameState.Monster(data: { [string]: any }, uid: string): MonsterMeta
	local meta = data.Monsters[uid]
	if not meta then
		meta = { Level = 1, Xp = 0, Mutation = "Normal", Unlocked = {} }
		data.Monsters[uid] = meta
	end
	return meta
end

-- Marks the profile dirty and schedules one push of the slice (coalesced per frame).
function GameState.Changed(player: Player)
	local profile = PlayerData.Get(player)
	if not profile then
		return
	end
	PlayerData.MarkDirty(profile)
	if pending[player] then
		return
	end
	pending[player] = true
	task.defer(function()
		pending[player] = nil
		local current = PlayerData.Get(player)
		if current and statePush then
			statePush:Fire(player, current.Data.Game)
		end
	end)
end

function GameState.Init()
	PlayerData.RegisterSlice("Game", makeDefault)
	statePush = Net.Push("Game.State")
	Net.Handle("Game.GetState", {
		rate = { burst = 3, perSecond = 1 },
		args = {},
		handler = function(player: Player): Net.Result
			local data = GameState.Get(player)
			return if data then Net.ok(data) else Net.fail("NotReady")
		end,
	})
	PlayerData.Loaded:Connect(function(player: Player)
		GameState.Changed(player)
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		pending[player] = nil
	end)
end

return GameState
</ProtectedString>
          <string name="ScriptGuid">{A4BF1BA1-57FB-432C-954E-19F733B25395}</string>
