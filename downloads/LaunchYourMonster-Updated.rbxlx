        <UniqueId name="UniqueId">038c44eb3ebffb0c0af64a9d0000040e</UniqueId>
        <ProtectedString name="Source">--!strict
-- LAUNCH YOUR MONSTER! - the only server Script.
-- LihFolk wiring order: PlayerData.Configure -&gt; Policy + service Init (slices, remotes)
-- -&gt; game services -&gt; cross-module hooks -&gt; Receipts.Start -&gt; PlayerData.Start.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

Players.CharacterAutoLoads = false -- Worlds spawns characters once the profile is ready

local Config = require(ReplicatedStorage:WaitForChild("LihFolkConfig")) :: any
local Secrets = require(ServerStorage:WaitForChild("LihFolkSecrets")) :: any
local LF = ServerScriptService:WaitForChild("LihFolk")
local GameFolder = ServerScriptService:WaitForChild("Game")

local PlayerData = require(LF.PlayerData)
local Policy = require(LF.Policy)
local Currency = require(LF.Currency)
local Inventory = require(LF.Inventory)
local Receipts = require(LF.Receipts)
local Shop = require(LF.Shop)
local EggHatch = require(LF.EggHatch)
local Codes = require(LF.Codes)
local DailyRewards = require(LF.DailyRewards)
local Quests = require(LF.Quests)
local Leaderboard = require(LF.Leaderboard)

local WorldBuilder = require(GameFolder.WorldBuilder)
local GameState = require(GameFolder.GameState)
local Flight = require(GameFolder.Flight)
local Progression = require(GameFolder.Progression)
local Worlds = require(GameFolder.Worlds)
local Monsters = require(GameFolder.Monsters)

-- World first so spawns and cannons exist before anyone loads
local started = os.clock()
WorldBuilder.Build()
require(GameFolder.PlazaBoards).Start()
print(string.format("[LYM] worlds built in %.2fs", os.clock() - started))

-- 1. Data layer
PlayerData.Configure(Config.PlayerData)

-- 2. LihFolk services
Policy.Init()
Currency.Init(Config.Currency)
Inventory.Init(Config.Inventory)
Receipts.Init(Config.Receipts)
Shop.Init(Config.Shop)
EggHatch.Init(Config.Eggs)
Codes.Init(Secrets.Codes)
DailyRewards.Init(Config.Daily)
Quests.Init(Config.Quests)

local boards = table.clone(Config.Leaderboard.boards)
boards.BestDistance = table.clone(boards.BestDistance)
-- Sources read the profile they are given (on leave it is already detached).
boards.BestDistance.source = function(_player: Player, profile: PlayerData.Profile): number
	local best = 0
	for _, value in profile.Data.Game.Best do
		best = math.max(best, value)
	end
	return best
end
Leaderboard.Init({
	boards = boards,
	writeSeconds = Config.Leaderboard.writeSeconds,
	refreshSeconds = Config.Leaderboard.refreshSeconds,
})

-- 3. Game services (same shape: slice + remotes in Init)
GameState.Init()
Flight.Init()
local Riding = require(GameFolder.Riding)
Riding.Init()
Flight.SetRiderService(Riding)
Progression.Init()
Worlds.Init()
Monsters.Init()

-- Cross-module hooks
Flight.Finished:Connect(function(player: Player, _summary)
	Leaderboard.Add(player, "WeeklyLaunches", 1)
end)

-- 4. Purchases (no developer products in V1; passes have id 0 and are never prompted)
Receipts.Start()

-- 5. Load players last
PlayerData.Start()

-- Studio-only test hook (ServerStorage never replicates). Used by automated MCP tests.
if RunService:IsStudio() then
	local hook = Instance.new("BindableFunction")
	hook.Name = "LYM_Debug"
	hook.OnInvoke = function(command: string, ...: any)
		local args = { ... }
		local player = Players:GetPlayers()[1]
		if not player then
			return nil
		end
		if command == "state" then
			local profile = PlayerData.Get(player)
			return profile and PlayerData.deepCopy(profile.Data)
		elseif command == "coins" then
			return Currency.Add(player, "StarCoins", args[1], "debug")
		elseif command == "launch" then
			local flight = Flight.Start(player, args[1] or "Good", args[2] or 45)
			return flight and flight.id
		elseif command == "input" then
			Flight.ApplyInput(player, args[1], args[2], args[3])
			return true
		elseif command == "flying" then
			return Flight.IsFlying(player)
		elseif command == "travel" then
			return Worlds.Travel(player, args[1])
		elseif command == "unlock" then
			local data = GameState.Get(player)
			if data then
				data.Unlocked[args[1]] = true
				GameState.Changed(player)
			end
			return true
		end
		return nil
	end
	hook.Parent = ServerStorage
end

print("[LYM] server started")
