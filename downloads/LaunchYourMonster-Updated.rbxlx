            <ProtectedString name="Source">--!strict
-- Fx: thin game-facing wrapper over the LihFolk VFX kits (client only, budgeted, culled).
-- Settings (reduced motion, shake) are pushed in from Data.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VFX = require(ReplicatedStorage:WaitForChild("LihFolkVFX")) :: any
local Abilities = require(ReplicatedStorage:WaitForChild("LihFolkVFX_Abilities")) :: any

local Fx = {}

function Fx.applySettings(settings: { [string]: any })
	Abilities.Config.reducedMotion = settings.reducedMotion == true
	Abilities.Config.shakeScale = if settings.cameraShake then 1 else 0
end

-- Impact star + rings + sparks along `direction` (ring pickups, bounces, landings).
function Fx.impact(position: Vector3, direction: Vector3, element: string, scale: number?)
	pcall(VFX.hitSpark, position, direction, { element = element, scale = scale or 1, important = true })
end

function Fx.shake(intensity: number, duration: number, position: Vector3?)
	pcall(Abilities.CameraShake, intensity, duration, { position = position })
end

function Fx.levelUp(character: Model?, element: string?)
	if character then
		pcall(Abilities.LevelUp, character, { element = element or "holy", important = true })
	end
end

function Fx.teleport(fromCF: CFrame, toCF: CFrame, element: string?)
	pcall(Abilities.Teleport, fromCF, toCF, { element = element or "teal", important = true })
end

function Fx.start()
	pcall(VFX.preload)
	pcall(Abilities.preload)
end

return Fx
