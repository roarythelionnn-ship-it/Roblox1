-- old name kept so existing calls keep working (it is the frontal sweep now)
(LihFolkVFX.Presets :: any).SlashRing = LihFolkVFX.Presets.SlashSweep

-- Marker value -&gt; what to play (values come from our clips: SwordLight1..3 "1".."3", SwordHeavy "heavy", SwordDashSlash "dash")
export type HitSpec = {
	preset: string,
	flip: boolean?,
	tilt: number?,
	yaw: number?,
	scale: number?,
	element: string?,
	offset: CFrame?,
	skipUnits: boolean?, -- play only the non-arc layers (e.g. OverheadCleave's ground crack for a slam)
	follow: boolean?, -- DashTrail: the streak head follows the root part (else the predicted path)
	byValue: { [string]: HitSpec }?, -- marker value -&gt; a different spec (e.g. Impact "ice" -&gt; IceExplosion)
}
LihFolkVFX.DefaultHits = {
	["1"] = { preset = "CrescentDouble", tilt = 12 },
	["2"] = { preset = "CrescentDouble", flip = true, tilt = -10 },
	["3"] = { preset = "OverheadCleave" }, -- SwordLight3 is the stepping overhead
	heavy = { preset = "SlashSweep" },
	dash = { preset = "CrescentDouble", scale = 1.3, offset = CFrame.new(0, 0, -3) },
	thrust = { preset = "ThrustPierce" }, -- for a stab clip with Hit value "thrust"
	-- SpinAttack clip (UNTESTED IN STUDIO): ground shock per turn, growing; frontal finisher.
	-- LihFolkVFX.playSpinAttack() adds the whirl trails, wind swirl and tangential sparks on top.
	spin1 = { preset = "SpinShock", scale = 0.85 },
	spin2 = { preset = "SpinShock", scale = 1.15 },
	spin3 = { preset = "SpinShock", scale = 1.5 },
	spinfinish = { preset = "SpinFinish", offset = CFrame.new(0, 0, -3) }, -- v2.1: spawned ahead of the body
} :: { [string]: HitSpec }

-- Other markers by name (the marker value, if a number, is the dash distance in studs)
LihFolkVFX.DefaultMarkers = {
	DashStart = { preset = "DashTrail", follow = true }, -- SwordDashSlash (value "11.0")
	Impact = { -- GroundSlam; marker value "ice" (or any preset name) picks another effect
		preset = "OverheadCleave", skipUnits = true, offset = CFrame.new(0, 0, 3.5),
		byValue = { ice = { preset = "IceExplosion", offset = CFrame.new(0, 0, -3) } },
	},
	Deflect = { preset = "HitSpark", offset = CFrame.new(0.5, 1, -2.5), scale = 0.7 }, -- SwordParry
} :: { [string]: HitSpec }

-- Clips that open with a charge (keyed by Animation.Name, or set the Animation attribute "VFXCharge" = preset):
-- the charge starts when the track starts and is retimed so its release lands on the Hit marker (lead, seconds).
LihFolkVFX.DefaultCharges = {
	SwordHeavy = { preset = "ChargeUp", lead = 0.767 },
} :: { [string]: { preset: string, lead: number } }

-- Clips whose weapon Trail must stay off (spins). Also any Animation with the attribute "VFXNoTrail".
LihFolkVFX.NoTrailClips = { SwordHeavy = true, SpinAttack = true } :: { [string]: boolean }

-------------------------------------------------------------------------------
-- Small helpers
-------------------------------------------------------------------------------
local warned: { [string]: boolean } = {}
local function warnOnce(key: string, msg: string)
	if not warned[key] then
		warned[key] = true
		warn("[LihFolkVFX] " .. msg)
	end
end

local function tex(key: string): string?
	local id = (LihFolkVFX.Textures :: any)[key]
	if type(id) == "string" and id ~= "" then
		return id
	end
	warnOnce("tex:" .. key, "texture '" .. key .. "' has no id yet; that layer is skipped")
	return nil
end

local function meshId(key: string): string?
	local id = (LihFolkVFX.Meshes :: any)[key]
	if type(id) == "string" and id ~= "" then
		return id
	end
	warnOnce("mesh:" .. key, "mesh '" .. key .. "' has no id yet; mesh layers using it are skipped")
	return nil
end

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

local function easeOut(x: number, p: number): number
	return 1 - (1 - clamp01(x)) ^ p
end

local function easeIn(x: number, p: number): number
	return clamp01(x) ^ p
end

local function ns(points: { { number } }): NumberSequence
	local kps = {}
	for _, p in points do
		table.insert(kps, NumberSequenceKeypoint.new(p[1], p[2], p[3] or 0))
	end
	return NumberSequence.new(kps)
end

-- point on the arc circle in pivot space; phi in degrees, 0 = +X, 90 = forward (-Z)
local function arcPoint(phi: number, r: number, y: number): Vector3
	local a = math.rad(phi)
	return Vector3.new(math.cos(a) * r, y, -math.sin(a) * r)
end

local function arcTangent(phi: number): Vector3
	local a = math.rad(phi)
	return Vector3.new(-math.sin(a), 0, -math.cos(a))
end

local function newPart(name: string, cf: CFrame, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = cf
	p.Parent = parent
	return p
end

local function newEmitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Rate = 0
	e.LightInfluence = 0
	e.LockedToPart = false
	e.VelocityInheritance = 0
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = parent
	return e
end

local function meshLayer(name: string, mesh: string, texture: string, cf: CFrame, parent: Instance, neon: boolean): (Part, SpecialMesh)
	local p = newPart(name, cf, parent)
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.Transparency = 1
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.FileMesh
	m.MeshId = mesh
	m.TextureId = texture
	m.Scale = Vector3.one
	m.Parent = p
	return p, m
end

local function v3(c: Color3, gain: number): Vector3
	return Vector3.new(c.R * gain, c.G * gain, c.B * gain)
end

-- palette role -&gt; colour ("deep" = main halfway to dark, "white")
local function role(pal: Palette, name: string?): Color3
	local key = name or "main"
	local c = (pal :: any)[key]
	if typeof(c) == "Color3" then
		return c
	elseif key == "deep" then
		return pal.main:Lerp(pal.dark, 0.5)
	elseif key == "white" then
		return Color3.new(1, 1, 1)
	end
	return pal.main
end

-- role or { roleAtStart, roleAtEnd }
local function roleSeq(pal: Palette, r: any): ColorSequence
	if type(r) == "table" then
		return ColorSequence.new(role(pal, r[1]), role(pal, r[2] or r[1]))
	end
	return ColorSequence.new(role(pal, r))
end

local function vec(t: any, s: number): Vector3
	if type(t) ~= "table" then
		return Vector3.zero
	end
	return Vector3.new((t[1] or 0) * s, (t[2] or 0) * s, (t[3] or 0) * s)
end

-- number or {{t, v}, ...} -&gt; NumberSequence, values scaled by s
local function seqOf(v: any, s: number): NumberSequence
	if type(v) == "number" then
		return NumberSequence.new(v * s)
	end
	local kps = {}
	for _, p in v do
		table.insert(kps, NumberSequenceKeypoint.new(p[1], p[2] * s))
	end
	return NumberSequence.new(kps)
end

local function range(v: any, default: number, s: number?): NumberRange
	local k = s or 1
	if type(v) == "table" then
		return NumberRange.new(v[1] * k, (v[2] or v[1]) * k)
	elseif type(v) == "number" then
		return NumberRange.new(v * k)
	end
	return NumberRange.new(default)
end

local function randomUnit(): Vector3
	local z = 2 * math.random() - 1
	local a = 2 * math.pi * math.random()
	local r = math.sqrt(1 - z * z)
	return Vector3.new(r * math.cos(a), z, r * math.sin(a))
end

-- random direction within `deg` of axis
local function randomCone(axis: Vector3, deg: number): Vector3
	local ref = if math.abs(axis.Y) &lt; 0.9 then Vector3.yAxis else Vector3.xAxis
	local p = axis:Cross(ref).Unit
	local q = axis:Cross(p)
	local th = math.rad(deg) * math.sqrt(math.random())
	local ph = 2 * math.pi * math.random()
	return (axis * math.cos(th) + (p * math.cos(ph) + q * math.sin(ph)) * math.sin(th)).Unit
end

local function aim(pos: Vector3, dir: Vector3): CFrame
	local up = if math.abs(dir.Y) &gt; 0.99 then Vector3.xAxis else Vector3.yAxis
	return CFrame.lookAt(pos, pos + dir, up)
end

-------------------------------------------------------------------------------
-- Timeline engine (one Heartbeat connection for every live effect)
-------------------------------------------------------------------------------
type Step = (t: number) -&gt; ()
type Effect = {
	t0: number,
	life: number,
	steps: { Step },
	root: Instance,
	particles: number,
	stopped: boolean,
	finished: boolean,
	speed: number, -- timeline rate (ChargeUp is retimed to its clip)
}

local active: { Effect } = {}
local heartbeat: RBXScriptConnection? = nil
local liveParticles = 0
local container: Folder? = nil

local function getContainer(): Folder
	local c = container
	if c and c.Parent then
		return c
	end
	local f = Instance.new("Folder")
	f.Name = "LihFolkVFX"
	f.Parent = Workspace
	container = f
	return f
end

local function finish(e: Effect)
	-- (a stop() call only flags `stopped`; the next tick lands here and really cleans up)
	if e.finished then
		return
	end
	e.finished = true
	e.stopped = true
	liveParticles = math.max(0, liveParticles - e.particles)
	e.root:Destroy()
end

local function tick()
	local now = os.clock()
	for i = #active, 1, -1 do
		local e = active[i]
		local t = now - e.t0
		if e.stopped or t &gt;= e.life then
			finish(e)
			table.remove(active, i)
		else
			local ok, err = pcall(function()
				local lt = t * e.speed
				for _, step in e.steps do
					step(lt)
				end
			end)
			if not ok then
				warn("[LihFolkVFX] effect step failed, cleaning up: " .. tostring(err))
				finish(e)
				table.remove(active, i)
			end
		end
	end
	if #active == 0 and heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
end

local function start(e: Effect)
	table.insert(active, e)
	-- safety net: even if the loop dies, the instances go away
	Debris:AddItem(e.root, e.life + 3)
	if not heartbeat then
		heartbeat = RunService.Heartbeat:Connect(tick)
	end
	tick()
end

-------------------------------------------------------------------------------
-- Build context
-------------------------------------------------------------------------------
type BuildCtx = {
	root: Instance,
	base: CFrame, -- swing frame (XZ plane = swing plane, -Z = forward)
	body: CFrame, -- the cf passed to play (no flip/tilt/yaw)
	ground: CFrame, -- flat on the floor under body, facing body's heading
	anchor: BasePart,
	pal: Palette,
	scale: number,
	detail: number, -- 0..1 count scale
	deco: boolean, -- decoration layers on
	steps: { Step },
	particles: number,
	pathHead: (t: number) -&gt; Vector3, -- dash head in body space
	character: Model?,
	arcShift: number, -- degrees added to every unit's yaw (from opts.arc), then clamped to the front
}

local function frameOf(space: string?, ctx: BuildCtx): CFrame
	if space == "ground" then
		return ctx.ground
	elseif space == "swing" then
		return ctx.base
	end
	return ctx.body -- "body" and "path"
end

local function count(n: number, ctx: BuildCtx): number
	if n &lt;= 0 then
		return 0
	end
	return math.max(1, math.floor(n * ctx.detail + 0.5))
end

-------------------------------------------------------------------------------
-- Unit builder: one crescent or ring with all its layers
-------------------------------------------------------------------------------
local BODY_REVEAL = { "strip_body_reveal_1", "strip_body_reveal_2", "strip_body_reveal_3", "strip_body" }
local BODY_ERODE = { "strip_body_erode_1", "strip_body_erode_2", "strip_body_erode_3", "strip_body_erode_4", "strip_body_erode_5" }
local function bodyStack(family: string): { string }
	local ids = { family }
	for i = 1, 5 do
		table.insert(ids, family .. "_erode_" .. i)
	end
	return ids
end

local function inkStages(family: string): { string }
	return { family, family .. "_erode_1", family .. "_erode_2", family .. "_erode_3" }
end

--[[ Cross-fade between baked erosion stages: part A shows stage floor(s) and fades out while part B
	shows the next (smaller, it is a subset) stage at full alpha, so the break-up eats in smoothly
	instead of popping. `alpha` is the layer's overall opacity. ]]
local function crossfade(a: Part, am: SpecialMesh, b: Part?, bm: SpecialMesh?, ids: { string }, s: number, alpha: number)
	local n = #ids
	local k = math.clamp(math.floor(s), 1, n)
	local f = if k &gt;= n then 0 else s - k
	am.TextureId = ids[k]
	a.Transparency = 1 - alpha * (1 - f)
	if b and bm then
		if k &lt; n then
			bm.TextureId = ids[k + 1]
			b.Transparency = 1 - alpha
		else
			b.Transparency = 1
		end
	end
end

-- Frontal rule: a slash arc stays in front of the character. In the unit's own plane phi 90 is forward,
-- so the arc (tail .. head) is clamped to 90 +- FRONT_LIMIT and the drift may carry the head only
-- FRONT_DRIFT degrees further. Arcs longer than 2 * FRONT_LIMIT are not allowed (no rings or spins).
local FRONT_LIMIT = 100
local FRONT_DRIFT = 10

local function frontalYaw(u: Unit, shift: number): (number, number)
	local half = math.min(u.span, 2 * FRONT_LIMIT) / 2
	local yaw = math.clamp(u.yaw + shift, half - FRONT_LIMIT, FRONT_LIMIT - half)
	local drift = math.clamp(u.drift, 0, math.max(0, FRONT_LIMIT + FRONT_DRIFT - (half + yaw)))
	return yaw, drift
end

local function buildUnit(u: Unit, ctx: BuildCtx)
	local R = u.radius * ctx.scale
	local unitYaw, driftDeg = frontalYaw(u, ctx.arcShift)
	local cf = ctx.base
		* CFrame.new(0, u.lift * ctx.scale, 0)
		* CFrame.Angles(0, 0, math.rad(u.tilt))
		* CFrame.Angles(0, math.rad(unitYaw), 0)
	local pivot = newPart("Unit", cf, ctx.root)
	local tail = 90 - u.span / 2
	local head0 = 90 + u.span / 2
	local tHold = u.sweep + u.hold
	local tEnd = tHold + u.erode
	local smooth = u.smoothErode == true

	-- shared clock of the unit: reveal r(t) and the head angle
	local function reveal(t: number): number
		return easeOut(t / u.sweep, u.sweepEase)
	end
	local function yawAt(t: number): number
		local r = reveal(t)
		local drift = driftDeg * easeOut((t - u.sweep) / (tEnd - u.sweep), 2)
		return -u.span * (1 - r) + drift
	end

	local yawOffset = LihFolkVFX.Config.meshYawOffset
	local meshKey = meshId(u.mesh)

	-- 1) dark ink smear mesh (painted over the body's inner half)
	local family = u.ink or "strip_ink"
	local inkTex = tex(family)
	if meshKey and inkTex then
		local part, mesh = meshLayer("Ink", meshKey, inkTex, cf, ctx.root, false)
		mesh.VertexColor = v3(ctx.pal.dark, 1)
		local partB: Part?, meshB: SpecialMesh? = nil, nil
		if smooth then
			local pb, mb = meshLayer("InkB", meshKey, inkTex, cf, ctx.root, false)
			mb.VertexColor = v3(ctx.pal.dark, 1)
			partB, meshB = pb, mb
		end
		local inkIds: { string } = {}
		for _, k in inkStages(family) do
			table.insert(inkIds, tex(k) or inkTex)
		end
		local lastStage = 0
		table.insert(ctx.steps, function(t: number)
			local lt = t - u.delay - 0.03
			if lt &lt; 0 then
				part.Transparency = 1
				if partB then
					partB.Transparency = 1
				end
				return
			end
			local inT = clamp01(lt / 0.07)
			local outT = clamp01((lt - (tHold + u.erode * 0.4)) / (u.erode * 0.65))
			local alpha = 0.88 * inT - 0.88 * easeIn(outT, 1.6)
			-- erosion is front-loaded (sqrt): the break-up starts right after the hold
			local ex = clamp01((lt - tHold) / u.erode)
			if smooth then
				local s = if lt &lt; tHold then 1 else 1 + 3 * math.sqrt(ex)
				crossfade(part, mesh, partB, meshB, inkIds, s, math.max(alpha, 0))
			else
				part.Transparency = 1 - alpha
				local stage = if lt &lt; tHold then 1 else 1 + math.clamp(math.floor(3 * math.sqrt(ex)) + 1, 1, 3)
				if stage ~= lastStage then
					lastStage = stage
					mesh.TextureId = inkIds[stage]
				end
			end
			local s = R * u.inkScale * (0.95 + 0.07 * easeOut(lt / tEnd, 2))
			local icf = cf * CFrame.new(0, -u.inkDrop * ctx.scale, 0) * CFrame.Angles(0, math.rad(yawAt(lt) - u.inkLag + yawOffset), 0)
			mesh.Scale = Vector3.new(s, s, s)
			part.CFrame = icf
			if partB and meshB then
				meshB.Scale = mesh.Scale
				partB.CFrame = icf
			end
		end)
	end

	-- 2) body mesh: reveal swaps during the sweep, erosion swaps (or cross-fades) after the hold
	local bodyTex = tex("strip_body")
	if meshKey and bodyTex then
		local part, mesh = meshLayer("Body", meshKey, bodyTex, cf, ctx.root, true)
		part.Color = ctx.pal.main
		mesh.VertexColor = v3(ctx.pal.main, u.bodyGain)
		local partB: Part?, meshB: SpecialMesh? = nil, nil
		if smooth then
			local pb, mb = meshLayer("BodyB", meshKey, bodyTex, cf, ctx.root, true)
			pb.Color = ctx.pal.main
			mb.VertexColor = v3(ctx.pal.main, u.bodyGain)
			partB, meshB = pb, mb
		end
		local reveals: { string } = {}
		local fam = u.body or "strip_body"
		for i, k in BODY_REVEAL do
			local key = if fam == "strip_body" then k elseif i &lt; 4 then fam .. "_reveal_" .. i else fam
			table.insert(reveals, tex(key) or bodyTex)
		end
		local erodes: { string } = {}
		for _, k in BODY_ERODE do
			table.insert(erodes, tex(k) or bodyTex)
		end
		local stack: { string } = {}
		for _, k in bodyStack(u.body or "strip_body") do
			table.insert(stack, tex(k) or bodyTex)
		end
		local current = ""
		table.insert(ctx.steps, function(t: number)
			local lt = t - u.delay
			if lt &lt; 0 then
				part.Transparency = 1
				if partB then
					partB.Transparency = 1
				end
				return
			end
			local fade = clamp01((lt - (tHold + u.erode * 0.4)) / (u.erode * 0.6))
			local alpha = 1 - easeIn(fade, 1.8)
			if smooth and lt &gt;= tHold then
				-- strip_body -&gt; erode_5 as one continuous stack (front-loaded)
				crossfade(part, mesh, partB, meshB, stack, 1 + 5 * math.sqrt(clamp01((lt - tHold) / u.erode)), alpha)
				current = ""
			else
				local id: string
				if lt &lt; u.sweep then
					local r = reveal(lt)
					id = reveals[if r &lt; 0.42 then 1 elseif r &lt; 0.67 then 2 elseif r &lt; 0.9 then 3 else 4]
				elseif lt &lt; tHold then
					id = if smooth then stack[1] else reveals[4]
				else
					local k = math.clamp(math.floor(5 * math.sqrt(clamp01((lt - tHold) / u.erode))) + 1, 1, 5)
					id = erodes[k]
				end
				if id ~= current then
					current = id
					mesh.TextureId = id
				end
				part.Transparency = 1 - alpha
				if partB then
					partB.Transparency = 1
				end
			end
			local grow = 0.86 + 0.14 * easeOut(lt / tHold, 2) + (u.expand or 0.04) * easeOut((lt - tHold) / u.erode, 2)
			local s = R * grow
			local bcf = cf * CFrame.Angles(0, math.rad(yawAt(lt) + yawOffset), 0)
			mesh.Scale = Vector3.new(s, s, s)
			part.CFrame = bcf
			if partB and meshB then
				meshB.Scale = mesh.Scale
				partB.CFrame = bcf
			end
		end)
	end

	-- 2b) white-hot rim along the whole arc once it is drawn (value ladder: white rim, element body, dark ink)
	local rimTex = if u.rim then tex("strip_edge") else nil
	if meshKey and rimTex then
		local part, mesh = meshLayer("Rim", meshKey, rimTex, cf, ctx.root, true)
		part.Color = ctx.pal.hot
		mesh.VertexColor = v3(ctx.pal.hot, u.rim or 1)
		table.insert(ctx.steps, function(t: number)
			local lt = t - u.delay
			if lt &lt; u.sweep * 0.8 then
				part.Transparency = 1
				return
			end
			local alpha = clamp01((lt - u.sweep * 0.8) / 0.04) * (1 - easeIn((lt - tHold) / (u.erode * 0.55), 1.3))
			part.Transparency = 1 - alpha
			local s = R * (0.86 + 0.14 * easeOut(lt / tHold, 2) + (u.expand or 0.04) * easeOut((lt - tHold) / u.erode, 2))
			mesh.Scale = Vector3.new(s, s, s)
			part.CFrame = cf * CFrame.Angles(0, math.rad(yawAt(lt) + yawOffset), 0)
		end)
	end

	-- 3) additive flipbook glow card (+ dark card) lying in the swing plane
	local cardSize = 2 * R / u.cardROut
	local cardRot = tail + LihFolkVFX.Config.cardRotation
	local cardAtt = Instance.new("Attachment")
	cardAtt.Parent = pivot
	local cardsOn = u.cards ~= false
	local cardTex = if cardsOn then tex(u.card) else nil
	if cardTex then
		local e = newEmitter(cardAtt, {
			Texture = cardTex,
			Color = ColorSequence.new(ctx.pal.glow),
			LightEmission = 1,
			Brightness = u.cardBrightness,
			Size = NumberSequence.new(cardSize),
			Transparency = ns({ { 0, u.cardTransparency }, { 0.8, u.cardTransparency }, { 1, 1 } }),
			Lifetime = NumberRange.new(tEnd),
			Speed = NumberRange.new(0.001),
			SpreadAngle = Vector2.zero,
			EmissionDirection = Enum.NormalId.Top,
			Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
			Rotation = NumberRange.new(cardRot),
			FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4,
			FlipbookMode = Enum.ParticleFlipbookMode.OneShot,
			ZOffset = 0.5,
		})
		local fired = false
		table.insert(ctx.steps, function(t: number)
			if not fired and t &gt;= u.delay then
				fired = true
				e:Emit(1)
			end
		end)
		ctx.particles += 1
	end
	if cardsOn and u.inkCard and ctx.deco then
		local inkCardTex = tex(u.inkCard)
		if inkCardTex then
			local e = newEmitter(cardAtt, {
				Texture = inkCardTex,
				Color = ColorSequence.new(ctx.pal.dark),
				LightEmission = 0,
				Brightness = 1,
				Size = NumberSequence.new(cardSize * u.inkScale),
				Transparency = ns({ { 0, 0.35 }, { 0.75, 0.35 }, { 1, 1 } }),
				Lifetime = NumberRange.new(tEnd * 1.1),
				Speed = NumberRange.new(0.001),
				SpreadAngle = Vector2.zero,
				EmissionDirection = Enum.NormalId.Top,
				Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
				Rotation = NumberRange.new(cardRot - u.inkLag),
				FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4,
				FlipbookMode = Enum.ParticleFlipbookMode.OneShot,
				ZOffset = -0.5,
			})
			local fired = false
			table.insert(ctx.steps, function(t: number)
				if not fired and t &gt;= u.delay then
					fired = true
					e:Emit(1)
				end
			end)
			ctx.particles += 1
		end
	end

	-- 4) hot edge: a Beam band riding the head (solid ribbon if beam_edge_h is not uploaded)
	do
		local a0 = Instance.new("Attachment")
		local a1 = Instance.new("Attachment")
		a0.Parent = pivot
		a1.Parent = pivot
		local beams: { Beam } = {}
		local function makeBeam(widthMul: number, transp: number, color: ColorSequence, brightness: number)
			local b = Instance.new("Beam")
			b.Attachment0 = a0
			b.Attachment1 = a1
			b.FaceCamera = true
			b.Segments = 24
			b.LightEmission = 1
			b.LightInfluence = 0
			b.Brightness = brightness
			b.Color = color
			b.Texture = (LihFolkVFX.Textures :: any).beam_edge_h or ""
			b.TextureMode = Enum.TextureMode.Stretch
			b.TextureLength = 1
			b.TextureSpeed = 0
			b.Transparency = NumberSequence.new(1)
			b:SetAttribute("WidthMul", widthMul)
			b:SetAttribute("Base", transp)
			b.Parent = pivot
			table.insert(beams, b)
		end
		makeBeam(1, 0, ColorSequence.new(ctx.pal.glow, ctx.pal.hot), u.edge.brightness)
		if ctx.deco then
			makeBeam(3.2, 0.72, ColorSequence.new(ctx.pal.glow), 1.5)
		end
		local rEdge = R * 0.985
		local yEdge = (u.edge.lift or 0) * R + 0.05
		table.insert(ctx.steps, function(t: number)
			local lt = t - u.delay
			local alive = lt &gt;= 0 and lt &lt;= u.edge.life
			if not alive then
				for _, b in beams do
					b.Transparency = NumberSequence.new(1)
				end
				return
			end
			local head = head0 + yawAt(lt)
			local band = u.edge.band * (0.35 + 0.65 * reveal(lt))
			local phiA = head - band
			local k = 4 / 3 * math.tan(math.rad(band) / 4) * rEdge
			a0.CFrame = CFrame.fromMatrix(arcPoint(phiA, rEdge, yEdge), arcTangent(phiA), Vector3.yAxis)
			a1.CFrame = CFrame.fromMatrix(arcPoint(head, rEdge, yEdge), arcTangent(head), Vector3.yAxis)
			local life = lt / u.edge.life
			local w = u.edge.width * ctx.scale * (1 - easeIn(life, 1.5))
			local fade = easeIn(life, 2)
			for _, b in beams do
				b.CurveSize0 = k
				b.CurveSize1 = k
				local wm = b:GetAttribute("WidthMul") :: number
				local base = b:GetAttribute("Base") :: number
				b.Width0 = w * wm * 0.15
				b.Width1 = w * wm
				local o = base + (1 - base) * fade
				b.Transparency = ns({ { 0, 1 }, { 0.3, math.min(1, o + 0.35) }, { 0.8, o }, { 1, math.min(1, o + 0.1) } })
			end
		end)
	end

	-- 5) head-spawned particles: sparks, glints, debris (along the swing, not radial)
	local emitAtt = Instance.new("Attachment")
	emitAtt.Parent = pivot
	local spawners: { { e: ParticleEmitter, n: number, done: number, out: number, up: number, ramp: number } } = {}
	local function spawner(e: ParticleEmitter?, n: number, outward: number, up: number, ramp: number)
		if e and n &gt; 0 then
			table.insert(spawners, { e = e, n = n, done = 0, out = outward, up = up, ramp = ramp })
			ctx.particles += n
		end
	end
	local sparkTex = tex("spark_streak")
	spawner(sparkTex and newEmitter(emitAtt, {
		Texture = sparkTex,
		Color = ColorSequence.new(ctx.pal.spark),
		LightEmission = 1,
		Brightness = 5,
		Size = ns({ { 0, 0.55 * ctx.scale }, { 1, 0 } }),
		Transparency = ns({ { 0, 0 }, { 0.7, 0.1 }, { 1, 1 } }),
		Lifetime = NumberRange.new(0.2, 0.38),
		Speed = NumberRange.new(34, 58),
		SpreadAngle = Vector2.new(14, 14),
		EmissionDirection = Enum.NormalId.Front,
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Drag = 6,
		Acceleration = Vector3.new(0, -24, 0),
		ZOffset = 1,
	}) or nil, count(u.sparks, ctx), 0.35, 0.12, 1)
	local glintTex = tex("flip_glint_4x4")
	if ctx.deco then
		spawner(glintTex and newEmitter(emitAtt, {
			Texture = glintTex,
			Color = ColorSequence.new(ctx.pal.hot),
			LightEmission = 1,
			Brightness = 6,
			Size = NumberSequence.new(u.glintSize * ctx.scale),
			Lifetime = NumberRange.new(0.18, 0.24),
			Speed = NumberRange.new(0.5, 2),
			SpreadAngle = Vector2.new(60, 60),
			EmissionDirection = Enum.NormalId.Front,
			Orientation = Enum.ParticleOrientation.FacingCamera,
			FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4,
			FlipbookMode = Enum.ParticleFlipbookMode.OneShot,
			ZOffset = 2,
		}) or nil, count(u.glints, ctx), 0.6, 0.1, 1)
	end
	local petalTex = tex("flip_petals_8x8")
	spawner(petalTex and newEmitter(emitAtt, {
		Texture = petalTex,
		Color = ColorSequence.new(ctx.pal.debris),
		LightEmission = ctx.pal.debrisLight or 0,
		Brightness = 1,
		Size = ns({ { 0, 0.35 * u.debrisSize * ctx.scale }, { 0.15, 0.7 * u.debrisSize * ctx.scale }, { 1, 0.45 * u.debrisSize * ctx.scale } }),
		Squash = ns({ { 0, 0 }, { 0.25, 0.6 }, { 0.5, -0.4 }, { 0.75, 0.5 }, { 1, 0 } }), -- fake tumble
		Transparency = ns({ { 0, 0 }, { 0.7, 0 }, { 1, 1 } }),
		Lifetime = NumberRange.new(0.55, 0.95),
		Speed = NumberRange.new(30, 62),
		SpreadAngle = Vector2.new(18, 18),
		EmissionDirection = Enum.NormalId.Front,
		Orientation = Enum.ParticleOrientation.FacingCamera,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-420, 420),
		Drag = 3.2,
		Acceleration = Vector3.new(0, -14, 0),
		FlipbookLayout = Enum.ParticleFlipbookLayout.Grid8x8,
		FlipbookMode = Enum.ParticleFlipbookMode.Loop,
		FlipbookFramerate = NumberRange.new(0.001),
		FlipbookStartRandom = true,
		ZOffset = 0.2,
	}) or nil, count(u.debris, ctx), 0.55, 0.15, 1.15)

	if #spawners &gt; 0 then
		table.insert(ctx.steps, function(t: number)
			local lt = t - u.delay
			if lt &lt; 0 then
				return
			end
			for _, s in spawners do
				-- spread each burst over the sweep (+ a short tail), always from the current head
				local due = math.min(s.n, math.floor(s.n * clamp01(lt / (u.sweep * s.ramp + 0.03)) + 0.5))
				local k = due - s.done
				if k &gt; 0 then
					local head = head0 + yawAt(lt)
					local dir = (arcTangent(head) + arcPoint(head, 1, 0) * s.out + Vector3.yAxis * s.up + Vector3.new(0, 0, -(u.fwd or 0))).Unit
					local pos = arcPoint(head, R * (0.88 + 0.1 * math.random()), 0.1)
					emitAtt.CFrame = CFrame.lookAt(pos, pos + dir)
					s.e:Emit(k)
					s.done = due
				end
			end
		end)
	end

	-- 6) floating square sparks along the whole arc at the hold (violet style)
	local squareTex = tex("spark_square")
	local nSq = if ctx.deco then count(u.squares, ctx) else 0
	if squareTex and nSq &gt; 0 then
		local sqAtt = Instance.new("Attachment")
		sqAtt.Parent = pivot
		local e = newEmitter(sqAtt, {
			Texture = squareTex,
			Color = ColorSequence.new(ctx.pal.spark),
			LightEmission = 1,
			Brightness = 4,
			Size = ns({ { 0, 0 }, { 0.15, 0.32 * ctx.scale }, { 0.35, 0.12 * ctx.scale }, { 0.55, 0.28 * ctx.scale }, { 1, 0 } }),
			Lifetime = NumberRange.new(0.6, 1.1),
			Speed = NumberRange.new(3, 10),
			SpreadAngle = Vector2.new(40, 40),
			EmissionDirection = Enum.NormalId.Front,
			Orientation = Enum.ParticleOrientation.FacingCamera,
			Rotation = NumberRange.new(0, 45),
			Drag = 2,
			Acceleration = Vector3.new(0, 2.5, 0),
			ZOffset = 1,
		})
		local fired = false
		table.insert(ctx.steps, function(t: number)
			if not fired and t - u.delay &gt;= u.sweep * 0.7 then
				fired = true
				for _ = 1, nSq do
					local phi = tail + u.span * (0.15 + 0.85 * math.random()) + yawAt(t - u.delay)
					local pos = arcPoint(phi, R * (0.75 + 0.3 * math.random()), (math.random() - 0.5) * 1.2)
					sqAtt.CFrame = CFrame.lookAt(pos, pos + (arcPoint(phi, 1, 0) + Vector3.yAxis * 0.4).Unit)
					e:Emit(1)
				end
			end
		end)
		ctx.particles += nSq
	end
end

-------------------------------------------------------------------------------
-- Generic layers (ThrustPierce, OverheadCleave, DashTrail, HitSpark, ChargeUp, flashes)
-------------------------------------------------------------------------------
--[[ Burst: Emit `count` particles at time t (or spread over `over` seconds).
	dir: "none" (sprite/card), "cone" (forward, spread), "back" (+Z, spread), "up" (spread),
	     "sphere" (outward from a radius), "disc" (radial in the floor plane, `up` lift),
	     "converge" (start on a sphere of `radius`, fly to `at`; speed ~ radius / life)
	orient: "camera" (default), "vpar" (streaks), "flat" (card in the space's floor plane),
	        "flatForward" (card facing forward) ]]
local function buildBurst(b: any, ctx: BuildCtx)
	if b.deco and not ctx.deco then
		return
	end
	local n = count(b.count or 1, ctx)
	local texId = tex(b.tex)
	if n &lt;= 0 or not texId then
		return
	end
	local s = ctx.scale
	local orient = b.orient or "camera"
	local mode = b.dir or "none"
	local props: { [string]: any } = {
		Texture = texId,
		Color = roleSeq(ctx.pal, b.role),
		LightEmission = if b.debris then (ctx.pal.debrisLight or 0) else (b.le or 1),
		Brightness = b.bright or 1,
		Size = seqOf(b.size or 1, s),
		Transparency = if b.transp then seqOf(b.transp, 1) else NumberSequence.new(0),
		Lifetime = range(b.life, 0.3),
		Speed = if b.speed then range(b.speed, 0, s) else NumberRange.new(0.001),
		SpreadAngle = Vector2.zero,
		EmissionDirection = if orient == "flat" then Enum.NormalId.Top else Enum.NormalId.Front,
		Orientation = if orient == "flat" or orient == "flatForward"
			then Enum.ParticleOrientation.VelocityPerpendicular
			elseif orient == "vpar" then Enum.ParticleOrientation.VelocityParallel
			else Enum.ParticleOrientation.FacingCamera,
		Rotation = range(b.rot, 0),
		RotSpeed = range(b.rotSpeed, 0),
		Drag = b.drag or 0,
		Acceleration = vec(b.acc, s),
		ZOffset = b.zoff or 0,
	}
	if b.grid then
		props.FlipbookLayout = if b.grid == 8 then Enum.ParticleFlipbookLayout.Grid8x8 else Enum.ParticleFlipbookLayout.Grid4x4
		if b.mode == "random" then
			props.FlipbookMode = Enum.ParticleFlipbookMode.Loop
			props.FlipbookFramerate = NumberRange.new(0.001)
			props.FlipbookStartRandom = true
		else
			props.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
		end
	end
	local att = Instance.new("Attachment")
	att.Parent = ctx.anchor
	local e = newEmitter(att, props)
	ctx.particles += n
	local at = vec(b.at, s)
	local r = (b.radius or 0) * s
	local spread = b.spread or 0
	local function spawnCf(lt: number): CFrame
		local pos = at
		if b.space == "path" then
			pos += ctx.pathHead(lt)
		end
		if mode == "cone" then
			return aim(pos, randomCone(Vector3.new(0, 0, -1), spread))
		elseif mode == "back" then
			local j = randomUnit() * r
			return aim(pos + Vector3.new(j.X, j.Y, 0), randomCone(Vector3.new(0, 0, 1), spread))
		elseif mode == "up" then
			local a = 2 * math.pi * math.random()
			return aim(pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), randomCone(Vector3.yAxis, spread))
		elseif mode == "sphere" then
			local d = randomUnit()
			return aim(pos + d * r * math.random(), d)
		elseif mode == "disc" then
			local a = 2 * math.pi * math.random()
			local radial = Vector3.new(math.cos(a), 0, math.sin(a))
			return aim(pos + radial * r * (0.5 + 0.5 * math.random()), (radial + Vector3.yAxis * (b.up or 0)).Unit)
		elseif mode == "converge" then
			local d = (randomUnit() + Vector3.yAxis * (b.up or 0)).Unit
			return aim(pos + d * r, -d)
		end
		return CFrame.new(pos)
	end
	local t0 = b.t or 0
	local over = b.over or 0
	local done = 0
	local frame = frameOf(b.space, ctx)
	table.insert(ctx.steps, function(t: number)
		local lt = t - t0
		if lt &lt; 0 or done &gt;= n then
			return
		end
		local due = if over &gt; 0 then math.min(n, math.floor(n * clamp01(lt / over)) + 1) else n
		for _ = done + 1, due do
			att.WorldCFrame = frame * spawnCf(lt)
			e:Emit(1)
		end
		done = due
	end)
end

--[[ Ring: a ground_ring-style SpecialMesh scaling from r0 to r1 (ease "out" expands, "in" implodes),
	in the space's floor plane ("flat") or facing forward ("forward"). le 0 = dark SmoothPlastic. ]]
local function buildRing(g: any, ctx: BuildCtx)
	if g.deco and not ctx.deco then
		return
	end
	local m = meshId(g.mesh or "ground_ring")
	local tx = tex(g.tex or "strip_ground_ring")
	if not (m and tx) then
		return
	end
	local s = ctx.scale
	local frame = frameOf(g.space, ctx) * CFrame.new(vec(g.at, s))
	if g.plane == "forward" then
		frame = frame * CFrame.Angles(math.rad(90), 0, 0)
	end
	local neon = (g.le or 1) &gt; 0
	local part, mesh = meshLayer("Ring", m, tx, frame, ctx.root, neon)
	local c = role(ctx.pal, g.role)
	part.Color = c
	mesh.VertexColor = v3(c, g.gain or 1)
	local t0, life = g.t or 0, g.life
	local implode = g.ease == "in"
	local a0 = 1 - (g.transp0 or 0)
	local fadeIn, hold = g.fadeIn or 0, g.hold or 0
	table.insert(ctx.steps, function(t: number)
		local lt = t - t0
		if lt &lt; 0 or lt &gt; life then
			part.Transparency = 1
			return
		end
		local x = lt / life
		local k = if implode then easeIn(x, g.pow or 2) else easeOut(x, g.pow or 3)
		local rr = (g.r0 + (g.r1 - g.r0) * k) * s
		mesh.Scale = Vector3.new(rr, rr, rr)
		local alpha = a0 * (if fadeIn &gt; 0 then clamp01(x / fadeIn) else 1)
		alpha *= 1 - easeIn((x - hold) / (1 - hold), g.fadePow or 1.4)
		part.Transparency = 1 - alpha
		part.CFrame = frame * CFrame.Angles(0, math.rad((g.spin or 0) * easeOut(x, 2)), 0)
	end)
end

--[[ Beam ribbon: head grows from `from` toward `to` (grow, ease-out), or along the dash path (path = true,
	then `to` is an offset from the dash head); after tailDelay the tail chases the head. ]]
local function buildBeam(bm: any, ctx: BuildCtx)
	if bm.deco and not ctx.deco then
		return
	end
	local s = ctx.scale
	local frame = frameOf(bm.space, ctx)
	local a0 = Instance.new("Attachment")
	local a1 = Instance.new("Attachment")
	a0.Parent = ctx.anchor
	a1.Parent = ctx.anchor
	local b = Instance.new("Beam")
	b.Attachment0 = a0
	b.Attachment1 = a1
	b.FaceCamera = true
	b.Segments = bm.segments or 12
	b.LightEmission = bm.le or 1
	b.LightInfluence = 0
	b.Brightness = bm.bright or 1
	b.Color = roleSeq(ctx.pal, bm.role)
	b.Texture = (LihFolkVFX.Textures :: any)[bm.tex or ""] or ""
	b.TextureMode = Enum.TextureMode.Stretch
	b.TextureLength = 1
	b.TextureSpeed = 0
	b.ZOffset = bm.zoff or 0
	b.Transparency = NumberSequence.new(1)
	b.Parent = ctx.anchor
	local from, to = vec(bm.from, s), vec(bm.to, s)
	local t0, life = bm.t or 0, bm.life
	local tailDelay = bm.tailDelay or life
	table.insert(ctx.steps, function(t: number)
		local lt = t - t0
		if lt &lt; 0 or lt &gt; life then
			b.Transparency = NumberSequence.new(1)
			return
		end
		local head: Vector3
		if bm.path then
			head = ctx.pathHead(lt) + to
		else
			head = from:Lerp(to, easeOut(lt / (bm.grow or 0.05), bm.growPow or 2.4))
		end
		local tk = easeIn((lt - tailDelay) / math.max(life - tailDelay, 1e-3), bm.tailPow or 1.5) * (bm.tailMax or 1)
		local tailP = from:Lerp(head, tk)
		if (head - tailP).Magnitude &lt; 0.05 then
			head = tailP + Vector3.new(0, 0, -0.05)
		end
		a0.WorldCFrame = frame * CFrame.new(tailP)
		a1.WorldCFrame = frame * CFrame.new(head)
		local x = lt / life
		local wk = 1 - easeIn(x, bm.shrinkPow or 1.5) * (bm.shrink or 1)
		b.Width0 = bm.width0 * s * wk
		b.Width1 = bm.width1 * s * wk
		local o = (bm.transp or 0) + (1 - (bm.transp or 0)) * easeIn(x, bm.fadePow or 2)
		b.Transparency = ns({
			{ 0, math.min(1, o + (bm.tailFade or 0.5)) },
			{ 0.5, o },
			{ 1, math.min(1, o + (bm.headFade or 0)) },
		})
	end)
end

--[[ Ghosts: `count` afterimages of opts.character, one every `interval`, each a Neon copy of the
	visible BaseParts (max `maxParts`) fading over `life`. Oldest uses oldRole. Needs opts.character. ]]
local function buildGhosts(gs: any, ctx: BuildCtx)
	local character = ctx.character
	if not character or not ctx.deco then
		return
	end
	local n = count(gs.count or 4, ctx)
	local spawned = 0
	local ghosts: { { t0: number, parts: { BasePart } } } = {}
	local function snapshot(i: number, t: number)
		local model = Instance.new("Model")
		model.Name = "Ghost"
		local c = role(ctx.pal, if i == 1 then (gs.oldRole or gs.role) else gs.role)
		local parts: { BasePart } = {}
		for _, d in character:GetDescendants() do
			if #parts &gt;= (gs.maxParts or 24) then
				break
			end
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency &lt; 0.95 then
				local ok, copy = pcall(function()
					return d:Clone()
				end)
				if ok and copy then
					copy:ClearAllChildren()
					copy.Anchored = true
					copy.CanCollide = false
					copy.CanQuery = false
					copy.CanTouch = false
					copy.CastShadow = false
					copy.Massless = true
					copy.Material = Enum.Material.Neon
					copy.Color = c
					if copy:IsA("MeshPart") then
						copy.TextureID = ""
					end
					copy.CFrame = d.CFrame
					copy.Transparency = 1
					copy.Parent = model
					table.insert(parts, copy)
				end
			end
		end
		model.Parent = ctx.root
		table.insert(ghosts, { t0 = t, parts = parts })
	end
	table.insert(ctx.steps, function(t: number)
		local lt = t - (gs.t or 0)
		if lt &lt; 0 then
			return
		end
		while spawned &lt; n and lt &gt;= spawned * gs.interval do
			spawned += 1
			snapshot(spawned, lt)
		end
		for _, g in ghosts do
			local x = clamp01((lt - g.t0) / gs.life)
			local tr = (gs.transp0 or 0.5) + (1 - (gs.transp0 or 0.5)) * easeIn(x, 1.2)
			for _, p in g.parts do
				p.Transparency = tr
			end
		end
	end)
end

--[[ Spikes: a crystal cluster erupting from `at`: a near-vertical centre spike, `count` main spikes leaning
	outward, `small.count` short ones at the base, all bedded in an icy mound; staggered eruption with a small
	overshoot, a hold, then each spike collapses and throws shard particles. Meshes are 1 stud wide and
	1 stud long along Y, centred (as Roblox imports them); the facet texture carries the value ladder
	(white facet edges, pale body, deep base), tinted by VertexColor. ]]
local function buildSpikes(sp: any, ctx: BuildCtx)
	local m = meshId(sp.mesh or "crystal")
	if not m then
		return
	end
	local s = ctx.scale
	local frame = frameOf(sp.space, ctx) * CFrame.new(vec(sp.at, s))
	local texId = if sp.tex then (tex(sp.tex) or "") else ""
	local neon = sp.neon == true
	local function rnd(r: any): number
		return r[1] + (r[2] - r[1]) * math.random()
	end
	local sh = sp.shards
	local shardEmitter: ParticleEmitter? = nil
	local shardAtt = Instance.new("Attachment")
	shardAtt.Parent = ctx.anchor

	-- the list of spikes: { len, wid, lean, radius, angle, role, t }
	local list: { { number } } = {}
	local nMain = count(sp.count or 6, ctx)
	for i = 1, nMain do
		local centre = sp.centre and i == 1
		table.insert(list, {
			rnd(sp.length) * (if centre then 1.15 else 1),
			rnd(sp.width) * (if centre then 1.15 else 1),
			if centre then 4 else rnd(sp.lean),
			if centre then 0 else rnd(sp.radius),
			(i - 1) / math.max(nMain - 1, 1) * 2 * math.pi + (math.random() - 0.5) * 0.6,
			if i % 3 == 0 then 2 else 1,
		})
	end
	local sm = sp.small
	if sm and ctx.deco then
		for i = 1, count(sm.count or 4, ctx) do
			table.insert(list, { rnd(sm.length), rnd(sm.width), rnd(sm.lean), rnd(sm.radius), math.random() * 2 * math.pi, 1 })
		end
	end
	local n = #list
	if sh then
		local shTex = tex(sh.tex or "shard_A")
		if shTex then
			shardEmitter = newEmitter(shardAtt, {
				Texture = shTex,
				Color = roleSeq(ctx.pal, sh.role),
				LightEmission = sh.le or 0.5,
				Brightness = sh.bright or 1,
				Size = seqOf(sh.size, s),
				Transparency = ns({ { 0, 0 }, { 0.75, 0.1 }, { 1, 1 } }),
				Lifetime = range(sh.life, 0.5),
				Speed = range(sh.speed, 10, s),
				SpreadAngle = Vector2.new(35, 35),
				EmissionDirection = Enum.NormalId.Front,
				Rotation = NumberRange.new(0, 360),
				RotSpeed = NumberRange.new(-360, 360),
				Drag = sh.drag or 1,
				Acceleration = vec(sh.acc, s),
				ZOffset = 1,
			})
			ctx.particles += nMain * (sh.per or 3)
		end
	end

	-- icy mound the spikes are bedded in
	local md = sp.mound
	if md then
		local mm = meshId(md.mesh or "ice_mound")
		if mm then
			local part, mesh = meshLayer("Mound", mm, texId, frame, ctx.root, neon)
			local c = role(ctx.pal, md.role or sp.role)
			part.Color = c
			mesh.VertexColor = v3(c, sp.gain or 1)
			local t0 = sp.t or 0
			table.insert(ctx.steps, function(t: number)
				local lt = t - t0
				local x = clamp01(lt / (sp.grow * 1.2))
				local fx = clamp01((lt - sp.grow - sp.hold - sp.shatter) / (md.fade or 0.3))
				if lt &lt; 0 or fx &gt;= 1 then
					part.Transparency = 1
					return
				end
				local k = easeOut(x, 3)
				mesh.Scale = Vector3.new(md.width * s * k, md.height * s * k * (1 - 0.5 * fx), md.width * s * k)
				part.CFrame = frame * CFrame.new(0, md.height * 0.35 * 0.5 * s * k * (1 - 0.5 * fx), 0)
				part.Transparency = easeIn(fx, 1.2)
			end)
		end
	end

	local order: { number } = {}
	for i = 1, n do
		table.insert(order, i)
	end
	for i = n, 2, -1 do -- random eruption order (the centre spike first)
		local j = math.random(2, math.max(i, 2))
		order[i], order[j] = order[j], order[i]
	end
	for i, d in list do
		local len, wid = d[1] * s, d[2] * s
		local lean, ang = math.rad(d[3]), d[5]
		local out = Vector3.new(math.cos(ang), 0, math.sin(ang))
		local axis = (out * math.sin(lean) + Vector3.yAxis * math.cos(lean)).Unit
		local side = axis:Cross(out).Unit
		-- sink the base a little into the mound/floor
		local basePos = out * d[4] * s - axis * (0.12 * len)
		local c = role(ctx.pal, if d[6] == 2 then (sp.altRole or sp.role) else sp.role)
		local core, coreMesh = meshLayer("Spike", m, texId, frame, ctx.root, neon)
		core.Color = c
		coreMesh.VertexColor = v3(c, sp.gain or 1)
		local t0 = (sp.t or 0) + (order[i] - 1) * (sp.stagger or 0.033)
		local isMain = i &lt;= nMain
		local shattered = false
		table.insert(ctx.steps, function(t: number)
			local lt = t - t0
			if lt &lt; 0 then
				core.Transparency = 1
				return
			end
			-- grow with a small overshoot (back ease), hold, then collapse while it shatters
			local x = lt / sp.grow
			local k = if x &lt; 1 then 1 + 2.2 * (x - 1) ^ 3 + 1.2 * (x - 1) ^ 2 else 1
			local sx = clamp01((lt - sp.grow - sp.hold) / sp.shatter)
			if sx &gt; 0 and not shattered then
				shattered = true
				if shardEmitter and isMain then
					shardAtt.WorldCFrame = frame * aim(basePos + axis * len * 0.5, (axis + out).Unit)
					shardEmitter:Emit(sh.per or 3)
				end
			end
			local L = math.max(len * k * (1 - 0.6 * sx), 0.05)
			local W = math.max(wid * (1 - sx), 0.05)
			coreMesh.Scale = Vector3.new(W, L, W)
			core.CFrame = frame * CFrame.fromMatrix(basePos + axis * (L * 0.5), side, axis)
			core.Transparency = if sx &gt;= 1 then 1 else 0.02 + 0.98 * easeIn(sx, 1.5)
		end)
	end
end

-------------------------------------------------------------------------------
-- Public API
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Lightning bolts (LightningExplosion `bolts` layer, LightningBallCast). !! UNTESTED IN STUDIO !!
-- A bolt is a jagged polyline drawn with stretched Neon parts: white core, cyan halo, violet edge
-- (roles core / halo / edge). It re-jitters every `flicker` seconds (a re-strike) so it crackles.
-- Layer fields: kind "radial" (strikes along the ground) | "column" (upward) | "arcs" (short static),
-- count, segs, jitter, branches, branchLen, width, glow (edge width / core width), t, stagger,
-- grow (strike-out time), hold, fade, flicker, length / height / spread / radius / up / over / life.
-------------------------------------------------------------------------------
type BoltSeg = { core: Part, halo: Part, edge: Part }
type BoltLine = { segs: { BoltSeg }, pts: { Vector3 }, shown: boolean }

local function boltPoints(a: Vector3, b: Vector3, n: number, jitter: number, flat: boolean): { Vector3 }
	local d = b - a
	local len = d.Magnitude
	local dir = if len &gt; 1e-4 then d / len else Vector3.yAxis
	local ref = if math.abs(dir.Y) &gt; 0.9 then Vector3.xAxis else Vector3.yAxis
	local s1 = dir:Cross(ref).Unit
	local s2 = dir:Cross(s1).Unit
	local pts = { a }
	for i = 1, n - 1 do
		local u = i / n
		local amp = jitter * len / n * (0.5 + 0.7 * math.sin(math.pi * u))
		local o = s1 * (math.random() * 2 - 1) * amp + s2 * (math.random() * 2 - 1) * amp * (if flat then 0.3 else 1)
		table.insert(pts, a + d * (u + (math.random() - 0.5) * 0.4 / n) + o)
	end
	table.insert(pts, b)
	return pts
end

local function boltPart(name: string, color: Color3, parent: Instance): Part
	local p = newPart(name, CFrame.identity, parent)
	p.Material = Enum.Material.Neon
	p.Color = color
	return p
end

local function newBoltLine(n: number, pal: Palette, roles: any, parent: Instance): BoltLine
	local segs: { BoltSeg } = {}
	for _ = 1, n do
		table.insert(segs, {
			core = boltPart("BoltCore", role(pal, roles.core or "hot"), parent),
			halo = boltPart("BoltHalo", role(pal, roles.halo or "main"), parent),
			edge = boltPart("BoltEdge", role(pal, roles.edge or "glow"), parent),
		})
	end
	return { segs = segs, pts = {}, shown = true }
end

local function hideBoltLine(line: BoltLine)
	if not line.shown then
		return
	end
	line.shown = false
	for _, sg in line.segs do
		sg.core.Transparency, sg.halo.Transparency, sg.edge.Transparency = 1, 1, 1
	end
end

-- draw the first `shown` (fractional) segments; the width tapers toward the far end
local function drawBoltLine(line: BoltLine, shown: number, w: number, glow: number, alpha: number)
	if alpha &lt;= 0.01 or shown &lt;= 0 then
		hideBoltLine(line)
		return
	end
	line.shown = true
	local pts = line.pts
	local n = #line.segs
	for i, sg in line.segs do
		local a, b = pts[i], pts[i + 1]
		local k = math.clamp(shown - (i - 1), 0, 1)
		if a and b and k &gt; 0 then
			b = a:Lerp(b, k)
			local len = (b - a).Magnitude
			local cf = if len &gt; 1e-3 then CFrame.lookAt((a + b) / 2, b) else CFrame.new(a)
			local ww = w * (1 - 0.55 * (i - 1) / math.max(n, 1))
			sg.core.Size = Vector3.new(ww, ww, len + ww)
			sg.core.CFrame = cf
			sg.core.Transparency = 1 - alpha
			local hw = ww * 2.2
			sg.halo.Size = Vector3.new(hw, hw, len + hw)
			sg.halo.CFrame = cf
			sg.halo.Transparency = 1 - alpha * 0.45
			local ew = ww * glow
			sg.edge.Size = Vector3.new(ew, ew, len + ew)
			sg.edge.CFrame = cf
			sg.edge.Transparency = 1 - alpha * 0.16
		else
			sg.core.Transparency, sg.halo.Transparency, sg.edge.Transparency = 1, 1, 1
		end
	end
end

local function buildBolts(bo: any, ctx: BuildCtx)
	if bo.deco and not ctx.deco then
		return
	end
	local s = ctx.scale
	local frame = frameOf(bo.space, ctx) * CFrame.new(vec(bo.at, s))
	local function rnd(r: any, d: number): number
		if type(r) ~= "table" then
			return r or d
		end
		return r[1] + (r[2] - r[1]) * math.random()
	end
	local kind = bo.kind or "radial"
	local flat = kind == "radial"
	local segsN = bo.segs or 6
	local jitter = bo.jitter or 0.8
	local nBr = if ctx.deco then (bo.branches or 0) else 0
	local brSegs = math.max(2, math.ceil(segsN / 2))
	local grow = bo.grow or 0
	local hold = bo.hold or bo.life or 0.1
	local fade = bo.fade or 0
	local flicker = bo.flicker or 0.05
	local w = (bo.width or 0.3) * s
	local glow = bo.glow or 4
	local roles = { core = bo.core, halo = bo.halo, edge = bo.edge }
	local folder = Instance.new("Folder")
	folder.Name = "Bolts"
	folder.Parent = ctx.root
	local list = {}
	local n = count(bo.count or 1, ctx)
	for i = 1, n do
		local a: Vector3, b: Vector3, t0: number
		if kind == "radial" then
			local ang = (i - 1) / n * 2 * math.pi + (math.random() - 0.5) * (2 * math.pi / n) * 0.7
			local L = rnd(bo.length, 6) * s
			a = frame.Position
			b = frame:PointToWorldSpace(Vector3.new(math.cos(ang) * L, 0, math.sin(ang) * L))
			t0 = (bo.t or 0) + (bo.stagger or 0) * (i - 1)
		elseif kind == "column" then
			local sp = (bo.spread or 0.4) * s
			local o = Vector3.new((math.random() * 2 - 1) * sp, 0, (math.random() * 2 - 1) * sp)
			a = frame:PointToWorldSpace(o)
			b = frame:PointToWorldSpace(o * 0.3 + Vector3.new(0, (bo.height or 10) * s * (0.8 + 0.2 * math.random()), 0))
			t0 = (bo.t or 0) + (bo.stagger or 0) * (i - 1)
		else
			local ang = math.random() * 2 * math.pi
			local r = rnd(bo.radius, 3) * s
			a = frame:PointToWorldSpace(Vector3.new(math.cos(ang) * r, math.random() * (bo.up or 1) * s, math.sin(ang) * r))
			b = a + randomUnit() * rnd(bo.length, 2) * s
			t0 = (bo.t or 0) + (bo.over or 0) * math.random()
		end
		local brs = {}
		for _ = 1, nBr do
			table.insert(brs, { line = newBoltLine(brSegs, ctx.pal, roles, folder), k = math.random(2, math.max(2, segsN - 2)) })
		end
		table.insert(list, { a = a, b = b, t0 = t0, main = newBoltLine(segsN, ctx.pal, roles, folder), brs = brs, nextJit = -1 })
	end
	local function rejitter(B: any)
		B.main.pts = boltPoints(B.a, B.b, segsN, jitter, flat)
		local d = B.b - B.a
		for _, br in B.brs do
			local p = B.main.pts[br.k + 1] or B.a
			local dir: Vector3
			if flat then
				local ang = math.rad((25 + 25 * math.random()) * (if math.random() &lt; 0.5 then -1 else 1))
				dir = CFrame.Angles(0, ang, 0):VectorToWorldSpace(d.Unit)
			else
				dir = randomCone(d.Unit, 50)
			end
			br.line.pts = boltPoints(p, p + dir * d.Magnitude * (bo.branchLen or 0.4), brSegs, jitter, flat)
		end
	end
	table.insert(ctx.steps, function(t: number)
		for _, B in list do
			local lt = t - B.t0
			if lt &lt; 0 or lt &gt; grow + hold + fade then
				hideBoltLine(B.main)
				for _, br in B.brs do
					hideBoltLine(br.line)
				end
			else
				if lt &gt;= B.nextJit then
					rejitter(B)
					B.nextJit = lt + flicker
				end
				local shown = if grow &gt; 0 then segsN * clamp01(lt / grow) else segsN
				local k = if lt &gt; grow + hold then 1 - clamp01((lt - grow - hold) / math.max(fade, 1e-3)) else 1
				local alpha = k * (0.65 + 0.35 * math.random())
				drawBoltLine(B.main, shown, w, glow, alpha)
				for _, br in B.brs do
					drawBoltLine(br.line, (shown - br.k) * 2, w * 0.6, glow, alpha * 0.85)
				end
			end
		end
	end)
end

export type PlayOptions = {
	element: string?,
	palette: Palette?,
	flip: boolean?,
	tilt: number?,
	yaw: number?,
	scale: number?,
	important: boolean?, -- own casts: ignore maxActive and keep decoration at distance
	skipUnits: boolean?, -- play only the generic layers (e.g. a slam using OverheadCleave's ground crack)
	follow: BasePart?, -- DashTrail: the streak head follows this part (else the predicted dash path)
	character: Model?, -- DashTrail: afterimages are copied from this character
	distance: number?, -- DashTrail: dash length in studs (default preset.dash.distance)
	speed: number?, -- timeline rate (1 = authored; ChargeUp bindings retime to the clip)
	arc: { number }?, -- { startDeg, endDeg } from the LookVector (+ = right / weapon side): where the slash
	--                   sits and which way it sweeps; clamped so the arc stays within +-100 deg of forward
	size: number?, -- alias of scale
}

--[[ Play a preset. `cf` is the swing frame: its position is the swing centre (e.g. the root part),
	its XZ plane is the swing plane and -Z is forward. Returns a stop function. ]]
function LihFolkVFX.play(presetName: string, cf: CFrame, options: PlayOptions?): () -&gt; ()
	local opts: PlayOptions = options or {}
	local preset = (LihFolkVFX.Presets :: any)[presetName] :: Preset?
	if not preset then
		warnOnce("preset:" .. presetName, "unknown preset " .. presetName)
		return function() end
	end
	local cfg = LihFolkVFX.Config
	local important = opts.important == true
	if not important and #active &gt;= cfg.maxActive then
		return function() end
	end
	local detail = cfg.quality
	local deco = detail &gt;= 0.55
	local cam = Workspace.CurrentCamera
	if cam and not important then
		local dist = (cam.CFrame.Position - cf.Position).Magnitude
		if dist &gt; cfg.cullDistance then
			return function() end
		elseif dist &gt; cfg.lowDetailDistance then
			detail *= 0.5
			deco = false
		end
	end
	if liveParticles &gt; cfg.maxLiveParticles * 0.75 then
		detail *= 0.5
		deco = false
	end
	local pal = opts.palette or (LihFolkVFX.Elements :: any)[opts.element or preset.element or "teal"] :: Palette?
	if not pal then
		pal = (LihFolkVFX.Elements :: any).teal
	end
	local base = cf
	if opts.flip then
		base = base * CFrame.Angles(0, 0, math.pi)
	end
	if opts.tilt then
		base = base * CFrame.Angles(0, 0, math.rad(opts.tilt))
	end
	if opts.yaw then
		base = base * CFrame.Angles(0, math.rad(opts.yaw), 0)
	end
	local scale = opts.scale or opts.size or 1
	-- arc range: centre and direction of the sweep (its length is the mesh's: 200 deg thick, 160 deg thin)
	local arcShift = 0
	if opts.arc and #opts.arc &gt;= 2 then
		local a0 = math.clamp(opts.arc[1], -FRONT_LIMIT, FRONT_LIMIT)
		local a1 = math.clamp(opts.arc[2], -FRONT_LIMIT, FRONT_LIMIT)
		arcShift = -(a0 + a1) / 2
		if a1 &gt; a0 then -- left -&gt; right: mirror the sweep
			base = base * CFrame.Angles(0, 0, math.pi)
			arcShift = -arcShift
		end
	end
	local speed = math.max(opts.speed or 1, 0.05)

	-- floor frame: flat, below the cf, facing the caster's heading
	local g = preset.ground
	local drop = preset.floor or (g and g.drop) or 3
	local gPos = cf.Position - Vector3.new(0, drop * scale, 0)
	local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if flat.Magnitude &lt; 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	local groundCf = CFrame.lookAt(gPos, gPos + flat.Unit)

	-- dash head in body space (predicted ease-out path, or the followed part)
	local dash = preset.dash
	local dashDist = (opts.distance or (dash and dash.distance) or 0) * scale
	local follow = opts.follow
	local function pathHead(t: number): Vector3
		if follow and follow.Parent then
			local p = cf:PointToObjectSpace(follow.Position)
			return Vector3.new(p.X, 0, p.Z)
		end
		if not dash then
			return Vector3.zero
		end
		return Vector3.new(0, 0, -dashDist * easeOut(t / dash.duration, dash.pow))
	end

	local root = Instance.new("Model")
	root.Name = presetName
	local anchor = newPart("Anchor", base, root)
	local ctx: BuildCtx = {
		root = root,
		base = base,
		body = cf,
		ground = groundCf,
		anchor = anchor,
		pal = pal :: Palette,
		scale = scale,
		detail = detail,
		deco = deco,
		steps = {},
		particles = 0,
		pathHead = pathHead,
		character = opts.character,
		arcShift = arcShift,
	}

	-- hot flash (at the contact point, or wherever the preset puts it)
	local f = preset.flash
	if f then
		buildBurst({
			tex = "flash_hot",
			role = "hot",
			count = 1,
			t = f.t or 0,
			at = f.at or { 0, 0, -(f.forward or 0) },
			space = if f.at then f.space else "swing",
			size = { { 0, 0 }, { 0.3, f.size }, { 1, f.size * 0.4 } },
			transp = { { 0, 0 }, { 0.6, 0.2 }, { 1, 1 } },
			life = { f.life, f.life },
			le = 1,
			bright = f.brightness,
			rot = { 0, 90 },
			zoff = 4,
		}, ctx)
	end

	if preset.units and not opts.skipUnits then
		for _, u in preset.units do
			buildUnit(u, ctx)
		end
	end
	for _, b in preset.beams or {} do
		buildBeam(b, ctx)
	end
	for _, r in preset.rings or {} do
		buildRing(r, ctx)
	end
	for _, b in preset.bursts or {} do
		buildBurst(b, ctx)
	end
	if preset.ghosts then
		buildGhosts(preset.ghosts, ctx)
	end
	if preset.spikes then
		buildSpikes(preset.spikes, ctx)
	end
	for _, bo in preset.bolts or {} do
		buildBolts(bo, ctx)
	end

	-- ground ring + disc (world up, below the swing centre)
	if g and ctx.deco then
		local gMesh = meshId("ground_ring")
		local gTex = tex("strip_ground_ring")
		if gMesh and gTex and g.ring ~= false then
			local part, mesh = meshLayer("Ground", gMesh, gTex, groundCf * CFrame.new(0, 0, -(g.forward or 0) * scale), root, true)
			part.Color = ctx.pal.glow
			mesh.VertexColor = v3(ctx.pal.glow, 1)
			table.insert(ctx.steps, function(t: number)
				local x = clamp01(t / g.life)
				local s = g.radius * scale * (0.45 + 0.8 * easeOut(x, 3))
				mesh.Scale = Vector3.new(s, s, s)
				part.Transparency = g.transparency + (1 - g.transparency) * easeIn(x, 1.4)
			end)
		end
		buildBurst({
			tex = "ground_disc_faint",
			role = g.discRole or "glow",
			le = g.discLe or 1,
			bright = g.discBright or 0.6,
			count = 1,
			at = { 0, 0.05, -(g.forward or 0) },
			space = "ground",
			orient = "flat",
			size = { { 0, g.radius * 1.6 }, { 1, g.radius * 2.6 } },
			transp = { { 0, if g.discRole then g.transparency else 0.7 }, { 1, 1 } },
			life = { g.life * 1.2, g.life * 1.2 },
			zoff = -1,
		}, ctx)
	end

	-- short light in the glow colour (no shadows); `rise` = fraction of life spent rising (charges)
	local L = preset.light
	local lightPart = anchor
	if L.at then
		lightPart = newPart("Light", frameOf(L.space, ctx) * CFrame.new(vec(L.at, scale)), root)
	end
	local light = Instance.new("PointLight")
	light.Color = ctx.pal.glow
	light.Range = L.range * scale
	light.Shadows = false
	light.Brightness = 0
	light.Parent = lightPart
	local rise = L.rise or 0.1
	local lt0 = L.t or 0
	table.insert(ctx.steps, function(t: number)
		local x = (t - lt0) / L.life
		if x &lt; 0 then
			light.Brightness = 0
		elseif x &lt; rise then
			light.Brightness = L.brightness * x / rise
		else
			light.Brightness = L.brightness * math.max(0, 1 - easeOut((x - rise) / (1 - rise), 2))
		end
	end)

	-- sound with its peak on the hit
	local snd = (LihFolkVFX.Sounds :: any)[preset.sound]
	if snd and snd.id ~= "" then
		local s = Instance.new("Sound")
		s.SoundId = snd.id
		s.Volume = snd.volume
		-- the marker IS the hit, so skip into the sound until its crack lands now
		s.TimePosition = snd.peak
		s.PlaybackSpeed = speed
		s.Parent = anchor
		s:Play()
	end

	root.Parent = getContainer()
	liveParticles += ctx.particles
	local effect: Effect = {
		t0 = os.clock(),
		life = preset.life / speed,
		steps = ctx.steps,
		root = root,
		particles = ctx.particles,
		stopped = false,
		finished = false,
		speed = speed,
	}
	start(effect)
	return function()
		effect.stopped = true
	end
end

-- Impact burst on a target: position = contact point, direction = attacker -&gt; target.
function LihFolkVFX.hitSpark(position: Vector3, direction: Vector3, options: PlayOptions?): () -&gt; ()
	local d = if direction.Magnitude &gt; 1e-3 then direction.Unit else Vector3.new(0, 0, -1)
	return LihFolkVFX.play("HitSpark", aim(position, d), options)
end

--[[ Preload every texture and mesh id a preset uses (call when the weapon is equipped, not on first swing).
	Fresh uploads can fail PreloadAsync for about a minute; that is normal. ]]
function LihFolkVFX.preload()
	local ids: { string } = {}
	for _, id in LihFolkVFX.Textures :: any do
		if type(id) == "string" and id ~= "" then
			table.insert(ids, id)
		end
	end
	for _, id in LihFolkVFX.Meshes :: any do
		if type(id) == "string" and id ~= "" then
			table.insert(ids, id)
		end
	end
	if #ids &gt; 0 then
		task.spawn(function()
			local ok, err = pcall(function()
				ContentProvider:PreloadAsync(ids)
			end)
			if not ok then
				warn("[LihFolkVFX] preload failed: " .. tostring(err))
			end
		end)
	end
end

function LihFolkVFX.setQuality(q: number)
	LihFolkVFX.Config.quality = math.clamp(q, 0.25, 1)
end

-- Stop and remove every live effect (scene change, death, teleport).
function LihFolkVFX.clear()
	for _, e in active do
		finish(e)
	end
	table.clear(active)
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
end

-------------------------------------------------------------------------------
-- Weapon trail (TrailOn / TrailOff window)
-------------------------------------------------------------------------------
--[[ Creates a disabled Trail on the blade between two points (blade-local offsets).
	Use it for cuts and stabs only: across a spin (&gt; ~120 deg) a Trail draws a solid wedge. ]]
function LihFolkVFX.attachTrail(blade: BasePart, baseOffset: Vector3, tipOffset: Vector3, element: string?): Trail
	local pal = (LihFolkVFX.Elements :: any)[element or "teal"] :: Palette
	local a0 = Instance.new("Attachment")
	a0.Name = "LihFolkTrail0"
	a0.Position = baseOffset
	a0.Parent = blade
	local a1 = Instance.new("Attachment")
	a1.Name = "LihFolkTrail1"
	a1.Position = tipOffset
	a1.Parent = blade
	local tr = Instance.new("Trail")
	tr.Name = "LihFolkTrail"
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Enabled = false
	tr.Lifetime = 0.16
	tr.MinLength = 0.05
	tr.FaceCamera = false
	tr.LightEmission = 1
	tr.LightInfluence = 0
	tr.Brightness = 3
	tr.Color = ColorSequence.new(pal.hot, pal.glow)
	tr.Transparency = ns({ { 0, 0.1 }, { 0.5, 0.5 }, { 1, 1 } })
	tr.WidthScale = ns({ { 0, 1 }, { 1, 0.15 } })
	tr.Texture = LihFolkVFX.Textures.trail_soft
	tr.TextureMode = Enum.TextureMode.Stretch
	tr.Parent = blade
	return tr
end

-------------------------------------------------------------------------------
-- Animation marker binding
--   Hit (value -&gt; DefaultHits), DashStart / Impact / Deflect (DefaultMarkers), TrailOn / TrailOff,
--   charge on track start (DefaultCharges, retimed so its release lands on Hit)
-------------------------------------------------------------------------------
export type Binding = {
	hits: { [string]: HitSpec }?, -- marker value -&gt; spec; defaults to LihFolkVFX.DefaultHits
	markers: { [string]: HitSpec }?, -- marker name -&gt; spec; defaults to LihFolkVFX.DefaultMarkers
	charges: { [string]: { preset: string, lead: number } }?, -- Animation.Name -&gt; charge; defaults to DefaultCharges
	element: string?, -- default element (else the character's "VFXElement" attribute)
	trail: Trail?, -- weapon trail toggled by TrailOn / TrailOff
	important: boolean?, -- true for the local player's own character
}

local function rootOf(character: Model): BasePart?
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp
	end
	return character.PrimaryPart
end

local function elementOf(spec: HitSpec, b: Binding, character: Model): string?
	local element = spec.element or b.element or character:GetAttribute("VFXElement")
	return if type(element) == "string" then element else nil
end

--[[ Listen to one AnimationTrack's markers. Returns a disconnect function. ]]
function LihFolkVFX.bindTrack(track: AnimationTrack, character: Model, binding: Binding?): () -&gt; ()
	local b: Binding = binding or {}
	local anim = track.Animation
	-- upper-body copies carry the same markers; only the full clip fires effects
	if anim and anim:GetAttribute("KitUpper") then
		return function() end
	end
	local conns: { RBXScriptConnection } = {}
	local hits = b.hits or LihFolkVFX.DefaultHits
	local markers = b.markers or LihFolkVFX.DefaultMarkers
	local trail = b.trail
	local animName = if anim then anim.Name else ""
	local noTrail = LihFolkVFX.NoTrailClips[animName] == true or (anim ~= nil and anim:GetAttribute("VFXNoTrail") == true)

	local function fire(spec: HitSpec, param: string?)
		if param and spec.byValue and spec.byValue[param] then
			spec = spec.byValue[param]
			param = nil
		elseif param and param ~= "" and (LihFolkVFX.Presets :: any)[param] then
			spec = { preset = param, offset = spec.offset }
			param = nil
		end
		local root = rootOf(character)
		if not root then
			return
		end
		local preset = (LihFolkVFX.Presets :: any)[spec.preset] :: Preset?
		if trail and preset and preset.trail == false then
			trail.Enabled = false
			trail:Clear()
		end
		LihFolkVFX.play(spec.preset, root.CFrame * (spec.offset or CFrame.identity), {
			element = elementOf(spec, b, character),
			flip = spec.flip,
			tilt = spec.tilt,
			yaw = spec.yaw,
			scale = spec.scale,
			skipUnits = spec.skipUnits,
			important = b.important,
			follow = if spec.follow then root else nil,
			character = character,
			distance = tonumber(param or ""),
		})
	end

	-- charge: starts with the clip, retimed so its release lands on the Hit marker
	local chargeStop: (() -&gt; ())? = nil
	local charges = b.charges or LihFolkVFX.DefaultCharges
	local charge = charges[animName]
	local attr = if anim then anim:GetAttribute("VFXCharge") else nil
	if not charge and type(attr) == "string" then
		charge = { preset = attr, lead = 0.75 }
	end
	if charge then
		local root = rootOf(character)
		local preset = (LihFolkVFX.Presets :: any)[charge.preset] :: Preset?
		if root and preset then
			local lead = math.max(charge.lead / math.max(track.Speed, 0.05), 0.1)
			chargeStop = LihFolkVFX.play(charge.preset, root.CFrame, {
				element = elementOf({ preset = charge.preset }, b, character),
				important = b.important,
				speed = (preset.lead or lead) / lead,
			})
		end
	end

	table.insert(conns, track:GetMarkerReachedSignal("Hit"):Connect(function(param: string?)
		chargeStop = nil -- the charge has released; let it finish on its own
		local spec = hits[param or ""] or hits["1"]
		if spec then
			fire(spec, nil)
		end
	end))
	for name, spec in markers do
		table.insert(conns, track:GetMarkerReachedSignal(name):Connect(function(param: string?)
			fire(spec, param)
		end))
	end
	if trail then
		table.insert(conns, track:GetMarkerReachedSignal("TrailOn"):Connect(function()
			if noTrail then
				return
			end
			trail:Clear() -- otherwise it connects from where the blade was last time
			trail.Enabled = true
		end))
		table.insert(conns, track:GetMarkerReachedSignal("TrailOff"):Connect(function()
			trail.Enabled = false
		end))
	end
	table.insert(conns, track.Stopped:Connect(function()
		if trail then
			trail.Enabled = false
		end
		if chargeStop then
			chargeStop() -- interrupted before the Hit
			chargeStop = nil
		end
	end))
	return function()
		for _, c in conns do
			c:Disconnect()
		end
		table.clear(conns)
		if trail then
			trail.Enabled = false
		end
		if chargeStop then
			chargeStop()
			chargeStop = nil
		end
	end
end

--[[ Bind every track this Animator plays from now on. Returns a disconnect function. ]]
function LihFolkVFX.bindAnimator(animator: Animator, character: Model, binding: Binding?): () -&gt; ()
	local unbinds: { [AnimationTrack]: () -&gt; () } = {}
	local played = animator.AnimationPlayed:Connect(function(track: AnimationTrack)
		if unbinds[track] then
			return
		end
		unbinds[track] = LihFolkVFX.bindTrack(track, character, binding)
		track.Ended:Once(function()
			local un = unbinds[track]
			if un then
				un()
				unbinds[track] = nil
			end
		end)
	end)
	local destroying = character.Destroying:Once(function()
		played:Disconnect()
		for _, un in unbinds do
			un()
		end
		table.clear(unbinds)
	end)
	return function()
		played:Disconnect()
		destroying:Disconnect()
		for _, un in unbinds do
			un()
		end
		table.clear(unbinds)
	end
end

-------------------------------------------------------------------------------
-- Sequences (multi-stage effects driven by clip markers)
-- !! UNTESTED IN STUDIO !! IceBallCast was authored against the Blender preview
-- (Previews/IceBall_Cast_to_Explosion.mp4) only. Verify welds, timings and the
-- landing raycast in Studio before shipping.
-------------------------------------------------------------------------------
export type SequenceSpec = {
	element: string,
	ballRadius: number, -- studs
	growTime: number, -- seed -&gt; full size (s), slight overshoot
	flightTime: number, -- Release -&gt; Impact (s)
	distance: number, -- studs ahead of the root part where the ball lands
	arcHeight: number, -- extra apex height of the flight arc (studs)
	impactPreset: string, -- played on the floor where the ball lands
}

LihFolkVFX.Sequences = {
	-- IceCastThrow clip: ChargeStart (f12) -&gt; ball grows on RightGripAttachment; Release (f49) -&gt; projectile;
	-- Impact (f64) -&gt; IceExplosion where it lands. UNTESTED IN STUDIO.
	IceBallCast = {
		element = "ice",
		ballRadius = 0.72,
		growTime = 0.73,
		flightTime = 0.5,
		distance = 12,
		arcHeight = 1.3,
		impactPreset = "IceExplosion",
	} :: SequenceSpec,
} :: { [string]: SequenceSpec }

local function makeIceBall(pal: Palette, radius: number): (Part, PointLight)
	local ball = Instance.new("Part")
	ball.Name = "LihFolkIceBall"
	ball.Shape = Enum.PartType.Ball
	ball.Material = Enum.Material.Glass
	ball.Color = pal.main
	ball.Transparency = 0.15
	ball.Reflectance = 0.25
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.CastShadow = false
	ball.Massless = true
	ball.Size = Vector3.one * 0.05
	local core = Instance.new("Part")
	core.Name = "Core"
	core.Shape = Enum.PartType.Ball
	core.Material = Enum.Material.Neon
	core.Color = pal.dark:Lerp(pal.main, 0.35)
	core.CanCollide, core.CanQuery, core.CanTouch, core.CastShadow, core.Massless = false, false, false, false, true
	core.Size = Vector3.one * 0.03
	local w = Instance.new("WeldConstraint")
	w.Part0, w.Part1 = ball, core
	core.CFrame = ball.CFrame
	w.Parent = core
	core.Parent = ball
	local light = Instance.new("PointLight")
	light.Color = pal.glow
	light.Range = 10
	light.Brightness = 0
	light.Parent = ball
	local glint = Instance.new("ParticleEmitter")
	glint.Name = "Glints"
	glint.Texture = LihFolkVFX.Textures.glint_star4 or ""
	glint.Color = ColorSequence.new(pal.hot)
	glint.LightEmission = 1
	glint.Size = ns({ { 0, 0 }, { 0.4, radius * 1.3 }, { 1, 0 } })
	glint.Lifetime = NumberRange.new(0.18, 0.28)
	glint.Rate = 10
	glint.Speed = NumberRange.new(0)
	glint.Shape = Enum.ParticleEmitterShape.Sphere
	glint.Parent = ball
	return ball, light
end

--[[ Play the IceBallCast sequence on a character whose track carries ChargeStart / Release / Impact markers.
	UNTESTED IN STUDIO. Returns a cleanup function. ]]
function LihFolkVFX.playIceBallCast(track: AnimationTrack, character: Model, spec: SequenceSpec?): () -&gt; ()
	local s: SequenceSpec = spec or LihFolkVFX.Sequences.IceBallCast
	local pal = (LihFolkVFX.Elements :: any)[s.element] :: Palette
	local conns: { RBXScriptConnection } = {}
	local ball: Part? = nil
	local light: PointLight? = nil
	local charge: (() -&gt; ())? = nil
	-- lihfolk-ignore: findfirstchild-chain (results are nil-checked before use)
	local hand = character:FindFirstChild("RightHand") :: BasePart?
	-- lihfolk-ignore: findfirstchild-chain (guarded by `hand and`)
	local grip = hand and hand:FindFirstChild("RightGripAttachment") :: Attachment?

	local function cleanup()
		for _, c in conns do
			c:Disconnect()
		end
		table.clear(conns)
		if charge then
			charge()
			charge = nil
		end
		if ball then
			ball:Destroy()
			ball = nil
		end
	end

	table.insert(conns, track:GetMarkerReachedSignal("ChargeStart"):Connect(function()
		if not hand then
			return
		end
		local b, l = makeIceBall(pal, s.ballRadius)
		ball, light = b, l
		local up = s.ballRadius + 0.18
		b.CFrame = (if grip then grip.WorldCFrame else hand.CFrame) * CFrame.new(0, 0, 0) + Vector3.new(0, up, 0)
		local weld = Instance.new("WeldConstraint")
		weld.Name = "HandWeld"
		weld.Part0, weld.Part1 = hand, b
		weld.Parent = b
		b.Parent = getContainer()
		-- converging frost motes + mist (ChargeUp preset recoloured ice, retimed to the grow)
		charge = LihFolkVFX.play("ChargeUp", b.CFrame, { element = s.element, speed = 1 })
		local t0 = os.clock()
		local c: RBXScriptConnection
		c = RunService.Heartbeat:Connect(function()
			if ball ~= b then
				c:Disconnect()
				return
			end
			local x = clamp01((os.clock() - t0) / s.growTime)
			local c1 = 1.70158
			local k = 1 + (c1 + 1) * (x - 1) ^ 3 + c1 * (x - 1) ^ 2 -- easeOutBack: slight overshoot
			local d = math.max(0.05, 2 * s.ballRadius * k)
			if weld.Parent then
				weld.Enabled = false
				b.Size = Vector3.one * d
				-- lihfolk-ignore: findfirstchild-chain (nil-checked on the next line)
				local core = b:FindFirstChild("Core") :: BasePart?
				if core then
					core.Size = Vector3.one * d * 0.55
					core.CFrame = b.CFrame
				end
				weld.Enabled = true
			end
			l.Brightness = 2 * x
			if x &gt;= 1 then
				c:Disconnect()
			end
		end)
		table.insert(conns, c)
	end))

	table.insert(conns, track:GetMarkerReachedSignal("Release"):Connect(function()
		local b = ball
		local root = rootOf(character)
		if not b or not root then
			return
		end
		local weld = b:FindFirstChild("HandWeld")
		if weld then
			weld:Destroy()
		end
		b.Anchored = true
		local p0 = b.Position
		local flat = root.CFrame.LookVector * Vector3.new(1, 0, 1)
		local target = root.Position + (if flat.Magnitude &gt; 1e-3 then flat.Unit else Vector3.new(0, 0, -1)) * s.distance
		local params = RaycastParams.new()
		params.FilterDescendantsInstances = { character, getContainer() }
		params.FilterType = Enum.RaycastFilterType.Exclude
		local hit = Workspace:Raycast(target + Vector3.new(0, 4, 0), Vector3.new(0, -12, 0), params)
		local p1 = if hit then hit.Position else target - Vector3.new(0, 3, 0)
		local trail = LihFolkVFX.attachTrail(b, Vector3.new(0, -s.ballRadius * 0.8, 0), Vector3.new(0, s.ballRadius * 0.8, 0), s.element)
		trail.Enabled = true
		local t0 = os.clock()
		local c: RBXScriptConnection
		c = RunService.Heartbeat:Connect(function()
			if ball ~= b then
				c:Disconnect()
				return
			end
			local u = clamp01((os.clock() - t0) / s.flightTime)
			b.CFrame = CFrame.new(p0:Lerp(p1 + Vector3.new(0, s.ballRadius * 0.6, 0), u) + Vector3.new(0, 4 * s.arcHeight * u * (1 - u), 0))
				* CFrame.Angles(u * 9, u * 5, 0)
			if u &gt;= 1 then
				c:Disconnect()
			end
		end)
		table.insert(conns, c)
		b:SetAttribute("LandAt", p1)
	end))

	table.insert(conns, track:GetMarkerReachedSignal("Impact"):Connect(function()
		local b = ball
		if not b then
			return
		end
		local p1 = b:GetAttribute("LandAt")
		local at = if typeof(p1) == "Vector3" then p1 else b.Position
		local root = rootOf(character)
		local look = if root then root.CFrame.LookVector * Vector3.new(1, 0, 1) else Vector3.new(0, 0, -1)
		if look.Magnitude &lt; 1e-3 then
			look = Vector3.new(0, 0, -1)
		end
		-- IceExplosion cf = impact point at body height (its floor is 3 studs down)
		LihFolkVFX.play(s.impactPreset, CFrame.lookAt(at + Vector3.new(0, 3, 0), at + Vector3.new(0, 3, 0) + look.Unit), {
			element = s.element,
			important = true,
		})
		ball = nil
		b:Destroy()
	end))

	table.insert(conns, track.Stopped:Connect(function()
		task.delay(0.1, cleanup)
	end))
	return cleanup
end

-------------------------------------------------------------------------------
-- !! UNTESTED IN STUDIO !! LightningBallCast was authored against the Blender preview
-- (Previews/LightningBall_Cast_to_Explosion.mp4) only. Verify part counts, timings, the hand
-- midpoint tracking and the landing raycast in Studio before shipping.
-- Clip: LightningCastThrow (ChargeStart f12, Release f49, Impact f64); IceCastThrow also works
-- (same markers) but its single raised palm does not match the two-hand cup.
-------------------------------------------------------------------------------
export type LightningSequenceSpec = {
	element: string,
	ballRadius: number, -- studs
	growTime: number, -- seed -&gt; full size (s), slight overshoot
	pullStart: number, -- s after ChargeStart: the ball leaves the cupped hands ...
	pullEnd: number, -- ... and sits in the right hand (wind-up)
	flightTime: number, -- Release -&gt; Impact (s)
	distance: number, -- studs ahead of the root part where the ball lands
	arcHeight: number,
	impactDelay: number, -- the explosion starts this long after contact (1 frame: keep the landing readable)
	impactPreset: string,
	inArcRate: number, -- arcs per second jumping from the air / ground INTO the hands
	surfaceArcs: number, -- arcs crawling over the ball surface
}

(LihFolkVFX.Sequences :: any).LightningBallCast = {
	element = "plasma",
	ballRadius = 0.55,
	growTime = 0.73,
	pullStart = 0.933,
	pullEnd = 1.067,
	flightTime = 0.5,
	distance = 12,
	arcHeight = 1.3,
	impactDelay = 1 / 30,
	impactPreset = "LightningExplosion",
	inArcRate = 22,
	surfaceArcs = 3,
} :: LightningSequenceSpec

local function makePlasmaBall(pal: Palette, parent: Instance): (Part, Part, PointLight)
	local core = newPart("LihFolkPlasmaBall", CFrame.identity, parent)
	core.Shape = Enum.PartType.Ball
	core.Material = Enum.Material.Neon
	core.Color = pal.hot
	core.Transparency = 0
	core.Size = Vector3.one * 0.05
	local shell = newPart("Halo", CFrame.identity, core)
	shell.Shape = Enum.PartType.Ball
	shell.Material = Enum.Material.ForceField -- electric cyan film, violet tint at the rim via the palette glow
	shell.Color = pal.main
	shell.Transparency = 0
	shell.Size = Vector3.one * 0.08
	local light = Instance.new("PointLight")
	light.Color = pal.main
	light.Range = 12
	light.Brightness = 0
	light.Shadows = false
	light.Parent = core
	local sp = Instance.new("ParticleEmitter")
	sp.Name = "Sparks"
	sp.Texture = LihFolkVFX.Textures.spark_square or ""
	sp.Color = ColorSequence.new(pal.hot, pal.main)
	sp.LightEmission = 1
	sp.LightInfluence = 0
	sp.Size = ns({ { 0, 0 }, { 0.15, 0.22 }, { 0.4, 0.06 }, { 0.6, 0.18 }, { 1, 0 } })
	sp.Lifetime = NumberRange.new(0.2, 0.4)
	sp.Speed = NumberRange.new(3, 7)
	sp.Drag = 3
	sp.Rate = 30
	sp.SpreadAngle = Vector2.new(180, 180)
	sp.Parent = core
	return core, shell, light
end

--[[ Play the LightningBallCast sequence on a character whose track carries ChargeStart / Release / Impact.
	UNTESTED IN STUDIO. Returns a cleanup function. ]]
function LihFolkVFX.playLightningBallCast(track: AnimationTrack, character: Model, spec: LightningSequenceSpec?): () -&gt; ()
	local s: LightningSequenceSpec = spec or (LihFolkVFX.Sequences :: any).LightningBallCast
	local pal = (LihFolkVFX.Elements :: any)[s.element] :: Palette
	local conns: { RBXScriptConnection } = {}
	local folder: Folder? = nil
	local ball: Part? = nil
	local charge: (() -&gt; ())? = nil
	local phase = "none" -- "charge" | "flight" | "done"
	-- lihfolk-ignore: findfirstchild-chain (results are nil-checked before use)
	local rh = character:FindFirstChild("RightHand") :: BasePart?
	-- lihfolk-ignore: findfirstchild-chain (results are nil-checked before use)
	local lh = character:FindFirstChild("LeftHand") :: BasePart?
	-- lihfolk-ignore: findfirstchild-chain (guarded by `rh and`)
	local grip = rh and rh:FindFirstChild("RightGripAttachment") :: Attachment?

	local function cleanup()
		for _, c in conns do
			c:Disconnect()
		end
		table.clear(conns)
		if charge then
			charge()
			charge = nil
		end
		if folder then
			folder:Destroy()
			folder = nil
		end
		ball = nil
	end

	table.insert(conns, track:GetMarkerReachedSignal("ChargeStart"):Connect(function()
		if not rh then
			return
		end
		local hand: BasePart = rh
		local f = Instance.new("Folder")
		f.Name = "LihFolkLightningBall"
		f.Parent = getContainer()
		folder = f
		local b, shell, light = makePlasmaBall(pal, f)
		ball = b
		phase = "charge"
		local roles = { core = "hot", halo = "main", edge = "glow" }
		local inArcs: { BoltLine } = {}
		local inLife: { number } = {}
		for i = 1, 4 do
			inArcs[i] = newBoltLine(6, pal, roles, f)
			inLife[i] = -1
		end
		local surf: { BoltLine } = {}
		for i = 1, s.surfaceArcs do
			surf[i] = newBoltLine(3, pal, roles, f)
		end
		local trail: { BoltLine } = { newBoltLine(6, pal, roles, f), newBoltLine(4, pal, roles, f) }
		local hist: { Vector3 } = {}
		local t0 = os.clock()
		local lastJit, lastArc, lastGhost = -1, 0, 0
		local p0, p1, tRel = Vector3.zero, Vector3.zero, 0
		charge = LihFolkVFX.play("ChargeUp", b.CFrame, { element = s.element, important = true })

		local function handPos(t: number): Vector3
			local right = (if grip then grip.WorldPosition else hand.Position) + Vector3.new(0, s.ballRadius + 0.18, 0)
			if not lh then
				return right
			end
			local mid = (hand.Position + lh.Position) / 2
			local k = clamp01((t - s.pullStart) / (s.pullEnd - s.pullStart))
			k = k * k * (3 - 2 * k)
			return mid:Lerp(right, k)
		end

		local c: RBXScriptConnection
		c = RunService.Heartbeat:Connect(function()
			if ball ~= b or not b.Parent then
				c:Disconnect()
				return
			end
			local now = os.clock()
			local t = now - t0
			local x = clamp01(t / s.growTime)
			local c1 = 1.70158
			local grow = 1 + (c1 + 1) * (x - 1) ^ 3 + c1 * (x - 1) ^ 2 -- easeOutBack
			local r = math.max(0.03, s.ballRadius * grow)
			local pos: Vector3
			if phase == "charge" then
				pos = handPos(t)
			elseif phase == "flight" then
				local u = clamp01((now - tRel) / s.flightTime)
				pos = p0:Lerp(p1 + Vector3.new(0, s.ballRadius, 0), u) + Vector3.new(0, 4 * s.arcHeight * u * (1 - u), 0)
			else
				pos = b.Position
			end
			b.CFrame = CFrame.new(pos)
			-- flicker every 1-2 frames: core size, halo opacity, light
			local jit = now - lastJit &gt;= (if math.random() &lt; 0.5 then 1 / 30 else 1 / 15)
			if jit then
				lastJit = now
				local fl = 0.9 + 0.2 * math.random()
				b.Size = Vector3.one * 2 * r * 0.62 * fl
				shell.Size = Vector3.one * 2 * r * (1.05 + 0.1 * math.random())
				shell.Transparency = 0.15 + 0.35 * math.random()
				light.Brightness = (2 + 2 * math.random()) * x
				-- arcs crawling over the surface
				for _, ln in surf do
					local d1 = randomUnit()
					local d2 = randomCone(d1, 70)
					ln.pts = boltPoints(pos + d1 * r * 1.05, pos + d2 * r * 1.1, 3, 1.4, false)
					drawBoltLine(ln, 3, 0.06, 3, 0.9)
				end
			end
			if phase == "charge" then
				-- arcs jumping from the air / ground INTO the hands (each lives ~2 frames)
				if t - lastArc &gt;= 1 / s.inArcRate and x &lt; 1.4 then
					lastArc = t
					for i, ln in inArcs do
						if t - inLife[i] &gt; 0.066 then
							local from = if math.random() &lt; 0.3
								then Vector3.new(pos.X, pos.Y - 2.6, pos.Z) + Vector3.new(math.random() * 4 - 2, 0, math.random() * 4 - 2)
								else pos + randomUnit() * (2.4 + 2 * math.random())
							ln.pts = boltPoints(from, pos, 6, 1.0, false)
							inLife[i] = t
							break
						end
					end
				end
				for i, ln in inArcs do
					local age = t - inLife[i]
					if age &gt;= 0 and age &lt;= 0.066 then
						drawBoltLine(ln, 6, 0.09, 3.5, 1 - age / 0.1)
					else
						hideBoltLine(ln)
					end
				end
			else
				for _, ln in inArcs do
					hideBoltLine(ln)
				end
			end
			if phase == "flight" then
				-- forked lightning trail along the recent path + afterimages
				table.insert(hist, 1, pos)
				if #hist &gt; 8 then
					table.remove(hist)
				end
				if jit and #hist &gt;= 3 then
					local tail = hist[#hist]
					trail[1].pts = boltPoints(pos, tail, 6, 0.9, false)
					local mid = trail[1].pts[3]
					trail[2].pts = boltPoints(mid, mid + randomCone((tail - pos).Unit, 40) * (tail - pos).Magnitude * 0.5, 4, 1.0, false)
				end
				drawBoltLine(trail[1], 6, 0.16, 3.5, 0.9)
				drawBoltLine(trail[2], 4, 0.1, 3.5, 0.7)
				if now - lastGhost &gt;= 1 / 30 then
					lastGhost = now
					local g = shell:Clone()
					g:ClearAllChildren()
					g.CFrame = CFrame.new(pos)
					g.Material = Enum.Material.Neon
					g.Color = pal.glow
					g.Transparency = 0.55
					g.Parent = f
					local g0 = now
					local gc: RBXScriptConnection
					gc = RunService.Heartbeat:Connect(function()
						local a = (os.clock() - g0) / 0.15
						if a &gt;= 1 or not g.Parent then
							gc:Disconnect()
							g:Destroy()
							return
						end
						g.Transparency = 0.55 + 0.45 * a
						g.Size = shell.Size * (1 - 0.4 * a)
					end)
				end
			else
				hideBoltLine(trail[1])
				hideBoltLine(trail[2])
			end
		end)
		table.insert(conns, c)

		table.insert(conns, track:GetMarkerReachedSignal("Release"):Connect(function()
			local root = rootOf(character)
			if ball ~= b or not root then
				return
			end
			p0 = b.Position
			local flat = root.CFrame.LookVector * Vector3.new(1, 0, 1)
			local target = root.Position + (if flat.Magnitude &gt; 1e-3 then flat.Unit else Vector3.new(0, 0, -1)) * s.distance
			local params = RaycastParams.new()
			params.FilterDescendantsInstances = { character, getContainer() }
			params.FilterType = Enum.RaycastFilterType.Exclude
			local hit = Workspace:Raycast(target + Vector3.new(0, 4, 0), Vector3.new(0, -12, 0), params)
			p1 = if hit then hit.Position else target - Vector3.new(0, 3, 0)
			tRel = os.clock()
			phase = "flight"
			if charge then
				charge()
				charge = nil
			end
		end))

		table.insert(conns, track:GetMarkerReachedSignal("Impact"):Connect(function()
			if ball ~= b then
				return
			end
			phase = "done"
			local at = p1
			local root = rootOf(character)
			local look = if root then root.CFrame.LookVector * Vector3.new(1, 0, 1) else Vector3.new(0, 0, -1)
			if look.Magnitude &lt; 1e-3 then
				look = Vector3.new(0, 0, -1)
			end
			-- ball stays visible on the contact frame; the explosion starts 1 frame later
			task.delay(s.impactDelay, function()
				LihFolkVFX.play(s.impactPreset, CFrame.lookAt(at + Vector3.new(0, 3, 0), at + Vector3.new(0, 3, 0) + look.Unit), {
					element = s.element,
					important = true,
				})
				if ball == b then
					ball = nil
				end
				if folder == f then
					f:Destroy()
					folder = nil
				end
			end)
		end))
	end))

	table.insert(conns, track.Stopped:Connect(function()
		task.delay(0.3, cleanup)
	end))
	return cleanup
end

-------------------------------------------------------------------------------
-- !! UNTESTED IN STUDIO !! SpinAttack v2 was authored against the Blender preview
-- (Previews/SpinAttack.mp4, tools/spinattack/composite.py) only. Verify blade attachment
-- offsets, Trail look at 6-8 frame turns, the vortex beams/emitters and part counts in
-- Studio (PC + phone) before shipping.
-- Clip: SpinAttack v2 (SpinStart f12, Hit "spin1" f16 / "spin2" f24 / "spin3" f30, SpinEnd f34,
-- Hit "spinfinish" f41, TrailOff f48). Turns accelerate (~8 / 7 / 6 frames). Radial layers are
-- deliberate here (spin move); the finisher stays frontal.
-- Use EITHER playSpinAttack (everything) OR bindAnimator alone (ground shocks + finisher only);
-- with both bound set spec.playHits = false so the shocks are not doubled.
--
-- BUDGET (whole move, quality 1; counts scale with Config.quality):
--   persistent: 1 pivot part + 1 rune part (Decal; no light: it tinted the shins), 7 Attachments + 5 Trails on the blade,
--               6 vortex Beams (12 Attachments), 3 vortex ParticleEmitters (LockedToPart)
--   vortex particles: dust &lt;= 14/s, debris &lt;= 22/s, pebbles &lt;= 12/s -&gt; ~35 live at the peak
--   per turn: 1 transient spark part (10/16/24 sparks) + SpinShock (1 mesh ring, ~13 particles)
--   finisher: SpinFinish (~11 mesh parts, 6 beams, ~60 particles, 1 light)
--   peak live particles ~150 (Config.maxLiveParticles PC 900 / mobile 360)
-------------------------------------------------------------------------------
export type SpinTier = {
	life: number, -- trail lifetime (s): shorter as the turns speed up, so the stack stays thin
	inner: number, -- studs along the blade (Handle +Y) where this layer starts
	outer: number, -- ... and ends (past bladeTip = wider than the blade)
	color0: string, -- palette role at the head (newest)
	color1: string, -- palette role at the tail
	brightness: number,
	transparency: number, -- at the head
}

export type SpinSequenceSpec = {
	element: string,
	ink: Color3, -- deep navy value layer (shadow smear under the bright rings)
	accent: Color3, -- violet secondary: outer rim on turn 3 + every other vortex line
	bladeBase: number,
	bladeTip: number, -- the pipeline's preview blade: 0.55 .. 3.45 along Handle +Y
	inkLife: number,
	tiers: { SpinTier }, -- one Trail per turn: 1 teal, 2 brighter/wider, 3 white-hot core
	hotLife: number,
	vortexLines: number,
	vortexRadius: { number }, -- start, end (tightens over the 3 turns)
	vortexHeight: { number }, -- start, end (grows)
	vortexSpeed: { number }, -- deg/s start, end (spins up)
	sparks: { number }, -- per turn, flung tangentially off the blade tip
	runeSize: number, -- studs
	runeTransparency: { number }, -- per turn (brightens)
	shockPreset: string,
	shockScale: { number },
	finishPreset: string,
	finishForward: number, -- studs ahead of the root: the finisher layers never cross the character
	playHits: boolean, -- false when bindAnimator already plays DefaultHits for this clip
}

(LihFolkVFX.Sequences :: any).SpinAttack = {
	element = "teal",
	ink = Color3.fromRGB(10, 16, 46),
	accent = Color3.fromRGB(150, 90, 255),
	bladeBase = 0.9,
	bladeTip = 3.4,
	inkLife = 0.24,
	tiers = {
		{ life = 0.17, inner = 2.0, outer = 3.4, color0 = "glow", color1 = "main", brightness = 2, transparency = 0.4 },
		{ life = 0.14, inner = 1.9, outer = 3.8, color0 = "hot", color1 = "glow", brightness = 3.5, transparency = 0.3 },
		{ life = 0.12, inner = 1.8, outer = 4.2, color0 = "hot", color1 = "hot", brightness = 6, transparency = 0.15 },
	},
	hotLife = 0.05,
	vortexLines = 6,
	vortexRadius = { 5.0, 3.2 },
	vortexHeight = { 3.0, 8.0 },
	vortexSpeed = { 700, 1500 },
	sparks = { 10, 16, 24 },
	runeSize = 9,
	runeTransparency = { 0.85, 0.68, 0.45 },
	shockPreset = "SpinShock",
	shockScale = { 0.85, 1.15, 1.5 },
	finishPreset = "SpinFinish",
	finishForward = 3,
	playHits = true,
} :: SpinSequenceSpec

local function spinTrail(blade: BasePart, a0: Attachment, a1: Attachment, name: string): Trail
	local tr = Instance.new("Trail")
	tr.Name = name
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Enabled = false
	tr.MinLength = 0.05
	tr.FaceCamera = false
	tr.LightInfluence = 0
	tr.TextureMode = Enum.TextureMode.Stretch
	tr.Texture = tex("trail_soft") or ""
	tr.Parent = blade
	return tr
end

--[[ Play the SpinAttack v2 sequence on a character whose track carries SpinStart / Hit "spinN" / SpinEnd /
	Hit "spinfinish" / TrailOff. The weapon is the first Tool's Handle (blade along Handle +Y).
	UNTESTED IN STUDIO. Returns a cleanup function. ]]
function LihFolkVFX.playSpinAttack(track: AnimationTrack, character: Model, spec: SpinSequenceSpec?): () -&gt; ()
	local s: SpinSequenceSpec = spec or (LihFolkVFX.Sequences :: any).SpinAttack
	local pal = ((LihFolkVFX.Elements :: any)[s.element] or (LihFolkVFX.Elements :: any).teal) :: Palette
	local conns: { RBXScriptConnection } = {}
	local made: { Instance } = {}
	local vortex: Effect? = nil
	local tier = 0 -- 0 before SpinStart, 1..3 during the turns, 4 = collapsing (finisher)
	local collapseAt: number? = nil
	local tool = character:FindFirstChildOfClass("Tool")
	-- lihfolk-ignore: findfirstchild-chain (nil-checked below)
	local blade = if tool then tool:FindFirstChild("Handle") :: BasePart? else nil
	local tierTrails: { Trail } = {}
	local others: { Trail } = {} -- ink + accent: on for the whole spin
	local hot: Trail? = nil

	if blade then
		local function att(name: string, y: number): Attachment
			local a = Instance.new("Attachment")
			a.Name = name
			a.Position = Vector3.new(0, y, 0)
			a.Parent = blade
			table.insert(made, a)
			return a
		end
		-- deep navy ink smear: thick, pushed outward past the tip so it frames the bright layers
		local ink = spinTrail(blade, att("SpinInk0", s.bladeTip - 0.6), att("SpinInk1", s.bladeTip + 1.1), "SpinInk")
		ink.Lifetime = s.inkLife
		ink.LightEmission = 0
		ink.Brightness = 1
		ink.Color = ColorSequence.new(s.ink)
		ink.Transparency = ns({ { 0, 0.5 }, { 0.4, 0.55 }, { 1, 1 } })
		ink.WidthScale = ns({ { 0, 1 }, { 1, 0.85 } })
		table.insert(others, ink)
		table.insert(made, ink)
		for i, t in s.tiers do
			local tr = spinTrail(blade, att("SpinT" .. i .. "a", t.inner), att("SpinT" .. i .. "b", t.outer), "SpinTier" .. i)
			tr.Lifetime = t.life
			tr.LightEmission = 1
			tr.Brightness = t.brightness
			tr.Color = ColorSequence.new(role(pal, t.color0), role(pal, t.color1))
			tr.Transparency = ns({ { 0, t.transparency }, { 0.5, 0.5 + t.transparency * 0.5 }, { 1, 1 } })
			tr.WidthScale = ns({ { 0, 1 }, { 1, 0.4 } })
			table.insert(tierTrails, tr)
			table.insert(made, tr)
		end
		-- violet accent rim on the last turn (outside the white-hot core)
		local acc = spinTrail(blade, att("SpinAcc0", s.bladeTip + 0.3), att("SpinAcc1", s.bladeTip + 0.9), "SpinAccent")
		acc.Lifetime = 0.12
		acc.LightEmission = 1
		acc.Brightness = 3
		acc.Color = ColorSequence.new(s.accent)
		acc.Transparency = ns({ { 0, 0.2 }, { 1, 1 } })
		table.insert(made, acc)
		-- white-hot edge for the finisher
		local h = spinTrail(blade, att("SpinHot0", s.bladeTip - 0.9), att("SpinHot1", s.bladeTip), "SpinHot")
		h.Lifetime = s.hotLife
		h.LightEmission = 1
		h.Brightness = 6
		h.Color = ColorSequence.new(pal.hot, pal.glow)
		h.Transparency = ns({ { 0, 0 }, { 1, 1 } })
		hot = h
		table.insert(made, h)
		tierTrails[4] = acc
	else
		warnOnce("spin:noblade", "playSpinAttack: no Tool Handle on the character; whirl trails skipped")
	end

	local function setTier(n: number)
		tier = n
		for i = 1, 3 do
			local tr = tierTrails[i]
			if tr then
				if i == n then
					tr:Clear()
				end
				tr.Enabled = (i == n) -- the previous turn's layer stops emitting and fades on its own
			end
		end
		local acc = tierTrails[4]
		if acc then
			acc.Enabled = (n == 3)
		end
	end

	local function stopVortex()
		if vortex then
			vortex.stopped = true
			vortex = nil
		end
	end

	local function cleanup()
		for _, c in conns do
			c:Disconnect()
		end
		table.clear(conns)
		stopVortex()
		for _, i in made do
			i:Destroy()
		end
		table.clear(made)
	end

	-- wind vortex column + rune sigil + lifted dust / debris / pebbles
	local function startVortex()
		local root = rootOf(character)
		if not root then
			return
		end
		local hum = character:FindFirstChildOfClass("Humanoid")
		local floorY = root.Position.Y - (if hum then hum.HipHeight else 2) - root.Size.Y / 2
		local base = Vector3.new(root.Position.X, floorY, root.Position.Z)
		local folder = Instance.new("Folder")
		folder.Name = "SpinVortex"
		folder.Parent = getContainer()
		local pivot = newPart("VortexPivot", CFrame.new(base), folder)
		-- rune sigil on the floor
		local rune = newPart("Rune", CFrame.new(base + Vector3.new(0, 0.03, 0)), folder)
		rune.Size = Vector3.new(s.runeSize, 0.05, s.runeSize)
		local decal = Instance.new("Decal")
		decal.Face = Enum.NormalId.Top
		decal.Texture = tex("rune_circle") or ""
		decal.Color3 = pal.glow
		decal.Transparency = 1
		decal.Parent = rune
		-- helical vortex lines (each beam = one 140 deg rising arc, re-posed every frame)
		local lines: { { b: Beam, a0: Attachment, a1: Attachment, phi: number, y: number } } = {}
		for i = 1, s.vortexLines do
			local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
			a0.Parent, a1.Parent = pivot, pivot
			local b = Instance.new("Beam")
			b.Attachment0, b.Attachment1 = a0, a1
			b.Segments = 24
			b.FaceCamera = true
			b.LightEmission = 1
			b.LightInfluence = 0
			b.Brightness = 2
			b.Color = if i % 2 == 0 then ColorSequence.new(s.accent, pal.glow) else ColorSequence.new(pal.hot, pal.glow)
			b.Transparency = NumberSequence.new(1)
			b.Texture = tex("trail_soft") or ""
			b.Parent = pivot
			table.insert(lines, { b = b, a0 = a0, a1 = a1, phi = 360 * i / s.vortexLines, y = (i - 1) / math.max(1, s.vortexLines - 1) })
		end
		-- lifted particles ride the spinning pivot (LockedToPart) -&gt; they spiral up the column
		local function liftEmitter(props: { [string]: any }): ParticleEmitter
			local e = newEmitter(pivot, props)
			e.LockedToPart = true
			e.Shape = Enum.ParticleEmitterShape.Cylinder
			e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
			e.EmissionDirection = Enum.NormalId.Top
			e.Enabled = true
			return e
		end
		pivot.Size = Vector3.new(2 * s.vortexRadius[1], 0.2, 2 * s.vortexRadius[1])
		local dust = liftEmitter({
			Texture = tex("smoke_puff") or "",
			Color = ColorSequence.new(pal.spark, role(pal, "deep")),
			LightEmission = 0,
			Size = ns({ { 0, 1.2 }, { 1, 3 } }),
			Transparency = ns({ { 0, 1 }, { 0.15, 0.45 }, { 0.7, 0.6 }, { 1, 1 } }),
			Lifetime = NumberRange.new(0.6, 0.9),
			Speed = NumberRange.new(3, 6),
			Acceleration = Vector3.new(0, 4, 0),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-60, 60),
		})
		local debris = liftEmitter({
			Texture = tex("flip_petals_8x8") or "",
			FlipbookLayout = Enum.ParticleFlipbookLayout.Grid8x8,
			FlipbookMode = Enum.ParticleFlipbookMode.Random,
			Color = ColorSequence.new(s.ink),
			LightEmission = 0,
			Size = ns({ { 0, 0.25 }, { 0.3, 0.5 }, { 1, 0.3 } }),
			Lifetime = NumberRange.new(0.5, 0.8),
			Speed = NumberRange.new(5, 10),
			Acceleration = Vector3.new(0, 6, 0),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-400, 400),
		})
		local pebbles = liftEmitter({
			Texture = tex("spark_square") or "",
			Color = ColorSequence.new(pal.debris),
			LightEmission = 0,
			Size = NumberSequence.new(0.18),
			Lifetime = NumberRange.new(0.35, 0.55),
			Speed = NumberRange.new(6, 11),
			Acceleration = Vector3.new(0, -20, 0),
			Rotation = NumberRange.new(0, 45),
		})
		local q = LihFolkVFX.Config.quality
		local e: Effect = { t0 = os.clock(), life = 3.0, steps = {}, root = folder, particles = 0, stopped = false,
			finished = false, speed = 1 }
		local spin = 0
		local lastT = 0
		local spinDur = 0.75 -- SpinStart -&gt; SpinEnd at clip speed 1
		table.insert(e.steps, function(t: number)
			local u = clamp01(t / spinDur)
			local k = 0.0 -- collapse 0..1
			if collapseAt then
				k = clamp01((os.clock() - collapseAt) / 0.3)
			end
			local r = (s.vortexRadius[1] + (s.vortexRadius[2] - s.vortexRadius[1]) * u) * (1 + 1.6 * easeOut(k, 2))
			local hgt = s.vortexHeight[1] + (s.vortexHeight[2] - s.vortexHeight[1]) * u
			local w = s.vortexSpeed[1] + (s.vortexSpeed[2] - s.vortexSpeed[1]) * u
			spin += w * (t - lastT)
			lastT = t
			local rp = rootOf(character)
			local p = if rp then Vector3.new(rp.Position.X, floorY, rp.Position.Z) else base
			pivot.CFrame = CFrame.new(p) * CFrame.Angles(0, math.rad(spin), 0)
			pivot.Size = Vector3.new(2 * r * 0.8, 0.2, 2 * r * 0.8)
			local a = (0.25 + 0.1 * math.min(tier, 3)) * clamp01(t / 0.12) * (1 - k)
			for _, l in lines do
				local y0 = 0.3 + l.y * hgt * 0.75
				local y1 = y0 + hgt * 0.25
				l.a0.CFrame = CFrame.new(arcPoint(l.phi, r, y0)) * CFrame.Angles(0, math.rad(l.phi), 0)
				l.a1.CFrame = CFrame.new(arcPoint(l.phi + 140, r * 0.92, y1)) * CFrame.Angles(0, math.rad(l.phi + 140), 0)
				local kk = 4 / 3 * math.tan(math.rad(140) / 4) * r
				l.b.CurveSize0, l.b.CurveSize1 = kk, -kk
				l.b.Width0, l.b.Width1 = 0.06, 0.35 + 0.12 * math.min(tier, 3)
				l.b.Transparency = ns({ { 0, 1 }, { 0.3, 1 - a }, { 0.8, 1 - a * 0.6 }, { 1, 1 } })
			end
			local tt = math.min(tier, 3)
			dust.Rate = (if k &gt; 0 then 0 else 6 + 4 * tt) * q
			debris.Rate = (if k &gt; 0 then 0 else 10 + 4 * tt) * q
			pebbles.Rate = (if k &gt; 0 then 0 else 4 + 3 * tt) * q
			-- rune: brightens per turn, flares on the finisher, then fades
			local rt = s.runeTransparency[math.max(1, tt)]
			if tier == 0 then
				rt = 1
			end
			if k &gt; 0 then
				rt = 0.05 + 0.95 * easeIn(k, 1.5)
			end
			decal.Transparency = rt
			rune.CFrame = CFrame.new(p + Vector3.new(0, 0.03, 0)) * CFrame.Angles(0, math.rad(-spin * 0.08), 0)
			if k &gt;= 1 then
				e.stopped = true
			end
		end)
		start(e)
		vortex = e
	end

	local function tipSparks(n: number)
		if not blade then
			return
		end
		local root = rootOf(character)
		local tip = blade.CFrame * Vector3.new(0, s.bladeTip, 0)
		local centre = if root then root.Position else blade.Position
		local radial = (tip - centre) * Vector3.new(1, 0, 1)
		if radial.Magnitude &lt; 1e-3 then
			return
		end
		local tangent = Vector3.yAxis:Cross(radial.Unit) -- counter-clockwise from above
		local p = newPart("SpinSparks", CFrame.lookAt(tip, tip + (tangent + radial.Unit * 0.25).Unit), getContainer())
		local em = newEmitter(p, {
			Texture = tex("spark_streak") or "",
			Color = ColorSequence.new(pal.hot, pal.spark),
			LightEmission = 1,
			Brightness = 5,
			Size = ns({ { 0, 0.5 }, { 1, 0 } }),
			Transparency = ns({ { 0, 0 }, { 0.7, 0.1 }, { 1, 1 } }),
			Lifetime = NumberRange.new(0.15, 0.28),
			Speed = NumberRange.new(18, 32),
			SpreadAngle = Vector2.new(14, 10),
			Drag = 6,
			Acceleration = Vector3.new(0, -24, 0),
			Orientation = Enum.ParticleOrientation.VelocityParallel,
			EmissionDirection = Enum.NormalId.Front,
		})
		em:Emit(math.max(1, math.floor(n * LihFolkVFX.Config.quality + 0.5)))
		Debris:AddItem(p, 0.5)
	end

	table.insert(conns, track:GetMarkerReachedSignal("SpinStart"):Connect(function()
		for _, t in others do
			t:Clear()
			t.Enabled = true
		end
		if hot then
			hot:Clear()
			hot.Enabled = true
		end
		setTier(1)
		startVortex()
	end))

	table.insert(conns, track:GetMarkerReachedSignal("Hit"):Connect(function(param: string?)
		local v = param or ""
		local i = tonumber(string.match(v, "^spin(%d)$") or "")
		local root = rootOf(character)
		if i then
			tipSparks(s.sparks[i] or 12)
			if i &lt; 3 then
				task.delay(0.033, function()
					if tier == i then
						setTier(i + 1)
					end
				end)
			end
			if s.playHits and root then
				LihFolkVFX.play(s.shockPreset, root.CFrame, { element = s.element, scale = s.shockScale[i] or 1, important = true })
			end
		elseif v == "spinfinish" then
			collapseAt = os.clock() -- the vortex blows outward into the finisher's dust blast
			tier = 4
			if s.playHits and root then
				LihFolkVFX.play(s.finishPreset, root.CFrame * CFrame.new(0, 0, -s.finishForward), { element = s.element, important = true })
			end
		end
	end))

	table.insert(conns, track:GetMarkerReachedSignal("SpinEnd"):Connect(function()
		-- the turn layers stop emitting and fade; the hot edge stays on for the finishing slash
		for i = 1, 4 do
			local tr = tierTrails[i]
			if tr then
				tr.Enabled = false
			end
		end
		for _, t in others do
			t.Enabled = false
		end
	end))

	table.insert(conns, track:GetMarkerReachedSignal("TrailOff"):Connect(function()
		if hot then
			hot.Enabled = false
		end
	end))

	table.insert(conns, track.Stopped:Connect(function()
		for _, t in made do
			if t:IsA("Trail") then
				t.Enabled = false
			end
		end
		if not collapseAt then
			stopVortex()
		end
		task.delay(0.6, cleanup)
	end))
	return cleanup
end


return LihFolkVFX
</ProtectedString>
        <string name="ScriptGuid">{FC624585-CFD7-4B2C-9D2B-3E7823EA2DD5}</string>
        <BinaryString name="AttributesSerialize" />
        <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
        <bool name="DefinesCapabilities">false</bool>
        <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
        <string name="Name">LihFolkVFX</string>
        <BinaryString name="SerializedOverrides" />
        <int64 name="SourceAssetId">-1</int64>
        <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
        <UniqueId name="UniqueId">038c44eb3ebffb0c0af64a9d000003f7</UniqueId>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="27">
      <Properties>
        <Content name="LinkedSource">
          <null />
        </Content>
        <ProtectedString name="Source">--!strict
--[[
	LihFolkVFX_Abilities: ability VFX beyond slashes (client only). UNTESTED IN STUDIO.

	Standalone module next to LihFolkVFX.luau: same conventions (Textures table with "" = fallback or
	skipped layer + one warning, one shared Heartbeat loop, quality scaling, live-particle cap, Debris
	safety net, Emit bursts, CanCollide/CanQuery/CanTouch false, CastShadow false), no shared state.

	  local A = require(ReplicatedStorage.LihFolkVFX_Abilities)
	  A.Projectile(fromCF, target, opts)   muzzle flash, travelling core + Trail + particle wake, optional
	                                       homing, impact burst on arrival           -&gt; h:Impact(pos?), h:Destroy()
	  A.Aura(character, opts)              persistent rim + motes + foot ring + orbit wisps on Attachments
	                                                                                 -&gt; h:SetIntensity(0..1), h:Destroy()
	  A.Telegraph(cf, shape, opts)         ground AoE warning "circle" | "cone" | "line": dark outline, bright
	                                       rim, translucent fill that grows over `duration`, then a pop
	                                                                                 -&gt; h:Cancel(), h:Destroy()
	  A.Shield(characterOrPart, opts)      ForceField bubble + Highlight rim, ripples   -&gt; h:Hit(worldPos), h:Break(), h:Destroy()
	  A.BeamLaser(fromAtt, to, opts)       charge, core + outer (+ dark edge) Beams, impact glow per frame,
	                                       end burst                                 -&gt; h:SetTarget(posOrAtt), h:Stop(), h:Destroy()
	  A.Heal(character, opts)              rising motes + expanding foot ring + glints  -&gt; h:Destroy()
	  A.Buff(character, opts)              rising streaks + imploding foot ring + pop   -&gt; h:Destroy()
	  A.Teleport(fromCF, toCF, opts)       implode at the source, burst at the destination -&gt; h:Destroy()
	  A.LevelUp(character, opts)           rising scan ring, light pillar above the head, two foot rings,
	                                       sparkles and confetti (celebration)          -&gt; h:Destroy()
	  A.CameraShake(intensity, duration, opts?)   local camera only, distance falloff, reducedMotion aware
	  A.HitStop(tracksOrAnimator, duration, opts?) AdjustSpeed freeze then restore (optional catch-up)
	  A.playPayload(caster, presetId, cf, elementIndex, seed, aux?)  replay a server broadcast (see
	                                       examples/AbilityVFXReplication.*.luau)
	  A.setQuality(q), A.clear(), A.preload(), A.liveParticles()

	Common options: element ("teal", "violet", "fire", "ice", "lightning", "void", "holy", "plasma", "heal"),
	palette (a full Palette), scale, important (own casts and gameplay warnings: never culled), seed, quality.

	Budget at quality 1 (see SKILL.md for the full table); counts scale with quality (touch devices 0.6),
	halve above 75 % of the live cap or beyond lowDetailDistance, decoration layers drop at quality &lt; 0.55.
	At most one light per effect, lights never cast shadows.

	Built-in looks when Textures are empty (no upload needed):
	  glow_soft, flash_hot, spark_streak, spark_square -&gt; the engine's default particle sprite
	  trail_soft, beam_core, beam_outer               -&gt; solid gradient ribbons (no scroll)
	  Neon parts, ForceField material, HandleAdornments (rings, discs, sectors) and Highlights need no texture.
	Skipped when empty (one warning each): smoke_puff (teleport dust), scorch_mark (projectile ground mark).
]]

local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Abilities = {}

-------------------------------------------------------------------------------
-- Asset config: paste "rbxassetid://&lt;id&gt;" after uploading your own textures. "" = built-in look or skipped.
-------------------------------------------------------------------------------
Abilities.Textures = {
	glow_soft = "", -- soft round glow (motes, wake, impact glow); "" = default particle sprite
	flash_hot = "", -- 4-point star flash; "" = default particle sprite
	spark_streak = "", -- thin streak, drawn VelocityParallel; "" = default particle sprite
	spark_square = "", -- small square fleck (debris, shards, confetti); "" = default particle sprite
	smoke_puff = "", -- textured dust puff; "" = dust layer skipped
	scorch_mark = "", -- projectile impact ground mark (Decal); "" = skipped
	trail_soft = "", -- projectile Trail, stretched; "" = solid gradient ribbon
	beam_core = "", -- laser core, scrolls along the beam; "" = solid core
	beam_outer = "", -- laser outer body, scrolls slower; "" = solid body
}

Abilities.Config = {
	quality = 1, -- 0.25..1, scales every Emit count and stream Rate
	maxLiveParticles = 900, -- PC; touch devices 360 (set below)
	maxActive = 10, -- one-shot effects alive at once (important casts bypass)
	cullDistance = 220, -- studs from the camera: others' one-shots are skipped
	lowDetailDistance = 160, -- studs: decoration off, counts halved; persistent effects sleep beyond this
	groundProbe = 40, -- studs a telegraph/ring raycasts down to find the floor
	coneSectorOffset = 0, -- degrees; tune once if Telegraph cones point the wrong way (Studio check)
	reducedMotion = false, -- player setting: CameraShake and HitStop do nothing
	shakeScale = 1, -- player setting 0..1 for CameraShake
	maxHitStop = 0.2, -- seconds
	-- optional: returns the live particles of other VFX modules so all of them share one cap
	externalLive = nil :: (() -&gt; number)?,
}
if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
	Abilities.Config.quality = 0.6
	Abilities.Config.maxLiveParticles = 360
end

-------------------------------------------------------------------------------
-- Palettes: same roles and values as LihFolkVFX.Elements (+ heal)
-------------------------------------------------------------------------------
export type Palette = {
	main: Color3, -- element body
	hot: Color3, -- white-hot core and rims
	dark: Color3, -- saturated ink (outlines, dark wake)
	glow: Color3, -- soft glow, lights
	spark: Color3, -- accent sparks
	debris: Color3, -- flecks
	debrisLight: number?,
}

local rgb = Color3.fromRGB
Abilities.Elements = {
	teal = { main = rgb(40, 215, 195), hot = rgb(225, 255, 250), dark = rgb(5, 20, 24), glow = rgb(60, 255, 220), spark = rgb(185, 255, 240), debris = rgb(8, 12, 14) },
	violet = { main = rgb(120, 48, 255), hot = rgb(242, 234, 255), dark = rgb(40, 12, 100), glow = rgb(125, 70, 255), spark = rgb(205, 180, 255), debris = rgb(16, 6, 34) },
	fire = { main = rgb(255, 105, 25), hot = rgb(255, 242, 205), dark = rgb(38, 8, 3), glow = rgb(255, 150, 40), spark = rgb(255, 205, 110), debris = rgb(28, 9, 5) },
	ice = { main = rgb(85, 185, 255), hot = rgb(235, 250, 255), dark = rgb(8, 24, 46), glow = rgb(135, 215, 255), spark = rgb(220, 245, 255), debris = rgb(170, 220, 245), debrisLight = 0.3 },
	lightning = { main = rgb(255, 225, 55), hot = rgb(255, 255, 238), dark = rgb(28, 22, 58), glow = rgb(255, 238, 110), spark = rgb(255, 255, 200), debris = rgb(18, 16, 38) },
	-- void: inverted (dark body, bright magenta rim); cores get a rim shell instead of a hot centre
	void = { main = rgb(60, 18, 98), hot = rgb(255, 95, 232), dark = rgb(4, 0, 10), glow = rgb(205, 60, 255), spark = rgb(255, 140, 240), debris = rgb(3, 0, 7) },
	holy = { main = rgb(255, 212, 115), hot = rgb(255, 255, 240), dark = rgb(70, 48, 18), glow = rgb(255, 228, 150), spark = rgb(255, 246, 205), debris = rgb(255, 240, 205), debrisLight = 0.4 },
	plasma = { main = rgb(70, 215, 255), hot = rgb(246, 252, 255), dark = rgb(14, 8, 40), glow = rgb(150, 95, 255), spark = rgb(175, 238, 255), debris = rgb(10, 8, 26) },
	-- heal: soft green body, gold accent sparks
	heal = { main = rgb(70, 230, 120), hot = rgb(235, 255, 238), dark = rgb(6, 40, 22), glow = rgb(120, 255, 160), spark = rgb(255, 238, 150), debris = rgb(10, 30, 18), debrisLight = 0.4 },
}

-- Stable ids for network payloads (append only; never reorder a shipped list)
Abilities.ElementIds = { "teal", "violet", "fire", "ice", "lightning", "void", "holy", "plasma", "heal" }
Abilities.PresetIds = {
	"Projectile", -- cf = muzzle, aux = target position
	"TelegraphCircle", -- cf = centre (radius from Abilities.PayloadDefaults)
	"TelegraphCone", -- cf = apex, LookVector = cone direction
	"TelegraphLine", -- cf = start, LookVector = line direction
	"Teleport", -- cf = source, aux = destination position
	"Heal", -- on the caster's character
	"Buff", -- on the caster's character
	"LevelUp", -- on the caster's character
}
-- per-preset options used by playPayload (keep payloads small; put tuning here, not on the wire)
Abilities.PayloadDefaults = {
	Projectile = { speed = 90, range = 160 },
	TelegraphCircle = { radius = 10, duration = 1 },
	TelegraphCone = { radius = 14, angle = 60, duration = 0.8 },
	TelegraphLine = { length = 24, width = 4, duration = 0.7 },
} :: { [string]: { [string]: any } }
-- casts a client may request (server-only presets such as telegraphs and LevelUp are absent).
-- The server enforces these; the client mirrors them so it predicts only casts the server will accept.
Abilities.CastRules = {
	Projectile = { cooldown = 0.35, range = 160 },
	Teleport = { cooldown = 2, range = 40 },
	Heal = { cooldown = 5, range = 0 },
	Buff = { cooldown = 8, range = 0 },
} :: { [string]: { cooldown: number, range: number } }

-------------------------------------------------------------------------------
-- Small helpers (same shapes as LihFolkVFX.luau)
-------------------------------------------------------------------------------
local warned: { [string]: boolean } = {}
local function warnOnce(key: string, msg: string)
	if not warned[key] then
		warned[key] = true
		warn("[LihFolkVFX_Abilities] " .. msg)
	end
end

local function texId(key: string): string?
	local id = (Abilities.Textures :: any)[key]
	if type(id) == "string" and id ~= "" and not string.find(id, "REPLACE_ME", 1, true) then
		return id
	end
	return nil
end

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

local function easeOut(x: number, p: number): number
	return 1 - (1 - clamp01(x)) ^ p
end

local function easeIn(x: number, p: number): number
	return clamp01(x) ^ p
end

local function easeOutBack(x: number): number
	local c1 = 1.70158
	local u = clamp01(x) - 1
	return 1 + (c1 + 1) * u ^ 3 + c1 * u ^ 2
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function ns(points: { { number } }): NumberSequence
	local kps: { NumberSequenceKeypoint } = {}
	for _, p in points do
		table.insert(kps, NumberSequenceKeypoint.new(p[1], p[2], p[3] or 0))
	end
	return NumberSequence.new(kps)
end

local function cs(points: { { any } }): ColorSequence
	local kps: { ColorSequenceKeypoint } = {}
	for _, p in points do
		table.insert(kps, ColorSequenceKeypoint.new(p[1] :: number, p[2] :: Color3))
	end
	return ColorSequence.new(kps)
end

local function aim(pos: Vector3, dir: Vector3): CFrame
	local d = if dir.Magnitude &gt; 1e-4 then dir.Unit else Vector3.new(0, 0, -1)
	local up = if math.abs(d.Y) &gt; 0.99 then Vector3.xAxis else Vector3.yAxis
	return CFrame.lookAt(pos, pos + d, up)
end

-- frame whose Y axis is `up` and whose -Z follows `forward` projected onto that plane
local function surfaceFrame(pos: Vector3, up: Vector3, forward: Vector3): CFrame
	local u = if up.Magnitude &gt; 1e-4 then up.Unit else Vector3.yAxis
	local f = forward - u * forward:Dot(u)
	if f.Magnitude &lt; 1e-3 then
		f = if math.abs(u.Y) &lt; 0.9 then Vector3.yAxis:Cross(u) else Vector3.xAxis:Cross(u)
	end
	return CFrame.lookAt(pos, pos + f.Unit, u)
end

local function isDark(pal: Palette): boolean
	local c = pal.main
	return 0.2126 * c.R + 0.7152 * c.G + 0.0722 * c.B &lt; 0.2
end

local function newPart(name: string, cf: CFrame, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.Transparency = 1
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = cf
	p.Parent = parent
	return p
end

local function neonPart(name: string, shape: Enum.PartType, color: Color3, cf: CFrame, parent: Instance): Part
	local p = newPart(name, cf, parent)
	p.Shape = shape
	p.Material = Enum.Material.Neon
	p.Color = color
	return p
end

local function newAttachment(name: string, parent: Instance, cf: CFrame?): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	if cf then
		a.CFrame = cf
	end
	a.Parent = parent
	return a
end

-- Emitter with a texture key. An empty id keeps the engine's default sprite when `fallback` is true,
-- else the layer is skipped (nil). Emitters start disabled; bursts use Emit.
local function newEmitter(parent: Instance, key: string, props: { [string]: any }, fallback: boolean): ParticleEmitter?
	local id = texId(key)
	if not id then
		if not fallback then
			warnOnce("tex:" .. key, "texture '" .. key .. "' has no id yet; that layer is skipped")
			return nil
		end
		warnOnce("fb:" .. key, "texture '" .. key .. "' has no id yet; using the built-in particle sprite")
	end
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Rate = 0
	e.LightInfluence = 0
	e.LockedToPart = false
	e.VelocityInheritance = 0
	if id then
		e.Texture = id
	end
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = parent
	return e
end

local function newLight(parent: Instance, color: Color3, brightness: number, range: number): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = parent
	return l
end

-- flat ring / disc / sector on a surface frame (Y up). CylinderHandleAdornment lies along its own Z.
local FLAT = CFrame.Angles(math.rad(90), 0, 0)
local function newDisc(parent: Instance, adornee: BasePart, cf: CFrame, outer: number, inner: number, color: Color3, transparency: number): CylinderHandleAdornment
	local a = Instance.new("CylinderHandleAdornment")
	a.Adornee = adornee
	a.CFrame = cf * FLAT
	a.Height = 0.03
	a.Radius = math.max(0.01, outer)
	a.InnerRadius = math.clamp(inner, 0, a.Radius - 0.005)
	a.Color3 = color
	a.Transparency = transparency
	a.AlwaysOnTop = false
	a.Parent = parent
	return a
end

local function setDisc(a: CylinderHandleAdornment, outer: number, width: number?)
	local r = math.max(0.01, outer)
	a.Radius = r
	a.InnerRadius = if width then math.clamp(r - width, 0, r - 0.005) else 0
end

local function newBox(parent: Instance, adornee: BasePart, cf: CFrame, size: Vector3, color: Color3, transparency: number): BoxHandleAdornment
	local b = Instance.new("BoxHandleAdornment")
	b.Adornee = adornee
	b.CFrame = cf
	b.Size = size
	b.Color3 = color
	b.Transparency = transparency
	b.AlwaysOnTop = false
	b.Parent = parent
	return b
end

local function vertical(cf: CFrame): CFrame
	-- Part cylinders run along X: stand them up
	return cf * CFrame.Angles(0, 0, math.rad(90))
end

local function rootOf(character: Model): BasePart?
	local r = character:FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then
		return r
	end
	return character.PrimaryPart
end

-- studs from the root part's centre down to the feet
local function feetOffset(character: Model, root: BasePart): number
	local hum = character:FindFirstChildOfClass("Humanoid")
	if hum and hum.HipHeight &gt; 0 then
		return -(root.Size.Y * 0.5 + hum.HipHeight)
	end
	return -3
end

-------------------------------------------------------------------------------
-- Timeline engine: one Heartbeat for every live effect, disconnected when idle
-------------------------------------------------------------------------------
type Fx = {
	name: string,
	t0: number,
	life: number, -- math.huge for persistent effects
	persistent: boolean,
	root: Model,
	anchor: Part,
	particles: number,
	step: ((t: number, dt: number) -&gt; boolean?)?, -- return true to finish early
	cleanup: { () -&gt; () },
	finished: boolean,
	killed: boolean,
	-- build context
	pal: Palette,
	scale: number,
	detail: number,
	deco: boolean,
	important: boolean,
	rng: Random,
}

local active: { Fx } = {}
local heartbeat: RBXScriptConnection? = nil
local live = 0
local container: Folder? = nil

local function getContainer(): Folder
	local c = container
	if c and c.Parent then
		return c
	end
	local f = Instance.new("Folder")
	f.Name = "LihFolkAbilityFX"
	f.Parent = Workspace
	container = f
	return f
end

local function account(fx: Fx, n: number)
	fx.particles += n
	live += n
end

local function finish(fx: Fx)
	if fx.finished then
		return
	end
	fx.finished = true
	live = math.max(0, live - fx.particles)
	fx.particles = 0
	for _, fn in fx.cleanup do
		local ok, err = pcall(fn)
		if not ok then
			warn("[LihFolkVFX_Abilities] cleanup failed: " .. tostring(err))
		end
	end
	fx.root:Destroy()
end

local function tick(dt: number)
	local now = os.clock()
	for i = #active, 1, -1 do
		local fx = active[i]
		local t = now - fx.t0
		local done = fx.killed or t &gt;= fx.life
		if not done and fx.step then
			local ok, res = pcall(fx.step :: any, t, dt)
			if not ok then
				warn("[LihFolkVFX_Abilities] " .. fx.name .. " step failed, cleaning up: " .. tostring(res))
				done = true
			elseif res == true then
				done = true
			end
		end
		if done then
			finish(fx)
			table.remove(active, i)
		end
	end
	if #active == 0 and heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
end

local function start(fx: Fx)
	fx.root.Parent = getContainer()
	if not fx.persistent then
		Debris:AddItem(fx.root, fx.life + 3) -- safety net if the loop ever dies
	end
	table.insert(active, fx)
	if not heartbeat then
		heartbeat = RunService.Heartbeat:Connect(tick)
	end
end

local function oneShotCount(): number
	local n = 0
	for _, fx in active do
		if not fx.persistent then
			n += 1
		end
	end
	return n
end

local function totalLive(): number
	local ext = Abilities.Config.externalLive
	return live + (if ext then ext() else 0)
end

export type CommonOptions = {
	element: string?,
	palette: Palette?,
	scale: number?,
	important: boolean?, -- own casts and gameplay warnings: never culled or capped
	seed: number?, -- deterministic variation (replication)
	quality: number?, -- overrides Config.quality for this effect
}

local function resolvePalette(opts: CommonOptions, default: string): Palette
	if opts.palette then
		return opts.palette
	end
	local p = (Abilities.Elements :: any)[opts.element or default] :: Palette?
	if p then
		return p
	end
	if opts.element then
		warnOnce("el:" .. opts.element, "unknown element " .. opts.element .. "; using " .. default)
	end
	return (Abilities.Elements :: any)[default] :: Palette
end

-- decide once per effect: skip (nil), reduced or full
local function admit(name: string, pos: Vector3, opts: CommonOptions, default: string, persistent: boolean, life: number): Fx?
	local cfg = Abilities.Config
	local important = opts.important == true
	if not persistent and not important and oneShotCount() &gt;= cfg.maxActive then
		return nil
	end
	local detail = math.clamp(opts.quality or cfg.quality, 0.25, 1)
	local deco = detail &gt;= 0.55
	local cam = Workspace.CurrentCamera
	if cam and not important and not persistent then
		local dist = (cam.CFrame.Position - pos).Magnitude
		if dist &gt; cfg.cullDistance then
			return nil
		elseif dist &gt; cfg.lowDetailDistance then
			detail *= 0.5
			deco = false
		end
	end
	local load = totalLive()
	if load &gt;= cfg.maxLiveParticles and not important then
		return nil
	elseif load &gt; cfg.maxLiveParticles * 0.75 then
		detail *= 0.5
		deco = false
	end
	local root = Instance.new("Model")
	root.Name = name
	local anchor = newPart("Anchor", CFrame.new(pos), root)
	return {
		name = name,
		t0 = os.clock(),
		life = life,
		persistent = persistent,
		root = root,
		anchor = anchor,
		particles = 0,
		step = nil,
		cleanup = {},
		finished = false,
		killed = false,
		pal = resolvePalette(opts, default),
		scale = opts.scale or 1,
		detail = detail,
		deco = deco,
		important = important,
		rng = Random.new(opts.seed or math.floor(os.clock() * 1e6) % 2147483647),
	}
end

-- attachment on the effect's anchor, placed in world space
local function worldAttachment(fx: Fx, name: string, worldCF: CFrame): Attachment
	local a = newAttachment(name, fx.anchor)
	a.WorldCFrame = worldCF
	return a
end

local function count(fx: Fx, n: number): number
	if n &lt;= 0 then
		return 0
	end
	return math.max(1, math.floor(n * fx.detail + 0.5))
end

local function burst(fx: Fx, e: ParticleEmitter?, n: number)
	if e then
		local k = count(fx, n)
		e:Emit(k)
		account(fx, k)
	end
end

-- stream particles alive ~ Rate * Lifetime.Max
local function setStream(fx: Fx, e: ParticleEmitter?, rate: number, prev: number): number
	if not e then
		return 0
	end
	local r = if rate &gt; 0 then rate * fx.detail else 0
	e.Rate = r
	e.Enabled = r &gt; 0
	local alive = r * e.Lifetime.Max
	account(fx, alive - prev)
	return alive
end

local excludeList: { Instance } = {}
local function rayParams(extra: { Instance }?): RaycastParams
	table.clear(excludeList)
	table.insert(excludeList, getContainer())
	if extra then
		for _, inst in extra do
			table.insert(excludeList, inst)
		end
	end
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances = excludeList
	p.IgnoreWater = false
	return p
end

local function characters(): { Instance }
	local list = {}
	for _, pl in Players:GetPlayers() do
		if pl.Character then
			table.insert(list, pl.Character)
		end
	end
	return list
end

-- floor under pos (characters ignored): position and normal
local function groundAt(pos: Vector3): (Vector3, Vector3)
	local probe = Abilities.Config.groundProbe
	local hit = Workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -probe, 0), rayParams(characters()))
	if hit then
		return hit.Position, hit.Normal
	end
	return pos, Vector3.yAxis
end

-------------------------------------------------------------------------------
-- Shared layers
-------------------------------------------------------------------------------
local function flashEmitter(fx: Fx, parent: Instance, size: number, color: Color3): ParticleEmitter?
	return newEmitter(parent, "flash_hot", {
		Lifetime = NumberRange.new(0.05, 0.07), -- 2 frames
		Speed = NumberRange.new(0),
		Size = ns({ { 0, size }, { 1, size * 1.25 } }),
		Transparency = ns({ { 0, 0 }, { 1, 1 } }),
		Rotation = NumberRange.new(0, 360),
		Color = ColorSequence.new(color),
		LightEmission = 1,
		Brightness = 3,
		ZOffset = 2,
	}, true)
end

local function sparkEmitter(fx: Fx, parent: Instance, s: number, spread: number, speed: { number }): ParticleEmitter?
	local pal = fx.pal
	return newEmitter(parent, "spark_streak", {
		EmissionDirection = Enum.NormalId.Front,
		SpreadAngle = Vector2.new(spread, spread),
		Speed = NumberRange.new(speed[1] * s, speed[2] * s),
		Drag = 6,
		Lifetime = NumberRange.new(0.16, 0.3),
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Size = ns({ { 0, 0.22 * s }, { 1, 0 } }),
		Squash = ns({ { 0, 1.2 }, { 1, 0.6 } }),
		Transparency = ns({ { 0, 0 }, { 0.7, 0.2 }, { 1, 1 } }),
		Color = cs({ { 0, pal.hot }, { 0.4, pal.spark }, { 1, pal.main } }),
		LightEmission = 1,
		Brightness = 2,
		ZOffset = 1,
	}, true)
end

local function debrisEmitter(fx: Fx, parent: Instance, s: number, spread: number): ParticleEmitter?
	local pal = fx.pal
	return newEmitter(parent, "spark_square", {
		EmissionDirection = Enum.NormalId.Front,
		SpreadAngle = Vector2.new(spread, spread),
		Speed = NumberRange.new(10 * s, 20 * s),
		Drag = 2.5,
		Acceleration = Vector3.new(0, -40, 0),
		Lifetime = NumberRange.new(0.35, 0.55),
		Size = ns({ { 0, 0.18 * s }, { 1, 0.05 * s } }),
		Transparency = ns({ { 0, 0 }, { 0.8, 0 }, { 1, 1 } }),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-360, 360),
		Color = ColorSequence.new(pal.debris),
		LightEmission = pal.debrisLight or 0,
	}, true)
end

-- expanding ring that fades (eased out). Returns a step piece; call with the local time.
local function ringStep(a: CylinderHandleAdornment, t0: number, dur: number, r0: number, r1: number, w0: number, w1: number, tr0: number): (t: number) -&gt; ()
	return function(t: number)
		local u = (t - t0) / dur
		if u &lt; 0 then
			a.Visible = false
			return
		end
		a.Visible = u &lt;= 1
		local e = easeOut(u, 3)
		setDisc(a, lerp(r0, r1, e), lerp(w0, w1, e))
		a.Transparency = lerp(tr0, 1, easeIn(u, 1.4))
	end
end

-------------------------------------------------------------------------------
-- Handles
-------------------------------------------------------------------------------
export type Handle = {
	Destroy: (self: any) -&gt; (),
	IsAlive: (self: any) -&gt; boolean,
}
export type ProjectileHandle = Handle &amp; { Impact: (self: any, at: Vector3?, normal: Vector3?) -&gt; () }
export type AuraHandle = Handle &amp; { SetIntensity: (self: any, x: number) -&gt; () }
export type TelegraphHandle = Handle &amp; { Cancel: (self: any) -&gt; () }
export type ShieldHandle = Handle &amp; { Hit: (self: any, worldPos: Vector3) -&gt; (), Break: (self: any) -&gt; () }
export type LaserHandle = Handle &amp; { SetTarget: (self: any, to: Vector3 | Attachment) -&gt; (), Stop: (self: any) -&gt; () }

local function baseHandle(fx: Fx?): any
	return {
		Destroy = function(_self: any)
			if fx then
				fx.killed = true
			end
		end,
		IsAlive = function(_self: any): boolean
			return fx ~= nil and not fx.finished and not fx.killed
		end,
	}
end

-- handle with no-op methods for culled effects (callers never need nil checks)
local function deadHandle(): any
	local h = baseHandle(nil)
	local noop = function() end
	h.Impact, h.SetIntensity, h.Cancel, h.Hit, h.Break, h.SetTarget, h.Stop = noop, noop, noop, noop, noop, noop, noop
	return h
end

-------------------------------------------------------------------------------
-- Projectile
-------------------------------------------------------------------------------
export type ProjectileOptions = CommonOptions &amp; {
	speed: number?, -- studs/s (default 90)
	range: number?, -- studs before an air pop (default 160)
	direction: Vector3?, -- fly this way instead of at the target
	homing: number?, -- max turn rate in deg/s toward a BasePart/Attachment target (default 0 = straight)
	gravity: number?, -- studs/s^2 drop (default 0)
	collide: boolean?, -- raycast the world each frame and pop on walls (default true)
	ignore: { Instance }?, -- the caster's character, the weapon...
	light: boolean?, -- default true (one PointLight, travels with the core, pulses at impact)
	onImpact: ((position: Vector3, normal: Vector3) -&gt; ())?,
}

--[[ Visual projectile. `target`: a world position, a BasePart, an Attachment, or nil (fly along
	fromCF.LookVector or opts.direction). Hit detection stays on the server; call h:Impact(pos) when the
	server confirms a hit somewhere else. ]]
function Abilities.Projectile(fromCF: CFrame, target: (Vector3 | BasePart | Attachment)?, options: ProjectileOptions?): ProjectileHandle
	local opts: ProjectileOptions = options or {}
	local speed = math.max(1, opts.speed or 90)
	local range = opts.range or 160
	local fx = admit("Projectile", fromCF.Position, opts, "fire", false, range / speed * 1.6 + 2.5)
	if not fx then
		return deadHandle()
	end
	local pal, s = fx.pal, fx.scale
	local from = fromCF.Position

	local function targetPos(): Vector3?
		if typeof(target) == "Vector3" then
			return target
		elseif typeof(target) == "Instance" then
			if target:IsA("Attachment") and target.Parent then
				return target.WorldPosition
			elseif target:IsA("BasePart") and target.Parent then
				return target.Position
			end
		end
		return nil
	end
	local tp0 = targetPos()
	local dir = opts.direction or (if tp0 and (tp0 - from).Magnitude &gt; 0.1 then tp0 - from else fromCF.LookVector)
	dir = dir.Unit

	-- muzzle: flash + forward spark cone, both one frame
	local muzzle = newAttachment("Muzzle", fx.anchor)
	muzzle.WorldCFrame = aim(from, dir)
	burst(fx, flashEmitter(fx, muzzle, 1.8 * s, pal.hot), 1)
	burst(fx, sparkEmitter(fx, muzzle, s, 22, { 18, 34 }), 8)

	-- core: Neon ball + hot centre (light palettes) or a hot rim shell (dark palettes)
	local core = neonPart("Core", Enum.PartType.Ball, pal.main, aim(from, dir), fx.root)
	core.Size = Vector3.one * 0.9 * s
	core.Transparency = 0
	local inner: Part
	if isDark(pal) then
		inner = newPart("Rim", core.CFrame, fx.root)
		inner.Shape = Enum.PartType.Ball
		inner.Material = Enum.Material.ForceField
		inner.Color = pal.hot
		inner.Size = Vector3.one * 1.15 * s
		inner.Transparency = 0
	else
		inner = neonPart("Hot", Enum.PartType.Ball, pal.hot, core.CFrame, fx.root)
		inner.Size = Vector3.one * 0.5 * s
		inner.Transparency = 0
	end

	-- Trail: white head -&gt; body -&gt; deep tail, tapering
	local a0 = newAttachment("T0", core, CFrame.new(0, 0.32 * s, 0))
	local a1 = newAttachment("T1", core, CFrame.new(0, -0.32 * s, 0))
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.2
	trail.MinLength = 0.05
	trail.FaceCamera = true
	trail.LightEmission = 0.8
	trail.LightInfluence = 0
	trail.WidthScale = ns({ { 0, 1 }, { 1, 0 } })
	trail.Transparency = ns({ { 0, 0.05 }, { 0.6, 0.45 }, { 1, 1 } })
	trail.Color = cs({ { 0, pal.hot }, { 0.3, pal.main }, { 1, pal.main:Lerp(pal.dark, 0.5) } })
	local trailTex = texId("trail_soft")
	if trailTex then
		trail.Texture = trailTex
		trail.TextureMode = Enum.TextureMode.Stretch
	end
	trail.Parent = core

	-- wake: element motes + dark ink motes (decoration)
	local wakeAtt = newAttachment("Wake", core)
	local wake = newEmitter(wakeAtt, "glow_soft", {
		Lifetime = NumberRange.new(0.22, 0.36),
		Speed = NumberRange.new(0.5, 1.5),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 5,
		Size = ns({ { 0, 0.55 * s }, { 1, 0 } }),
		Transparency = ns({ { 0, 0.2 }, { 1, 1 } }),
		Color = cs({ { 0, pal.main }, { 1, pal.main:Lerp(pal.dark, 0.5) } }),
		LightEmission = 1,
	}, true)
	local ink = if fx.deco
		then newEmitter(wakeAtt, "glow_soft", {
			Lifetime = NumberRange.new(0.35, 0.5),
			Speed = NumberRange.new(0.3, 1),
			SpreadAngle = Vector2.new(180, 180),
			Drag = 3,
			Size = ns({ { 0, 0.4 * s }, { 1, 0.9 * s } }),
			Transparency = ns({ { 0, 0.55 }, { 1, 1 } }),
			Color = ColorSequence.new(pal.dark),
			LightEmission = 0,
		}, true)
		else nil
	local wakeAlive = setStream(fx, wake, 36, 0)
	local inkAlive = setStream(fx, ink, 12, 0)

	local light = if opts.light ~= false then newLight(core, pal.glow, 1.4, 9 * s) else nil

	local params = rayParams(opts.ignore)
	local pos = from
	local vel = dir * speed
	local travelled = 0
	local homing = math.rad(opts.homing or 0)
	local gravity = opts.gravity or 0
	local impactT: number? = nil
	local impactSteps: { (t: number) -&gt; () } = {}

	local function impact(t: number, at: Vector3, normal: Vector3)
		if impactT then
			return
		end
		impactT = t
		wakeAlive = setStream(fx, wake, 0, wakeAlive)
		inkAlive = setStream(fx, ink, 0, inkAlive)
		core.Transparency = 1
		inner.Transparency = 1
		core.CFrame = aim(at, vel)
		local n = if normal.Magnitude &gt; 1e-3 then normal.Unit else -vel.Unit
		local hitAtt = newAttachment("Impact", fx.anchor)
		hitAtt.WorldCFrame = aim(at + n * 0.2, n)
		local flash = flashEmitter(fx, hitAtt, 2.6 * s, pal.hot)
		local sparks = sparkEmitter(fx, hitAtt, s, 65, { 22, 40 })
		local chips = if fx.deco then debrisEmitter(fx, hitAtt, s, 55) else nil
		burst(fx, sparks, 16)
		burst(fx, chips, 8)
		-- flash one frame after contact
		local flashed = false
		table.insert(impactSteps, function(lt: number)
			if not flashed and lt &gt;= 0.016 then
				flashed = true
				burst(fx, flash, 1)
			end
		end)
		-- surface rings: bright fast ring, then a dark slower outline ring (decoration)
		local surf = surfaceFrame(at + n * 0.05, n, vel)
		local ringAnchor = newPart("RingAnchor", surf, fx.root)
		local r1 = newDisc(fx.root, ringAnchor, CFrame.identity, 0.4 * s, 0.35 * s, pal.hot:Lerp(pal.main, 0.35), 0.1)
		table.insert(impactSteps, ringStep(r1, 0, 0.3, 0.4 * s, 3.6 * s, 0.35 * s, 0.08 * s, 0.1))
		if fx.deco then
			local r2 = newDisc(fx.root, ringAnchor, CFrame.new(0, -0.01, 0), 0.6 * s, 0.4 * s, pal.dark, 0.35)
			table.insert(impactSteps, ringStep(r2, 0.03, 0.42, 0.6 * s, 4.4 * s, 0.4 * s, 0.1 * s, 0.35))
		end
		local scorch = texId("scorch_mark")
		local tail = 0.9
		if scorch then
			local plate = newPart("Scorch", surf * CFrame.new(0, -0.03, 0), fx.root)
			plate.Size = Vector3.new(3 * s, 0.05, 3 * s)
			local d = Instance.new("Decal")
			d.Face = Enum.NormalId.Top
			d.Texture = scorch
			d.Color3 = pal.dark
			d.Transparency = 0.3
			d.Parent = plate
			table.insert(impactSteps, function(lt: number)
				d.Transparency = lerp(0.3, 1, easeIn(lt / 1.6, 2))
			end)
			tail = 1.7
		else
			warnOnce("tex:scorch_mark", "texture 'scorch_mark' has no id yet; that layer is skipped")
		end
		if light then
			light.Parent = hitAtt
			table.insert(impactSteps, function(lt: number)
				light.Brightness = 3 * (1 - easeOut(lt / 0.2, 2))
				light.Enabled = lt &lt; 0.2
			end)
		end
		fx.life = math.min(fx.life, t + tail)
		if opts.onImpact then
			task.spawn(opts.onImpact, at, n)
		end
	end

	local forced: { at: Vector3?, normal: Vector3? }? = nil

	fx.step = function(t: number, dt: number): boolean?
		local it = impactT
		if it then
			local lt = t - it
			for _, f in impactSteps do
				f(lt)
			end
			return nil
		end
		local f = forced
		if f then
			impact(t, f.at or pos, f.normal or -vel)
			return nil
		end
		if dt &lt;= 0 then
			return nil
		end
		if t &gt; range / speed * 1.6 + 1.4 then
			impact(t, pos, -vel) -- a homing shot that never arrives still ends with a pop
			return nil
		end
		local tp = targetPos()
		local d = vel.Unit
		if tp and homing &gt; 0 then
			local want = tp - pos
			if want.Magnitude &gt; 1e-3 then
				want = want.Unit
				local ang = math.acos(math.clamp(d:Dot(want), -1, 1))
				local maxTurn = homing * dt
				if ang &gt; 1e-4 then
					d = d:Lerp(want, math.min(1, maxTurn / ang)).Unit
				end
			end
		end
		vel = d * speed + Vector3.new(0, -gravity * dt, 0)
		if gravity &gt; 0 then
			speed = vel.Magnitude
		end
		local stepVec = vel * dt
		if tp and (tp - pos).Magnitude &lt;= stepVec.Magnitude + 0.5 * s then
			impact(t, tp, pos - tp)
			return nil
		end
		if opts.collide ~= false then
			local hit = Workspace:Raycast(pos, stepVec, params)
			if hit then
				impact(t, hit.Position, hit.Normal)
				return nil
			end
		end
		pos += stepVec
		travelled += stepVec.Magnitude
		local cf = aim(pos, vel)
		core.CFrame = cf
		inner.CFrame = cf
		if travelled &gt;= range then
			impact(t, pos, -vel) -- air pop at max range
		end
		return nil
	end

	start(fx)
	local h = baseHandle(fx)
	h.Impact = function(_self: any, at: Vector3?, normal: Vector3?)
		if not impactT then
			forced = { at = at, normal = normal }
		end
	end
	return h
end

-------------------------------------------------------------------------------
-- Aura (persistent, attached to the character with Attachments)
-------------------------------------------------------------------------------
export type AuraOptions = CommonOptions &amp; {
	intensity: number?, -- 0..1 (default 1)
	rim: boolean?, -- Highlight outline rim, no fill (default true)
	ring: boolean?, -- breathing foot ring (default true)
	wisps: number?, -- orbiting Trail wisps (default 2, 0 = off)
	light: boolean?, -- small light above and behind the head (default false: lights tint the body)
}

--[[ Persistent aura. Everything lives on Attachments of the root part or on adornments: no glow parts
	welded to the body, and the rim is an outline (FillTransparency 1) so the character stays untinted.
	Sleeps beyond Config.lowDetailDistance (wakes inside 85 % of it). ]]
function Abilities.Aura(character: Model, options: AuraOptions?): AuraHandle
	local opts: AuraOptions = options or {}
	local root = rootOf(character)
	if not root then
		return deadHandle()
	end
	local fx = admit("Aura", root.Position, opts, "teal", true, math.huge)
	if not fx then
		return deadHandle()
	end
	local pal, s = fx.pal, fx.scale
	local feet = feetOffset(character, root)
	local made: { Instance } = {}
	local function own(inst: Instance): Instance
		table.insert(made, inst)
		return inst
	end
	table.insert(fx.cleanup, function()
		for _, inst in made do
			inst:Destroy()
		end
	end)

	local feetAtt = own(newAttachment("AuraFeet", root, CFrame.new(0, feet + 0.2, 0))) :: Attachment
	-- rising motes: slow, sparse, light on top
	local motes = newEmitter(feetAtt, "glow_soft", {
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(70, 70),
		Speed = NumberRange.new(1.2 * s, 2.6 * s),
		Acceleration = Vector3.new(0, 2.5 * s, 0),
		Drag = 0.8,
		Lifetime = NumberRange.new(1.1, 1.6),
		Size = ns({ { 0, 0 }, { 0.25, 0.22 * s }, { 1, 0 } }),
		Transparency = ns({ { 0, 1 }, { 0.2, 0.15 }, { 1, 1 } }),
		Color = cs({ { 0, pal.main }, { 1, pal.hot } }),
		LightEmission = 1,
	}, true)
	-- dark specks for value (decoration)
	local specks = if fx.deco
		then newEmitter(feetAtt, "spark_square", {
			EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(60, 60),
			Speed = NumberRange.new(1 * s, 2 * s),
			Acceleration = Vector3.new(0, 1.5 * s, 0),
			Lifetime = NumberRange.new(0.9, 1.3),
			Size = ns({ { 0, 0.12 * s }, { 1, 0 } }),
			Transparency = ns({ { 0, 0.2 }, { 1, 1 } }),
			Rotation = NumberRange.new(0, 360),
			Color = ColorSequence.new(pal.dark),
			LightEmission = 0,
		}, true)
		else nil

	-- rim: outline only
	local rim: Highlight? = nil
	if opts.rim ~= false then
		local hl = Instance.new("Highlight")
		hl.Adornee = character
		hl.FillTransparency = 1
		hl.OutlineColor = pal.glow
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = fx.root
		rim = hl
	end

	-- foot ring: thin bright ring over a faint dark ring (reads on light and dark floors)
	local ringOuter: CylinderHandleAdornment? = nil
	local ringDark: CylinderHandleAdornment? = nil
	if opts.ring ~= false then
		local base = CFrame.new(0, feet + 0.06, 0)
		ringDark = newDisc(fx.root, root, base, 2.9 * s, 0.5 * s, pal.dark, 0.55)
		ringOuter = newDisc(fx.root, root, base * CFrame.new(0, 0.02, 0), 2.7 * s, 0.12 * s, pal.main:Lerp(pal.hot, 0.3), 0.25)
	end

	-- orbit wisps: two Attachments each, a short Trail between them
	type Wisp = { a: Attachment, b: Attachment, trail: Trail, phase: number, height: number, radius: number, speed: number }
	local wisps: { Wisp } = {}
	local nW = if fx.deco then (opts.wisps or 2) else 0
	for i = 1, nW do
		local a = own(newAttachment("WispA" .. i, root)) :: Attachment
		local b = own(newAttachment("WispB" .. i, root)) :: Attachment
		local tr = Instance.new("Trail")
		tr.Attachment0 = a
		tr.Attachment1 = b
		tr.Lifetime = 0.35
		tr.FaceCamera = true
		tr.LightEmission = 1
		tr.LightInfluence = 0
		tr.WidthScale = ns({ { 0, 1 }, { 1, 0 } })
		tr.Color = cs({ { 0, pal.hot }, { 0.35, pal.main }, { 1, pal.main:Lerp(pal.dark, 0.5) } })
		tr.Transparency = ns({ { 0, 0.1 }, { 1, 1 } })
		tr.Parent = fx.root
		table.insert(wisps, {
			a = a,
			b = b,
			trail = tr,
			phase = fx.rng:NextNumber(0, math.pi * 2),
			height = fx.rng:NextNumber(-1.2, 1.4),
			radius = 2.1 * s,
			speed = (if i % 2 == 0 then -1 else 1) * fx.rng:NextNumber(2.4, 3.2),
		})
	end

	local light: PointLight? = nil
	if opts.light == true then
		local la = own(newAttachment("AuraLight", root, CFrame.new(0, 3.5, 1.5))) :: Attachment
		light = newLight(la, pal.glow, 0.6, 8 * s)
	end

	local intensity = clamp01(opts.intensity or 1)
	local awake = true
	local motesAlive, specksAlive = 0, 0
	local function apply()
		local k = if awake then intensity else 0
		motesAlive = setStream(fx, motes, 7 * k, motesAlive)
		specksAlive = setStream(fx, specks, 3 * k, specksAlive)
		if rim then
			rim.Enabled = k &gt; 0.01
			rim.OutlineTransparency = lerp(1, 0.3, k)
		end
		for _, w in wisps do
			w.trail.Enabled = k &gt; 0.05
		end
		if light then
			light.Enabled = k &gt; 0.05
			light.Brightness = 0.6 * k
		end
	end
	apply()

	local nextSleepCheck = 0
	fx.step = function(t: number, _dt: number): boolean?
		if not character.Parent or not root.Parent then
			return true
		end
		if t &gt;= nextSleepCheck then
			nextSleepCheck = t + 0.5
			local cam = Workspace.CurrentCamera
			if cam and not fx.important then
				local d = (cam.CFrame.Position - root.Position).Magnitude
				local lim = Abilities.Config.lowDetailDistance
				if awake and d &gt; lim then
					awake = false
					apply()
				elseif not awake and d &lt; lim * 0.85 then
					awake = true
					apply()
				end
			end
		end
		if not awake then
			return nil
		end
		local breathe = 0.5 + 0.5 * math.sin(t * 2.4)
		local ro = ringOuter
		if ro then
			setDisc(ro, (2.55 + 0.25 * breathe) * s, 0.12 * s)
			ro.Transparency = lerp(1, lerp(0.45, 0.2, breathe), intensity)
		end
		local rd = ringDark
		if rd then
			rd.Transparency = lerp(1, 0.55, intensity)
		end
		for _, w in wisps do
			local ang = w.phase + t * w.speed
			local y = w.height + 0.5 * math.sin(t * 1.3 + w.phase)
			local p = Vector3.new(math.cos(ang) * w.radius, y, math.sin(ang) * w.radius)
			w.a.Position = p + Vector3.new(0, 0.18 * s, 0)
			w.b.Position = p - Vector3.new(0, 0.18 * s, 0)
		end
		return nil
	end

	start(fx)
	local h = baseHandle(fx)
	h.SetIntensity = function(_self: any, x: number)
		intensity = clamp01(x)
		if not fx.finished then
			apply()
		end
	end
	return h
end

-------------------------------------------------------------------------------
-- Telegraph (ground AoE warning)
-------------------------------------------------------------------------------
export type TelegraphOptions = CommonOptions &amp; {
	duration: number?, -- fill time in seconds (default 1)
	radius: number?, -- circle / cone (default 8 / 12)
	angle: number?, -- cone width in degrees (default 60)
	length: number?, -- line (default 20)
	width: number?, -- line (default 4)
	elapsed: number?, -- seconds already gone (late arrival: GetServerTimeNow() - startedAt); fills the remainder
	onPop: (() -&gt; ())?, -- runs when the fill completes (visual only; damage stays on the server)
}

--[[ Ground warning. shape "circle" (cf.Position = centre), "cone" (apex at cf, opens along LookVector)
	or "line" (starts at cf, runs along LookVector). Raycasts to the floor and follows its slope.
	Layers bottom to top: dark outline (bright floors), translucent base fill, growing progress fill with
	a hot leading edge, bright rim (dark floors). Gameplay information: important by default. ]]
function Abilities.Telegraph(cf: CFrame, shape: string, options: TelegraphOptions?): TelegraphHandle
	local opts: TelegraphOptions = options or {}
	if opts.important == nil then
		opts = table.clone(opts)
		opts.important = true
	end
	local dur = math.max(0.05, opts.duration or 1)
	local fx = admit("Telegraph", cf.Position, opts, "fire", false, dur + 0.5)
	if not fx then
		return deadHandle()
	end
	fx.t0 -= math.clamp(opts.elapsed or 0, 0, dur) -- late arrival: start part-filled
	local pal, s = fx.pal, fx.scale
	local gp, gn = groundAt(cf.Position)
	local frame = surfaceFrame(gp + gn * 0.04, gn, cf.LookVector)
	fx.anchor.CFrame = frame
	local A = fx.anchor
	local P = fx.root

	local outlineC = pal.dark
	local fillC = pal.main
	local rimC = pal.main:Lerp(pal.hot, 0.45)
	local edgeC = pal.hot
	local OUT = 0.32 * s -- dark outline width
	local RIM = 0.16 * s -- bright rim width
	local y0, y1, y2, y3 = CFrame.new(0, 0, 0), CFrame.new(0, 0.012, 0), CFrame.new(0, 0.024, 0), CFrame.new(0, 0.036, 0)

	local fills: { GuiBase3d } = {}
	local rims: { GuiBase3d } = {}
	local setProgress: (p: number) -&gt; ()

	if shape == "cone" then
		local R = (opts.radius or 12) * s
		local ang = math.clamp(opts.angle or 60, 5, 359)
		local secCF = CFrame.Angles(0, 0, math.rad(-90 - ang * 0.5 + Abilities.Config.coneSectorOffset))
		local function sector(cfo: CFrame, outer: number, inner: number, angle: number, c: Color3, tr: number): CylinderHandleAdornment
			local a = newDisc(P, A, cfo, outer, inner, c, tr)
			a.Angle = angle
			a.CFrame = cfo * FLAT * secCF
			return a
		end
		-- outline: a slightly larger dark sector pushed back so its straight sides show too
		local back = OUT / math.sin(math.rad(math.min(ang, 179) * 0.5))
		sector(y0 * CFrame.new(0, 0, back), R + OUT + back, 0, ang, outlineC, 0.2)
		table.insert(fills, sector(y1, R, 0, ang, fillC, 0.78))
		local prog = sector(y2, 0.01, 0, ang, fillC, 0.45)
		local edge = sector(y3, 0.01, 0, ang, edgeC, 0.15)
		table.insert(fills, prog)
		table.insert(rims, sector(y3, R, R - RIM, ang, rimC, 0.05))
		for _, side in { -1, 1 } do
			local yaw = math.rad(side * ang * 0.5)
			local d = CFrame.Angles(0, yaw, 0)
			table.insert(rims, newBox(P, A, y3 * d * CFrame.new(0, 0, -R * 0.5), Vector3.new(RIM, 0.03, R), rimC, 0.05))
		end
		setProgress = function(p: number)
			local r = math.max(0.02, R * p)
			setDisc(prog, r)
			setDisc(edge, r, 0.22 * s)
		end
	elseif shape == "line" then
		local L = (opts.length or 20) * s
		local W = (opts.width or 4) * s
		newBox(P, A, y0 * CFrame.new(0, 0, -L * 0.5), Vector3.new(W + OUT * 2, 0.03, L + OUT * 2), outlineC, 0.2)
		table.insert(fills, newBox(P, A, y1 * CFrame.new(0, 0, -L * 0.5), Vector3.new(W, 0.03, L), fillC, 0.78))
		local prog = newBox(P, A, y2, Vector3.new(W, 0.03, 0.01), fillC, 0.45)
		local edge = newBox(P, A, y3, Vector3.new(W, 0.03, 0.22 * s), edgeC, 0.15)
		table.insert(fills, prog)
		-- rim: two sides and the far end
		for _, side in { -1, 1 } do
			table.insert(rims, newBox(P, A, y3 * CFrame.new(side * (W - RIM) * 0.5, 0, -L * 0.5), Vector3.new(RIM, 0.03, L), rimC, 0.05))
		end
		table.insert(rims, newBox(P, A, y3 * CFrame.new(0, 0, -L + RIM * 0.5), Vector3.new(W, 0.03, RIM), rimC, 0.05))
		setProgress = function(p: number)
			local l = math.max(0.02, L * p)
			prog.Size = Vector3.new(W, 0.03, l)
			prog.CFrame = y2 * CFrame.new(0, 0, -l * 0.5)
			edge.CFrame = y3 * CFrame.new(0, 0, -math.max(0.11 * s, l - 0.11 * s))
		end
	else
		if shape ~= "circle" then
			warnOnce("shape:" .. tostring(shape), "unknown telegraph shape " .. tostring(shape) .. "; drawing a circle")
		end
		local R = (opts.radius or 8) * s
		newDisc(P, A, y0, R + OUT, 0, outlineC, 0.2)
		table.insert(fills, newDisc(P, A, y1, R, 0, fillC, 0.78))
		local prog = newDisc(P, A, y2, 0.01, 0, fillC, 0.45)
		local edge = newDisc(P, A, y3, 0.01, 0, edgeC, 0.15)
		table.insert(fills, prog)
		table.insert(rims, newDisc(P, A, y3, R, R - RIM, rimC, 0.05))
		setProgress = function(p: number)
			local r = math.max(0.02, R * p)
			setDisc(prog, r)
			setDisc(edge, r, 0.22 * s)
		end
	end
	setProgress(0)

	local popT: number? = nil
	local cancelT: number? = nil
	local all = fx.root:GetChildren()
	local base: { [Instance]: number } = {}
	for _, c in all do
		if c:IsA("GuiBase3d") then
			base[c] = c.Transparency
		end
	end
	local function fadeAll(k: number)
		for inst, tr in base do
			(inst :: GuiBase3d).Transparency = lerp(tr, 1, k)
		end
	end

	fx.step = function(t: number, _dt: number): boolean?
		local ct = cancelT
		if ct then
			local k = (t - ct) / 0.15
			fadeAll(easeOut(k, 2))
			return k &gt;= 1
		end
		local pt = popT
		if not pt then
			-- fade in over 0.08 s, then the progress fill grows (ease in: the last third feels urgent)
			fadeAll(1 - easeOut(t / 0.08, 2))
			setProgress(easeIn(t / dur, 1.3))
			if t &gt;= dur then
				popT = t
				for _, f in fills do
					(f :: GuiBase3d).Color3 = pal.hot:Lerp(pal.main, 0.25)
				end
				if opts.onPop then
					task.spawn(opts.onPop)
				end
			end
			return nil
		end
		-- pop: fill flashes hot, everything fades in 0.22 s
		local k = (t - pt) / 0.22
		fadeAll(easeOut(k, 1.6))
		return k &gt;= 1
	end

	start(fx)
	local h = baseHandle(fx)
	h.Cancel = function(_self: any)
		if not popT and not cancelT and not fx.finished then
			cancelT = os.clock() - fx.t0
		end
	end
	return h
end

-------------------------------------------------------------------------------
-- Shield
-------------------------------------------------------------------------------
export type ShieldOptions = CommonOptions &amp; {
	radius: number?, -- default from the target's size (3..8 studs)
	duration: number?, -- auto end after this many seconds (default: until Break/Destroy)
	breakOnExpire: boolean?, -- end with the break burst instead of a quiet fade
}

function Abilities.Shield(target: Model | BasePart, options: ShieldOptions?): ShieldHandle
	local opts: ShieldOptions = options or {}
	local follow: BasePart? = if target:IsA("Model") then rootOf(target) elseif target:IsA("BasePart") then target else nil
	if not follow then
		return deadHandle()
	end
	local fx = admit("Shield", follow.Position, opts, "ice", true, math.huge)
	if not fx then
		return deadHandle()
	end
	local pal, s = fx.pal, fx.scale
	local R: number
	if opts.radius then
		R = opts.radius * s
	elseif target:IsA("Model") then
		R = math.clamp(target:GetExtentsSize().Y * 0.6, 3, 8) * s
	else
		R = math.clamp(follow.Size.Magnitude * 0.6, 3, 8) * s
	end

	-- shell: ForceField material gives the animated fresnel edge; Highlight adds a crisp silhouette rim
	local shell = newPart("Shell", follow.CFrame, fx.root)
	shell.Shape = Enum.PartType.Ball
	shell.Material = Enum.Material.ForceField
	shell.Color = pal.main
	shell.Size = Vector3.one * 0.1
	shell.Transparency = 0
	local rim = Instance.new("Highlight")
	rim.Adornee = shell
	rim.FillTransparency = 1
	rim.OutlineColor = pal.glow
	rim.OutlineTransparency = 0.3
	rim.DepthMode = Enum.HighlightDepthMode.Occluded
	rim.Parent = fx.root

	local glints = if fx.deco
		then newEmitter(shell, "glow_soft", {
			Shape = Enum.ParticleEmitterShape.Sphere,
			ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
			Speed = NumberRange.new(0),
			Lifetime = NumberRange.new(0.4, 0.6),
			Size = ns({ { 0, 0 }, { 0.3, 0.3 * s }, { 1, 0 } }),
			Transparency = ns({ { 0, 0.2 }, { 1, 1 } }),
			Color = ColorSequence.new(pal.hot),
			LightEmission = 1,
			LockedToPart = true,
		}, true)
		else nil
	local glintsAlive = setStream(fx, glints, 4, 0)

	type Ripple = { a: CylinderHandleAdornment, t0: number, size: number }
	local ripples: { Ripple } = {}
	local hitFlash = 0
	local breakT: number? = nil
	local fadeT: number? = nil
	local light: PointLight? = nil
	local lastT = 0
	local shardAtt = newAttachment("Shards", fx.anchor)
	local breakRing: CylinderHandleAdornment? = nil

	local function doBreak(t: number)
		if breakT then
			return
		end
		breakT = t
		glintsAlive = setStream(fx, glints, 0, glintsAlive)
		local c = shell.Position
		fx.anchor.CFrame = CFrame.new(c)
		local shards = newEmitter(shardAtt, "spark_square", {
			Shape = Enum.ParticleEmitterShape.Sphere,
			SpreadAngle = Vector2.new(180, 180),
			Speed = NumberRange.new(14 * s, 26 * s),
			Drag = 2,
			Acceleration = Vector3.new(0, -30, 0),
			Lifetime = NumberRange.new(0.4, 0.7),
			Size = ns({ { 0, 0.3 * s }, { 1, 0.08 * s } }),
			Transparency = ns({ { 0, 0 }, { 0.8, 0.1 }, { 1, 1 } }),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-400, 400),
			Color = cs({ { 0, pal.hot }, { 1, pal.main } }),
			LightEmission = 0.6,
		}, true)
		burst(fx, shards, 22)
		burst(fx, sparkEmitter(fx, shardAtt, s, 180, { 20, 36 }), 12)
		local ra = newPart("BreakRing", CFrame.new(c), fx.root)
		breakRing = newDisc(fx.root, ra, CFrame.identity, R, R - 0.4 * s, pal.hot, 0.1)
		light = newLight(newAttachment("BreakLight", fx.anchor, CFrame.new(0, R + 1, 0)), pal.glow, 2, 12 * s)
	end

	fx.step = function(t: number, dt: number): boolean?
		lastT = t
		if not follow.Parent then
			return true
		end
		local c = follow.CFrame
		local bt = breakT
		if bt then
			local u = (t - bt) / 0.18
			shell.Size = Vector3.one * 2 * R * lerp(1, 1.3, easeOut(u, 2))
			shell.CFrame = c
			shell.Transparency = easeOut(u, 1.5)
			rim.OutlineTransparency = lerp(0.1, 1, clamp01(u))
			local br = breakRing
			if br then
				local u2 = (t - bt) / 0.32
				setDisc(br, R * lerp(1, 2.2, easeOut(u2, 3)), 0.4 * s * (1 - u2) + 0.05)
				br.Transparency = lerp(0.1, 1, easeIn(u2, 1.3))
			end
			local l = light
			if l then
				l.Brightness = 2 * (1 - easeOut((t - bt) / 0.25, 2))
			end
			return t - bt &gt; 0.8
		end
		local ft = fadeT
		if ft then
			local u = (t - ft) / 0.25
			shell.CFrame = c
			shell.Transparency = easeOut(u, 2)
			rim.OutlineTransparency = lerp(0.3, 1, clamp01(u))
			return u &gt;= 1
		end
		if opts.duration and t &gt;= opts.duration then
			if opts.breakOnExpire then
				doBreak(t)
			else
				fadeT = t
				glintsAlive = setStream(fx, glints, 0, glintsAlive)
			end
			return nil
		end
		-- grow in with a slight overshoot, then breathe
		local grow = easeOutBack(t / 0.22)
		shell.Size = Vector3.one * 2 * R * math.max(0.05, grow)
		shell.CFrame = c
		hitFlash = math.max(0, hitFlash - dt / 0.18)
		shell.Color = pal.main:Lerp(pal.hot, hitFlash * 0.7)
		shell.Transparency = clamp01(1 - t / 0.12) * 0.8
		rim.OutlineTransparency = lerp(0.3 + 0.1 * math.sin(t * 7.5), 0.05, hitFlash)
		for i = #ripples, 1, -1 do
			local r = ripples[i]
			local u = (t - r.t0) / 0.35
			if u &gt;= 1 then
				r.a:Destroy()
				table.remove(ripples, i)
			else
				setDisc(r.a, lerp(0.2, 1.8, easeOut(u, 3)) * r.size, 0.25 * r.size)
				r.a.Transparency = lerp(0, 1, easeIn(u, 1.2))
			end
		end
		return nil
	end

	start(fx)
	local h = baseHandle(fx)
	h.Hit = function(_self: any, worldPos: Vector3)
		if fx.finished or breakT or fadeT then
			return
		end
		local c = shell.Position
		local d = worldPos - c
		local dir = if d.Magnitude &gt; 1e-3 then d.Unit else Vector3.yAxis
		local surf = c + dir * R
		-- ripple: a ring adornment on the tangent plane, riding the shell
		local rel = shell.CFrame:ToObjectSpace(CFrame.lookAt(surf, surf + dir))
		local a = Instance.new("CylinderHandleAdornment")
		a.Adornee = shell
		a.CFrame = rel
		a.Height = 0.04
		a.Radius = 0.2
		a.InnerRadius = 0
		a.Color3 = pal.hot
		a.Transparency = 0
		a.Parent = fx.root
		table.insert(ripples, { a = a, t0 = lastT, size = s * math.clamp(R / 4, 0.8, 1.6) })
		if #ripples &gt; 4 then
			ripples[1].a:Destroy()
			table.remove(ripples, 1)
		end
		hitFlash = 1
		local att = newAttachment("Hit", fx.anchor)
		att.WorldCFrame = aim(surf, dir)
		burst(fx, sparkEmitter(fx, att, s, 50, { 14, 26 }), 10)
		Debris:AddItem(att, 0.6)
	end
	h.Break = function(_self: any)
		if not fx.finished then
			doBreak(lastT)
		end
	end
	return h
end

-------------------------------------------------------------------------------
-- Beam laser
-------------------------------------------------------------------------------
export type LaserOptions = CommonOptions &amp; {
	charge: number?, -- seconds of charge before the beam (default 0.35, 0 = instant)
	duration: number?, -- auto Stop after this many seconds of beam (default: until Stop)
	width: number?, -- outer width in studs (default 1.2)
	range: number?, -- max length (default 200)
	clip: boolean?, -- raycast and end the beam on walls (default true)
	ignore: { Instance }?,
	onEnd: (() -&gt; ())?,
}

function Abilities.BeamLaser(fromAtt: Attachment, to: Vector3 | Attachment, options: LaserOptions?): LaserHandle
	local opts: LaserOptions = options or {}
	local fx = admit("BeamLaser", fromAtt.WorldPosition, opts, "plasma", true, math.huge)
	if not fx then
		return deadHandle()
	end
	local pal, s = fx.pal, fx.scale
	local W = (opts.width or 1.2) * s
	local chargeT = math.max(0, opts.charge or 0.35)
	local range = opts.range or 200
	local params = rayParams(opts.ignore)
	local goal: Vector3 | Attachment = to

	local endPart = newPart("End", CFrame.new(fromAtt.WorldPosition), fx.root)
	local endAtt = newAttachment("EndAtt", endPart)

	local function mkBeam(name: string, width: number, color: ColorSequence, tr: NumberSequence, emission: number, bright: number, key: string, speed: number): Beam
		local b = Instance.new("Beam")
		b.Name = name
		b.Attachment0 = fromAtt
		b.Attachment1 = endAtt
		b.Width0 = width
		b.Width1 = width * 0.85
		b.Color = color
		b.Transparency = tr
		b.LightEmission = emission
		b.LightInfluence = 0
		b.Brightness = bright
		b.FaceCamera = true
		b.Segments = 1
		b.Enabled = false
		local id = texId(key)
		if id then
			b.Texture = id
			b.TextureMode = Enum.TextureMode.Wrap
			b.TextureLength = 6 * s
			b.TextureSpeed = speed
		end
		b.Parent = fx.root
		return b
	end
	-- value: dark edge (decoration) under a saturated body with a thin white-hot core
	local edge = if fx.deco
		then mkBeam("Edge", W * 1.35, ColorSequence.new(pal.dark), ns({ { 0, 0.55 }, { 1, 0.7 } }), 0, 1, "beam_outer", 1)
		else nil
	local outer = mkBeam("Outer", W, cs({ { 0, pal.main }, { 1, pal.glow } }), ns({ { 0, 0.3 }, { 1, 0.45 } }), 1, 1.2, "beam_outer", 1.5)
	local core = mkBeam("Core", W * 0.28, ColorSequence.new(pal.hot), ns({ { 0, 0 }, { 1, 0.1 } }), 1, 1.6, "beam_core", 4)
	if edge then
		edge.ZOffset = -0.1
	end
	core.ZOffset = 0.1
	if not texId("beam_core") then
		warnOnce("fb:beam", "beam textures have no id yet; drawing solid ribbons")
	end

	-- charge: converging motes on a sphere shell + a growing glow ball just ahead of the source
	local chargeShell = newPart("ChargeShell", CFrame.new(fromAtt.WorldPosition), fx.root)
	chargeShell.Size = Vector3.one * 4.5 * s
	local converge = newEmitter(chargeShell, "glow_soft", {
		Shape = Enum.ParticleEmitterShape.Sphere,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		Speed = NumberRange.new(9 * s, 12 * s),
		Lifetime = NumberRange.new(0.2, 0.24),
		Size = ns({ { 0, 0.1 * s }, { 1, 0.3 * s } }),
		Transparency = ns({ { 0, 1 }, { 0.3, 0.1 }, { 1, 0.4 } }),
		Color = cs({ { 0, pal.main }, { 1, pal.hot } }),
		LightEmission = 1,
	}, true)
	local orb = neonPart("ChargeOrb", Enum.PartType.Ball, pal.hot, CFrame.new(fromAtt.WorldPosition), fx.root)
	orb.Size = Vector3.one * 0.05

	-- endpoint: impact glow ball, spark stream, the one light
	local glow = neonPart("ImpactGlow", Enum.PartType.Ball, pal.main:Lerp(pal.hot, 0.35), endPart.CFrame, fx.root)
	glow.Transparency = 1
	glow.Size = Vector3.one * 1.6 * W
	local hitAtt = newAttachment("Hit", endPart)
	local sparks = sparkEmitter(fx, hitAtt, s, 70, { 10, 22 })
	local light = newLight(endPart, pal.glow, 0, 10 * s)
	local sparksAlive = 0

	local pulses = 0
	local beamT: number? = nil
	local stopT: number? = nil
	local lastT = 0
	local dir = Vector3.new(0, 0, -1)

	local function goalPos(): Vector3?
		if typeof(goal) == "Vector3" then
			return goal
		elseif typeof(goal) == "Instance" and goal.Parent then
			return goal.WorldPosition
		end
		return nil
	end

	local function updateEnd()
		local from = fromAtt.WorldPosition
		local g = goalPos() or (from + dir * range)
		local v = g - from
		if v.Magnitude &gt; 1e-3 then
			dir = v.Unit
		end
		local len = math.min(v.Magnitude, range)
		local endPos = from + dir * len
		local normal = -dir
		if opts.clip ~= false then
			local hit = Workspace:Raycast(from, dir * len, params)
			if hit then
				endPos = hit.Position
				normal = hit.Normal
			end
		end
		endPart.CFrame = CFrame.new(endPos)
		hitAtt.WorldCFrame = aim(endPos + normal * 0.1, normal)
		glow.CFrame = endPart.CFrame
	end

	local function doStop(t: number)
		if stopT then
			return
		end
		stopT = t
		sparksAlive = setStream(fx, sparks, 0, sparksAlive)
		burst(fx, sparkEmitter(fx, hitAtt, s, 80, { 16, 30 }), 14)
		burst(fx, flashEmitter(fx, hitAtt, 2.2 * W, pal.hot), 1)
		if opts.onEnd then
			task.spawn(opts.onEnd)
		end
	end

	local function setWidth(k: number, t: number)
		local wob = 1 + 0.08 * math.sin(t * 31)
		outer.Width0, outer.Width1 = W * k * wob, W * 0.85 * k * wob
		core.Width0, core.Width1 = W * 0.28 * k, W * 0.24 * k
		if edge then
			edge.Width0, edge.Width1 = W * 1.35 * k * wob, W * 1.15 * k * wob
		end
	end

	fx.step = function(t: number, _dt: number): boolean?
		lastT = t
		if not fromAtt:IsDescendantOf(Workspace) then
			return true
		end
		local from = fromAtt.WorldPosition
		updateEnd()
		local st = stopT
		if st then
			local u = (t - st) / 0.12
			setWidth(1 - easeIn(u, 1.5), t)
			glow.Transparency = lerp(0.2, 1, clamp01(u))
			light.Brightness = 2 * (1 - clamp01((t - st) / 0.2))
			if u &gt;= 1 then
				outer.Enabled = false
				core.Enabled = false
				if edge then
					edge.Enabled = false
				end
			end
			return t - st &gt; 0.6
		end
		if t &lt; chargeT then
			local u = t / chargeT
			chargeShell.CFrame = CFrame.new(from)
			orb.CFrame = CFrame.new(from + dir * 0.6 * s)
			orb.Size = Vector3.one * math.max(0.05, 0.55 * W * easeIn(u, 1.6))
			orb.Transparency = lerp(0.6, 0, u)
			local want = math.floor(u * 3)
			while pulses &lt;= want and pulses &lt; 3 do
				pulses += 1
				burst(fx, converge, 5)
			end
			return nil
		end
		local bt: number = beamT or t
		if not beamT then
			beamT = t
			orb.Transparency = 1
			outer.Enabled = true
			core.Enabled = true
			if edge then
				edge.Enabled = true
			end
			sparksAlive = setStream(fx, sparks, 30, sparksAlive)
			burst(fx, flashEmitter(fx, worldAttachment(fx, "Muzzle", CFrame.new(from)), 1.4 * W, pal.hot), 1)
		end
		local bu = t - bt
		setWidth(easeOut(bu / 0.08, 2), t)
		local pulse = 0.5 + 0.5 * math.sin(t * 18)
		glow.Transparency = lerp(0.35, 0.15, pulse)
		glow.Size = Vector3.one * 1.6 * W * (0.9 + 0.2 * pulse)
		light.Brightness = 1.6 + 0.6 * pulse
		if opts.duration and bu &gt;= opts.duration then
			doStop(t)
		end
		return nil
	end

	start(fx)
	local h = baseHandle(fx)
	h.SetTarget = function(_self: any, newTo: Vector3 | Attachment)
		goal = newTo
	end
	h.Stop = function(_self: any)
		if not fx.finished then
			doStop(lastT)
		end
	end
	return h
end

-------------------------------------------------------------------------------
-- Heal / Buff pickups (on a character)
-------------------------------------------------------------------------------
export type PickupOptions = CommonOptions &amp; {
	duration: number?, -- seconds of rising motes (default 0.9)
}

local function pickup(kind: string, character: Model, opts: PickupOptions): Handle
	local root = rootOf(character)
	if not root then
		return deadHandle()
	end
	local motesFor = math.max(0.2, opts.duration or 0.9)
	local fx = admit(kind, root.Position, opts, if kind == "Heal" then "heal" else "holy", false, motesFor + 1.3)
	if not fx then
		return deadHandle()
	end
	local pal, s = fx.pal, fx.scale
	local feet = feetOffset(character, root)
	local feetAtt = newAttachment(kind .. "Feet", root, CFrame.new(0, feet + 0.2, 0))
	local chestAtt = newAttachment(kind .. "Chest", root, CFrame.new(0, 0.6, 0))
	table.insert(fx.cleanup, function()
		feetAtt:Destroy()
		chestAtt:Destroy()
	end)

	local motes = newEmitter(feetAtt, "glow_soft", {
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(40, 40),
		Speed = NumberRange.new(3 * s, 6 * s),
		Acceleration = Vector3.new(0, 2 * s, 0),
		Drag = 1,
		Lifetime = NumberRange.new(0.8, 1.2),
		Size = ns({ { 0, 0 }, { 0.2, 0.32 * s }, { 1, 0 } }),
		Transparency = ns({ { 0, 0.1 }, { 0.7, 0.2 }, { 1, 1 } }),
		Color = cs({ { 0, pal.main }, { 1, pal.hot } }),
		LightEmission = 1,
		LockedToPart = true,
	}, true)
	local steps: { (t: number) -&gt; () } = {}
	local base = CFrame.new(0, feet + 0.06, 0)

	if kind == "Heal" then
		-- ring expands out from the feet; faint ground disc under it (decoration)
		local ring = newDisc(fx.root, root, base * CFrame.new(0, 0.02, 0), 1.2 * s, 0.5 * s, pal.main:Lerp(pal.hot, 0.3), 0.15)
		table.insert(steps, ringStep(ring, 0, 0.55, 1.2 * s, 4.5 * s, 0.5 * s, 0.1 * s, 0.15))
		if fx.deco then
			local disc = newDisc(fx.root, root, base, 3.2 * s, 0, pal.main, 0.7)
			table.insert(steps, function(t: number)
				disc.Transparency = lerp(0.7, 1, easeOut(t / 0.7, 2))
			end)
		end
		local glints = newEmitter(chestAtt, "flash_hot", {
			SpreadAngle = Vector2.new(180, 180),
			Speed = NumberRange.new(2 * s, 4 * s),
			Drag = 3,
			Lifetime = NumberRange.new(0.4, 0.6),
			Size = ns({ { 0, 0 }, { 0.3, 0.45 * s }, { 1, 0 } }),
			Rotation = NumberRange.new(0, 360),
			Color = ColorSequence.new(pal.spark),
			LightEmission = 1,
			LockedToPart = true,
		}, true)
		local glinted = false
		table.insert(steps, function(t: number)
			if not glinted and t &gt;= 0.15 then
				glinted = true
				burst(fx, glints, 6)
			end
		end)
	else
		-- Buff: ring implodes onto the feet, then a small bright pop ring; streaks shoot upward
		local ring = newDisc(fx.root, root, base * CFrame.new(0, 0.02, 0), 4.5 * s, 0.15 * s, pal.main:Lerp(pal.hot, 0.3), 0.6)
		table.insert(steps, function(t: number)
			local u = t / 0.32
			ring.Visible = u &lt;= 1
			setDisc(ring, lerp(4.5, 1.1, easeIn(u, 2)) * s, lerp(0.15, 0.45, u) * s)
			ring.Transparency = lerp(0.6, 0.05, u)
		end)
		local pop = newDisc(fx.root, root, base * CFrame.new(0, 0.03, 0), 1 * s, 0.4 * s, pal.hot, 0)
		table.insert(steps, ringStep(pop, 0.32, 0.3, 1 * s, 2.8 * s, 0.4 * s, 0.06 * s, 0))
		local streaks = newEmitter(feetAtt, "spark_streak", {
			EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(18, 18),
			Speed = NumberRange.new(10 * s, 14 * s),
			Drag = 1.5,
			Lifetime = NumberRange.new(0.35, 0.5),
			Orientation = Enum.ParticleOrientation.VelocityParallel,
			Size = ns({ { 0, 0.3 * s }, { 1, 0 } }),
			Transparency = ns({ { 0, 0 }, { 1, 1 } }),
			Color = cs({ { 0, pal.hot }, { 1, pal.main } }),
			LightEmission = 1,
			LockedToPart = true,
		}, true)
		local shots = 0
		table.insert(steps, function(t: number)
			while shots &lt; 3 and t &gt;= 0.32 + shots * 0.08 do
				shots += 1
				burst(fx, streaks, 5)
			end
		end)
	end

	local pulsesDone = 0
	local pulseCount = math.max(1, math.floor(motesFor / 0.08))
	fx.step = function(t: number, _dt: number): boolean?
		if not root.Parent then
			return true
		end
		while pulsesDone &lt; pulseCount and t &gt;= pulsesDone * 0.08 do
			pulsesDone += 1
			burst(fx, motes, 3)
		end
		for _, f in steps do
			f(t)
		end
		return nil
	end
	start(fx)
	return baseHandle(fx)
end

function Abilities.Heal(character: Model, options: PickupOptions?): Handle
	local o: PickupOptions = options or {}
	return pickup("Heal", character, o)
end

function Abilities.Buff(character: Model, options: PickupOptions?): Handle
	local o: PickupOptions = options or {}
	return pickup("Buff", character, o)
end

-------------------------------------------------------------------------------
-- Teleport
-------------------------------------------------------------------------------
export type TeleportOptions = CommonOptions &amp; {
	delay: number?, -- seconds between the implode and the arrival burst (default 0.25)
}

function Abilities.Teleport(fromCF: CFrame, toCF: CFrame, options: TeleportOptions?): Handle
	local opts: TeleportOptions = options or {}
	local delay = math.max(0, opts.delay or 0.25)
	local fx = admit("Teleport", toCF.Position, opts, "violet", false, delay + 1.2)
	if not fx then
		return deadHandle()
	end
	local pal, s = fx.pal, fx.scale
	local steps: { (t: number) -&gt; () } = {}

	-- source: imploding ring + converging motes + thin column that collapses
	local gpA, gnA = groundAt(fromCF.Position)
	local srcGround = newPart("SrcGround", surfaceFrame(gpA + gnA * 0.05, gnA, fromCF.LookVector), fx.root)
	local implode = newDisc(fx.root, srcGround, CFrame.identity, 4 * s, 0.2 * s, pal.main:Lerp(pal.hot, 0.3), 0.4)
	table.insert(steps, function(t: number)
		local u = t / 0.25
		implode.Visible = u &lt;= 1
		setDisc(implode, lerp(4, 0.3, easeIn(u, 2)) * s, lerp(0.2, 0.3, u) * s)
		implode.Transparency = lerp(0.4, 0, u)
	end)
	local shellA = newPart("SrcShell", CFrame.new(fromCF.Position), fx.root)
	shellA.Size = Vector3.one * 7 * s
	local converge = newEmitter(shellA, "glow_soft", {
		Shape = Enum.ParticleEmitterShape.Sphere,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		Speed = NumberRange.new(13 * s, 15 * s),
		Lifetime = NumberRange.new(0.22, 0.25),
		Size = ns({ { 0, 0.15 * s }, { 1, 0.35 * s } }),
		Transparency = ns({ { 0, 1 }, { 0.3, 0.1 }, { 1, 0.3 } }),
		Color = cs({ { 0, pal.main }, { 1, pal.hot } }),
		LightEmission = 1,
	}, true)
	burst(fx, converge, 20)
	local colA = neonPart("SrcColumn", Enum.PartType.Cylinder, pal.hot, vertical(CFrame.new(fromCF.Position)), fx.root)
	table.insert(steps, function(t: number)
		local u = t / 0.25
		colA.Transparency = if u &gt; 1 then 1 else lerp(0.5, 0.1, u)
		colA.Size = Vector3.new(7 * s, math.max(0.05, lerp(1.2, 0.08, easeIn(u, 1.5)) * s), math.max(0.05, lerp(1.2, 0.08, easeIn(u, 1.5)) * s))
	end)

	-- destination: flash, column burst, expanding ring, sparks up, dust (texture only), one light
	local gpB, gnB = groundAt(toCF.Position)
	local dstGround = newPart("DstGround", surfaceFrame(gpB + gnB * 0.05, gnB, toCF.LookVector), fx.root)
	local dstAtt = newAttachment("Dst", fx.anchor)
	dstAtt.WorldCFrame = aim(gpB + gnB * 0.3, gnB)
	local flash = flashEmitter(fx, worldAttachment(fx, "DstFlash", CFrame.new(toCF.Position + Vector3.new(0, 0.5, 0))), 3 * s, pal.hot)
	local sparks = sparkEmitter(fx, dstAtt, s, 35, { 20, 36 })
	local dust = if fx.deco
		then newEmitter(dstAtt, "smoke_puff", {
			EmissionDirection = Enum.NormalId.Front,
			SpreadAngle = Vector2.new(85, 85),
			Speed = NumberRange.new(6 * s, 10 * s),
			Drag = 4,
			Lifetime = NumberRange.new(0.5, 0.8),
			Size = ns({ { 0, 0.8 * s }, { 1, 2.2 * s } }),
			Transparency = ns({ { 0, 0.5 }, { 1, 1 } }),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-60, 60),
			Color = ColorSequence.new(pal.main:Lerp(pal.dark, 0.6)),
			LightEmission = 0,
		}, false)
		else nil
	local colB = neonPart("DstColumn", Enum.PartType.Cylinder, pal.main:Lerp(pal.hot, 0.4), vertical(CFrame.new(gpB + Vector3.new(0, 4.5 * s, 0))), fx.root)
	colB.Transparency = 1
	local ringB = newDisc(fx.root, dstGround, CFrame.identity, 0.5 * s, 0.4 * s, pal.main:Lerp(pal.hot, 0.3), 0.1)
	ringB.Visible = false
	table.insert(steps, ringStep(ringB, delay, 0.4, 0.5 * s, 6 * s, 0.45 * s, 0.08 * s, 0.1))
	local ringDark = if fx.deco then newDisc(fx.root, dstGround, CFrame.new(0, -0.01, 0), 0.7 * s, 0.5 * s, pal.dark, 0.4) else nil
	if ringDark then
		ringDark.Visible = false
		table.insert(steps, ringStep(ringDark, delay + 0.04, 0.5, 0.7 * s, 7 * s, 0.5 * s, 0.1 * s, 0.4))
	end
	local light = newLight(worldAttachment(fx, "DstLight", CFrame.new(toCF.Position + Vector3.new(0, 4, 0))), pal.glow, 0, 14 * s)
	local arrived = false
	table.insert(steps, function(t: number)
		local u = (t - delay) / 0.32
		if u &lt; 0 then
			return
		end
		if not arrived then
			arrived = true
			burst(fx, flash, 1)
			burst(fx, sparks, 22)
			burst(fx, dust, 6)
		end
		local w = if u &lt; 0.3 then lerp(0.2, 1.4, easeOut(u / 0.3, 2)) else lerp(1.4, 0.05, easeIn((u - 0.3) / 0.7, 1.5))
		colB.Size = Vector3.new(9 * s * lerp(0.6, 1, easeOut(u, 2)), math.max(0.05, w * s), math.max(0.05, w * s))
		colB.Transparency = if u &gt;= 1 then 1 else lerp(0.1, 0.8, easeIn(u, 1.5))
		light.Brightness = 3 * (1 - easeOut((t - delay) / 0.3, 2))
	end)

	fx.step = function(t: number, _dt: number): boolean?
		for _, f in steps do
			f(t)
		end
		return nil
	end
	start(fx)
	return baseHandle(fx)
end

-------------------------------------------------------------------------------
-- LevelUp (celebration, not combat)
-------------------------------------------------------------------------------
export type LevelUpOptions = CommonOptions &amp; {
	light: boolean?, -- default true (one light above the head)
}

function Abilities.LevelUp(character: Model, options: LevelUpOptions?): Handle
	local opts: LevelUpOptions = options or {}
	if opts.important == nil and Players.LocalPlayer and character == Players.LocalPlayer.Character then
		opts = table.clone(opts)
		opts.important = true
	end
	local root = rootOf(character)
	if not root then
		return deadHandle()
	end
	local fx = admit("LevelUp", root.Position, opts, "holy", false, 2.2)
	if not fx then
		return deadHandle()
	end
	local pal, s = fx.pal, fx.scale
	local feet = feetOffset(character, root)
	local head = 2.2 -- studs above the root centre to the top of the head (R15 and R6)
	local made: { Instance } = {}
	table.insert(fx.cleanup, function()
		for _, inst in made do
			inst:Destroy()
		end
	end)
	local function att(name: string, cf: CFrame): Attachment
		local a = newAttachment(name, root, cf)
		table.insert(made, a)
		return a
	end
	local feetAtt = att("LvlFeet", CFrame.new(0, feet + 0.2, 0))
	local headAtt = att("LvlHead", CFrame.new(0, head, 0))
	local steps: { (t: number) -&gt; () } = {}
	local base = CFrame.new(0, feet + 0.06, 0)

	-- 1. two foot rings: a slower body ring, then a bigger, faster, thinner hot ring (escalation)
	local r1 = newDisc(fx.root, root, base * CFrame.new(0, 0.01, 0), 1 * s, 0.6 * s, pal.main, 0.15)
	table.insert(steps, ringStep(r1, 0, 0.6, 1 * s, 7 * s, 0.6 * s, 0.12 * s, 0.15))
	local r2 = newDisc(fx.root, root, base * CFrame.new(0, 0.02, 0), 1 * s, 0.25 * s, pal.hot, 0)
	r2.Visible = false
	table.insert(steps, ringStep(r2, 0.12, 0.45, 1 * s, 10 * s, 0.25 * s, 0.05 * s, 0))
	-- 2. scan ring: rises from the feet to above the head and widens (a rim around the body, no wash)
	local scan = newDisc(fx.root, root, base, 2 * s, 0.18 * s, pal.hot:Lerp(pal.main, 0.3), 0.1)
	table.insert(steps, function(t: number)
		local u = t / 0.55
		scan.Visible = u &lt;= 1
		local y = lerp(feet + 0.1, head + 1.2, easeOut(u, 2))
		scan.CFrame = CFrame.new(0, y, 0) * FLAT
		setDisc(scan, lerp(2, 2.8, u) * s, 0.18 * s)
		scan.Transparency = lerp(0.1, 1, easeIn(u, 2))
	end)
	-- 3. light pillar above the head (visible from far away, leaves the character clear)
	local pillar = neonPart("Pillar", Enum.PartType.Cylinder, pal.main, CFrame.new(), fx.root)
	local pillarCore = neonPart("PillarCore", Enum.PartType.Cylinder, pal.hot, CFrame.new(), fx.root)
	table.insert(steps, function(t: number)
		local hp = root.Position + Vector3.new(0, head + 1, 0)
		local grow = easeOut(t / 0.25, 3)
		local thin = 1 - easeIn((t - 0.15) / 0.85, 1.4)
		local h = math.max(0.1, 15 * s * grow)
		pillar.CFrame = vertical(CFrame.new(hp + Vector3.new(0, h * 0.5, 0)))
		pillarCore.CFrame = pillar.CFrame
		pillar.Size = Vector3.new(h, math.max(0.05, 1.5 * s * thin), math.max(0.05, 1.5 * s * thin))
		pillarCore.Size = Vector3.new(h, math.max(0.05, 0.45 * s * thin), math.max(0.05, 0.45 * s * thin))
		pillar.Transparency = if thin &lt;= 0 then 1 else lerp(0.45, 0.85, 1 - thin)
		pillarCore.Transparency = if thin &lt;= 0 then 1 else lerp(0, 0.5, 1 - thin)
	end)
	-- 4. sparkles fountain up and fall; confetti flecks tumble (decoration); motes rise round the body
	local sparkles = newEmitter(headAtt, "flash_hot", {
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(28, 28),
		Speed = NumberRange.new(22 * s, 36 * s),
		Acceleration = Vector3.new(0, -32, 0),
		Drag = 1.4,
		Lifetime = NumberRange.new(1.1, 1.6),
		Size = ns({ { 0, 0.5 * s }, { 0.5, 0.35 * s }, { 1, 0 } }),
		Transparency = ns({ { 0, 0 }, { 0.75, 0.1 }, { 1, 1 } }),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-180, 180),
		Color = cs({ { 0, pal.hot }, { 1, pal.spark } }),
		LightEmission = 1,
	}, true)
	local confetti = if fx.deco
		then newEmitter(headAtt, "spark_square", {
			EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(40, 40),
			Speed = NumberRange.new(18 * s, 28 * s),
			Acceleration = Vector3.new(0, -26, 0),
			Drag = 2,
			Lifetime = NumberRange.new(1.2, 1.7),
			Size = ns({ { 0, 0.22 * s }, { 1, 0.16 * s } }),
			Transparency = ns({ { 0, 0 }, { 0.85, 0 }, { 1, 1 } }),
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-500, 500),
			Color = cs({ { 0, pal.main }, { 0.5, pal.spark }, { 1, pal.main:Lerp(pal.dark, 0.4) } }),
			LightEmission = 0.3,
		}, true)
		else nil
	local motes = newEmitter(feetAtt, "glow_soft", {
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(55, 55),
		Speed = NumberRange.new(3 * s, 6 * s),
		Acceleration = Vector3.new(0, 2, 0),
		Drag = 1,
		Lifetime = NumberRange.new(0.9, 1.3),
		Size = ns({ { 0, 0 }, { 0.2, 0.3 * s }, { 1, 0 } }),
		Transparency = ns({ { 0, 0.1 }, { 1, 1 } }),
		Color = cs({ { 0, pal.main }, { 1, pal.hot } }),
		LightEmission = 1,
		LockedToPart = true,
	}, true)
	local fired = false
	local motePulses = 0
	table.insert(steps, function(t: number)
		if not fired and t &gt;= 0.08 then
			fired = true
			burst(fx, sparkles, 30)
			burst(fx, confetti, 16)
		end
		while motePulses &lt; 10 and t &gt;= motePulses * 0.12 do
			motePulses += 1
			burst(fx, motes, 3)
		end
	end)
	-- 5. one light above the head
	if opts.light ~= false then
		local l = newLight(att("LvlLight", CFrame.new(0, head + 3, 0)), pal.glow, 0, 16 * s)
		table.insert(made, l)
		table.insert(steps, function(t: number)
			l.Brightness = 2.5 * easeOut(t / 0.08, 2) * (1 - easeOut((t - 0.1) / 0.8, 2))
		end)
	end

	fx.step = function(t: number, _dt: number): boolean?
		if not root.Parent then
			return true
		end
		for _, f in steps do
			f(t)
		end
		return nil
	end
	start(fx)
	return baseHandle(fx)
end

-------------------------------------------------------------------------------
-- Game feel: camera shake (local camera only)
-------------------------------------------------------------------------------
export type ShakeOptions = {
	position: Vector3?, -- world source: falls off with distance from the camera (smoothstep)
	near: number?, -- full strength inside this many studs (default 30)
	far: number?, -- nothing beyond this many studs (default 150)
	frequency: number?, -- Hz of the noise (default 16)
}

type Shake = { amp: number, t0: number, dur: number, freq: number, seed: number }
local shakes: { Shake } = {}
local SHAKE_BIND = "LihFolkAbilityShake"
local shakeBound = false
local MAX_PITCH = math.rad(1.6)
local MAX_YAW = math.rad(1.6)
local MAX_ROLL = math.rad(0.9)

local function shakeStep()
	local cam = Workspace.CurrentCamera
	local now = os.clock()
	local p: number = 0
	local y: number = 0
	local r: number = 0
	for i = #shakes, 1, -1 do
		local sh = shakes[i]
		local u = (now - sh.t0) / sh.dur
		if u &gt;= 1 then
			table.remove(shakes, i)
		else
			-- trauma model: amplitude decays, felt shake = trauma squared
			local k = (sh.amp * (1 - u)) ^ 2
			local tt = (now - sh.t0) * sh.freq
			p += k * math.noise(sh.seed, tt, 0.5)
			y += k * math.noise(sh.seed + 17.3, tt, 0.5)
			r += k * math.noise(sh.seed + 41.7, tt, 0.5)
		end
	end
	if cam and #shakes &gt; 0 then
		local pitch = math.clamp(p, -1, 1) * MAX_PITCH
		local yaw = math.clamp(y, -1, 1) * MAX_YAW
		local roll = math.clamp(r, -1, 1) * MAX_ROLL
		cam.CFrame = cam.CFrame * CFrame.Angles(pitch, yaw, roll)
	end
	if #shakes == 0 and shakeBound then
		shakeBound = false
		RunService:UnbindFromRenderStep(SHAKE_BIND)
	end
end

--[[ Shake the local camera. intensity 0..1 (0.12 medium hit, 0.35 finisher, 0.6 ultimate), duration in
	seconds (0.15-0.4). Applied after the camera scripts each frame, so it never accumulates.
	Config.reducedMotion turns it off; Config.shakeScale scales it. Only the local camera moves. ]]
function Abilities.CameraShake(intensity: number, duration: number, options: ShakeOptions?)
	local cfg = Abilities.Config
	if cfg.reducedMotion or intensity &lt;= 0 or duration &lt;= 0 then
		return
	end
	local opts: ShakeOptions = options or {}
	local amp = math.clamp(intensity, 0, 1) * math.clamp(cfg.shakeScale, 0, 1)
	local cam = Workspace.CurrentCamera
	if opts.position and cam then
		local near, far = opts.near or 30, opts.far or 150
		local d = (cam.CFrame.Position - opts.position).Magnitude
		local u = clamp01((d - near) / math.max(1, far - near))
		amp *= 1 - u * u * (3 - 2 * u)
	end
	if amp &lt;= 0.01 then
		return
	end
	table.insert(shakes, { amp = amp, t0 = os.clock(), dur = duration, freq = opts.frequency or 16, seed = math.random() * 100 })
	if not shakeBound then
		shakeBound = true
		RunService:BindToRenderStep(SHAKE_BIND, Enum.RenderPriority.Camera.Value + 1, shakeStep)
	end
end

-------------------------------------------------------------------------------
-- Game feel: hit-stop (AnimationTrack freeze, then restore)
-------------------------------------------------------------------------------
export type HitStopOptions = {
	speed: number?, -- playback speed during the stop (default 0 = freeze)
	catchUp: boolean?, -- afterwards play faster for the same time so the clip ends on schedule (default false)
}

type Frozen = { speed: number, token: number }
local frozen: { [AnimationTrack]: Frozen } = setmetatable({}, { __mode = "k" }) :: any
local stopToken = 0

--[[ Freeze tracks for `duration` seconds (50-90 ms is the usual range; capped by Config.maxHitStop),
	then restore the speed each track had before the first overlapping stop. Accepts one track, a list,
	or an Animator (all playing tracks). Does nothing under Config.reducedMotion. ]]
function Abilities.HitStop(tracks: AnimationTrack | { AnimationTrack } | Animator, duration: number, options: HitStopOptions?)
	local cfg = Abilities.Config
	if cfg.reducedMotion or duration &lt;= 0 then
		return
	end
	local opts: HitStopOptions = options or {}
	local d = math.min(duration, cfg.maxHitStop)
	local list: { AnimationTrack }
	if typeof(tracks) == "Instance" then
		if tracks:IsA("Animator") then
			list = tracks:GetPlayingAnimationTracks()
		elseif tracks:IsA("AnimationTrack") then
			list = { tracks }
		else
			return
		end
	else
		list = tracks :: { AnimationTrack }
	end
	stopToken += 1
	local token = stopToken
	local slow = math.max(0, opts.speed or 0)
	for _, tr in list do
		if tr.IsPlaying then
			local f = frozen[tr]
			if f then
				f.token = token -- overlapping stop: keep the original speed, extend the freeze
			else
				frozen[tr] = { speed = tr.Speed, token = token }
			end
			tr:AdjustSpeed(slow)
		end
	end
	task.delay(d, function()
		for _, tr in list do
			local f = frozen[tr]
			if f and f.token == token then
				frozen[tr] = nil
				if tr.IsPlaying then
					if opts.catchUp and f.speed &gt; 0 then
						-- run fast for the same time to land the clip back on schedule
						tr:AdjustSpeed(f.speed * (2 - slow))
						task.delay(d, function()
							if tr.IsPlaying and frozen[tr] == nil then
								tr:AdjustSpeed(f.speed)
							end
						end)
					else
						tr:AdjustSpeed(f.speed)
					end
				end
			end
		end
	end)
end

-------------------------------------------------------------------------------
-- Replication: replay a compact server broadcast (presetId, cf, elementIndex, seed, aux)
-------------------------------------------------------------------------------
--[[ Clients call this from the RemoteEvent handler. The caster already played the effect locally
	(prediction) and skips its own echo. Returns the handle, or nil for a bad payload. ]]
function Abilities.playPayload(caster: Player?, presetId: number, cf: CFrame, elementIndex: number, seed: number, aux: Vector3?): Handle?
	if type(presetId) ~= "number" or typeof(cf) ~= "CFrame" then
		return nil
	end
	local name = Abilities.PresetIds[presetId]
	local element = Abilities.ElementIds[if type(elementIndex) == "number" then elementIndex else 1]
	if not name or not element then
		return nil
	end
	local base = Abilities.PayloadDefaults[name] or {}
	local opts: any = table.clone(base)
	opts.element = element
	opts.seed = if type(seed) == "number" then seed else nil
	local auxPos: Vector3? = if typeof(aux) == "Vector3" then aux else nil
	local character = caster and caster.Character
	if name == "Projectile" then
		opts.ignore = if character then { character } else nil
		return Abilities.Projectile(cf, auxPos, opts)
	elseif name == "TelegraphCircle" then
		return Abilities.Telegraph(cf, "circle", opts)
	elseif name == "TelegraphCone" then
		return Abilities.Telegraph(cf, "cone", opts)
	elseif name == "TelegraphLine" then
		return Abilities.Telegraph(cf, "line", opts)
	elseif name == "Teleport" then
		local dest = auxPos or cf.Position
		return Abilities.Teleport(cf, CFrame.new(dest) * cf.Rotation, opts)
	elseif character then
		if name == "Heal" then
			return Abilities.Heal(character, opts)
		elseif name == "Buff" then
			return Abilities.Buff(character, opts)
		elseif name == "LevelUp" then
			return Abilities.LevelUp(character, opts)
		end
	end
	return nil
end

function Abilities.presetIndex(name: string): number?
	return table.find(Abilities.PresetIds, name)
end

function Abilities.elementIndex(name: string): number?
	return table.find(Abilities.ElementIds, name)
end

-------------------------------------------------------------------------------
-- Housekeeping
-------------------------------------------------------------------------------
function Abilities.setQuality(q: number)
	Abilities.Config.quality = math.clamp(q, 0.25, 1)
end

function Abilities.liveParticles(): number
	return live
end

function Abilities.preload()
	local ids: { string } = {}
	for key in Abilities.Textures :: any do
		local id = texId(key)
		if id then
			table.insert(ids, id)
		end
	end
	if #ids &gt; 0 then
		task.spawn(function()
			local ok, err = pcall(function()
				ContentProvider:PreloadAsync(ids)
			end)
			if not ok then
				warn("[LihFolkVFX_Abilities] preload failed: " .. tostring(err))
			end
		end)
	end
end

-- Stop and remove every live effect (scene change, death, teleport)
function Abilities.clear()
	for _, fx in active do
		finish(fx)
	end
	table.clear(active)
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	table.clear(shakes)
end

return Abilities
