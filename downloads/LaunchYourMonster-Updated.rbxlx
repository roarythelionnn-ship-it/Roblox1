            <ProtectedString name="Source">-- FlightSim: deterministic arcade projectile simulation in course-local coordinates.
-- The server runs it authoritatively; the owning client runs the same code to predict
-- smoothly and gets corrected by server snapshots. Pure module (runs under Lune).
-- Collisions are analytic swept-segment tests against WorldConfig data, so fast
-- monsters can never tunnel through rings or pads.

local GameConfig = require(script.Parent.GameConfig)

local F = GameConfig.Flight

local FlightSim = {}

export type Params = {
	speed: number,
	angle: number, -- degrees
	boostLevel: number,
	bounceLevel: number,
	magnetLevel: number,
	petBounce: number?,
}

export type Event = { kind: string, index: number?, perfect: boolean?, x: number?, y: number?, z: number? }

function FlightSim.new(world, params: Params)
	local angle = math.rad(math.clamp(params.angle, F.MinAngle, F.MaxAngle))
	return {
		x = world.muzzle[1],
		y = world.muzzle[2],
		z = world.muzzle[3],
		vx = 0,
		vy = math.sin(angle) * params.speed,
		vz = math.cos(angle) * params.speed,
		t = 0,
		acc = 0,
		phase = "FLYING", -- FLYING -&gt; SLIDING -&gt; DONE
		params = params,
		steer = 0,
		boosted = false,
		bounces = 0,
		skips = 0,
		perfectBounces = 0,
		rings = {},
		ringCount = 0,
		perfectUntil = -1, -- tap before this time upgrades the last bounce
		bounceUpgraded = true,
		pendingTapAt = -math.huge,
		endReason = nil :: string?,
	}
end

function FlightSim.setSteer(state, value: number)
	if value ~= value then
		value = 0
	end
	state.steer = math.clamp(value, -1, 1)
end

function FlightSim.boost(state): boolean
	if state.boosted or state.phase ~= "FLYING" then
		return false
	end
	state.boosted = true
	local impulse = GameConfig.boostImpulse(state.params.boostLevel)
	state.vy = math.max(state.vy, 0) + impulse * F.BoostUp
	state.vz += impulse * F.BoostForward
	return true
end

local function applyPerfect(state)
	state.vy *= F.PerfectBounceVertical
	state.vz *= F.PerfectBounceForward
	state.perfectBounces += 1
	state.bounceUpgraded = true
end

-- Returns true when the tap turned the latest bounce into a Perfect Bounce.
function FlightSim.tapBounce(state): boolean
	if state.phase ~= "FLYING" then
		return false
	end
	if not state.bounceUpgraded and state.t &lt;= state.perfectUntil then
		applyPerfect(state)
		return true
	end
	state.pendingTapAt = state.t -- early tap, consumed by the next contact
	return false
end

local function capSpeed(state)
	local speed = math.sqrt(state.vx * state.vx + state.vy * state.vy + state.vz * state.vz)
	if speed &gt; F.SpeedCap then
		local k = F.SpeedCap / speed
		state.vx *= k
		state.vy *= k
		state.vz *= k
	end
end

local function finish(state, reason: string, events: { Event })
	state.phase = "DONE"
	state.endReason = reason
	table.insert(events, { kind = "end", x = state.x, y = state.y, z = state.z })
end

local function stepOnce(state, world, dt: number, events: { Event })
	local p = state.params
	local px, py, pz = state.x, state.y, state.z
	local R = F.Radius

	if state.phase == "SLIDING" then
		local horizontal = math.sqrt(state.vx * state.vx + state.vz * state.vz)
		local slowed = math.max(0, horizontal - F.SlideFriction * dt)
		if slowed &lt; 1 then
			state.vx, state.vz = 0, 0
			finish(state, "landed", events)
			return
		end
		local k = slowed / horizontal
		state.vx *= k
		state.vz *= k
		state.x += state.vx * dt
		state.z += state.vz * dt
	else
		-- Forces: gravity, drag, steering, wind tunnels
		state.vy -= F.Gravity * dt
		local drag = 1 - F.Drag * dt
		state.vy *= drag
		state.vz *= drag
		if state.steer ~= 0 then
			state.vx += state.steer * F.SteerAccel * dt
		else
			state.vx *= 1 - 2.5 * dt
		end
		state.vx = math.clamp(state.vx, -F.SteerMaxSpeed, F.SteerMaxSpeed)
		for _, t in world.tunnels do
			if math.abs(px - t.x) &lt;= t.sx / 2 and math.abs(py - t.y) &lt;= t.sy / 2 and math.abs(pz - t.z) &lt;= t.sz / 2 then
				state.vx += t.ax * dt
				state.vy += t.ay * dt
				state.vz += t.az * dt
			end
		end
		capSpeed(state)
		state.x += state.vx * dt
		state.y += state.vy * dt
		state.z += state.vz * dt
	end

	-- Lane bounds and ceiling (soft walls, never invisible stops)
	if math.abs(state.x) &gt; world.laneHalf then
		state.x = math.sign(state.x) * world.laneHalf
		state.vx = 0
	end
	if state.y &gt; F.Ceiling then
		state.y = F.Ceiling
		state.vy = math.min(state.vy, 0)
	end

	-- Rings: swept crossing of the ring plane (z = ring.z)
	local magnet = (p.magnetLevel or 0) * F.MagnetPerLevel
	for index, r in world.rings do
		if not state.rings[index] and pz &lt; r.z and state.z &gt;= r.z then
			local f = (r.z - pz) / (state.z - pz)
			local cx = px + (state.x - px) * f
			local cy = py + (state.y - py) * f
			local dx, dy = cx - r.x, cy - r.y
			if dx * dx + dy * dy &lt;= (r.r + magnet + R) ^ 2 then
				state.rings[index] = true
				state.ringCount += 1
				state.vz += F.RingSpeedBonus
				table.insert(events, { kind = "ring", index = index, x = r.x, y = r.y, z = r.z })
			end
		end
	end

	if state.phase ~= "FLYING" then
		if state.z &gt;= world.length then
			state.z = world.length
			finish(state, "finish", events)
		end
		return
	end

	-- Bounce pads: descending crossing of the pad's top plane inside its rectangle
	if state.vy &lt; 0 and state.bounces &lt; F.MaxBounces then
		for _, pad in world.pads do
			local top = pad.y + R
			if py &gt;= top and state.y &lt; top then
				local f = (py - top) / (py - state.y)
				local cx = px + (state.x - px) * f
				local cz = pz + (state.z - pz) * f
				if math.abs(cx - pad.x) &lt;= pad.w / 2 and math.abs(cz - pad.z) &lt;= pad.d / 2 then
					local retention = (pad.retention or F.BounceVertical)
						+ F.BounceTechPerLevel * (p.bounceLevel or 0)
						+ (p.petBounce or 0)
					state.y = top
					state.vy = math.max(-state.vy * retention, 18)
					state.vz *= F.BounceForward
					state.bounces += 1
					state.bounceUpgraded = false
					state.perfectUntil = state.t + F.BounceWindow
					local perfect = state.t - state.pendingTapAt &lt;= F.BounceWindow
					if perfect then
						applyPerfect(state)
						state.pendingTapAt = -math.huge
					end
					capSpeed(state)
					table.insert(events, { kind = "bounce", perfect = perfect, x = cx, y = pad.y, z = cz })
					break
				end
			end
		end
	end

	-- Ground: skip a couple of times, then slide to a stop
	local floor = world.groundY + R
	if state.y &lt;= floor then
		state.y = floor
		local fall = -state.vy
		if fall &gt; F.SkipMinFallSpeed and state.skips &lt; F.MaxSkips then
			state.vy = fall * F.SkipVertical
			state.vz *= F.SkipForward
			state.skips += 1
			table.insert(events, { kind = "skip", x = state.x, y = world.groundY, z = state.z })
		else
			state.vy = 0
			state.phase = "SLIDING"
			table.insert(events, { kind = "land", x = state.x, y = world.groundY, z = state.z })
		end
	end

	if state.z &gt;= world.length then
		state.z = world.length
		finish(state, "finish", events)
	end
end

-- Advances by real elapsed time using fixed steps; returns the events produced.
function FlightSim.advance(state, world, elapsed: number): { Event }
	local events = {}
	if state.phase == "DONE" then
		return events
	end
	state.acc = math.min(state.acc + elapsed, F.Step * F.MaxCatchUpSteps)
	while state.acc &gt;= F.Step and state.phase ~= "DONE" do
		state.acc -= F.Step
		state.t += F.Step
		stepOnce(state, world, F.Step, events)
		if state.phase ~= "DONE" and state.t &gt;= F.MaxDuration then
			finish(state, "timeout", events)
		end
	end
	return events
end

function FlightSim.distance(state): number
	return math.max(0, math.floor(state.z))
end

-- Runs a whole flight without input (tests and balancing).
function FlightSim.simulate(world, params: Params, inputs: { [number]: string }?)
	local state = FlightSim.new(world, params)
	local frame = 0
	local events = {}
	while state.phase ~= "DONE" do
		frame += 1
		local action = inputs and inputs[frame]
		if action == "boost" then
			FlightSim.boost(state)
		elseif action == "tap" then
			FlightSim.tapBounce(state)
		end
		for _, e in FlightSim.advance(state, world, F.Step) do
			table.insert(events, e)
		end
	end
	return state, events
end

return FlightSim
