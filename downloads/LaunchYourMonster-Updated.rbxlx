            <null />
          </Content>
          <string name="ScriptGuid">{BB84473F-39C1-4DB1-8617-56488527166F}</string>
          <BinaryString name="AttributesSerialize" />
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <bool name="DefinesCapabilities">false</bool>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <string name="Name">Progression</string>
          <BinaryString name="SerializedOverrides" />
          <int64 name="SourceAssetId">-1</int64>
          <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
          <UniqueId name="UniqueId">038c44eb3ebffb0c0af64a9d000003fd</UniqueId>
          <ProtectedString name="Source">--!strict
-- Progression: cannon/boost/bounce/magnet upgrades, power training mini game,
-- settings and tutorial step. Check -&gt; spend -&gt; apply in one synchronous block.
-- Remotes: Upgrades.Buy(id)  Training.Aim()  Training.Hit(session, marker)
--          Settings.Set(key, value)  Tutorial.Step(step)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))
local GameConfig = require(ReplicatedStorage:WaitForChild("Game"):WaitForChild("GameConfig")) :: any
local LihFolkConfig = require(ReplicatedStorage:WaitForChild("LihFolkConfig")) :: any
local LF = ServerScriptService:WaitForChild("LihFolk")
local Currency = require(LF:WaitForChild("Currency"))
local Quests = require(LF:WaitForChild("Quests"))
local GameState = require(script.Parent.GameState)
local Flight = require(script.Parent.Flight)

local T = Net.T

local Progression = {}

local trainAims: { [Player]: { session: number, start: number, period: number } } = {}
local lastTrain: { [Player]: number } = {}
local nextTrainingId = 0

local function buy(player: Player, id: string): Net.Result
	local data = GameState.Get(player)
	if not data then
		return Net.fail("NotReady")
	end
	local upgrade = GameConfig.UpgradeById[id]
	local level = data[upgrade.field]
	local cost = GameConfig.upgradeCost(upgrade, level)
	if not cost then
		return Net.fail("Maxed")
	end
	if not Currency.Spend(player, "StarCoins", cost, `upgrade:{id}`) then
		return Net.fail("NotEnough")
	end
	data[upgrade.field] = level + 1
	GameState.Changed(player)
	Quests.Report(player, "Upgrade", id, 1)
	return Net.ok({ level = level + 1 })
end

local function addTrainingXp(data, xp: number): boolean
	local cfg = GameConfig.Training
	if data.TrainingLevel &gt;= cfg.MaxLevel then
		return false
	end
	data.TrainingXP += xp
	local leveled = false
	while data.TrainingLevel &lt; cfg.MaxLevel and data.TrainingXP &gt;= GameConfig.trainingXpForLevel(data.TrainingLevel) do
		data.TrainingXP -= GameConfig.trainingXpForLevel(data.TrainingLevel)
		data.TrainingLevel += 1
		leveled = true
	end
	if data.TrainingLevel &gt;= cfg.MaxLevel then
		data.TrainingXP = 0
	end
	return leveled
end

function Progression.Init()
	local upgradeIds = {}
	for _, upgrade in GameConfig.Upgrades do
		upgradeIds[upgrade.id] = true
	end

	Net.Handle("Upgrades.Buy", {
		rate = { burst = 6, perSecond = 4 },
		args = { T.key(upgradeIds) },
		handler = buy,
	})

	Net.Handle("Training.Aim", {
		rate = { burst = 2, perSecond = 1 },
		args = {},
		handler = function(player: Player): Net.Result
			local data = GameState.Get(player)
			if not data then
				return Net.fail("NotReady")
			end
			if Flight.IsFlying(player) then
				return Net.fail("Flying")
			end
			if player:GetAttribute("Traveling") then return Net.fail("Busy") end
			nextTrainingId += 1
			local aim = {
				session = nextTrainingId,
				start = workspace:GetServerTimeNow(),
				period = if data.Settings.slowTiming then GameConfig.Flight.MarkerPeriodSlow else GameConfig.Flight.MarkerPeriod,
			}
			trainAims[player] = aim
			return Net.ok({ session = aim.session, start = aim.start, period = aim.period })
		end,
	})

	Net.Handle("Training.Hit", {
		rate = { burst = 2, perSecond = 1 },
		args = { T.integer(1, 1e9), T.number(0, 1) },
		handler = function(player: Player, session: number, marker: number): Net.Result
			local data = GameState.Get(player)
			local aim = trainAims[player]
			if not data or not aim or aim.session ~= session then
				return Net.fail("NoAim")
			end
			if Flight.IsFlying(player) or player:GetAttribute("Traveling") then
				trainAims[player] = nil
				return Net.fail("Busy")
			end
			if workspace:GetServerTimeNow() - aim.start &gt; GameConfig.Flight.AimTimeout then
				trainAims[player] = nil
				return Net.fail("Expired")
			end
			local now = os.clock()
			if now - (lastTrain[player] or 0) &lt; GameConfig.Training.Cooldown then
				return Net.fail("TooFast")
			end
			trainAims[player] = nil
			lastTrain[player] = now
			if data.TrainingLevel &gt;= GameConfig.Training.MaxLevel then
				return Net.fail("Maxed")
			end
			local timing = GameConfig.timingFor(Flight.VerifyMarker(player, aim, marker))
			local xp = GameConfig.Training.Xp[timing]
			local leveled = addTrainingXp(data, xp)
			GameState.Changed(player)
			Quests.Report(player, "Train", timing, 1)
			return Net.ok({ timing = timing, xp = xp, leveled = leveled, level = data.TrainingLevel })
		end,
	})

	Net.Handle("Settings.Set", {
		rate = { burst = 8, perSecond = 4 },
		args = { T.key(GameConfig.DefaultSettings), T.boolean },
		handler = function(player: Player, key: string, value: boolean): Net.Result
			local data = GameState.Get(player)
			if not data then
				return Net.fail("NotReady")
			end
			data.Settings[key] = value
			GameState.Changed(player)
			return Net.ok()
		end,
	})

	Net.Handle("Tutorial.Step", {
		rate = { burst = 4, perSecond = 2 },
		args = { T.integer(1, 10) },
		handler = function(player: Player, step: number): Net.Result
			local data = GameState.Get(player)
			if data and step &gt; data.Tutorial then
				data.Tutorial = step
				GameState.Changed(player)
			end
			return Net.ok()
		end,
	})

	-- Flights feed missions and the weekly board
	Flight.Finished:Connect(function(player: Player, summary)
		Quests.Report(player, "Launch", summary.world, 1)
		Quests.Report(player, "Distance", summary.world, summary.distance)
		if summary.boosted then Quests.Report(player, "Boost", summary.world, 1) end
		if summary.rings &gt; 0 then
			Quests.Report(player, "Ring", summary.world, summary.rings)
		end
		if summary.timing == "Perfect" then
			Quests.Report(player, "Perfect", "Launch", 1)
		end
		if summary.perfectBounces &gt; 0 then
			Quests.Report(player, "Perfect", "Bounce", summary.perfectBounces)
		end
		for _, mark in LihFolkConfig.ReachMarks do
			if summary.distance &gt;= mark then
				Quests.Report(player, "Reach", tostring(mark), 1)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		trainAims[player] = nil
		lastTrain[player] = nil
	end)
end

return Progression
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <Content name="LinkedSource">
            <null />
          </Content>
          <string name="ScriptGuid">{BD7C8678-EBC0-4A06-9E7E-F8720D7A0546}</string>
          <BinaryString name="AttributesSerialize" />
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <bool name="DefinesCapabilities">false</bool>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <string name="Name">WorldBuilder</string>
          <BinaryString name="SerializedOverrides" />
          <int64 name="SourceAssetId">-1</int64>
          <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
          <UniqueId name="UniqueId">038c44eb3ebffb0c0af64a9d000003fe</UniqueId>
          <ProtectedString name="Source">--!strict
-- WorldBuilder: builds the three worlds at server start, macro to micro
-- (lihfolk-worldbuilding): 01 layout (terrain, plaza, path), 02 primary forms (launcher,
-- stations, hero landmark), 03 course gameplay twins (rings, pads, tunnels, finish from
-- WorldConfig - visual only, FlightSim never uses Touched), 04 story groups (trees,
-- islands, crystals) placed on the ground with LihFolkWorld.placeOnGround.
-- Each zone owns one terrain material so global material colours never clash.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Game = ReplicatedStorage:WaitForChild("Game")
local WorldConfig = require(Game:WaitForChild("WorldConfig")) :: any
local Pets = require(Game:WaitForChild("PetDefinitions")) :: any
local Look = require(Game:WaitForChild("Look")) :: any
local LihFolkWorld = require(ServerStorage:WaitForChild("LihFolkWorld")) :: any
local AssetLoader = require(script.Parent.AssetLoader)

local terrain = workspace.Terrain

local WorldBuilder = {}
local HubDesign = require(script.Parent.HubDesign)

local ZONE = {
	SunnySpringlands = { ground = Enum.Material.Grass, groundColor = "8FDB72", plaza = "FFF1C9", path = "F2D9A6", accent = "FF8579", lane = "A6E88A" },
	CloudtopCircuit = { ground = Enum.Material.Snow, groundColor = "F4EEFF", plaza = "FFFFFF", path = "FFE7B0", accent = "FFD17A", lane = "E7DDFF" },
	NebulaWilds = { ground = Enum.Material.Basalt, groundColor = "2A2F70", plaza = "3A3486", path = "6536CD", accent = "37F4FF", lane = "232866" },
}

local function hex(value: string): Color3
	return Color3.fromHex(value)
end

local function at(world, x: number, y: number, z: number): Vector3
	return Vector3.new(world.origin[1] + x, world.origin[2] + y, world.origin[3] + z)
end

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Flat stylised floor piece (walkable, anchored, no shadow on the ground itself).
local function slab(parent: Instance, size: Vector3, cframe: CFrame, color: string, material: Enum.Material?, tag: string?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = hex(color)
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = false
	p.Parent = parent
	CollectionService:AddTag(p, tag or "LF_Ground")
	return p
end

local function disc(parent: Instance, height: number, diameter: number, position: Vector3, color: string, material: Enum.Material?): Part
	local p = slab(parent, Vector3.new(height, diameter, diameter), CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- Places a generated asset; returns nil (and the caller decides) when it is not loaded.
local function place(category: string, key: string, cframe: CFrame, scale: number, parent: Instance): Model?
	return AssetLoader.Place(category, key, cframe, scale, parent)
end

-- Scale that makes a template's largest horizontal side `size` studs.
local function fitScale(category: string, key: string, size: number): number
	local template = AssetLoader.Get(category, key)
	if not template then
		return 1
	end
	local _, extents = template:GetBoundingBox()
	return size / math.max(extents.X, extents.Z, 0.1)
end

local function billboard(adornee: BasePart, text: string, color: Color3, offset: number, maxDistance: number?): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(16, 3)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offset, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or 160
	gui.Parent = adornee
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = color
	label.FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json")
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = hex("160F2B")
	stroke.Parent = label
	return label
end

local function anchorFor(parent: Instance, position: Vector3, name: string): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(4, 4, 4)
	p.Position = position
	p.Parent = parent
	return p
end

local function prompt(parent: Instance, action: string, object: string, distance: number?): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.MaxActivationDistance = distance or 14
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	return pp
end

------------------------------------------------------------------------
-- 01 Layout: terrain ground, course lane, hub plaza and the main path
------------------------------------------------------------------------
local function layout(world, root: Instance)
	local zone = ZONE[world.id]
	local o = world.origin
	local width = world.laneHalf * 2 + 260
	-- Ground: one terrain slab from behind the hub to past the finish (4 stud voxels)
	terrain:FillBlock(CFrame.new(o[1], o[2] - 6, o[3] + world.length / 2 - 40), Vector3.new(width, 12, world.length + 360), zone.ground)
	-- Side hills frame the lane (edges contain the space; never inside the flight lane)
	local rng = Random.new(world.order * 31)
	local hills = math.floor(world.length / 120)
	for i = 1, hills do
		local side = if i % 2 == 0 then -1 else 1
		local radius = rng:NextNumber(28, 60)
		local x = side * (world.laneHalf + 40 + radius * 0.6 + rng:NextNumber(0, 50))
		local z = (i / hills) * world.length + rng:NextNumber(-40, 40)
		if world.id ~= "CloudtopCircuit" then
			terrain:FillBall(Vector3.new(o[1] + x, o[2] - radius * 0.45, o[3] + z), radius, zone.ground)
		end
	end
	-- Readable lane: a lighter, smoother strip under the flight path
	local laneFolder = folder("01_Lane", root)
	slab(laneFolder, Vector3.new(world.laneHalf * 2, 1, world.length + 40), CFrame.new(at(world, 0, -1.1, world.length / 2)), zone.lane, Enum.Material.SmoothPlastic)
	-- Distance markers: thin strips every 100, signs every 500
	for d = 100, world.length - 1, 100 do
		local major = d % 500 == 0
		local stripe = slab(laneFolder, Vector3.new(world.laneHalf * 2, 0.2, if major then 3 else 1.2), CFrame.new(at(world, 0, 0.1, d)), "FFFFFF", Enum.Material.Neon, "LF_NoScatter")
		stripe.Transparency = if major then 0.15 else 0.6
		stripe.CanCollide = false
		if major then
			local post = anchorFor(laneFolder, at(world, -world.laneHalf - 6, 6, d), "Marker" .. d)
			billboard(post, `{d} STUDS`, Color3.new(1, 1, 1), 4, 900)
		end
	end
	-- Native themed plaza is supplied by HubDesign; retain the original course layout.
end

------------------------------------------------------------------------
-- 02 Primary forms: launcher, stations, portals, hero landmark
------------------------------------------------------------------------
local function launcher(world, root: Instance)
	local position = at(world, 0, 0, -12)
	local model = place("Launchers", world.id, CFrame.new(position), 1.25, root)
	if not model then
		-- Fallback: a readable cannon stand-in so the slice stays playable
		model = Instance.new("Model")
		model.Name = "Launcher"
		local barrel = Instance.new("Part")
		barrel.Name = "barrel"
		barrel.Shape = Enum.PartType.Cylinder
		barrel.Anchored = true
		barrel.Size = Vector3.new(16, 7, 7)
		local dir = Vector3.new(0, math.sin(math.rad(45)), math.cos(math.rad(45)))
		barrel.CFrame = CFrame.lookAt(position + Vector3.new(0, 8, 0), position + Vector3.new(0, 8, 0) + dir) * CFrame.Angles(0, math.pi / 2, 0)
		barrel.Color = hex(ZONE[world.id].accent)
		barrel.Parent = model
		model.PrimaryPart = barrel
		model.Parent = root
	end
	model.Name = "Launcher"
	model:SetAttribute("World", world.id)
	CollectionService:AddTag(model, "LYM_Cannon")
	local holder = anchorFor(model, position + Vector3.new(0, 4, -10), "PromptHolder")
	prompt(holder, "Launch!", world.launcher, 20)
	billboard(holder, world.launcher:upper(), Color3.new(1, 1, 1), 22, 200)
end

local function station(world, root: Instance, key: string, spot: { number }, width: number, tagName: string, action: string, label: string, color: Color3)
	local position = at(world, spot[1], spot[2], spot[3])
	local center = at(world, 0, 0, -40)
	local model = if key == "Kiosk" or key == "EggPedestal" then nil else place("Props", key, CFrame.new(position), fitScale("Props", key, width), root)
	if model then
		LihFolkWorld.faceToward(model, Vector3.new(center.X, position.Y, center.Z))
	end
	local holder = anchorFor(root, position + Vector3.new(0, 4, 0), key .. "Prompt")
	prompt(holder, action, label, 16)
	if key ~= "Kiosk" and key ~= "EggPedestal" then billboard(holder, label:upper(), color, 12) end
	-- The prompt lives on the holder, so the holder always carries the tag
	CollectionService:AddTag(holder, tagName)
	holder:SetAttribute("World", world.id)
	local tagged = model or holder
	tagged:SetAttribute("World", world.id)
	return tagged, holder
end

local function stations(world, root: Instance)
	local h = world.hub
	local egg = Pets.EggById[world.egg]
	-- Egg stand: pedestal + the world's egg on top
	local stand, holder = station(world, root, "EggPedestal", h.eggStand, 12, "LYM_EggStand", "Hatch", egg.name, hex(egg.accent))
	stand:SetAttribute("Egg", egg.id)
	holder:SetAttribute("Egg", egg.id)
	CollectionService:AddTag(holder, "LYM_EggStand")
	local eggPosition = at(world, h.eggStand[1], h.eggStand[2] + 3.2, h.eggStand[3])
	local eggModel = place("Eggs", egg.id, CFrame.new(eggPosition), 1.6, root)
	if eggModel then
		eggModel.Name = "DisplayEgg"
		CollectionService:AddTag(eggModel, "LYM_Spin")
		eggModel:SetAttribute("Speed", 0.6)
		eggModel:SetAttribute("SpinAxis", "Y")
		eggModel:SetAttribute("Bob", 0.6)
	end
	station(world, root, "Kiosk", h.kiosk, 16, "LYM_Kiosk", "Upgrades", "Upgrades", hex("7CC8FF"))
	if h.training then
		station(world, root, "StrengthTower", h.training, 9, "LYM_Training", "Train Power", "Power Tower", hex("FFD24A"))
	end
	for _, portal in h.portals do
		local target = WorldConfig.ById[portal.target]
		local position = at(world, portal.pos[1], portal.pos[2], portal.pos[3])
		local model = place("Props", "Portal", CFrame.new(position), fitScale("Props", "Portal", 18), root)
		if model then
			LihFolkWorld.faceToward(model, at(world, 0, 0, -58))
			model:SetAttribute("Target", target.id)
			CollectionService:AddTag(model, "LYM_Portal")
		end
		local holder2 = anchorFor(root, position + Vector3.new(0, 6, 0), "PortalPrompt")
		holder2:SetAttribute("Target", target.id)
		CollectionService:AddTag(holder2, "LYM_Portal")
		prompt(holder2, "Travel", target.name, 16)
		local label = billboard(holder2, target.name:upper(), Color3.new(1, 1, 1), 13, 200)
		label.Name = "PortalLabel"
	end
	-- Live stud boards are authored in the plaza template.

end

local function hero(world, root: Instance)
	local o = world.origin
	if world.id == "SunnySpringlands" then
		-- Windmill hero: visible from the spawn, framing the launch lane on the left
		local mill = place("Props", "Windmill", CFrame.new(o[1] - 95, o[2], o[3] + 60), 2.2, root)
		if mill then
			LihFolkWorld.faceToward(mill, at(world, 0, 0, -58))
		end
	elseif world.id == "CloudtopCircuit" then
		place("Props", "SkyIsland", CFrame.new(o[1] - 120, o[2] + 70, o[3] + 140), 2.4, root)
	else
		place("Props", "Planet", CFrame.new(o[1] + 160, o[2] + 140, o[3] + 260), 3.2, root)
	end
end

------------------------------------------------------------------------
-- 03 Course: gameplay twins of WorldConfig
------------------------------------------------------------------------
local PAD_PROP = { SunnySpringlands = "MushroomPad", CloudtopCircuit = "CloudPad", NebulaWilds = "CrystalPad" }

local function course(world, root: Instance)
	local rings = folder("Rings", root)
	for index, r in world.rings do
		local cf = CFrame.lookAt(at(world, r.x, r.y, r.z), at(world, r.x, r.y, r.z - 1))
		local model = place("Props", "Ring", cf * CFrame.new(0, -r.r * 1.15, 0), fitScale("Props", "Ring", r.r * 2.3), rings)
		if not model then
			model = Instance.new("Model")
			for i = 0, 15 do
				local a = i / 16 * math.pi * 2
				local seg = Instance.new("Part")
				seg.Anchored = true
				seg.CanCollide = false
				seg.Material = Enum.Material.Neon
				seg.Color = hex("FFD24A")
				seg.Size = Vector3.new(1.4, 2 * math.pi * r.r / 16 * 1.1, 1.4)
				seg.CFrame = cf * CFrame.new(math.cos(a) * r.r, math.sin(a) * r.r, 0) * CFrame.Angles(0, 0, a)
				seg.Parent = model
			end
			model.Parent = rings
		end
		model.Name = "Ring" .. index
		model:SetAttribute("Index", index)
		model:SetAttribute("World", world.id)
		CollectionService:AddTag(model, "LYM_Ring")
	end

	local pads = folder("Pads", root)
	for index, pad in world.pads do
		local base = at(world, pad.x, 0, pad.z)
		local key = if pad.kind == "spring" then "MushroomPad" else PAD_PROP[world.id]
		local scale = fitScale("Props", key, math.min(pad.w, pad.d))
		local model = place("Props", key, CFrame.new(base), scale, pads)
		-- Collision-free top marker at the exact simulated height so the read matches the sim
		local top = slab(pads, Vector3.new(pad.w, 0.4, pad.d), CFrame.new(at(world, pad.x, pad.y, pad.z)), "FFFFFF", Enum.Material.Neon, "LF_NoScatter")
		top.Transparency = if model then 0.85 else 0.2
		top.CanCollide = false
		top.Name = "PadTop" .. index
		local m = model or top
		m:SetAttribute("Index", index)
		m:SetAttribute("World", world.id)
		CollectionService:AddTag(m, "LYM_Pad")
	end

	local tunnels = folder("Tunnels", root)
	for index, t in world.tunnels do
		local center = at(world, t.x, t.y, t.z)
		for i = 0, 2 do
			local z = -t.sz / 2 + i * t.sz / 2
			local cf = CFrame.lookAt(center + Vector3.new(0, 0, z), center + Vector3.new(0, 0, z - 1))
			local r = math.max(t.sx, t.sy) / 2
			place("Props", "Ring", cf * CFrame.new(0, -r * 1.1, 0), fitScale("Props", "Ring", r * 2.2), tunnels)
		end
		local volume = Instance.new("Part")
		volume.Name = "Tunnel" .. index
		volume.Anchored = true
		volume.CanCollide = false
		volume.CanQuery = false
		volume.CanTouch = false
		volume.CastShadow = false
		volume.Size = Vector3.new(t.sx, t.sy, t.sz)
		volume.CFrame = CFrame.new(center)
		volume.Material = Enum.Material.ForceField
		volume.Color = hex(ZONE[world.id].accent)
		volume.Transparency = 0.55
		volume.Parent = tunnels
		local wind = Instance.new("ParticleEmitter")
		wind.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		wind.LightEmission = 1
		wind.LightInfluence = 0
		wind.Size = NumberSequence.new(0.5, 0)
		wind.Speed = NumberRange.new(45, 70)
		wind.Lifetime = NumberRange.new(0.5, 0.9)
		wind.Rate = 10
		wind.Orientation = Enum.ParticleOrientation.VelocityParallel
		wind.Squash = NumberSequence.new(2.5)
		wind.EmissionDirection = if t.ay &gt; t.az then Enum.NormalId.Top else Enum.NormalId.Back
		wind.SpreadAngle = Vector2.new(4, 4)
		wind.Parent = volume
		CollectionService:AddTag(volume, "LYM_Tunnel")
	end

	local finish = folder("Finish", root)
	local arch = place("Props", "FinishArch", CFrame.new(at(world, 0, 0, world.length)), fitScale("Props", "FinishArch", world.laneHalf * 2 + 20), finish)
	if not arch then
		local banner = anchorFor(finish, at(world, 0, 30, world.length), "Banner")
		billboard(banner, "FINISH!", hex("FFD24A"), 0, 3000)
	end
end

------------------------------------------------------------------------
-- 04 Story groups: odd-numbered clusters at the lane edges, never in the lane
------------------------------------------------------------------------
local function dress(world, root: Instance)
	local o = world.origin
	local rng = Random.new(world.order * 977)
	local edge = world.laneHalf + 24
	local groups = math.floor(world.length / 110)
	for g = 1, groups do
		local side = if g % 2 == 0 then -1 else 1
		local cz = (g / groups) * world.length + rng:NextNumber(-30, 30)
		local cx = side * rng:NextNumber(edge, edge + 70)
		local count = if g % 3 == 0 then 5 else 3 -- odd groups: one big, two mid, a few small
		for i = 1, count do
			local scale = if i == 1 then rng:NextNumber(1.6, 2.1) else rng:NextNumber(0.9, 1.4)
			local x = o[1] + cx + rng:NextNumber(-16, 16)
			local z = o[3] + cz + rng:NextNumber(-16, 16)
			local key = if world.id == "SunnySpringlands" then "Tree" elseif world.id == "NebulaWilds" then "CrystalCluster" else nil
			if key then
				local model = place("Props", key, CFrame.new(x, o[2] + 40, z), scale, root)
				if model then
					LihFolkWorld.placeOnGround(model, x, z, { yaw = rng:NextNumber(0, 360), alignToNormal = true, maxTilt = 8, sink = 0.2 })
				end
			end
		end
		if world.id == "CloudtopCircuit" and g % 2 == 0 then
			place("Props", "SkyIsland", CFrame.new(o[1] + cx * 1.4, o[2] + rng:NextNumber(40, 120), o[3] + cz), rng:NextNumber(0.8, 1.5), root)
		end
	end

end

function WorldBuilder.Build()
	local preview = workspace:FindFirstChild("LYM_DesignPreview")
	if preview then preview:Destroy() end
	AssetLoader.Load(30)
	terrain:SetMaterialColor(Enum.Material.Grass, hex(ZONE.SunnySpringlands.groundColor))
	terrain:SetMaterialColor(Enum.Material.Snow, hex(ZONE.CloudtopCircuit.groundColor))
	terrain:SetMaterialColor(Enum.Material.Basalt, hex(ZONE.NebulaWilds.groundColor))
	Look.apply(Lighting, WorldConfig.Home)

	local worlds = workspace:FindFirstChild("Worlds") or folder("Worlds", workspace)
	worlds:ClearAllChildren()
	if not workspace:FindFirstChild("ActiveFlights") then
		folder("ActiveFlights", workspace)
	end
	for _, world in WorldConfig.List do
		local root = folder(world.id, worlds)
		root:SetAttribute("World", world.id)
		layout(world, root)
		local primary = folder("02_Primary", root)
		HubDesign.Build(world, primary)
		stations(world, primary)
		hero(world, primary)
		course(world, folder("03_Course", root))
		dress(world, folder("04_Detail", root))
	end
end

return WorldBuilder
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <Content name="LinkedSource">
            <null />
          </Content>
          <string name="ScriptGuid">{364A2AF9-B0CF-498E-B53B-1139EE000E79}</string>
          <BinaryString name="AttributesSerialize" />
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <bool name="DefinesCapabilities">false</bool>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <string name="Name">Worlds</string>
          <BinaryString name="SerializedOverrides" />
          <int64 name="SourceAssetId">-1</int64>
          <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
          <UniqueId name="UniqueId">038c44eb3ebffb0c0af64a9d000003ff</UniqueId>
          <ProtectedString name="Source">--!strict
-- Worlds: spawning after the profile loads, verified unlocks, safe travel.
-- The current world is session state (player attribute "World"); everyone starts at home.
-- Remotes: Worlds.Unlock(worldId)  Worlds.Travel(worldId)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))
local Game = ReplicatedStorage:WaitForChild("Game")
local GameConfig = require(Game:WaitForChild("GameConfig")) :: any
local WorldConfig = require(Game:WaitForChild("WorldConfig")) :: any
local LF = ServerScriptService:WaitForChild("LihFolk")
local PlayerData = require(LF:WaitForChild("PlayerData"))
local Currency = require(LF:WaitForChild("Currency"))
local Quests = require(LF:WaitForChild("Quests"))
local GameState = require(script.Parent.GameState)
local Flight = require(script.Parent.Flight)

local T = Net.T

local Worlds = {}

Worlds.Unlocks = {
	CloudtopCircuit = GameConfig.World2Unlock,
	NebulaWilds = GameConfig.World3Unlock,
}

function Worlds.SpawnCFrame(worldId: string): CFrame
	local world = WorldConfig.ById[worldId] or WorldConfig.ById[WorldConfig.Home]
	local o, s = world.origin, world.hub.spawn
	local position = Vector3.new(o[1] + s[1], o[2] + s[2] + 3, o[3] + s[3])
	return CFrame.lookAt(position, Vector3.new(o[1], position.Y, o[3]))
end

local function spawn(player: Player)
	if player.Parent ~= Players then
		return
	end
	local ok, err = pcall(player.LoadCharacterAsync, player)
	if not ok then
		warn(`[Worlds] LoadCharacterAsync failed: {err}`)
	end
end

function Worlds.Travel(player: Player, worldId: string): (boolean, string?)
	local data = GameState.Get(player)
	if not data then
		return false, "NotReady"
	end
	if not data.Unlocked[worldId] then
		return false, "Locked"
	end
	if Flight.IsFlying(player) then
		return false, "Flying"
	end
	if player:GetAttribute("Traveling") then return false, "Busy" end
	Flight.InvalidateAim(player)
	require(script.Parent.Riding).Dismount(player, false)
	if player:GetAttribute("World") ~= worldId then
		player:SetAttribute("Traveling", true)
		player:SetAttribute("World", worldId)
		local character = player.Character
		if character then
			character:PivotTo(Worlds.SpawnCFrame(worldId))
		end
		task.delay(0.6, function()
			if player.Parent then
				player:SetAttribute("Traveling", false)
			end
		end)
	end
	return true, nil
end

function Worlds.Init()
	Net.Handle("Worlds.Unlock", {
		rate = { burst = 2, perSecond = 1 },
		args = { T.key(Worlds.Unlocks) },
		handler = function(player: Player, worldId: string): Net.Result
			local data = GameState.Get(player)
			if not data then
				return Net.fail("NotReady")
			end
			if data.Unlocked[worldId] then
				return Net.fail("Owned")
			end
			local rule = Worlds.Unlocks[worldId]
			if (data.Best[rule.bestWorld] or 0) &lt; rule.best then
				return Net.fail("NeedDistance", { world = rule.bestWorld, best = rule.best })
			end
			if not Currency.Spend(player, "StarCoins", rule.cost, `unlock:{worldId}`) then
				return Net.fail("NotEnough")
			end
			data.Unlocked[worldId] = true
			GameState.Changed(player)
			Quests.Report(player, "Unlock", worldId, 1)
			return Net.ok()
		end,
	})

	Net.Handle("Worlds.Travel", {
		rate = { burst = 2, perSecond = 1 },
		args = { T.key(WorldConfig.ById) },
		handler = function(player: Player, worldId: string): Net.Result
			local ok, code = Worlds.Travel(player, worldId)
			return if ok then Net.ok() else Net.fail(code or "Error")
		end,
	})

	-- Characters spawn only after the profile is ready, always in the current world's hub.
	PlayerData.Loaded:Connect(function(player: Player)
		player:SetAttribute("World", WorldConfig.Home)
		player.CharacterAdded:Connect(function(character: Model)
			task.defer(function()
				if character.Parent then
					character:PivotTo(Worlds.SpawnCFrame(player:GetAttribute("World") or WorldConfig.Home))
				end
			end)
			local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
			if humanoid then
				humanoid.Died:Connect(function()
					Flight.Cancel(player, "died")
					task.delay(3, spawn, player)
				end)
			end
		end)
		spawn(player)
	end)
end

return Worlds
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXDFD89AE13E6346DC8941609E29DD9F6D">
        <Properties>
          <Content name="LinkedSource">
            <null />
          </Content>
          <string name="ScriptGuid">{1DCE5CFB-8887-42AC-9DAD-C437C2D279EE}</string>
          <BinaryString name="AttributesSerialize" />
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <bool name="DefinesCapabilities">false</bool>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <string name="Name">AssetLoader</string>
          <BinaryString name="SerializedOverrides" />
          <int64 name="SourceAssetId">-1</int64>
          <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
          <UniqueId name="UniqueId">381fa19eebc508c80af65c1f00000967</UniqueId>
          <ProtectedString name="Source">--!strict
-- AssetLoader: rebuilds the generated art from ReplicatedStorage.Assets.Manifest at server
-- start (AssetService:CreateMeshPartAsync + TextureID) into ReplicatedStorage.AssetModels,
-- so the place file never has to carry the meshes and code stays the source of truth.
-- Missing or failed entries are reported once and skipped; callers check Get() for nil.

local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Manifest = require(ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Manifest")) :: any

local AssetLoader = {}

local root: Folder? = nil

local function buildModel(key: string, spec): Model?
	local model = Instance.new("Model")
	model.Name = key
	local largest: MeshPart? = nil
	for _, partSpec in spec.parts do
		local ok, part = pcall(function()
			return AssetService:CreateMeshPartAsync(Content.fromUri(partSpec.mesh), {
				CollisionFidelity = Enum.CollisionFidelity.Box,
				RenderFidelity = Enum.RenderFidelity.Automatic,
			})
		end)
		if not ok or not part then
			warn(`[AssetLoader] {key}/{partSpec.name}: {part}`)
			model:Destroy()
			return nil
		end
		local mesh = part :: MeshPart
		mesh.Name = partSpec.name
		mesh.TextureID = partSpec.texture
		mesh.Size = Vector3.new(partSpec.size[1], partSpec.size[2], partSpec.size[3])
		local c = partSpec.cf
		mesh.CFrame = CFrame.new(c[1], c[2], c[3], c[4], c[5], c[6], c[7], c[8], c[9], c[10], c[11], c[12])
		mesh.Anchored = true
		mesh.CanCollide = false
		mesh.CanQuery = false
		mesh.CanTouch = false
		mesh.Parent = model
		if not largest or mesh.Size.Magnitude &gt; largest.Size.Magnitude then
			largest = mesh
		end
	end
	model.PrimaryPart = largest
	-- Pivot at the bottom centre, front facing -Z (generation convention, checked in Studio).
	local cf, size = model:GetBoundingBox()
	model.WorldPivot = CFrame.new(cf.Position - Vector3.new(0, size.Y / 2, 0))
	return model
end

-- Builds every manifest entry in parallel; returns when all finished (or timed out).
function AssetLoader.Load(timeout: number?)
	local embedded = ReplicatedStorage:FindFirstChild("AssetModels")
	if embedded and embedded:IsA("Folder") then
		for _, model in embedded:GetDescendants() do
			if model:IsA("Model") and model.PrimaryPart then
				local pivot = model.PrimaryPart.CFrame
				model.PrimaryPart.PivotOffset = pivot:Inverse()
			end
		end
		root = embedded
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "AssetModels"
	local pending = 0
	for category, entries in Manifest do
		local sub = Instance.new("Folder")
		sub.Name = category
		sub.Parent = folder
		for key, spec in entries do
			pending += 1
			task.spawn(function()
				local model = buildModel(key, spec)
				if model then
					model.Parent = sub
				end
				pending -= 1
			end)
		end
	end
	local deadline = os.clock() + (timeout or 25)
	while pending &gt; 0 and os.clock() &lt; deadline do
		task.wait(0.1)
	end
	if pending &gt; 0 then
		warn(`[AssetLoader] {pending} assets still loading after timeout`)
	end
	folder.Parent = ReplicatedStorage
	root = folder
end

function AssetLoader.Get(category: string, key: string): Model?
	local folder = root and root:FindFirstChild(category)
	local model = folder and folder:FindFirstChild(key)
	return if model and model:IsA("Model") then model else nil
end

-- A placed copy: pivot at `cframe`, uniformly scaled to `scale`.
function AssetLoader.Place(category: string, key: string, cframe: CFrame, scale: number?, parent: Instance?): Model?
	local template = AssetLoader.Get(category, key)
	if not template then
		return nil
	end
	local model = template:Clone()
	if scale and scale ~= 1 then
		model:ScaleTo(scale)
	end
	model:PivotTo(cframe)
	model.Parent = parent
	return model
end

return AssetLoader
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="LYMNEW1">
        <Properties>
          <string name="Name">HubDesign</string>
          <ProtectedString name="Source">--!strict
-- Native stud-plaza art, wired to the game's existing authoritative services.
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")
local HubDesign = {}

local function part(parent, name, size, cf, color, collidable)
 local p = Instance.new("Part")
 p.Name = name; p.Size = size; p.CFrame = cf; p.Color = Color3.fromHex(color)
 p.Anchored = true; p.CanCollide = collidable ~= false
 p.CanTouch = false; p.TopSurface = Enum.SurfaceType.Studs; p.BottomSurface = Enum.SurfaceType.Smooth
 p.Material = Enum.Material.Plastic; p.Parent = parent
 return p
end

function HubDesign.Build(world, root)
 local template = ServerStorage:WaitForChild("LYM_StudPlaza")
 local plaza = template:Clone()
 plaza.Name = "StudPlaza"
 -- Template is already in home-world coordinates; translate without changing its pivot.
 local offset = Vector3.new(world.origin[1], world.origin[2], world.origin[3])
 for _, p in plaza:GetDescendants() do
  if p:IsA("BasePart") then
   p.CFrame += offset
   if world.id ~= "SunnySpringlands" then
    if p.Name == "GrassTile" or p.Name == "GrassLip" or p.Name:match("Crown") then
     p.Color = Color3.fromHex(if world.id == "CloudtopCircuit" then "D5B6FF" else "6536CD")
    elseif p.Name == "PathTile" then
     p.Color = Color3.fromHex(if world.id == "CloudtopCircuit" then "FFD17A" else "37B8D5")
    elseif p.Name == "Cliff" or p.Name == "BackCliff" then
     p.Color = Color3.fromHex(if world.id == "CloudtopCircuit" then "869BCB" else "23264F")
    end
   end
  end
 end
 for _, label in plaza:GetDescendants() do
  if label:IsA("TextLabel") and string.find(label.Text, "MEADOW EGG", 1, true) then
   label.Text = if world.id == "SunnySpringlands" then "MEADOW EGG\n250 STAR COINS" elseif world.id == "CloudtopCircuit" then "STORM EGG\n6,000 STAR COINS" else "COSMIC EGG\n90,000 STAR COINS"
  end
 end
 plaza.Parent = root
 local cannon = plaza:FindFirstChild("Launcher")
 cannon:SetAttribute("World", world.id)
 CollectionService:AddTag(cannon, "LYM_Cannon")
 local pp = Instance.new("ProximityPrompt")
 pp.ActionText = "Launch!"; pp.ObjectText = world.launcher
 pp.MaxActivationDistance = 20; pp.RequiresLineOfSight = false
 pp.Parent = cannon.PromptHolder
 for _, board in plaza:GetDescendants() do
  if board:IsA("BasePart") and ({ DistanceBoard = "Best", CoinsBoard = "Coins", LaunchesBoard = "Launches" })[board.Name] then
   board:SetAttribute("BoardStat", ({ DistanceBoard = "Best", CoinsBoard = "Coins", LaunchesBoard = "Launches" })[board.Name])
   CollectionService:AddTag(board, "LYM_StudBoard")
  end
 end
 -- Keep the course open, while canyon walls stay outside the simulated lateral bounds.
 local course = Instance.new("Folder"); course.Name = "StudCourse"; course.Parent = root
 local grass = if world.id == "SunnySpringlands" then "61D218" elseif world.id == "CloudtopCircuit" then "C4BAFF" else "433077"
 local alternate = if world.id == "SunnySpringlands" then "95E92C" elseif world.id == "CloudtopCircuit" then "E4DEFF" else "514196"
 local cliff = if world.id == "SunnySpringlands" then "6F351A" elseif world.id == "CloudtopCircuit" then "8B9FCC" else "23264F"
 for z = 24, world.length, 48 do
  for side = -1, 1, 2 do
   local x = side * (world.laneHalf + 18)
   part(course, "Canyon", Vector3.new(14, 30, 48), CFrame.new(offset + Vector3.new(x, 14, z)), cliff)
   part(course, "GrassCap", Vector3.new(16, 3, 48), CFrame.new(offset + Vector3.new(x, 30, z)), grass)
  end
  -- Broad checker tiles: bounded instance count instead of one instance per stud.
  for column = 0, 5 do
   local w = world.laneHalf * 2 / 6
   part(course, "CourseTile", Vector3.new(w, 1, math.min(48, world.length-z+24)), CFrame.new(offset + Vector3.new(-world.laneHalf+w*(column+.5), -.5, z)), if (column + math.floor(z/48))%2 == 0 then grass else alternate)
  end
 end
end
return HubDesign
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="LYMNEW2">
        <Properties>
          <string name="Name">PlazaBoards</string>
          <ProtectedString name="Source">--!strict
-- Genuine current-server scores; no fabricated global entries or placeholder names.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local GameState = require(script.Parent.GameState)
local PlazaBoards = {}
local started = false
local TITLES = { Best = "BEST DISTANCE", Coins = "STAR COINS", Launches = "TOTAL LAUNCHES" }
local function update()
 local rows = { Best = {}, Coins = {}, Launches = {} }
 for _, player in Players:GetPlayers() do
  local data = GameState.Get(player)
  if data then
   local best = 0
   for _, distance in data.Best do best = math.max(best, distance) end
   for stat, value in { Best = best, Coins = player:GetAttribute("StarCoins") or 0, Launches = data.Launches } do
    table.insert(rows[stat], { name = player.DisplayName, id = player.UserId, value = value })
   end
  end
 end
 for _, list in rows do
  table.sort(list, function(a,b) return if a.value == b.value then a.id &lt; b.id else a.value &gt; b.value end)
 end
 for _, board in CollectionService:GetTagged("LYM_StudBoard") do
  local stat = board:GetAttribute("BoardStat")
  local gui = board:FindFirstChildOfClass("SurfaceGui")
  local label = gui and gui:FindFirstChild("Caption")
  if label and rows[stat] then
   local lines = { TITLES[stat], "THIS SERVER", "" }
   for rank = 1, math.min(8, #rows[stat]) do
    local entry = rows[stat][rank]
    table.insert(lines, string.format("%d. %s  •  %d%s", rank, entry.name, entry.value, if stat == "Best" then " studs" else ""))
   end
   if #rows[stat] == 0 then table.insert(lines, "Waiting for players...") end
   label.Text = table.concat(lines, "\n")
  end
 end
end
function PlazaBoards.Start()
 if started then return end
 started = true
 task.spawn(function() while true do update(); task.wait(5) end end)
end
return PlazaBoards
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="LYMNEW3">
        <Properties>
          <string name="Name">DailyMissionRules</string>
          <ProtectedString name="Source">-- Pure daily objective rules; state is stored in the existing Quests profile slice.
local Rules = {}
local MATCH = {
 launches = {"Launch", "*"}, rings = {"Ring", "*"}, perfectLaunches = {"Perfect", "Launch"},
 boosts = {"Boost", "*"}, hatches = {"Hatch", "*"}, bestToday = {"Distance", "*"},
 perfectBounces = {"Perfect", "Bounce"}, trains = {"Train", "*"},
}
function Rules.reset(state, day)
 if state.DailyDay ~= day then
  state.DailyDay = day; state.DailyProgress = {}; state.DailyClaimed = {}
 end
 state.DailyProgress = state.DailyProgress or {}; state.DailyClaimed = state.DailyClaimed or {}
end
function Rules.id(day, definition) return `Daily_{day}_{definition.id}` end
function Rules.report(state, definitions, kind, target, amount)
 local changed = false
 for _, def in definitions do
  local match = MATCH[def.stat]
  if match and match[1] == kind and (match[2] == "*" or match[2] == target) and not state.DailyClaimed[def.id] then
   local old = state.DailyProgress[def.id] or 0
   local value = math.min(def.goal, if def.stat == "bestToday" then math.max(old,amount) else old+amount)
   if value ~= old then state.DailyProgress[def.id] = value; changed = true end
  end
 end
 return changed
end
function Rules.complete(state, def) return not state.DailyClaimed[def.id] and (state.DailyProgress[def.id] or 0) &gt;= def.goal end
return Rules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="LYMNEW4">
        <Properties>
          <string name="Name">Riding</string>
          <ProtectedString name="Source">--!strict
-- Server-owned ground mounts. The client sends a bounded direction, never a position.
-- Flight remains authoritative in Flight; SetFlightPose only seats the avatar on it.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))
local WorldConfig = require(ReplicatedStorage:WaitForChild("Game"):WaitForChild("WorldConfig")) :: any
local Inventory = require(ServerScriptService:WaitForChild("LihFolk"):WaitForChild("Inventory"))

local Riding = {}
local SPEED = 18
local INPUT_TIMEOUT = 0.35
local ROOT_ABOVE_SADDLE = 1.7
local states: { [Player]: any } = {}
local aiming: { [Player]: boolean } = {}
local watched: { [Player]: { RBXScriptConnection } } = {}
local mountsFolder: Folder? = nil
local started = false

local function finite(n: any): boolean
 return type(n) == "number" and n == n and math.abs(n) &lt; math.huge
end

-- Exported pure checks also used by the service; make exploit tests independent of physics.
function Riding.ClampDirection(x: number, z: number): Vector3
 if not finite(x) or not finite(z) then return Vector3.zero end
 local v = Vector3.new(math.clamp(x, -1, 1), 0, math.clamp(z, -1, 1))
 return if v.Magnitude &gt; 1 then v.Unit else v
end

function Riding.ClampHub(world: any, position: Vector3): Vector3
 local o = world.origin
 return Vector3.new(o[1] + math.clamp(position.X - o[1], -44, 44), position.Y,
  o[3] + math.clamp(position.Z - o[3], -84, -16))
end

local function worldFor(player: Player): any
 return WorldConfig.ById[player:GetAttribute("World") or WorldConfig.Home] or WorldConfig.ById[WorldConfig.Home]
end

local function characterParts(player: Player): (Model?, BasePart?, Humanoid?)
 local character = player.Character
 local root = character and character:FindFirstChild("HumanoidRootPart")
 local humanoid = character and character:FindFirstChildOfClass("Humanoid")
 if not character or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health &lt;= 0 then
  return nil, nil, nil
 end
 return character, root, humanoid
end

local function equippedPet(player: Player): string?
 local uid = Inventory.GetEquipped(player)[1]
 local unique = uid and Inventory.GetUnique(player, uid)
 return if unique then unique.Item else nil
end

local function templateFor(id: string): Model?
 local root = ReplicatedStorage:FindFirstChild("AssetModels")
 local monsters = root and root:FindFirstChild("Monsters")
 local template = monsters and monsters:FindFirstChild(id)
 return if template and template:IsA("Model") and template.PrimaryPart then template else nil
end

local function queryFor(state): RaycastParams
 local params = RaycastParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 local filter: { Instance } = { state.character }
 if mountsFolder then table.insert(filter, mountsFolder) end
 local flights = workspace:FindFirstChild("ActiveFlights")
 if flights then table.insert(filter, flights) end
 params.FilterDescendantsInstances = filter
 params.RespectCanCollide = true
 return params
end

local function groundAt(state, at: Vector3): Vector3?
 local hit = workspace:Raycast(at + Vector3.new(0, 6, 0), Vector3.new(0, -16, 0), queryFor(state))
 if not hit or hit.Normal.Y &lt; 0.65 then return nil end
 -- Do not climb roofs/awnings or jump down cliffs on a single input packet.
 if math.abs(hit.Position.Y - state.position.Y) &gt; 3.5 then return nil end
 return Vector3.new(at.X, hit.Position.Y + 0.03, at.Z)
end

local function setHidden(state, hidden: boolean)
 if state.hidden == hidden then return end
 state.hidden = hidden
 for part, original in state.transparency do
  if part.Parent then part.Transparency = if hidden then 1 else original end
 end
 for _, effect in state.model:GetDescendants() do
  if effect:IsA("ParticleEmitter") or effect:IsA("Trail") then
   effect.Enabled = not hidden
  elseif effect:IsA("PointLight") then
   effect.Enabled = not hidden
  end
 end
end

local function seatOffset(model: Model): CFrame
 local seat = model:FindFirstChild("RideSeat", true)
 if seat and seat:IsA("Attachment") and model.PrimaryPart then
  -- Local attachment frame is authored relative to Root at the model's origin.
  return model:GetPivot():ToObjectSpace(seat.WorldCFrame) * CFrame.new(0, ROOT_ABOVE_SADDLE, 0)
 end
 return CFrame.new(0, 5.2, 0)
end

local function applyPose(state, cf: CFrame, characterOnly: boolean?)
 if not characterOnly then state.model:PivotTo(cf) end
 if state.root.Parent and state.humanoid.Parent then
  state.root.CFrame = cf * state.seat
  state.root.AssemblyLinearVelocity = Vector3.zero
  state.root.AssemblyAngularVelocity = Vector3.zero
  state.humanoid.Sit = true
 end
end

local function groundPose(state): CFrame
 return CFrame.lookAt(state.position, state.position + state.forward)
end

local function newVisual(state, pet: string): boolean
 local template = templateFor(pet)
 if not template then return false end
 local model = template:Clone()
 model.Name = "Mount_" .. state.player.UserId
 local transparency = {}
 for _, p in model:GetDescendants() do
  if p:IsA("BasePart") then
   p.Anchored = true; p.CanCollide = false; p.CanTouch = false; p.CanQuery = false
   transparency[p] = p.Transparency
  end
 end
 local mutation = state.player:GetAttribute("PetMutation")
 local variant = ({ Neon = "37F4FF", Frost = "CFF4FF", Golden = "FFD24A", Celestial = "B48CFF" })[mutation]
 if variant then
  local highlight = Instance.new("Highlight")
  highlight.Name = "RideVariant"; highlight.Adornee = model
  highlight.FillColor = Color3.fromHex(variant); highlight.FillTransparency = .72
  highlight.OutlineColor = Color3.fromHex(variant); highlight.OutlineTransparency = .15
  highlight.Parent = model
 end
 local old = state.model
 state.model = model; state.transparency = transparency; state.seat = seatOffset(model)
 state.pet = pet; state.hidden = false
 model:SetAttribute("Owner", state.player.UserId)
 model.Parent = mountsFolder
 if old then old:Destroy() end
 state.player:SetAttribute("RidingPet", pet)
 applyPose(state, groundPose(state))
 return true
end

function Riding.IsMounted(player: Player): boolean
 return states[player] ~= nil
end

function Riding.SetAiming(player: Player, active: boolean)
 aiming[player] = if active then true else nil
 local state = states[player]
 if state then state.input = Vector3.zero; state.lastInput = 0 end
end

-- moveAvatar=false is used before an existing world teleport / character removal.
function Riding.Dismount(player: Player, moveAvatar: boolean?): (boolean, string?)
 local state = states[player]
 if not state then return true, nil end
 if player:GetAttribute("Flying") and moveAvatar ~= false then return false, "Flying" end
 states[player] = nil
 if state.died then state.died:Disconnect() end
 if state.model then state.model:Destroy() end
 if state.root.Parent then
  if moveAvatar ~= false and state.humanoid.Health &gt; 0 then
   local standHeight = math.max(3, state.humanoid.HipHeight + state.root.Size.Y * .5)
   state.root.CFrame = groundPose(state) + Vector3.new(0, standHeight, 0)
  end
  state.root.Anchored = state.savedAnchored
  state.root.AssemblyLinearVelocity = Vector3.zero
  state.root.AssemblyAngularVelocity = Vector3.zero
 end
 if state.humanoid.Parent then
  state.humanoid.Sit = state.savedSit
  state.humanoid.AutoRotate = state.savedAutoRotate
  if state.humanoid.Health &gt; 0 and not state.savedSit then
   state.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
  end
 end
 if player.Parent then
  player:SetAttribute("Riding", false)
  player:SetAttribute("RidingPet", nil)
 end
 return true, nil
end

function Riding.Mount(player: Player): (boolean, string?)
 if states[player] then return true, nil end
 if player:GetAttribute("Traveling") then return false, "Busy" end
 if player:GetAttribute("DataReady") ~= true then return false, "NotReady" end
 local character, root, humanoid = characterParts(player)
 if not character or not root or not humanoid then return false, "NotReady" end
 local pet = equippedPet(player)
 if not pet or not templateFor(pet) then return false, "Unavailable" end
 local world = worldFor(player)
 local clamped = Riding.ClampHub(world, root.Position)
 if (Vector3.new(clamped.X, root.Position.Y, clamped.Z) - root.Position).Magnitude &gt; 12 then
  return false, "MountHub"
 end
 local o = world.origin
 local state = {
  player = player, character = character, root = root, humanoid = humanoid,
  world = world.id, position = Vector3.new(clamped.X, o[2] + 1.03, clamped.Z),
  forward = Vector3.new(0, 0, 1), input = Vector3.zero, lastInput = 0,
  savedAnchored = root.Anchored, savedSit = humanoid.Sit, savedAutoRotate = humanoid.AutoRotate,
  wasFlying = false, model = nil, hidden = false,
 }
 local look = root.CFrame.LookVector * Vector3.new(1,0,1)
 if look.Magnitude &gt; .1 then state.forward = look.Unit end
 local ground = groundAt(state, state.position)
 if ground then state.position = ground end
 if not newVisual(state, pet) then return false, "Unavailable" end
 states[player] = state
 root.Anchored = true; humanoid.AutoRotate = false; humanoid.Sit = true
 state.died = humanoid.Died:Connect(function() Riding.Dismount(player, false) end)
 player:SetAttribute("Riding", true)
 player:SetAttribute("RidingPet", pet)
 applyPose(state, groundPose(state))
 return true, nil
end

-- Called from Flight's authoritative simulation each step. Ground visuals are hidden;
-- Launch's existing interpolated client model supplies the visible flying animal.
function Riding.SetFlightPose(player: Player, cf: CFrame)
 local state = states[player]
 if not state then return end
 state.wasFlying = true; state.input = Vector3.zero; state.lastInput = 0
 setHidden(state, true)
 applyPose(state, cf, true)
end

function Riding.Step(dt: number)
 local step = math.clamp(dt, 0, 0.1)
 for player, state in states do
  if player.Parent ~= Players or player.Character ~= state.character or state.humanoid.Health &lt;= 0 then
   Riding.Dismount(player, false)
   continue
  end
  if player:GetAttribute("World") ~= state.world or player:GetAttribute("Traveling") then
   Riding.Dismount(player, false)
   continue
  end
  if player:GetAttribute("Flying") then continue end
  if state.wasFlying then
   state.wasFlying = false; setHidden(state, false)
   state.input = Vector3.zero; state.lastInput = 0
  end
  if not aiming[player] and os.clock() - state.lastInput &lt;= INPUT_TIMEOUT and state.input.Magnitude &gt; .01 then
   local world = worldFor(player)
   local desired = Riding.ClampHub(world, state.position + state.input * SPEED * step)
   local delta = desired - state.position
   -- A generous body box keeps the rider out of kiosks, trunks, walls and counters.
   local obstacle = if delta.Magnitude &gt; 0.001
    then workspace:Blockcast(CFrame.new(state.position + Vector3.new(0,3,0)), Vector3.new(3.5,3.5,4), delta, queryFor(state))
    else nil
   if not obstacle then
    local ground = groundAt(state, desired)
    if ground then state.position = ground; state.forward = state.input.Unit end
   end
  end
  applyPose(state, groundPose(state))
 end
end

local function watch(player: Player)
 if watched[player] then return end
 local connections = {}
 table.insert(connections, player.CharacterRemoving:Connect(function()
  aiming[player] = nil; Riding.Dismount(player, false)
 end))
 table.insert(connections, player:GetAttributeChangedSignal("PetId"):Connect(function()
  local state = states[player]
  if state and not player:GetAttribute("Flying") then
   local pet = equippedPet(player)
   if pet and pet ~= state.pet then newVisual(state, pet) end
  end
 end))
 table.insert(connections, player:GetAttributeChangedSignal("PetMutation"):Connect(function()
  local state = states[player]
  if state and not player:GetAttribute("Flying") then newVisual(state, state.pet) end
 end))
 table.insert(connections, player:GetAttributeChangedSignal("World"):Connect(function()
  aiming[player] = nil; Riding.Dismount(player, false)
 end))
 watched[player] = connections
end

function Riding.Init()
 if started then return end
 started = true
 local existing = workspace:FindFirstChild("LYM_Mounts")
 if existing and existing:IsA("Folder") then
  mountsFolder = existing
 else
  local folder = Instance.new("Folder"); folder.Name = "LYM_Mounts"; folder.Parent = workspace; mountsFolder = folder
 end
 Net.Handle("Mount.Toggle", {
  rate = { burst = 3, perSecond = 1 }, args = {},
  handler = function(player: Player): Net.Result
   if player:GetAttribute("Flying") then return Net.fail("Flying") end
   if player:GetAttribute("Traveling") or aiming[player] then return Net.fail("Busy") end
   local ok, code
   if states[player] then ok, code = Riding.Dismount(player) else ok, code = Riding.Mount(player) end
   return if ok then Net.ok({ mounted = states[player] ~= nil }) else Net.fail(code or "Unavailable")
  end,
 })
 Net.Listen("Mount.Input", {
  rate = { burst = 20, perSecond = 15 }, args = { Net.T.number(-1,1), Net.T.number(-1,1) },
  handler = function(player: Player, x: number, z: number)
   local state = states[player]
   if not state or player:GetAttribute("Flying") or player:GetAttribute("Traveling") or aiming[player] then return end
   state.input = Riding.ClampDirection(x,z); state.lastInput = os.clock()
  end,
 })
 RunService.Heartbeat:Connect(Riding.Step)
 Players.PlayerAdded:Connect(watch)
 Players.PlayerRemoving:Connect(function(player)
  aiming[player] = nil; Riding.Dismount(player,false)
  for _, connection in watched[player] or {} do connection:Disconnect() end
  watched[player] = nil
 end)
 for _, player in Players:GetPlayers() do watch(player) end
end
return Riding
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="LYMNEW5">
        <Properties>
          <string name="Name">ExactCreatureLoader</string>
          <ProtectedString name="Source">--!strict
-- Rebuild the user's ORIGINAL Three.js static creature geometry as Roblox meshes.
-- Native templates remain usable immediately. Call this from a background task.
-- Requires Roblox's EditableMesh capability; failure is explicit and never blocks play.
-- API permissions, rendering and replication MUST be checked in an actual Studio test.
local AssetService = game:GetService("AssetService")
local HttpService = game:GetService("HttpService")

local ExactCreatureLoader = {}
local started = false
-- Content.fromObject refers to live editable objects; retain them for this session.
local liveEditableMeshes = {}

local function readDefinition(source): any
 if source:IsA("StringValue") then return HttpService:JSONDecode(source.Value) end
 local chunks = source:GetChildren()
 table.sort(chunks, function(a, b) return a.Name &lt; b.Name end)
 local pieces = {}
 for _, chunk in chunks do
  if chunk:IsA("StringValue") then table.insert(pieces, chunk.Value) end
 end
 return HttpService:JSONDecode(table.concat(pieces))
end

local function basePart(part: BasePart)
 part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
 part.CastShadow = false
end

local function makeBatch(spec, batch, model, kept)
 local editable = AssetService:CreateEditableMesh()
 if not editable then error("EditableMesh allocation unavailable (permission or memory budget)") end
 table.insert(kept, editable)
 local low = Vector3.new(math.huge, math.huge, math.huge)
 local high = Vector3.new(-math.huge, -math.huge, -math.huge)
 for i = 1, #batch.p, 3 do
  local v = Vector3.new(batch.p[i], batch.p[i + 1], batch.p[i + 2])
  low = low:Min(v); high = high:Max(v)
 end
 local center = (low + high) * 0.5
 local extent = high - low
 local vertices = {}
 for i = 1, #batch.p, 3 do
  vertices[#vertices + 1] = editable:AddVertex(Vector3.new(batch.p[i], batch.p[i + 1], batch.p[i + 2]) - center)
  if i % 3072 == 1 then task.wait() end
 end
 local colors = {}
 for i = 1, #batch.c, 3 do
  -- Alpha is applied once on the MeshPart, not twice via vertex alpha.
  colors[#colors + 1] = editable:AddColor(Color3.new(batch.c[i], batch.c[i + 1], batch.c[i + 2]), 1)
 end
 for i = 1, #batch.t, 3 do
  local a, b, c = batch.t[i] + 1, batch.t[i + 1] + 1, batch.t[i + 2] + 1
  local function point(index)
   local j = (index - 1) * 3 + 1
   return Vector3.new(batch.p[j], batch.p[j + 1], batch.p[j + 2])
  end
  local normal = (point(b) - point(a)):Cross(point(c) - point(a))
  -- Degenerate source triangles have no visible surface and cannot define a normal.
  if normal.Magnitude &gt; 1e-7 then
   local face = editable:AddTriangle(vertices[a], vertices[b], vertices[c])
   editable:SetFaceColors(face, {
    colors[batch.ci[a] + 1], colors[batch.ci[b] + 1], colors[batch.ci[c] + 1],
   })
   local normalId = editable:AddNormal(normal.Unit)
   editable:SetFaceNormals(face, { normalId, normalId, normalId })
  end
  if i % 6000 == 1 then task.wait() end
 end
 local part = AssetService:CreateMeshPartAsync(Content.fromObject(editable), {
  CollisionFidelity = Enum.CollisionFidelity.Box,
  RenderFidelity = Enum.RenderFidelity.Automatic,
 })
 part.Name = if batch.neon then "OriginalGlowMesh" else "OriginalBodyMesh"
 basePart(part)
 part.DoubleSided = true
 part.Material = if batch.neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
 part.Color = Color3.new(1, 1, 1)
 part.Transparency = 1 - math.clamp(batch.opacity or 1, 0, 1)
 -- Vertices were centered explicitly, so mesh bounds and part CFrame line up exactly.
 part.Size = Vector3.new(math.max(extent.X, 0.001), math.max(extent.Y, 0.001), math.max(extent.Z, 0.001))
 part.CFrame = CFrame.new(center)
 part.Parent = model
end

local function buildModel(spec)
 local model = Instance.new("Model")
 model.Name = spec.id
 model:SetAttribute("ArtSource", "OriginalThreeJSGeometry")
 model:SetAttribute("OriginalTriangleCount", spec.triangles)
 local kept = {}
 local ok, err = pcall(function()
  local root = Instance.new("Part")
  root.Name = "Root"; root.Size = Vector3.new(0.2, 0.2, 0.2)
  root.Transparency = 1; root.CFrame = CFrame.identity
  basePart(root); root.Parent = model; model.PrimaryPart = root
  local seat = Instance.new("Attachment")
  seat.Name = "RideSeat"
  seat.CFrame = CFrame.new(spec.seat[1], spec.seat[2], spec.seat[3])
  seat.Parent = root
  for _, batch in spec.groups do makeBatch(spec, batch, model, kept) end
 end)
 if not ok then
  model:Destroy()
  for _, editable in kept do pcall(function() editable:Destroy() end) end
  error(tostring(err))
 end
 for _, editable in kept do table.insert(liveEditableMeshes, editable) end
 return model
end

-- geometryFolder contains one StringValue per creature OR one Folder per creature
-- with numbered StringValue chunks. Each concatenation is the corresponding JSON
-- object in assets/exact_creatures.json.creatures (not the entire file envelope).
function ExactCreatureLoader.Upgrade(assetModels: Instance, geometryFolder: Instance)
 if started then return { upgraded = 0, alreadyStarted = true } end
 started = true
 local monsters = assetModels:FindFirstChild("Monsters")
 if not monsters then return { upgraded = 0, error = "Missing Monsters template folder" } end
 local backup = assetModels:FindFirstChild("NativeCreatureFallbacks")
 if not backup then
  backup = Instance.new("Folder"); backup.Name = "NativeCreatureFallbacks"; backup.Parent = assetModels
 end
 assetModels:SetAttribute("ExactArtStatus", "Building")
 local sources = geometryFolder:GetChildren()
 table.sort(sources, function(a,b) return a.Name &lt; b.Name end)
 local upgraded = 0
 for _, source in sources do
  local ok, result = pcall(function()
   local spec = readDefinition(source)
   assert(type(spec.id) == "string" and type(spec.groups) == "table", "Invalid original creature geometry")
   return buildModel(spec)
  end)
  if not ok then
   -- A capability failure will repeat for every creature; stop once and retain all
   -- remaining native art instead of spamming sixteen API/permission errors.
   assetModels:SetAttribute("ExactArtStatus", if upgraded &gt; 0 then "PartialFallback" else "NativeFallback")
   assetModels:SetAttribute("ExactArtError", tostring(result):sub(1, 240))
   warn("[CreatureArt] Original geometry not fully available; native art remains active: " .. tostring(result))
   return { upgraded = upgraded, error = tostring(result), fallback = #sources - upgraded }
  end
  local model = result
  local old = monsters:FindFirstChild(model.Name)
  if old then old.Parent = backup end
  model.Parent = monsters
  upgraded += 1
  assetModels:SetAttribute("CreatureArtRevision", upgraded)
 end
 assetModels:SetAttribute("ExactArtStatus", "OriginalGeometryReady")
 return { upgraded = upgraded, fallback = 0 }
end

return ExactCreatureLoader
</ProtectedString>
