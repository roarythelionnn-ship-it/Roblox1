          <string name="ScriptGuid">{8C6E5A78-2A0D-48A3-A477-FA7C207EF0C3}</string>
          <BinaryString name="AttributesSerialize" />
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <bool name="DefinesCapabilities">false</bool>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <string name="Name">GameConfig</string>
          <BinaryString name="SerializedOverrides" />
          <int64 name="SourceAssetId">-1</int64>
          <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
          <UniqueId name="UniqueId">038c44eb3ebffb0c0af64a9d000003e7</UniqueId>
          <ProtectedString name="Source">-- GameConfig: every tunable number in one place (balance start points from the design brief).
-- Pure module: no Roblox services, so it also runs under Lune tests.

local GameConfig = {}

GameConfig.MaxCurrency = 1e15
GameConfig.InventoryCap = 150

GameConfig.Flight = {
	Gravity = 28, -- studs/s^2, flight only (characters keep normal gravity)
	Drag = 0.015, -- fraction of speed lost per second
	Step = 1 / 60, -- fixed simulation step
	MaxCatchUpSteps = 8,
	MaxDuration = 35,
	SpeedCap = 350,
	MinLaunchSpeed = 60,
	MinAngle = 30,
	MaxAngle = 60,
	DefaultAngle = 45,
	BaseSpeed = 85,
	PowerSpeed = 2.6, -- per Power level
	CannonSpeed = 8, -- per Cannon level
	Timing = { Miss = 0.9, Good = 1.0, Perfect = 1.1 },
	-- Power marker: ping-pong 0..1 over Period seconds. Perfect zone is ~15% of the bar.
	MarkerPeriod = 1.5,
	MarkerPeriodSlow = 2.4, -- accessibility "slow timing", same rewards
	PerfectZone = { 0.79, 0.94 },
	GoodZone = { 0.55, 1.0 },
	AimTimeout = 20,
	-- Steering
	SteerAccel = 26,
	SteerMaxSpeed = 22,
	-- Air Boost (once per flight)
	BoostBase = 9,
	BoostPerLevel = 2.5,
	BoostForward = 0.85,
	BoostUp = 0.6,
	-- Bounce pads
	BounceWindow = 0.2, -- seconds before/after contact (~400 ms total)
	BounceVertical = 0.58,
	BounceForward = 0.97,
	BounceTechPerLevel = 0.03,
	PerfectBounceVertical = 1.12,
	PerfectBounceForward = 1.04,
	MaxBounces = 6,
	-- Ground contact
	SkipMinFallSpeed = 24,
	SkipVertical = 0.4,
	SkipForward = 0.8,
	MaxSkips = 2,
	SlideFriction = 110,
	-- Rings
	RingSpeedBonus = 3,
	MagnetPerLevel = 1.5, -- extra ring radius per Coin Magnet level
	Radius = 1.6, -- logical monster sphere radius
	Ceiling = 520,
	SnapshotRate = 10, -- per second, all flights batched
}

GameConfig.Rewards = {
	CoinsPerStud = 0.42,
	MinCoins = 25,
	ComboPerRing = 0.04,
	ComboPerPerfectBounce = 0.08,
	ComboPerfectLaunch = 0.1,
	ComboCap = 1.5,
	PrestigeBonus = 0.05,
	PetXpBase = 5,
	PetXpPerStuds = 40,
	PetXpCap = 80,
	TrivialDistance = 40, -- below this, flights grant the minimum only
}

GameConfig.Training = {
	MaxLevel = 50,
	Cooldown = 2.2,
	Xp = { Miss = 4, Good = 8, Perfect = 14 },
}

function GameConfig.trainingXpForLevel(level: number): number
	return math.floor(20 * 1.12 ^ (level - 1))
end

GameConfig.PetLevel = { Max = 25, SpeedPerLevel = 0.004 } -- max +9.6% from level

function GameConfig.petXpForLevel(level: number): number
	return math.floor(30 + level * 18)
end

-- Upgrades. cost(level) = price to go from `level` to `level + 1`.
GameConfig.Upgrades = {
	{
		id = "Cannon",
		field = "CannonLevel",
		name = "Cannon Power",
		desc = "+8 launch speed per level",
		min = 0,
		max = 20,
		cost = function(level: number): number
			return math.floor(100 * 1.35 ^ level + 0.5)
		end,
	},
	{
		id = "Boost",
		field = "BoostLevel",
		name = "Air Boost",
		desc = "Stronger mid-air boost",
		min = 1,
		max = 5,
		costs = { 400, 1200, 4000, 12000 },
	},
	{
		id = "Bounce",
		field = "BounceLevel",
		name = "Bounce Tech",
		desc = "Keep more speed on bounce pads",
		min = 0,
		max = 5,
		costs = { 500, 2000, 6000, 18000, 50000 },
	},
	{
		id = "Magnet",
		field = "MagnetLevel",
		name = "Coin Magnet",
		desc = "Rings are easier to catch",
		min = 0,
		max = 3,
		costs = { 800, 5000, 25000 },
	},
}
GameConfig.UpgradeById = {}
for _, upgrade in GameConfig.Upgrades do
	GameConfig.UpgradeById[upgrade.id] = upgrade
end

-- Price for the next level, or nil when maxed.
function GameConfig.upgradeCost(upgrade, level: number): number?
	if level &gt;= upgrade.max or level &lt; upgrade.min then
		return nil
	end
	if upgrade.cost then
		return upgrade.cost(level)
	end
	return upgrade.costs[level - upgrade.min + 1]
end

function GameConfig.boostImpulse(boostLevel: number): number
	return GameConfig.Flight.BoostBase + GameConfig.Flight.BoostPerLevel * (boostLevel - 1)
end

-- Launch speed from progression + timing (formula from the design brief).
function GameConfig.launchSpeed(powerLevel: number, cannonLevel: number, petBonus: number, timing: number): number
	local f = GameConfig.Flight
	local raw = (f.BaseSpeed + f.PowerSpeed * powerLevel + f.CannonSpeed * cannonLevel) * (1 + petBonus)
	return math.clamp(raw * timing, f.MinLaunchSpeed, f.SpeedCap)
end

-- Ping-pong power marker position (0..1) for elapsed seconds.
function GameConfig.markerAt(elapsed: number, period: number): number
	local phase = (elapsed / period) % 2
	return if phase &lt;= 1 then phase else 2 - phase
end

function GameConfig.timingFor(marker: number): string
	local f = GameConfig.Flight
	if marker &gt;= f.PerfectZone[1] and marker &lt;= f.PerfectZone[2] then
		return "Perfect"
	elseif marker &gt;= f.GoodZone[1] and marker &lt;= f.GoodZone[2] then
		return "Good"
	end
	return "Miss"
end

function GameConfig.coinsFor(distance: number, combo: number, prestige: number): number
	local r = GameConfig.Rewards
	local base = math.max(r.MinCoins, math.floor(distance * r.CoinsPerStud))
	local mult = math.min(combo, r.ComboCap) * (1 + r.PrestigeBonus * prestige)
	return math.floor(base * mult)
end

function GameConfig.comboFor(rings: number, perfectBounces: number, perfectLaunch: boolean): number
	local r = GameConfig.Rewards
	local combo = 1 + rings * r.ComboPerRing + perfectBounces * r.ComboPerPerfectBounce
	if perfectLaunch then
		combo += r.ComboPerfectLaunch
	end
	return math.min(combo, r.ComboCap)
end

function GameConfig.petXpFor(distance: number): number
	local r = GameConfig.Rewards
	if distance &lt; r.TrivialDistance then
		return 1
	end
	return math.min(r.PetXpCap, r.PetXpBase + math.floor(distance / r.PetXpPerStuds))
end

GameConfig.Rarities = {
	Common = { order = 1, color = { 175, 190, 219 }, shards = 1 },
	Uncommon = { order = 2, color = { 50, 214, 154 }, shards = 2 },
	Rare = { order = 3, color = { 73, 107, 255 }, shards = 4 },
	Epic = { order = 4, color = { 139, 92, 255 }, shards = 8 },
	Legendary = { order = 5, color = { 255, 207, 85 }, shards = 20 },
}

-- Deterministic cosmetic mutations (no random rerolls, no power).
GameConfig.Mutations = {
	{ id = "Neon", shards = 30, minLevel = 1 },
	{ id = "Frost", shards = 60, minLevel = 5 },
	{ id = "Golden", shards = 120, minLevel = 10 },
	{ id = "Celestial", shards = 250, minLevel = 15 },
}
GameConfig.MutationById = {}
for _, mutation in GameConfig.Mutations do
	GameConfig.MutationById[mutation.id] = mutation
end

-- Missions: three per UTC day, picked deterministically from this pool.
GameConfig.MissionPool = {
	{ id = "launches5", stat = "launches", goal = 5, reward = 300, text = "Make 5 launches" },
	{ id = "rings8", stat = "rings", goal = 8, reward = 350, text = "Hit 8 rings" },
	{ id = "perfect3", stat = "perfectLaunches", goal = 3, reward = 400, text = "Perfect Launch 3 times" },
	{ id = "boost4", stat = "boosts", goal = 4, reward = 250, text = "Use Air Boost 4 times" },
	{ id = "hatch1", stat = "hatches", goal = 1, reward = 300, text = "Hatch 1 egg" },
	{ id = "reach1200", stat = "bestToday", goal = 1200, reward = 600, text = "Reach 1,200 studs" },
	{ id = "bounce5", stat = "perfectBounces", goal = 5, reward = 450, text = "Perfect Bounce 5 times" },
	{ id = "train10", stat = "trains", goal = 10, reward = 250, text = "Train Power 10 times" },
}
GameConfig.MissionsPerDay = 3

-- Picks today's missions with a seeded shuffle of the pool (same result on every server).
function GameConfig.missionsForDay(day: number): { any }
	local pool = table.clone(GameConfig.MissionPool)
	local seed = (day * 9301 + 49297) % 233280
	for i = #pool, 2, -1 do
		seed = (seed * 9301 + 49297) % 233280
		local j = seed % i + 1
		pool[i], pool[j] = pool[j], pool[i]
	end
	return { pool[1], pool[2], pool[3] }
end

GameConfig.Prestige = {
	Enabled = true,
	MinWorld3Best = 3000,
	Cost = 100000,
	MaxStacks = 5,
}

GameConfig.World2Unlock = { bestWorld = "SunnySpringlands", best = 1100, cost = 3000 }
GameConfig.World3Unlock = { bestWorld = "CloudtopCircuit", best = 2200, cost = 30000 }

GameConfig.DefaultSettings = {
	music = true,
	sfx = true,
	cameraShake = true,
	reducedMotion = false,
	highContrast = false,
	bloom = true,
	slowTiming = false,
	hideOthers = false,
	rareAnnouncements = true,
	showTutorial = true,
}

-- Cosmetic passes: real IDs must be supplied by the owner before anything is sold.
GameConfig.Passes = {
	{ id = "RainbowTrail", name = "Rainbow Flight Trail", robux = 79, passId = 0 },
	{ id = "GalaxyCannon", name = "Galaxy Cannon Skin", robux = 149, passId = 0 },
	{ id = "Celebrations", name = "Emote &amp; Celebration Pack", robux = 99, passId = 0 },
}

return GameConfig
</ProtectedString>
