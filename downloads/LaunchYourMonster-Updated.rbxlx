          <ProtectedString name="Source">-- WorldConfig: the single source of truth for every course. The server simulation and
-- the world builder both read it, so visuals and physics never drift apart.
-- Course coordinates are LOCAL: x = lateral, y = height, z = forward from the cannon.
-- World position = origin + local. Pure module (no Roblox services).

export type Ring = { x: number, y: number, z: number, r: number }
export type Pad = { x: number, z: number, w: number, d: number, y: number, kind: string, retention: number? }
export type Tunnel = {
	x: number,
	y: number,
	z: number,
	sx: number,
	sy: number,
	sz: number,
	ax: number,
	ay: number,
	az: number,
}

local WorldConfig = {}

local function ring(x, y, z, r): Ring
	return { x = x, y = y, z = z, r = r or 10 }
end

local function pad(x, z, w, d, kind, retention): Pad
	return { x = x, z = z, w = w, d = d, y = 3, kind = kind or "pad", retention = retention }
end

local function tunnel(x, y, z, sx, sy, sz, ay, az): Tunnel
	return { x = x, y = y, z = z, sx = sx, sy = sy, sz = sz, ax = 0, ay = ay, az = az }
end

local worlds = {
	{
		id = "SunnySpringlands",
		order = 1,
		name = "Sunny Springlands",
		origin = { 0, 0, 0 },
		length = 1600,
		laneHalf = 70,
		groundY = 0,
		muzzle = { 0, 14, 0 },
		egg = "MeadowEgg",
		launcher = "Spring Cannon",
		palette = { "8FDB72", "73D5FA", "FFF1C9", "FF8579", "FFC85B" },
		rings = {
			ring(0, 62, 70),
			ring(0, 84, 150),
			ring(0, 56, 230),
			ring(0, 92, 420),
			ring(-18, 110, 560),
			ring(18, 100, 720),
			ring(0, 92, 900),
			ring(-15, 80, 1100),
			ring(0, 70, 1300),
			ring(10, 55, 1480),
		},
		pads = {
			pad(0, 330, 70, 180), -- early safe platform: miss, good and perfect first flights all land here
			pad(10, 560, 44, 50),
			pad(0, 720, 40, 40, "spring", 0.82), -- spring trampoline
			pad(-15, 880, 44, 50),
			pad(0, 1080, 44, 50),
			pad(12, 1320, 40, 46),
		},
		tunnels = {
			tunnel(0, 70, 620, 36, 36, 90, 10, 45), -- floating rock tunnel
			tunnel(0, 60, 1180, 36, 36, 100, 8, 50),
		},
		hub = {
			spawn = { 0, 3, -58 },
			eggStand = { -28, 0, -50 },
			kiosk = { 28, 0, -50 },
			training = { -30, 0, -75 },
			board = { 0, 0, -96 },
			portals = {
				{ target = "CloudtopCircuit", pos = { 34, 0, -78 } },
				{ target = "NebulaWilds", pos = { 40, 0, -62 } },
			},
		},
	},
	{
		id = "CloudtopCircuit",
		order = 2,
		name = "Cloudtop Circuit",
		origin = { 3000, 0, 0 },
		length = 2600,
		laneHalf = 80,
		groundY = 0,
		muzzle = { 0, 20, 0 },
		egg = "StormEgg",
		launcher = "Sky Rail Launcher",
		palette = { "8FD9FF", "D5B6FF", "F9F5FF", "FFD17A" },
		rings = {},
		pads = {},
		tunnels = {
			tunnel(-35, 90, 700, 34, 34, 140, 6, 60), -- left route
			tunnel(35, 80, 1500, 34, 34, 160, 6, 65), -- right route
			tunnel(0, 70, 2150, 40, 40, 140, 10, 55),
		},
		hub = {
			spawn = { 0, 3, -58 },
			eggStand = { -28, 0, -50 },
			kiosk = { 28, 0, -50 },
			board = { 0, 0, -96 },
			portals = { { target = "SunnySpringlands", pos = { 34, 0, -78 } } },
		},
	},
	{
		id = "NebulaWilds",
		order = 3,
		name = "Nebula Wilds",
		origin = { 6000, 0, 0 },
		length = 4200,
		laneHalf = 90,
		groundY = 0,
		muzzle = { 0, 24, 0 },
		egg = "CosmicEgg",
		launcher = "Quantum Reactor Cannon",
		palette = { "141A45", "6536CD", "EB62FF", "37F4FF", "FFDE70" },
		rings = {},
		pads = {},
		tunnels = {
			tunnel(0, 60, 900, 40, 60, 80, 40, 20), -- plasma updraft
			tunnel(-30, 70, 1900, 40, 60, 90, 45, 25),
			tunnel(30, 70, 2900, 40, 60, 90, 45, 25),
			tunnel(0, 60, 3600, 44, 60, 100, 40, 30),
		},
		hub = {
			spawn = { 0, 3, -58 },
			eggStand = { -28, 0, -50 },
			kiosk = { 28, 0, -50 },
			board = { 0, 0, -96 },
			portals = { { target = "SunnySpringlands", pos = { 34, 0, -78 } } },
		},
	},
}

-- World 2: ring routes that weave left/right, cloud cushions every ~330 studs.
do
	local w = worlds[2]
	for i = 0, 15 do
		local z = 160 + i * 145
		local side = if i % 3 == 1 then -22 elseif i % 3 == 2 then 22 else 0
		table.insert(w.rings, ring(side, 70 + (i % 4) * 14, z))
	end
	for i = 0, 6 do
		table.insert(w.pads, pad(if i % 2 == 0 then 0 else -18, 360 + i * 330, 50, 56, "cloud", 0.66))
	end
end

-- World 3: long ring lines, bounce crystals and a high secret ring sequence.
do
	local w = worlds[3]
	for i = 0, 22 do
		local z = 180 + i * 172
		table.insert(w.rings, ring(math.sin(i * 0.9) * 28, 80 + (i % 5) * 16, z))
	end
	for i = 0, 2 do
		table.insert(w.rings, ring(55, 210, 1400 + i * 60, 12)) -- secret sequence
	end
	for i = 0, 8 do
		table.insert(w.pads, pad(if i % 2 == 0 then 0 else 20, 420 + i * 420, 46, 52, "crystal", 0.7))
	end
end

WorldConfig.List = worlds
WorldConfig.ById = {}
for _, world in worlds do
	WorldConfig.ById[world.id] = world
end
WorldConfig.Home = "SunnySpringlands"

return WorldConfig
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5707366509544268BA72FB1A7724A1CC">
        <Properties>
