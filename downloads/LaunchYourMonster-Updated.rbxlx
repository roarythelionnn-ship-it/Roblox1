            <ProtectedString name="Source">--!strict
-- Look: per-world sky + lighting presets. Values come from the LihFolk Asset Pack
-- (Skies/&lt;id&gt;/lighting.json, family status "pass"); face ids are the uploaded copies.

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local Look = {}

Look.Worlds = {
	SunnySpringlands = {
		source = "Skies/clear_day_azure_004",
		faces = { Bk = "rbxassetid://102524823964737", Dn = "rbxassetid://100227286035080", Ft = "rbxassetid://138570838064665", Lf = "rbxassetid://134170570903521", Rt = "rbxassetid://124954775714828", Up = "rbxassetid://96180455663396" },
		lighting = { Brightness = 2.5, ClockTime = 13.5, GeographicLatitude = 0, Ambient = rgb({ 105, 110, 132 }), OutdoorAmbient = rgb({ 141, 149, 170 }), ColorShift_Top = rgb({ 255, 243, 217 }), ColorShift_Bottom = rgb({ 0, 0, 0 }), EnvironmentDiffuseScale = 0.3, EnvironmentSpecularScale = 0, ExposureCompensation = 0 },
		atmosphere = { Density = 0.25, Offset = 0.1, Color = rgb({ 170, 204, 239 }), Decay = rgb({ 164, 200, 236 }), Glare = 0, Haze = 0.5 },
		grade = { Brightness = 0.02, Contrast = 0.08, Saturation = 0.15, TintColor = rgb({ 255, 255, 255 }) },
		bloom = 0.5,
	},
	CloudtopCircuit = {
		source = "Skies/golden_hour_peach_002",
		faces = { Bk = "rbxassetid://131633800184590", Dn = "rbxassetid://131932511631753", Ft = "rbxassetid://95043838295588", Lf = "rbxassetid://124352591235304", Rt = "rbxassetid://123660405420891", Up = "rbxassetid://106714034634398" },
		lighting = { Brightness = 2.2, ClockTime = 17.6, GeographicLatitude = 30, Ambient = rgb({ 92, 69, 69 }), OutdoorAmbient = rgb({ 134, 98, 89 }), ColorShift_Top = rgb({ 255, 214, 161 }), ColorShift_Bottom = rgb({ 60, 40, 80 }), EnvironmentDiffuseScale = 0.4, EnvironmentSpecularScale = 0, ExposureCompensation = 0 },
		atmosphere = { Density = 0.35, Offset = 0.2, Color = rgb({ 232, 183, 173 }), Decay = rgb({ 223, 195, 191 }), Glare = 0.4, Haze = 1.5 },
		grade = { Brightness = 0, Contrast = 0.1, Saturation = 0.1, TintColor = rgb({ 255, 250, 245 }) },
		bloom = 0.45,
	},
	NebulaWilds = {
		source = "Skies/night_stars_indigo_001",
		faces = { Bk = "rbxassetid://90433606846489", Dn = "rbxassetid://101543065449469", Ft = "rbxassetid://85642547048102", Lf = "rbxassetid://77219752453556", Rt = "rbxassetid://123642143529603", Up = "rbxassetid://118793121633585" },
		lighting = { Brightness = 0.6, ClockTime = 0, GeographicLatitude = 0, Ambient = rgb({ 58, 64, 123 }), OutdoorAmbient = rgb({ 77, 85, 160 }), ColorShift_Top = rgb({ 239, 240, 255 }), ColorShift_Bottom = rgb({ 0, 0, 0 }), EnvironmentDiffuseScale = 0.2, EnvironmentSpecularScale = 0, ExposureCompensation = 0.2 },
		atmosphere = { Density = 0.3, Offset = 0, Color = rgb({ 57, 42, 99 }), Decay = rgb({ 58, 43, 99 }), Glare = 0, Haze = 0.5 },
		grade = { Brightness = 0, Contrast = 0.05, Saturation = -0.05, TintColor = rgb({ 245, 242, 255 }) },
		bloom = 0.9,
	},
}

-- Applies a world's look to a Lighting service (server baseline or client per world).
function Look.apply(lighting: Lighting, worldId: string)
	local preset = Look.Worlds[worldId] or Look.Worlds.SunnySpringlands
	pcall(function()
		(lighting :: any).LightingStyle = Enum.LightingStyle.Soft
	end)
	for key, value in preset.lighting do
		(lighting :: any)[key] = value
	end
	local sky = lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
	sky.SkyboxBk = preset.faces.Bk
	sky.SkyboxDn = preset.faces.Dn
	sky.SkyboxFt = preset.faces.Ft
	sky.SkyboxLf = preset.faces.Lf
	sky.SkyboxRt = preset.faces.Rt
	sky.SkyboxUp = preset.faces.Up
	sky.CelestialBodiesShown = false
	sky.StarCount = 0
	sky.Parent = lighting
	local atmosphere = lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	for key, value in preset.atmosphere do
		(atmosphere :: any)[key] = value
	end
	atmosphere.Parent = lighting
	local function effect(name: string, className: string): any
		local existing = lighting:FindFirstChild(name)
		if existing then
			return existing
		end
		local created = Instance.new(className)
		created.Name = name
		return created
	end
	local grade = effect("LYM_Grade", "ColorCorrectionEffect")
	for key, value in preset.grade do
		grade[key] = value
	end
	grade.Parent = lighting
	local bloom = effect("LYM_Bloom", "BloomEffect")
	bloom.Threshold = 1.6
	bloom.Size = 24
	bloom.Intensity = preset.bloom
	bloom.Parent = lighting
end

return Look
