          <ProtectedString name="Source">-- LAUNCH YOUR MONSTER! server bootstrap.
-- Order: lighting -&gt; worlds -&gt; services register handlers -&gt; remote router -&gt; profiles
-- (characters spawn once their profile is loaded).
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

Players.CharacterAutoLoads = false

for _, name in { "Baseplate", "SpawnLocation" } do
	local object = workspace:FindFirstChild(name)
	if object then
		object:Destroy()
	end
end

Lighting.ClockTime = 14
Lighting.Brightness = 2.4
Lighting.Ambient = Color3.fromRGB(150, 150, 165)
Lighting.OutdoorAmbient = Color3.fromRGB(175, 180, 195)
Lighting.EnvironmentDiffuseScale = 0.7
Lighting.EnvironmentSpecularScale = 0.5
Lighting.GlobalShadows = true
if not Lighting:FindFirstChildOfClass("Atmosphere") then
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Haze = 0.6
	atmosphere.Color = Color3.fromHex("CDEFFF")
	atmosphere.Decay = Color3.fromHex("8FD9FF")
	atmosphere.Parent = Lighting
end

local started = os.clock()
local WorldBuilder = require(script.World.WorldBuilder)
WorldBuilder.build()
print(string.format("[LYM] worlds built in %.2fs", os.clock() - started))

local Services = script.Services
local Net = require(Services.Net)
local ProfileService = require(Services.ProfileService)
local FlightService = require(Services.FlightService)
local ProgressionService = require(Services.ProgressionService)
local PetService = require(Services.PetService)
local WorldService = require(Services.WorldService)

FlightService.init()
ProgressionService.init()
PetService.init()
WorldService.init()
Net.start()
ProfileService.start()

-- Server leaderboard boards: top 8 best distances in this server
task.spawn(function()
	local CollectionService = game:GetService("CollectionService")
	while true do
		local rows = {}
		for _, player in Players:GetPlayers() do
			local stats = player:FindFirstChild("leaderstats")
			if stats then
				table.insert(rows, { name = player.DisplayName, best = stats.BestDistance.Value })
			end
		end
		table.sort(rows, function(a, b)
			return a.best &gt; b.best
		end)
		local lines = { "SERVER BEST DISTANCE" }
		for i = 1, math.min(8, #rows) do
			table.insert(lines, `{i}. {rows[i].name}  -  {rows[i].best} studs`)
		end
		if #rows == 0 then
			table.insert(lines, "Be the first to launch!")
		end
		for _, board in CollectionService:GetTagged("LYM_Board") do
			local gui = board:FindFirstChild("BoardGui")
			if not gui then
				gui = Instance.new("SurfaceGui")
				gui.Name = "BoardGui"
				gui.Face = Enum.NormalId.Front
				gui.PixelsPerStud = 30
				gui.LightInfluence = 0
				local label = Instance.new("TextLabel")
				label.Name = "Text"
				label.Size = UDim2.fromScale(1, 1)
				label.BackgroundTransparency = 1
				label.TextColor3 = Color3.fromHex("F7FAFF")
				label.TextScaled = true
				label.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
				label.Parent = gui
				gui.Parent = board
			end
			gui.Text.Text = table.concat(lines, "\n")
		end
		task.wait(10)
	end
end)

-- Studio-only test hook (ServerStorage never replicates). Used for automated MCP tests.
if RunService:IsStudio() then
	local Shared = game:GetService("ReplicatedStorage").Shared
	local FlightSim = require(Shared.FlightSim)
	local hook = Instance.new("BindableFunction")
	hook.Name = "LYM_Debug"
	hook.OnInvoke = function(command: string, ...)
		local args = { ... }
		local player = Players:GetPlayers()[1]
		if not player then
			return nil
		end
		if command == "get" then
			return ProfileService.deepCopy(ProfileService.get(player))
		elseif command == "set" then
			local data = ProfileService.get(player)
			data[args[1]] = args[2]
			ProfileService.mark(player, args[1])
			return true
		elseif command == "launch" then
			local flight = FlightService.start(player, args[1] or "Good", args[2] or 45)
			return flight and flight.id
		elseif command == "input" then
			local flight = FlightService.isFlying(player)
			if flight then
				FlightService.applyInput(player, { id = args[2], kind = args[1], value = args[3] })
			end
			return flight
		elseif command == "flying" then
			return FlightService.isFlying(player)
		elseif command == "travel" then
			return WorldService.travel(player, args[1])
		elseif command == "give" then
			local entry = PetService.give(player, args[1])
			return entry and entry.uniqueId
		elseif command == "sim" then
			local world = require(Shared.WorldConfig).ById[args[1]]
			local state = FlightSim.simulate(world, args[2])
			return FlightSim.distance(state), state.endReason
		end
		return nil
	end
	hook.Parent = game:GetService("ServerStorage")
end

print("[LYM] server started")
