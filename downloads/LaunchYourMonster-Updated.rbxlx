          <ProtectedString name="Source">--!strict
-- LihFolk Systems: Quests
-- Install: ServerScriptService/LihFolk/Quests (ModuleScript)
--
-- Quests are data. Progress is reported ONLY by server systems
-- (Quests.Report(player, "Collect", "Coin", 1) from your pickup code), never by
-- a client remote. A quest is active when every quest in `requires` has been
-- claimed and it has not been claimed itself; this covers linear chains and
-- parallel quests. Claiming checks completion and bag space, then marks and
-- grants in one synchronous block.
-- Remotes: Quests.Get() -&gt; list, Quests.Claim(questId)
-- Push:    Quests.Changed(list), coalesced to at most one per 0.5 s per player
-- Status: reviewed, not run in Studio.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("LihFolk")
local Net = require(Shared:WaitForChild("Net"))
local PlayerData = require(script.Parent.PlayerData)
local Rewards = require(script.Parent.Rewards)

local T = Net.T
local GameConfig = require(ReplicatedStorage:WaitForChild("Game"):WaitForChild("GameConfig"))
local DailyRules = require(script.Parent.Parent.Game.DailyMissionRules)
local function today(state)
	local day = math.floor(os.time() / 86400)
	DailyRules.reset(state, day)
	return day, GameConfig.missionsForDay(day)
end

export type Objective = { kind: string, target: string, amount: number, text: string? }

export type QuestDef = {
	id: string,
	title: string,
	objectives: { Objective },
	reward: Rewards.Reward,
	requires: { string }?,
}

export type Config = { quests: { QuestDef } }

type State = { DailyDay: number?, DailyProgress: { [string]: number }?, DailyClaimed: { [string]: boolean }?, Progress: { [string]: { number } }, Claimed: { [string]: number } }

local Quests = {}

local list: { QuestDef } = {}
local byId: { [string]: QuestDef } = {}
local changedPush: Net.Push? = nil
local pushPending: { [Player]: boolean } = {}
local PUSH_INTERVAL = 0.5

---------------------------------------------------------------------------
-- Pure (exported for tests)
---------------------------------------------------------------------------

function Quests.isActive(quest: QuestDef, claimed: { [string]: number }): boolean
	if claimed[quest.id] then
		return false
	end
	for _, required in quest.requires or {} do
		if not claimed[required] then
			return false
		end
	end
	return true
end

-- Adds amount to matching objectives (target "*" matches any). Returns true if anything changed.
function Quests.applyProgress(quest: QuestDef, progress: { number }, kind: string, target: string, amount: number): boolean
	local changed = false
	for i, objective in quest.objectives do
		if objective.kind == kind and (objective.target == target or objective.target == "*") then
			local current = progress[i] or 0
			if current &lt; objective.amount then
				progress[i] = math.min(objective.amount, current + amount)
				changed = true
			end
		end
	end
	-- Keep the array dense for saving.
	for i = 1, #quest.objectives do
		if progress[i] == nil then
			progress[i] = 0
		end
	end
	return changed
end

function Quests.isComplete(quest: QuestDef, progress: { number }?): boolean
	for i, objective in quest.objectives do
		if not progress or (progress[i] or 0) &lt; objective.amount then
			return false
		end
	end
	return true
end

---------------------------------------------------------------------------
-- Internals
---------------------------------------------------------------------------

local function stateOf(profile: PlayerData.Profile): State
	return profile.Data.Quests :: State
end

local function view(state: State): { { [string]: any } }
	local out = {}
	local day, definitions = today(state)
	for _, def in definitions do
		if not state.DailyClaimed[def.id] then
			table.insert(out, {
				id = DailyRules.id(day, def), title = "DAILY • " .. def.text,
				objectives = {{ text = def.text, current = state.DailyProgress[def.id] or 0, amount = def.goal }},
				reward = tostring(def.reward) .. " Star Coins", complete = DailyRules.complete(state, def),
			})
		end
	end
	for _, quest in list do
		if Quests.isActive(quest, state.Claimed) then
			local progress = state.Progress[quest.id] or {}
			local objectives = {}
			for i, objective in quest.objectives do
				table.insert(objectives, {
					text = objective.text or `{objective.kind} {objective.amount} {objective.target}`,
					current = progress[i] or 0,
					amount = objective.amount,
				})
			end
			table.insert(out, {
				id = quest.id,
				title = quest.title,
				objectives = objectives,
				reward = Rewards.Describe(quest.reward),
				complete = Quests.isComplete(quest, progress),
			})
		end
	end
	return out
end

local function schedulePush(player: Player)
	if pushPending[player] then
		return
	end
	pushPending[player] = true
	task.delay(PUSH_INTERVAL, function()
		pushPending[player] = nil
		local profile = PlayerData.Get(player)
		if profile and changedPush then
			changedPush:Fire(player, view(stateOf(profile)))
		end
	end)
end

---------------------------------------------------------------------------
-- Public API (server systems call Report)
---------------------------------------------------------------------------

-- Reports progress from a SERVER system. kind/target are your own strings
-- ("Collect"/"Coin", "Defeat"/"Slime", "Talk"/"Guide"). Synchronous.
function Quests.Report(player: Player, kind: string, target: string, amount: number?)
	local n = amount or 1
	if type(n) ~= "number" or n ~= n or n &lt;= 0 or n &gt;= math.huge then
		return
	end
	local profile = PlayerData.Get(player)
	if not profile then
		return
	end
	local state = stateOf(profile)
	local _, definitions = today(state)
	local changed = DailyRules.report(state, definitions, kind, target, n)
	for _, quest in list do
		if Quests.isActive(quest, state.Claimed) then
			local progress = state.Progress[quest.id]
			if not progress then
				progress = {}
				state.Progress[quest.id] = progress
			end
			if Quests.applyProgress(quest, progress, kind, target, n) then
				changed = true
			end
		end
	end
	if changed then
		PlayerData.MarkDirty(profile)
		schedulePush(player)
	end
end

local function claim(player: Player, questId: string): Net.Result
	local quest = byId[questId]
	local profile = PlayerData.Get(player)
	if not profile then
		return Net.fail("NotReady")
	end
	local state = stateOf(profile)
	local day, definitions = today(state)
	for _, def in definitions do
		if questId == DailyRules.id(day, def) then
			if state.DailyClaimed[def.id] then return Net.fail("AlreadyClaimed") end
			if not DailyRules.complete(state, def) then return Net.fail("NotComplete") end
			local reward = { kind = "currency", currency = "StarCoins", amount = def.reward }
			local fits, code = Rewards.CanGrant(player, reward)
			if not fits then return Net.fail(code or "BagFull") end
			state.DailyClaimed[def.id] = true
			Rewards.Grant(player, reward, `daily:{questId}`, false, false)
			PlayerData.MarkDirty(profile); schedulePush(player)
			return Net.ok({reward = Rewards.Describe(reward)})
		end
	end
	if not quest then return Net.fail("Expired") end
	if not Quests.isActive(quest, state.Claimed) then
		return Net.fail(if state.Claimed[questId] then "AlreadyClaimed" else "Locked")
	end
	if not Quests.isComplete(quest, state.Progress[questId]) then
		return Net.fail("NotComplete")
	end
	local fits, code = Rewards.CanGrant(player, quest.reward)
	if not fits then
		return Net.fail(code or "BagFull")
	end
	-- Mark and grant together, no yield in between.
	state.Claimed[questId] = os.time()
	state.Progress[questId] = nil -- keep the save small
	Rewards.Grant(player, quest.reward, `quest:{questId}`, false, false)
	PlayerData.MarkDirty(profile)
	schedulePush(player)
	return Net.ok({ reward = Rewards.Describe(quest.reward) })
end

function Quests.Init(config: Config)
	for _, quest in config.quests do
		assert(type(quest.id) == "string" and string.match(quest.id, "^[%w_]+$"), `Quests: bad id {quest.id}`)
		assert(byId[quest.id] == nil, `Quests: duplicate id {quest.id}`)
		assert(#quest.objectives &gt;= 1, `Quest {quest.id}: no objectives`)
		for i, objective in quest.objectives do
			assert(objective.amount &gt;= 1 and objective.amount &lt; 2 ^ 53, `Quest {quest.id} objective {i}: bad amount`)
		end
		Rewards.Validate(`Quest {quest.id}`, quest.reward)
		byId[quest.id] = quest
		table.insert(list, quest)
	end
	for _, quest in list do
		for _, required in quest.requires or {} do
			assert(byId[required], `Quest {quest.id}: requires unknown quest {required}`)
		end
	end

	PlayerData.RegisterSlice("Quests", function()
		return { Progress = {}, Claimed = {} }
	end)
	changedPush = Net.Push("Quests.Changed")
	Net.Handle("Quests.Get", {
		rate = { burst = 4, perSecond = 1 },
		args = {},
		handler = function(player: Player): Net.Result
			local profile = PlayerData.Get(player)
			return if profile then Net.ok(view(stateOf(profile))) else Net.fail("NotReady")
		end,
	})
	Net.Handle("Quests.Claim", {
		rate = { burst = 4, perSecond = 1 },
		args = { T.string(64, "^[%w_]+$") },
		handler = claim,
	})
	PlayerData.Loaded:Connect(function(player: Player)
		schedulePush(player)
	end)
	-- Refresh open mission lists at UTC rollover without requiring a relog.
	task.spawn(function()
		local lastDay = math.floor(os.time() / 86400)
		while true do
			task.wait(30)
			local day = math.floor(os.time() / 86400)
			if day ~= lastDay then
				lastDay = day
				for _, player in Players:GetPlayers() do schedulePush(player) end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		pushPending[player] = nil
	end)
end

return Quests
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <Content name="LinkedSource">
            <null />
          </Content>
          <ProtectedString name="Source">--!strict
-- LihFolk Systems: Rebirth
-- Install: ServerScriptService/LihFolk/Rebirth (ModuleScript)
--
-- Spend a currency to reset it (and others you list) for a permanent earn
-- multiplier. Cost grows geometrically: rebirth i (0-based) costs base * growth^i.
-- Bulk buys use the closed-form geometric sum, so "x5" and "max" are O(1)
-- and the price is computed only on the server.
--   total(n, k) = floor(base * growth^n * (growth^k - 1) / (growth - 1))
-- Remote: Rebirth.Request(count)  count 1..maxBulk, or 0 for "as many as affordable"
-- Attribute: Rebirths (UI only)
-- Status: reviewed, not run in Studio.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("LihFolk")
local Net = require(Shared:WaitForChild("Net"))
local PlayerData = require(script.Parent.PlayerData)
local Currency = require(script.Parent.Currency)

local T = Net.T

export type Config = {
	currency: string, -- paid with and reset, e.g. "Coins"
	baseCost: number,
	growth: number, -- &gt;= 1
	bonusPerRebirth: number, -- multiplier = 1 + rebirths * bonus
	alsoReset: { string }?, -- other currencies reset to 0
	maxBulk: number?, -- default 1000
	maxRebirths: number?, -- default 1e6
}

local Rebirth = {}

local cfg: Config? = nil
local MAX_SAFE = 2 ^ 53

local function config(): Config
	assert(cfg, "Rebirth.Init has not run")
	return cfg :: Config
end

-- Pure: total cost of k rebirths starting after n done. Returns math.huge if not representable.
function Rebirth.totalCost(n: number, k: number, base: number, growth: number): number
	if k &lt;= 0 then
		return 0
	end
	local total
	if growth == 1 then
		total = base * k
	else
		total = base * growth ^ n * (growth ^ k - 1) / (growth - 1)
	end
	if total ~= total or total &gt;= MAX_SAFE then
		return math.huge
	end
	return math.floor(total)
end

-- Pure: largest k &lt;= cap with totalCost(n, k) &lt;= coins.
function Rebirth.maxAffordable(n: number, coins: number, base: number, growth: number, cap: number): number
	if coins &lt; Rebirth.totalCost(n, 1, base, growth) then
		return 0
	end
	local k
	if growth == 1 then
		k = math.floor(coins / base)
	else
		local first = base * growth ^ n
		k = math.floor(math.log(1 + coins * (growth - 1) / first) / math.log(growth))
	end
	k = math.clamp(k, 0, cap)
	-- Floating point can be off by one either way; correct with exact checks.
	while k &gt; 0 and Rebirth.totalCost(n, k, base, growth) &gt; coins do
		k -= 1
	end
	while k &lt; cap and Rebirth.totalCost(n, k + 1, base, growth) &lt;= coins do
		k += 1
	end
	return k
end

function Rebirth.multiplierFor(rebirths: number, bonus: number): number
	return 1 + rebirths * bonus
end

function Rebirth.Get(player: Player): number
	local profile = PlayerData.Get(player)
	return if profile then profile.Data.Rebirth.Count else 0
end

-- Cost of the next `k` rebirths for this player (for UI).
function Rebirth.Quote(player: Player, k: number): number
	local c = config()
	return Rebirth.totalCost(Rebirth.Get(player), k, c.baseCost, c.growth)
end

local function request(player: Player, count: number): Net.Result
	local c = config()
	local profile = PlayerData.Get(player)
	if not profile then
		return Net.fail("NotReady")
	end
	local state = profile.Data.Rebirth
	local n = state.Count
	local coins = Currency.Get(player, c.currency) or 0
	local cap = math.min(c.maxBulk or 1000, (c.maxRebirths or 1e6) - n)
	if cap &lt;= 0 then
		return Net.fail("MaxReached")
	end
	local k = if count == 0 then Rebirth.maxAffordable(n, coins, c.baseCost, c.growth, cap) else math.min(count, cap)
	if k &lt;= 0 then
		return Net.fail("NotEnough")
	end
	local cost = Rebirth.totalCost(n, k, c.baseCost, c.growth)
	if cost &gt; coins then
		return Net.fail("NotEnough")
	end
	-- Checks passed; nothing below yields. The whole balance resets (the
	-- leftover after the cost is part of the rebirth trade), then count up.
	Currency.Set(player, c.currency, 0, "rebirth")
	for _, other in c.alsoReset or {} do
		Currency.Set(player, other, 0, "rebirth")
	end
	state.Count = n + k
	PlayerData.MarkDirty(profile)
	player:SetAttribute("Rebirths", state.Count)
	return Net.ok({ rebirths = state.Count, gained = k, multiplier = Rebirth.multiplierFor(state.Count, c.bonusPerRebirth) })
end

function Rebirth.Init(newConfig: Config)
	assert(Currency.Exists(newConfig.currency), `Rebirth: unknown currency {newConfig.currency}`)
	assert(newConfig.baseCost &gt;= 1 and newConfig.growth &gt;= 1 and newConfig.growth &lt; 100, "Rebirth: baseCost &gt;= 1, growth 1..100")
	assert(newConfig.bonusPerRebirth &gt;= 0, "Rebirth: bonusPerRebirth &gt;= 0")
	for _, other in newConfig.alsoReset or {} do
		assert(Currency.Exists(other), `Rebirth: unknown currency {other}`)
	end
	cfg = newConfig
	local maxBulk = newConfig.maxBulk or 1000

	PlayerData.RegisterSlice("Rebirth", function()
		return { Count = 0 }
	end)
	-- Income multiplier for the reset currency. Cheap and non-yielding.
	Currency.AddMultiplier(newConfig.currency, function(player: Player): number
		return Rebirth.multiplierFor(Rebirth.Get(player), newConfig.bonusPerRebirth)
	end)

	Net.Handle("Rebirth.Request", {
		rate = { burst = 3, perSecond = 1 },
		args = { T.integer(0, maxBulk) },
		handler = request,
	})
	PlayerData.Loaded:Connect(function(player: Player, profile: PlayerData.Profile)
		player:SetAttribute("Rebirths", profile.Data.Rebirth.Count)
	end)
end

return Rebirth
</ProtectedString>
          <string name="ScriptGuid">{92549A36-C2BB-426A-ADAE-36B46699213B}</string>
