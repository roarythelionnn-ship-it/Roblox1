              <ProtectedString name="Source">-- WorldBuilder: builds the three worlds at server start from WorldConfig.
-- Gameplay objects (rings, pads, tunnels, finish) sit exactly where FlightSim expects them;
-- they are visual only - the simulation never uses Touched.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WorldConfig = require(Shared.WorldConfig)
local Pets = require(Shared.PetDefinitions)
local Kit = require(script.Parent.Kit)

local hex = Kit.hex
local WorldBuilder = {}

local THEMES = {
	SunnySpringlands = {
		ground = "8FDB72",
		ground2 = "7BCB5E",
		plaza = "FFF1C9",
		wood = "D99A5B",
		trim = "FF8579",
		ring = "FFC85B",
		pad = "FF8579",
		padTop = "FFF1C9",
		tunnel = "B9A68C",
		rail = "FFFFFF",
		cannon = { body = "2FC6C4", band = "FFF1C9", glow = "FFD84D", wheel = "5B6B8C" },
	},
	CloudtopCircuit = {
		ground = "F9F5FF",
		ground2 = "E6DEFF",
		plaza = "FFFFFF",
		wood = "FFD17A",
		trim = "8FD9FF",
		ring = "FFD17A",
		pad = "F4F7FF",
		padTop = "D5B6FF",
		tunnel = "8FD9FF",
		rail = "FFD17A",
		cannon = { body = "FFFFFF", band = "FFD17A", glow = "4FC3FF", wheel = "D5B6FF" },
	},
	NebulaWilds = {
		ground = "141A45",
		ground2 = "1D2560",
		plaza = "2A2F70",
		wood = "6536CD",
		trim = "37F4FF",
		ring = "37F4FF",
		pad = "6536CD",
		padTop = "EB62FF",
		tunnel = "EB62FF",
		rail = "37F4FF",
		cannon = { body = "2B2370", band = "EB62FF", glow = "37F4FF", wheel = "6536CD" },
	},
}

local function toWorld(world, x: number, y: number, z: number): Vector3
	return Vector3.new(world.origin[1] + x, world.origin[2] + y, world.origin[3] + z)
end

------------------------------------------------------------------------
-- Decor
------------------------------------------------------------------------
local function tree(parent, at: Vector3, scale: number, leaf: Color3, rng: Random)
	local m = Kit.model("Tree", parent)
	Kit.cyl(m, 8 * scale, 1.6 * scale, at + Vector3.new(0, 4 * scale, 0), Vector3.yAxis, hex("A86B3C"))
	Kit.ball(m, Vector3.new(9, 8, 9) * scale, CFrame.new(at + Vector3.new(0, 10 * scale, 0)), leaf)
	Kit.ball(
		m,
		Vector3.new(6, 5, 6) * scale,
		CFrame.new(at + Vector3.new(rng:NextNumber(-2, 2) * scale, 13.5 * scale, rng:NextNumber(-2, 2) * scale)),
		leaf:Lerp(Color3.new(1, 1, 1), 0.15)
	)
end

local function cloud(parent, at: Vector3, scale: number, color: Color3)
	local m = Kit.model("Cloud", parent)
	Kit.ball(m, Vector3.new(26, 12, 18) * scale, CFrame.new(at), color)
	Kit.ball(m, Vector3.new(16, 11, 14) * scale, CFrame.new(at + Vector3.new(-10, 2, 1) * scale), color)
	Kit.ball(m, Vector3.new(18, 14, 15) * scale, CFrame.new(at + Vector3.new(9, 3, -1) * scale), color)
end

local function flowers(parent, at: Vector3, rng: Random)
	local colors = { "FF8579", "FFC85B", "FFFFFF", "C7A8FF", "FF6FB5" }
	for _ = 1, 6 do
		local p = at + Vector3.new(rng:NextNumber(-5, 5), 0.6, rng:NextNumber(-5, 5))
		Kit.ball(parent, Vector3.new(1.4, 1.2, 1.4), CFrame.new(p), hex(colors[rng:NextInteger(1, #colors)]))
	end
end

local function windmill(parent, at: Vector3)
	local m = Kit.model("Windmill", parent)
	Kit.part(m, Vector3.new(8, 26, 8), CFrame.new(at + Vector3.new(0, 13, 0)), hex("FFF1C9"))
	Kit.part(m, Vector3.new(10, 2, 10), CFrame.new(at + Vector3.new(0, 27, 0)), hex("FF8579"))
	local hubPart = Kit.disc(m, 1.5, 3, at + Vector3.new(0, 22, -4.5), hex("5B6B8C"))
	hubPart.CFrame = CFrame.new(at + Vector3.new(0, 22, -4.6)) * CFrame.Angles(0, math.pi / 2, 0)
	local blades = Kit.model("Blades", m)
	for i = 0, 3 do
		local a = i * math.pi / 2
		Kit.part(
			blades,
			Vector3.new(2.6, 12, 0.4),
			CFrame.new(at + Vector3.new(0, 22, -5)) * CFrame.Angles(0, 0, a) * CFrame.new(0, 6.5, 0),
			hex("FFFFFF")
		)
	end
	blades:SetAttribute("SpinAxis", "Z")
	blades:SetAttribute("Speed", 0.8)
	CollectionService:AddTag(blades, "LYM_Spin")
end

local function island(parent, at: Vector3, scale: number, top: Color3)
	local m = Kit.model("SkyIsland", parent)
	Kit.ball(m, Vector3.new(30, 8, 26) * scale, CFrame.new(at), top)
	Kit.ball(m, Vector3.new(22, 22, 18) * scale, CFrame.new(at - Vector3.new(0, 9 * scale, 0)), hex("C9B6E8"))
	Kit.ball(m, Vector3.new(10, 12, 9) * scale, CFrame.new(at - Vector3.new(0, 19 * scale, 0)), hex("B39CDB"))
end

local function planet(parent, at: Vector3, radius: number, color: Color3, ringColor: Color3)
	local m = Kit.model("Planet", parent)
	Kit.ball(m, Vector3.one * radius * 2, CFrame.new(at), color)
	local r = Kit.disc(m, 0.6, radius * 3.4, at, ringColor, Enum.Material.Neon)
	r.Transparency = 0.35
	r.CFrame = CFrame.new(at) * CFrame.Angles(math.rad(18), 0, math.rad(90 + 12))
end

local function crystal(parent, at: Vector3, scale: number, color: Color3, rng: Random)
	local m = Kit.model("Crystal", parent)
	for _ = 1, 4 do
		local h = rng:NextNumber(6, 14) * scale
		local tilt = CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6.28), rng:NextNumber(-0.4, 0.4))
		Kit.part(
			m,
			Vector3.new(2.2, h, 2.2) * Vector3.new(scale, 1, scale),
			CFrame.new(at) * tilt * CFrame.new(0, h / 2, 0),
			color,
			Enum.Material.Neon
		).Transparency =
			0.15
	end
end

------------------------------------------------------------------------
-- Launchers: each has a "Barrel" model (aimed + recoiled by clients) and a "Muzzle" part
------------------------------------------------------------------------
local function buildLauncher(world, parent): Model
	local theme = THEMES[world.id].cannon
	local m = Kit.model(world.launcher, parent)
	local base = toWorld(world, 0, 0, -9)
	local muzzle = toWorld(world, world.muzzle[1], world.muzzle[2], world.muzzle[3])
	local platform =
		Kit.disc(m, 2, 30, base + Vector3.new(0, 1, 0), hex(THEMES[world.id].wood), Enum.Material.SmoothPlastic, true)
	platform.Name = "Platform"

	-- Barrel pivot sits behind and below the muzzle along the 45 degree default aim
	local length = 16
	local dir = Vector3.new(0, math.sin(math.rad(45)), math.cos(math.rad(45)))
	local pivot = muzzle - dir * length
	local barrel = Kit.model("Barrel", m)
	local barrelPart = Kit.cyl(barrel, length, 7, pivot + dir * length / 2, dir, hex(theme.body))
	barrelPart.Name = "Tube"
	for i = 1, 3 do
		Kit.cyl(barrel, 1.2, 7.8, pivot + dir * (length * i / 4), dir, hex(theme.band))
	end
	local rim = Kit.cyl(barrel, 1.6, 8.6, muzzle - dir * 0.8, dir, hex(theme.band))
	rim.Name = "Rim"
	local chamber = Kit.ball(barrel, Vector3.new(8, 8, 8), CFrame.new(pivot), hex(theme.glow), Enum.Material.Neon)
	chamber.Name = "Chamber"
	Kit.light(chamber, hex(theme.glow), 1.5, 14)
	barrel.PrimaryPart = barrelPart
	barrel:SetAttribute("PivotX", pivot.X)
	barrel:SetAttribute("PivotY", pivot.Y)
	barrel:SetAttribute("PivotZ", pivot.Z)

	-- Carriage + wheels + pistons
	Kit.part(m, Vector3.new(10, 6, 10), CFrame.new(pivot - Vector3.new(0, 4, 0)), hex(theme.wheel))
	for _, side in { -1, 1 } do
		Kit.cyl(
			m,
			2,
			10,
			pivot + Vector3.new(side * 6, -3, 0),
			Vector3.xAxis,
			hex(theme.wheel),
			Enum.Material.SmoothPlastic
		)
		Kit.cyl(m, 2.4, 4, pivot + Vector3.new(side * 6.2, -3, 0), Vector3.xAxis, hex(theme.band))
		Kit.cyl(
			m,
			7,
			1.2,
			pivot + Vector3.new(side * 3.2, -1, 2.5),
			Vector3.new(0, 0.6, 1),
			hex("C9D2E3"),
			Enum.Material.Metal
		)
	end

	if world.id == "CloudtopCircuit" then
		for i = 1, 3 do
			local hoop =
				Kit.ring(m, CFrame.lookAt(muzzle + dir * (6 + i * 7), muzzle + dir * 40), 6 + i, 0.8, hex("FFD17A"), 14)
			hoop.Name = "Hoop" .. i
		end
		for _, side in { -1, 1 } do
			local fan = Kit.model("Turbine", m)
			Kit.cyl(fan, 4, 7, pivot + Vector3.new(side * 9, 2, -2), Vector3.zAxis, hex("FFFFFF"))
			for b = 0, 2 do
				Kit.part(
					fan,
					Vector3.new(0.6, 6, 1.4),
					CFrame.new(pivot + Vector3.new(side * 9, 2, 0.2))
						* CFrame.Angles(0, 0, b * 2.09)
						* CFrame.new(0, 2.4, 0),
					hex("4FC3FF"),
					Enum.Material.Neon
				)
			end
			fan:SetAttribute("SpinAxis", "Z")
			fan:SetAttribute("Speed", 6)
			CollectionService:AddTag(fan, "LYM_Spin")
		end
	elseif world.id == "NebulaWilds" then
		for i = 1, 3 do
			local reactorRing = Kit.ring(
				m,
				CFrame.new(pivot) * CFrame.Angles(math.rad(30 * i), 0, 0),
				7 + i * 1.6,
				0.7,
				hex(if i == 2 then "37F4FF" else "EB62FF"),
				18
			)
			reactorRing.Name = "ReactorRing" .. i
			reactorRing:SetAttribute("SpinAxis", if i == 2 then "Y" else "X")
			reactorRing:SetAttribute("Speed", 0.6 + i * 0.4)
			CollectionService:AddTag(reactorRing, "LYM_Spin")
		end
		for i = 0, 5 do
			Kit.cyl(barrel, 0.8, 8.2, pivot + dir * (2 + i * 2.4), dir, hex("EB62FF"), Enum.Material.Neon)
		end
	end

	local muzzlePart = Kit.part(m, Vector3.one, CFrame.new(muzzle), Color3.new(1, 1, 1))
	muzzlePart.Name = "Muzzle"
	muzzlePart.Transparency = 1
	local promptHolder =
		Kit.part(m, Vector3.new(4, 4, 4), CFrame.new(base + Vector3.new(0, 4, -8)), Color3.new(1, 1, 1))
	promptHolder.Name = "PromptHolder"
	promptHolder.Transparency = 1
	Kit.prompt(promptHolder, "Launch!", world.launcher, 18)
	Kit.billboard(promptHolder, world.launcher:upper(), Color3.new(1, 1, 1), 2.4, 20)
	m:SetAttribute("World", world.id)
	CollectionService:AddTag(m, "LYM_Cannon")
	return m
end

------------------------------------------------------------------------
-- Hub
------------------------------------------------------------------------
local function buildHub(world, parent, rng: Random)
	local theme = THEMES[world.id]
	local hub = Kit.model("Hub", parent)
	local center = toWorld(world, 0, 0, -55)
	Kit.disc(hub, 2, 120, center + Vector3.new(0, -1, 0), hex(theme.ground), Enum.Material.Grass, true).Name =
		"HubFloor"
	Kit.disc(hub, 2.2, 62, center + Vector3.new(0, -0.8, 0), hex(theme.plaza), Enum.Material.SmoothPlastic, true)
	Kit.part(
		hub,
		Vector3.new(22, 2.4, 50),
		CFrame.new(toWorld(world, 0, -0.7, -25)),
		hex(theme.wood),
		Enum.Material.WoodPlanks,
		true
	).Name =
		"Walkway"
	if world.id ~= "SunnySpringlands" then
		for i = 1, 4 do
			local a = i / 4 * math.pi * 2
			Kit.ball(
				hub,
				Vector3.new(44, 14, 34),
				CFrame.new(center + Vector3.new(math.cos(a) * 66, -7, math.sin(a) * 66)),
				hex(theme.ground2)
			)
		end
	end

	-- Egg stand with the world's egg
	local h = world.hub
	local eggDef = Pets.EggById[world.egg]
	local eggAt = toWorld(world, h.eggStand[1], h.eggStand[2], h.eggStand[3])
	local stand = Kit.model("EggStand", hub)
	Kit.disc(stand, 2, 14, eggAt + Vector3.new(0, 1, 0), hex(theme.wood), nil, true)
	Kit.disc(stand, 1, 11, eggAt + Vector3.new(0, 2.4, 0), hex(eggDef.accent), Enum.Material.Neon)
	local egg =
		Kit.ball(stand, Vector3.new(6.5, 8.5, 6.5), CFrame.new(eggAt + Vector3.new(0, 7.4, 0)), hex(eggDef.color))
	egg.Name = "Egg"
	for i = 1, 3 do
		Kit.ball(
			stand,
			Vector3.new(1.6, 1.6, 0.6),
			CFrame.new(eggAt + Vector3.new(math.cos(i * 2.1) * 2.6, 6 + i * 1.3, -2.9)),
			hex(eggDef.accent)
		)
	end
	Kit.prompt(egg, "Hatch", `{eggDef.name} - {eggDef.price} Star Coins`, 16)
	Kit.billboard(egg, eggDef.name:upper(), hex(eggDef.accent), 2.2, 7)
	stand:SetAttribute("Egg", eggDef.id)
	CollectionService:AddTag(stand, "LYM_EggStand")

	-- Upgrade kiosk
	local kioskAt = toWorld(world, h.kiosk[1], h.kiosk[2], h.kiosk[3])
	local kiosk = Kit.model("UpgradeKiosk", hub)
	Kit.part(kiosk, Vector3.new(14, 6, 7), CFrame.new(kioskAt + Vector3.new(0, 3, 0)), hex(theme.wood), nil, true)
	Kit.part(kiosk, Vector3.new(16, 1.2, 9), CFrame.new(kioskAt + Vector3.new(0, 11, 0)), hex(theme.trim))
	for _, side in { -1, 1 } do
		Kit.part(kiosk, Vector3.new(0.8, 5, 0.8), CFrame.new(kioskAt + Vector3.new(side * 7, 8.5, 3.6)), hex("FFFFFF"))
	end
	local sign = Kit.part(
		kiosk,
		Vector3.new(12, 3, 0.6),
		CFrame.new(kioskAt + Vector3.new(0, 13.2, 0)),
		hex("496BFF"),
		Enum.Material.Neon
	)
	Kit.prompt(sign, "Upgrades", "Upgrade Kiosk", 16)
	Kit.billboard(sign, "UPGRADES", hex("FFCF55"), 2.4, 3)
	CollectionService:AddTag(kiosk, "LYM_Kiosk")

	-- Training tower (home world only): a big strength tester
	if h.training then
		local at = toWorld(world, h.training[1], h.training[2], h.training[3])
		local tower = Kit.model("TrainingTower", hub)
		Kit.disc(tower, 2, 12, at + Vector3.new(0, 1, 0), hex("FFF1C9"), nil, true)
		Kit.part(tower, Vector3.new(3, 22, 3), CFrame.new(at + Vector3.new(0, 12, -2)), hex("FFFFFF"))
		local meter = Kit.part(
			tower,
			Vector3.new(1.6, 20, 0.6),
			CFrame.new(at + Vector3.new(0, 12, -0.4)),
			hex("FF8579"),
			Enum.Material.Neon
		)
		meter.Name = "Meter"
		Kit.ball(
			tower,
			Vector3.new(4, 4, 4),
			CFrame.new(at + Vector3.new(0, 24, -2)),
			hex("FFC85B"),
			Enum.Material.Neon
		).Name =
			"Bell"
		local pad = Kit.disc(tower, 1, 5, at + Vector3.new(0, 2.5, 1.5), hex("496BFF"), Enum.Material.Neon)
		Kit.prompt(pad, "Train Power", "Power Tower", 14)
		Kit.billboard(pad, "TRAIN POWER", hex("FFFFFF"), 2.2, 26)
		CollectionService:AddTag(tower, "LYM_Training")
	end

	-- Portals
	for _, portal in h.portals do
		local at = toWorld(world, portal.pos[1], portal.pos[2], portal.pos[3])
		local target = WorldConfig.ById[portal.target]
		local targetTheme = THEMES[target.id]
		local m = Kit.model("Portal_" .. target.id, hub)
		local frame = CFrame.lookAt(
			at + Vector3.new(0, 0.5, 0),
			at + Vector3.new(0, 0.5, 0) + (center - at) * Vector3.new(1, 0, 1)
		)
		Kit.arch(m, frame, 9, 1.6, { hex(targetTheme.trim), hex(targetTheme.ring) }, 12)
		local swirl = Kit.ball(
			m,
			Vector3.new(13, 13, 0.6),
			frame * CFrame.new(0, 6.5, 0),
			hex(targetTheme.ground),
			Enum.Material.Neon
		)
		swirl.Transparency = 0.25
		swirl.Name = "Swirl"
		Kit.prompt(swirl, "Travel", target.name, 14)
		local label = Kit.billboard(swirl, target.name:upper(), Color3.new(1, 1, 1), 3.2, 9)
		label.Name = "PortalLabel"
		m:SetAttribute("Target", target.id)
		CollectionService:AddTag(m, "LYM_Portal")
	end

	-- Leaderboard
	local boardAt = toWorld(world, h.board[1], h.board[2], h.board[3])
	local board = Kit.part(hub, Vector3.new(26, 16, 1), CFrame.new(boardAt + Vector3.new(0, 10, 0)), hex("17203C"))
	board.Name = "Leaderboard"
	Kit.part(hub, Vector3.new(28, 1.4, 2), CFrame.new(boardAt + Vector3.new(0, 18.6, 0)), hex(theme.trim))
	CollectionService:AddTag(board, "LYM_Board")

	-- Tutorial signs on the walkway (home world)
	if world.id == WorldConfig.Home then
		local texts = {
			"1  WALK TO THE CANNON",
			"2  STOP THE MARKER IN THE GOLD ZONE",
			"3  BOOST IN THE AIR, TAP ON BOUNCE PADS",
		}
		for i, text in texts do
			local post = Kit.part(
				hub,
				Vector3.new(0.8, 5, 0.8),
				CFrame.new(toWorld(world, -14, 2.5, -48 + i * 11)),
				hex(theme.wood)
			)
			local plate = Kit.part(
				hub,
				Vector3.new(9, 3, 0.5),
				CFrame.new(toWorld(world, -14, 5.5, -48 + i * 11)) * CFrame.Angles(0, math.rad(90), 0),
				hex("FFF1C9")
			)
			local gui =
				Kit.new("SurfaceGui", { Face = Enum.NormalId.Front, PixelsPerStud = 40, LightInfluence = 0 }, plate)
			local label = Kit.new(
				"TextLabel",
				{
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1,
					Text = text,
					TextScaled = true,
					TextColor3 = hex("17203C"),
					FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy),
				},
				gui
			)
			Kit.new("UIPadding", { PaddingLeft = UDim.new(0.06, 0), PaddingRight = UDim.new(0.06, 0) }, label)
			local _ = post
		end
	end

	-- Hub decor ring
	for i = 1, 14 do
		local a = i / 14 * math.pi * 2
		local at = center + Vector3.new(math.cos(a) * 52, 0, math.sin(a) * 52)
		if math.abs(at.X - center.X) &lt; 18 and at.Z &gt; center.Z then
			continue -- keep the walkway to the cannon clear
		end
		if world.id == "SunnySpringlands" then
			tree(hub, at, rng:NextNumber(0.9, 1.3), hex(if i % 3 == 0 then "FF8FB1" else "6CCB5A"), rng)
			flowers(hub, at + Vector3.new(4, 0, 4), rng)
		elseif world.id == "CloudtopCircuit" then
			cloud(hub, at + Vector3.new(0, 4, 0), 0.4, hex("FFFFFF"))
		else
			crystal(hub, at, 0.8, hex(if i % 2 == 0 then "37F4FF" else "EB62FF"), rng)
		end
	end
	return hub
end

------------------------------------------------------------------------
-- Course
------------------------------------------------------------------------
local function buildCourse(world, parent, rng: Random)
	local theme = THEMES[world.id]
	local course = Kit.model("Course", parent)
	local width = world.laneHalf * 2 + 140
	local segment = 220
	local count = math.ceil((world.length + 260) / segment)

	-- Ground strips (alternating tones for a sense of speed)
	for i = 0, count - 1 do
		local z = i * segment + segment / 2 - 20
		local color = if i % 2 == 0 then hex(theme.ground) else hex(theme.ground2)
		local material = if world.id == "SunnySpringlands"
			then Enum.Material.Grass
			elseif world.id == "CloudtopCircuit" then Enum.Material.SmoothPlastic
			else Enum.Material.Slate
		Kit.part(
			course,
			Vector3.new(width, 4, segment),
			CFrame.new(toWorld(world, 0, world.groundY - 2, z)),
			color,
			material,
			true
		)
	end

	-- Distance markers every 100 studs
	for d = 100, world.length - 1, 100 do
		local major = d % 500 == 0
		local stripe = Kit.part(
			course,
			Vector3.new(world.laneHalf * 2, 0.2, if major then 3 else 1.2),
			CFrame.new(toWorld(world, 0, world.groundY + 0.1, d)),
			hex("FFFFFF"),
			Enum.Material.Neon
		)
		stripe.Transparency = if major then 0.1 else 0.55
		if major then
			local post = Kit.part(
				course,
				Vector3.new(2, 10, 2),
				CFrame.new(toWorld(world, -world.laneHalf - 4, world.groundY + 5, d)),
				hex(theme.trim)
			)
			Kit.billboard(post, d .. " STUDS", Color3.new(1, 1, 1), 2.4, 8, 600)
		end
	end

	-- Rings (visual twins of WorldConfig rings)
	for index, r in world.rings do
		local frame = CFrame.lookAt(toWorld(world, r.x, r.y, r.z), toWorld(world, r.x, r.y, r.z + 1))
		local ringModel = Kit.ring(course, frame, r.r, 1.4, hex(theme.ring), 16)
		ringModel.Name = "Ring" .. index
		ringModel:SetAttribute("Index", index)
		ringModel:SetAttribute("World", world.id)
		CollectionService:AddTag(ringModel, "LYM_Ring")
	end

	-- Bounce pads
	for index, pad in world.pads do
		local m = Kit.model("Pad" .. index, course)
		local center = toWorld(world, pad.x, pad.y, pad.z)
		local base = Kit.part(
			m,
			Vector3.new(pad.w, pad.y, pad.d),
			CFrame.new(toWorld(world, pad.x, pad.y / 2, pad.z)),
			hex(theme.pad),
			nil,
			true
		)
		base.Name = "Base"
		local top = Kit.part(
			m,
			Vector3.new(pad.w - 2, 0.6, pad.d - 2),
			CFrame.new(center + Vector3.new(0, 0.3, 0)),
			hex(theme.padTop),
			Enum.Material.Neon
		)
		top.Name = "Top"
		top.Transparency = 0.1
		if pad.kind == "spring" then
			for _, side in { -1, 1 } do
				Kit.cyl(
					m,
					6,
					3,
					center + Vector3.new(side * pad.w / 3, -3, 0),
					Vector3.yAxis,
					hex("C9D2E3"),
					Enum.Material.Metal
				)
			end
			Kit.billboard(top, "SPRING!", hex("FFC85B"), 2, 6, 500)
		elseif pad.kind == "cloud" then
			base.Transparency = 1
			cloud(m, center + Vector3.new(0, -2, 0), pad.w / 40, hex("FFFFFF"))
		elseif pad.kind == "crystal" then
			crystal(m, center + Vector3.new(pad.w / 2, -2, 0), 0.8, hex("EB62FF"), rng)
			crystal(m, center + Vector3.new(-pad.w / 2, -2, 0), 0.8, hex("37F4FF"), rng)
		end
		m:SetAttribute("Index", index)
		m:SetAttribute("World", world.id)
		CollectionService:AddTag(m, "LYM_Pad")
	end

	-- Wind tunnels / updrafts: translucent frames + streak particles
	for index, t in world.tunnels do
		local m = Kit.model("Tunnel" .. index, course)
		local center = toWorld(world, t.x, t.y, t.z)
		for i = 0, 3 do
			local z = -t.sz / 2 + i * t.sz / 3
			Kit.ring(
				m,
				CFrame.lookAt(center + Vector3.new(0, 0, z), center + Vector3.new(0, 0, z + 1)),
				math.max(t.sx, t.sy) / 2,
				1.2,
				hex(theme.tunnel),
				14,
				Enum.Material.SmoothPlastic
			)
		end
		local volume =
			Kit.part(m, Vector3.new(t.sx, t.sy, t.sz), CFrame.new(center), hex(theme.tunnel), Enum.Material.ForceField)
		volume.Transparency = 0.6
		volume.Name = "Volume"
		local emitter = Kit.new("ParticleEmitter", {
			Texture = "rbxasset://textures/particles/sparkles_main.dds",
			Color = ColorSequence.new(Color3.new(1, 1, 1)),
			LightEmission = 1,
			LightInfluence = 0,
			Size = NumberSequence.new(0.6, 0),
			Speed = NumberRange.new(40, 60),
			Lifetime = NumberRange.new(0.6, 1),
			Rate = 12,
			EmissionDirection = if t.ay &gt; t.az then Enum.NormalId.Top else Enum.NormalId.Back,
			SpreadAngle = Vector2.new(5, 5),
			Orientation = Enum.ParticleOrientation.VelocityParallel,
			Squash = NumberSequence.new(2),
		}, volume)
		local _ = emitter
		CollectionService:AddTag(m, "LYM_Tunnel")
	end

	-- Finish arch + soft landing pillows
	local finish = Kit.model("Finish", course)
	Kit.arch(
		finish,
		CFrame.new(toWorld(world, 0, world.groundY, world.length)),
		world.laneHalf + 10,
		4,
		{ hex("FF8579"), hex("FFC85B"), hex("8FDB72"), hex("73D5FA"), hex("8B5CFF") },
		20
	)
	local banner = Kit.part(
		finish,
		Vector3.new(30, 8, 1),
		CFrame.new(toWorld(world, 0, world.laneHalf + 2, world.length)),
		hex("17203C")
	)
	Kit.billboard(banner, "FINISH!", hex("FFCF55"), 4, 4, 2000)
	for i = 1, 5 do
		Kit.ball(
			finish,
			Vector3.new(30, 8, 30),
			CFrame.new(toWorld(world, (i - 3) * 26, world.groundY, world.length + 30)),
			hex("FFF1C9")
		)
	end

	-- Lane edge rails (soft, visible boundaries)
	for _, side in { -1, 1 } do
		for i = 0, count - 1 do
			local z = i * segment + segment / 2 - 20
			if z &lt; world.length + 40 then
				Kit.part(
					course,
					Vector3.new(1, 1, segment - 6),
					CFrame.new(toWorld(world, side * (world.laneHalf + 2), world.groundY + 0.5, z)),
					hex(theme.rail),
					Enum.Material.Neon
				).Transparency =
					0.3
			end
		end
	end

	-- Side scenery outside the flight lane, varied scale
	local edge = world.laneHalf + 30
	for i = 1, math.floor(world.length / 70) do
		local side = if i % 2 == 0 then -1 else 1
		local z = rng:NextNumber(0, world.length)
		local x = side * rng:NextNumber(edge, edge + 70)
		local at = toWorld(world, x, world.groundY, z)
		if world.id == "SunnySpringlands" then
			if i % 9 == 0 then
				windmill(course, at)
			elseif i % 3 == 0 then
				Kit.ball(
					course,
					Vector3.new(rng:NextNumber(40, 70), rng:NextNumber(14, 26), rng:NextNumber(40, 70)),
					CFrame.new(at),
					hex(if i % 2 == 0 then "9BE07F" else "B7E98F"),
					Enum.Material.Grass
				)
			else
				tree(course, at, rng:NextNumber(1, 1.8), hex(if i % 4 == 0 then "FF8FB1" else "6CCB5A"), rng)
			end
		elseif world.id == "CloudtopCircuit" then
			if i % 2 == 0 then
				island(course, at + Vector3.new(0, rng:NextNumber(40, 120), 0), rng:NextNumber(0.8, 1.6), hex("8FDB72"))
			else
				cloud(course, at + Vector3.new(0, rng:NextNumber(10, 90), 0), rng:NextNumber(0.8, 1.6), hex("FFFFFF"))
			end
		else
			if i % 6 == 0 then
				planet(
					course,
					at + Vector3.new(side * 120, rng:NextNumber(120, 260), 0),
					rng:NextNumber(40, 80),
					hex(if i % 12 == 0 then "6536CD" else "EB62FF"),
					hex("37F4FF")
				)
			else
				crystal(course, at, rng:NextNumber(1, 2.2), hex(if i % 2 == 0 then "37F4FF" else "EB62FF"), rng)
			end
		end
	end

	-- Sky clouds high above (Springlands + Cloudtop) for depth
	if world.id ~= "NebulaWilds" then
		for i = 1, math.floor(world.length / 160) do
			cloud(
				course,
				toWorld(world, rng:NextNumber(-260, 260), rng:NextNumber(160, 260), rng:NextNumber(0, world.length)),
				rng:NextNumber(1.2, 2.4),
				hex("FFFFFF")
			)
			local _ = i
		end
	end

	-- Rainbow bridges on Cloudtop
	if world.id == "CloudtopCircuit" then
		for i = 1, 4 do
			local z = i * world.length / 5
			Kit.arch(
				course,
				CFrame.new(toWorld(world, 0, world.groundY - 30, z)) * CFrame.Angles(0, math.rad(90), 0),
				140,
				3,
				{ hex("FF8579"), hex("FFD17A"), hex("8FDB72"), hex("8FD9FF"), hex("D5B6FF") },
				18
			)
		end
	end
	return course
end

function WorldBuilder.build()
	local root = workspace:FindFirstChild("Worlds") or Kit.folder("Worlds", workspace)
	root:ClearAllChildren()
	if not workspace:FindFirstChild("ActiveFlights") then
		Kit.folder("ActiveFlights", workspace)
	end
	for _, world in WorldConfig.List do
		local rng = Random.new(world.order * 7919)
		local model = Kit.model(world.id, root)
		model:SetAttribute("World", world.id)
		buildHub(world, model, rng)
		buildLauncher(world, model)
		buildCourse(world, model, rng)
	end
	return root
end

return WorldBuilder
