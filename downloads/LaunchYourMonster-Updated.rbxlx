              <Content name="LinkedSource">
                <null />
              </Content>
              <ProtectedString name="Source">-- PetService: hatching (earned Star Coins only), equip, duplicate fusion into Genome Shards,
-- deterministic cosmetic mutations and pet XP from completed flights.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Pets = require(Shared.PetDefinitions)
local Net = require(script.Parent.Net)
local ProfileService = require(script.Parent.ProfileService)
local FlightService = require(script.Parent.FlightService)
local ProgressionService = require(script.Parent.ProgressionService)
local Analytics = require(script.Parent.Analytics)

local PetService = {}

local rng = Random.new()
local lastAnnouncement = 0

local function findPet(data, uid)
	for index, entry in data.OwnedPets do
		if entry.uniqueId == uid then
			return entry, index
		end
	end
	return nil, nil
end

-- Replicates the equipped monster so every client can draw the follower.
function PetService.publish(player: Player)
	local data = ProfileService.get(player)
	local entry = data and findPet(data, data.EquippedPetUniqueId)
	player:SetAttribute("PetId", entry and entry.petId or Pets.Starter)
	player:SetAttribute("PetMutation", entry and entry.mutation or "Normal")
	player:SetAttribute("PetLevel", entry and entry.level or 1)
end

function PetService.give(player: Player, petId: string)
	local data = ProfileService.get(player)
	if not data or not Pets.ById[petId] or #data.OwnedPets &gt;= GameConfig.InventoryCap then
		return nil
	end
	local entry = {
		uniqueId = "p" .. data.NextPetUid,
		petId = petId,
		level = 1,
		xp = 0,
		mutation = "Normal",
		unlocked = {},
		new = true,
	}
	data.NextPetUid += 1
	table.insert(data.OwnedPets, entry)
	data.Discovered[petId] = true
	ProfileService.mark(player, "OwnedPets", "NextPetUid", "Discovered")
	return entry
end

local function addPetXp(player: Player, uid: string?, xp: number)
	local data = ProfileService.get(player)
	local entry = uid and findPet(data, uid)
	if not entry or entry.level &gt;= GameConfig.PetLevel.Max then
		return nil
	end
	entry.xp += xp
	local leveled = false
	while entry.level &lt; GameConfig.PetLevel.Max and entry.xp &gt;= GameConfig.petXpForLevel(entry.level) do
		entry.xp -= GameConfig.petXpForLevel(entry.level)
		entry.level += 1
		leveled = true
	end
	ProfileService.mark(player, "OwnedPets")
	if leveled and uid == data.EquippedPetUniqueId then
		PetService.publish(player)
	end
	return leveled
end

function PetService.init()
	ProfileService.onLoaded(PetService.publish)

	FlightService.onFinished(function(player, summary)
		local xp = GameConfig.petXpFor(summary.distance)
		summary.petXp = xp
		summary.petLevelUp = addPetXp(player, summary.petUid, xp) == true
	end)

	Net.handle("Hatch", function(player, eggId)
		local egg = type(eggId) == "string" and Pets.EggById[eggId]
		if not egg then
			return { ok = false, msg = "Unknown egg" }
		end
		local data = ProfileService.get(player)
		if not data.UnlockedWorlds[egg.world] then
			return { ok = false, msg = "Unlock this egg's world first" }
		end
		if #data.OwnedPets &gt;= GameConfig.InventoryCap then
			return { ok = false, msg = "Inventory full! Fuse duplicates first." }
		end
		if not ProfileService.spend(player, "StarCoins", egg.price) then
			return { ok = false, msg = "Not enough Star Coins" }
		end
		local def = Pets.pick(egg.id, rng:NextNumber(0, 100))
		local entry = PetService.give(player, def.id)
		data.Stats.TotalHatches += 1
		ProfileService.mark(player, "Stats")
		ProgressionService.bump(player, "hatches", 1)
		if data.Stats.TotalHatches == 1 then
			Analytics.funnel(player, "first_egg")
		end
		if def.rarity == "Legendary" and os.clock() - lastAnnouncement &gt; 20 then
			lastAnnouncement = os.clock()
			for _, other in Players:GetPlayers() do
				local otherData = ProfileService.get(other)
				if other ~= player and otherData and otherData.Settings.rareAnnouncements then
					Net.notify(other, `{player.DisplayName} hatched a LEGENDARY {def.name}!`, "legendary")
				end
			end
		end
		return { ok = true, petId = def.id, uid = entry.uniqueId }
	end, 3, 4)

	Net.handle("Equip", function(player, uid)
		local data = ProfileService.get(player)
		if FlightService.isFlying(player) then
			return { ok = false, msg = "Land first!" }
		end
		local entry = type(uid) == "string" and findPet(data, uid)
		if not entry then
			return { ok = false, msg = "Monster not found" }
		end
		data.EquippedPetUniqueId = uid
		entry.new = nil
		ProfileService.mark(player, "EquippedPetUniqueId", "OwnedPets")
		PetService.publish(player)
		return { ok = true }
	end, 6, 8)

	-- Fuses every duplicate of one species. Keeps the equipped copy, otherwise the highest level.
	Net.handle("Fuse", function(player, petId)
		local def = type(petId) == "string" and Pets.ById[petId]
		if not def then
			return { ok = false, msg = "Unknown monster" }
		end
		local data = ProfileService.get(player)
		local copies = {}
		for _, entry in data.OwnedPets do
			if entry.petId == petId then
				table.insert(copies, entry)
			end
		end
		if #copies &lt; 2 then
			return { ok = false, msg = "No duplicates to fuse" }
		end
		local keep = copies[1]
		for _, entry in copies do
			if entry.uniqueId == data.EquippedPetUniqueId then
				keep = entry
				break
			elseif entry.level &gt; keep.level then
				keep = entry
			end
		end
		local shards = 0
		for i = #data.OwnedPets, 1, -1 do
			local entry = data.OwnedPets[i]
			if entry.petId == petId and entry ~= keep then
				table.remove(data.OwnedPets, i)
				shards += GameConfig.Rarities[def.rarity].shards
			end
		end
		data.GenomeShards = math.min(GameConfig.MaxCurrency, data.GenomeShards + shards)
		ProfileService.mark(player, "OwnedPets", "GenomeShards")
		return { ok = true, shards = shards, kept = keep.uniqueId }
	end, 3, 4)

	-- Unlocks (Genome Shards) or applies an already unlocked cosmetic mutation.
	Net.handle("Mutate", function(player, payload)
		if type(payload) ~= "table" then
			return { ok = false }
		end
		local data = ProfileService.get(player)
		local entry = type(payload.uid) == "string" and findPet(data, payload.uid)
		if not entry then
			return { ok = false, msg = "Monster not found" }
		end
		if payload.mutation == "Normal" then
			entry.mutation = "Normal"
		else
			local mutation = GameConfig.MutationById[payload.mutation]
			if not mutation then
				return { ok = false, msg = "Unknown variant" }
			end
			if not table.find(entry.unlocked, mutation.id) then
				if entry.level &lt; mutation.minLevel then
					return { ok = false, msg = `Needs level {mutation.minLevel}` }
				end
				if not ProfileService.spend(player, "GenomeShards", mutation.shards) then
					return { ok = false, msg = "Not enough Genome Shards" }
				end
				table.insert(entry.unlocked, mutation.id)
			end
			entry.mutation = mutation.id
		end
		ProfileService.mark(player, "OwnedPets")
		if entry.uniqueId == data.EquippedPetUniqueId then
			PetService.publish(player)
		end
		return { ok = true }
	end, 4, 6)
end

return PetService
