              <ProtectedString name="Source">-- Kit: small helpers for building stylized geometry from native parts.
local Kit = {}

function Kit.hex(value: string): Color3
	return Color3.fromHex(value)
end

function Kit.new(className: string, props: { [string]: any }?, parent: Instance?): any
	local object = Instance.new(className)
	for key, value in props or {} do
		(object :: any)[key] = value
	end
	if parent then
		object.Parent = parent
	end
	return object
end

function Kit.folder(name: string, parent: Instance): Folder
	return Kit.new("Folder", { Name = name }, parent)
end

function Kit.model(name: string, parent: Instance): Model
	return Kit.new("Model", { Name = name }, parent)
end

-- Anchored, smooth, non-colliding by default (decor). Pass collide = true for floors.
function Kit.part(
	parent: Instance,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	collide: boolean?
): Part
	return Kit.new("Part", {
		Anchored = true,
		CanCollide = collide == true,
		CanTouch = false,
		CanQuery = collide == true,
		CastShadow = collide == true,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
		Size = size,
		CFrame = cframe,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	}, parent)
end

-- Ellipsoid: a part with a sphere mesh that fills its box.
function Kit.ball(parent: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Kit.part(parent, size, cframe, color, material)
	Kit.new("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, p)
	return p
end

-- Cylinder whose axis points along `direction`.
function Kit.cyl(
	parent: Instance,
	length: number,
	diameter: number,
	center: Vector3,
	direction: Vector3,
	color: Color3,
	material: Enum.Material?,
	collide: boolean?
): Part
	local p = Kit.part(
		parent,
		Vector3.new(length, diameter, diameter),
		CFrame.lookAt(center, center + direction) * CFrame.Angles(0, math.pi / 2, 0),
		color,
		material,
		collide
	)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- Upright disc (axis = up).
function Kit.disc(
	parent: Instance,
	height: number,
	diameter: number,
	position: Vector3,
	color: Color3,
	material: Enum.Material?,
	collide: boolean?
): Part
	local p = Kit.part(
		parent,
		Vector3.new(height, diameter, diameter),
		CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2),
		color,
		material,
		collide
	)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- Torus-like ring made of segments; `frame` looks along the ring's axis.
function Kit.ring(
	parent: Instance,
	frame: CFrame,
	radius: number,
	thickness: number,
	color: Color3,
	segments: number?,
	material: Enum.Material?
): Model
	local model = Kit.model("Ring", parent)
	local n = segments or 16
	local length = 2 * math.pi * radius / n * 1.08
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		local cf = frame * CFrame.new(math.cos(a) * radius, math.sin(a) * radius, 0) * CFrame.Angles(0, 0, a)
		Kit.part(model, Vector3.new(thickness, length, thickness), cf, color, material or Enum.Material.Neon)
	end
	return model
end

-- Arch from segments in the XY plane of `frame` (half ring standing on the ground).
function Kit.arch(
	parent: Instance,
	frame: CFrame,
	radius: number,
	thickness: number,
	colors: { Color3 },
	segments: number?
): Model
	local model = Kit.model("Arch", parent)
	local n = segments or 14
	for band, color in colors do
		local r = radius - (band - 1) * thickness
		local length = math.pi * r / n * 1.1
		for i = 0, n - 1 do
			local a = (i + 0.5) / n * math.pi
			local cf = frame * CFrame.new(math.cos(a) * r, math.sin(a) * r, 0) * CFrame.Angles(0, 0, a)
			Kit.part(model, Vector3.new(thickness, length, thickness * 1.4), cf, color, Enum.Material.SmoothPlastic)
		end
	end
	return model
end

function Kit.billboard(
	adornee: BasePart,
	text: string,
	color: Color3,
	sizeY: number?,
	offset: number?,
	maxDistance: number?
): TextLabel
	local gui = Kit.new("BillboardGui", {
		Size = UDim2.fromScale(14, sizeY or 3),
		StudsOffsetWorldSpace = Vector3.new(0, offset or 6, 0),
		AlwaysOnTop = false,
		LightInfluence = 0,
		MaxDistance = maxDistance or 220,
	}, adornee)
	local label = Kit.new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = text,
		TextScaled = true,
		TextColor3 = color,
		FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.ExtraBold),
	}, gui)
	Kit.new("UIStroke", { Thickness = 3, Color = Color3.fromHex("17203C") }, label)
	return label
end

function Kit.prompt(parent: Instance, action: string, object: string, distance: number?): ProximityPrompt
	return Kit.new("ProximityPrompt", {
		ActionText = action,
		ObjectText = object,
		MaxActivationDistance = distance or 14,
		HoldDuration = 0,
		RequiresLineOfSight = false,
		KeyboardKeyCode = Enum.KeyCode.E,
	}, parent)
end

function Kit.light(parent: BasePart, color: Color3, brightness: number, range: number)
	return Kit.new("PointLight", { Color = color, Brightness = brightness, Range = range, Shadows = false }, parent)
end

return Kit
