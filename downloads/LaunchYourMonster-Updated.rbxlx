      <Item class="ModuleScript" referent="32">
        <Properties>
          <Content name="LinkedSource">
            <null />
          </Content>
          <string name="ScriptGuid">{D938C57A-0C7D-4D7B-810A-3AE5B03062A4}</string>
          <BinaryString name="AttributesSerialize" />
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <bool name="DefinesCapabilities">false</bool>
          <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
          <string name="Name">Monsters</string>
          <BinaryString name="SerializedOverrides" />
          <int64 name="SourceAssetId">-1</int64>
          <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
          <UniqueId name="UniqueId">038c44eb3ebffb0c0af64a9d000003fc</UniqueId>
          <ProtectedString name="Source">--!strict
-- Monsters: starter Mallow (once), one-slot equip swap, duplicate fusion into Genome
-- Shards, deterministic cosmetic variants, collection, egg world gate, follower attributes.
-- Inventory owns the monsters (uids); GameState.Monsters owns their level/xp/variant.
-- Remotes: Monsters.Equip(uid)  Monsters.Fuse(petId)  Monsters.Variant(uid, variant)


local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))
local Game = ReplicatedStorage:WaitForChild("Game")
local GameConfig = require(Game:WaitForChild("GameConfig")) :: any
local Pets = require(Game:WaitForChild("PetDefinitions")) :: any
local LF = ServerScriptService:WaitForChild("LihFolk")
local PlayerData = require(LF:WaitForChild("PlayerData"))
local Currency = require(LF:WaitForChild("Currency"))
local Inventory = require(LF:WaitForChild("Inventory"))
local EggHatch = require(LF:WaitForChild("EggHatch"))
local Quests = require(LF:WaitForChild("Quests"))
local GameState = require(script.Parent.GameState)
local Flight = require(script.Parent.Flight)

local T = Net.T

local Monsters = {}

local VARIANTS = { Normal = true }
for _, mutation in GameConfig.Mutations do
	VARIANTS[mutation.id] = true
end

-- Replicates the equipped monster so every client can draw its follower.
function Monsters.Publish(player: Player)
	local uid, petId, level = Flight.Equipped(player)
	local data = GameState.Get(player)
	player:SetAttribute("PetId", petId)
	player:SetAttribute("PetLevel", level)
	player:SetAttribute("PetMutation", if uid and data then GameState.Monster(data, uid).Mutation else "Normal")
end

local function equip(player: Player, uid: string): Net.Result
	local profile = PlayerData.Get(player)
	if not profile then
		return Net.fail("NotReady")
	end
	if Flight.IsFlying(player) then
		return Net.fail("Flying")
	end
	local inv = profile.Data.Inventory
	if not inv.Uniques[uid] then
		return Net.fail("NotOwned")
	end
	table.clear(inv.Equipped) -- one slot: the swap is atomic, never "EquipFull"
	inv.Equipped[uid] = true
	PlayerData.MarkDirty(profile)
	Inventory.Refresh(player)
	Monsters.Publish(player)
	return Net.ok()
end

-- Fuses every extra copy of one species. Keeps the equipped copy, else the highest level.
local function fuse(player: Player, petId: string): Net.Result
	if Flight.IsFlying(player) then return Net.fail("Flying") end
	local data = GameState.Get(player)
	local profile = PlayerData.Get(player)
	if not data or not profile then
		return Net.fail("NotReady")
	end
	local inv = profile.Data.Inventory
	local copies = {}
	for uid, unique in inv.Uniques do
		if unique.Item == petId then
			table.insert(copies, uid)
		end
	end
	if #copies &lt; 2 then
		return Net.fail("NoDuplicates")
	end
	local keep = copies[1]
	for _, uid in copies do
		if inv.Equipped[uid] then
			keep = uid
			break
		end
		if GameState.Monster(data, uid).Level &gt; GameState.Monster(data, keep).Level then
			keep = uid
		end
	end
	local perCopy = GameConfig.Rarities[Pets.ById[petId].rarity].shards
	local shards = 0
	for _, uid in copies do
		if uid ~= keep and Inventory.RemoveUnique(player, uid) then
			data.Monsters[uid] = nil
			shards += perCopy
		end
	end
	Currency.Add(player, "GenomeShards", shards, "fuse")
	GameState.Changed(player)
	return Net.ok({ shards = shards, kept = keep })
end

-- Unlocks (Genome Shards + level gate) or applies an unlocked cosmetic variant.
local function variant(player: Player, uid: string, id: string): Net.Result
	if Flight.IsFlying(player) then return Net.fail("Flying") end
	local data = GameState.Get(player)
	if not data then
		return Net.fail("NotReady")
	end
	if not Inventory.GetUnique(player, uid) then
		return Net.fail("NotOwned")
	end
	local meta = GameState.Monster(data, uid)
	if id ~= "Normal" and not meta.Unlocked[id] then
		local rule = GameConfig.MutationById[id]
		if meta.Level &lt; rule.minLevel then
			return Net.fail("NeedLevel", rule.minLevel)
		end
		if not Currency.Spend(player, "GenomeShards", rule.shards, `variant:{id}`) then
			return Net.fail("NotEnough")
		end
		meta.Unlocked[id] = true
	end
	meta.Mutation = id
	GameState.Changed(player)
	Monsters.Publish(player)
	return Net.ok()
end

local function grantStarter(player: Player, profile: PlayerData.Profile)
	local data = profile.Data.Game
	local inv = profile.Data.Inventory
	if not data.StarterGiven and next(inv.Uniques) == nil then
		local ok, _, uids = Inventory.Add(player, Pets.Starter, 1)
		if ok and uids and uids[1] then
			inv.Equipped[uids[1]] = true
			data.StarterGiven = true
			data.Discovered[Pets.Starter] = true
			PlayerData.MarkDirty(profile)
		end
	elseif next(inv.Equipped) == nil then
		local first = next(inv.Uniques)
		if first then
			inv.Equipped[first] = true -- repair: always one monster equipped
			PlayerData.MarkDirty(profile)
		end
	end
	data.StarterGiven = true
	GameState.Changed(player)
	Monsters.Publish(player)
end

function Monsters.Init()
	Net.Handle("Monsters.Equip", {
		rate = { burst = 6, perSecond = 3 },
		args = { T.guid },
		handler = equip,
	})
	Net.Handle("Monsters.Fuse", {
		rate = { burst = 3, perSecond = 1 },
		args = { T.key(Pets.ById) },
		handler = fuse,
	})
	Net.Handle("Monsters.Variant", {
		rate = { burst = 4, perSecond = 2 },
		args = { T.guid, T.key(VARIANTS) },
		handler = variant,
	})

	-- Eggs need their world unlocked (checked before EggHatch charges).
	local eggWorld = {}
	for _, egg in Pets.Eggs do
		eggWorld[egg.id] = egg.world
	end
	EggHatch.SetHatchCheck(function(player: Player, eggId: string): (boolean, string?)
		local data = GameState.Get(player)
		if not data or not data.Unlocked[eggWorld[eggId]] then
			return false, "WorldLocked"
		end
		return true, nil
	end)
	EggHatch.Hatched:Connect(function(player: Player, eggId: string, results: { any })
		local data = GameState.Get(player)
		if data then
			for _, result in results do
				data.Discovered[result.item] = true
				if result.uid then
					GameState.Monster(data, result.uid)
				end
			end
			GameState.Changed(player)
		end
		Quests.Report(player, "Hatch", eggId, #results)
	end)

	PlayerData.Loaded:Connect(grantStarter)
end

return Monsters
</ProtectedString>
