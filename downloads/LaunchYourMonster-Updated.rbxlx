              <ProtectedString name="Source">-- ProfileService: one DataStore key per player holding { data, lock, savedAt }.
-- Session locks stop two servers from writing the same profile. A failed load puts
-- the player in a non-saving safe mode so defaults never overwrite real data.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local WorldConfig = require(Shared.WorldConfig)
local Pets = require(Shared.PetDefinitions)
local Net = require(script.Parent.Net)

local ProfileService = {}

local STORE_NAME = "LYM_Profiles_v1"
local PROFILE_VERSION = 1
local LOCK_TIMEOUT = 1800
local AUTOSAVE = 120
local MAX_LOAD_ATTEMPTS = 6
local MAX_SAVE_ATTEMPTS = 4
local JOB_ID = game.JobId

local profiles = {}
local loadedCallbacks, leavingCallbacks = {}, {}
local store: DataStore? = nil
local storeAvailable = true

do
	local ok, result = pcall(DataStoreService.GetDataStore, DataStoreService, STORE_NAME)
	if ok then
		store = result
	else
		storeAvailable = false
		warn("[Profile] DataStore unavailable: " .. tostring(result))
	end
end

------------------------------------------------------------------------
-- Schema
------------------------------------------------------------------------
local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end
ProfileService.deepCopy = deepCopy

function ProfileService.defaultData()
	local best = {}
	for _, world in WorldConfig.List do
		best[world.id] = 0
	end
	return {
		ProfileVersion = PROFILE_VERSION,
		StarCoins = 0,
		GenomeShards = 0,
		TrainingLevel = 1,
		TrainingXP = 0,
		CannonLevel = 0,
		BoostLevel = 1,
		BounceLevel = 0,
		MagnetLevel = 0,
		UnlockedWorlds = { [WorldConfig.Home] = true },
		BestDistanceByWorld = best,
		OwnedPets = {},
		EquippedPetUniqueId = "",
		NextPetUid = 1,
		Discovered = {},
		OwnedTrails = { Default = true },
		EquippedTrail = "Default",
		Missions = { day = -1, progress = {}, claimed = {} },
		PrestigeCount = 0,
		Stats = { TotalLaunches = 0, TotalFlightDistance = 0, TotalRings = 0, TotalHatches = 0 },
		Settings = deepCopy(GameConfig.DefaultSettings),
		Tutorial = 0,
	}
end

local function num(value, default: number, min: number?, max: number?): number
	local n = tonumber(value)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return default
	end
	return math.clamp(n, min or 0, max or GameConfig.MaxCurrency)
end

local function int(value, default: number, min: number?, max: number?): number
	return math.floor(num(value, default, min, max))
end

local function tbl(value)
	return if type(value) == "table" then value else {}
end

-- Future schema migrations go here (ProfileVersion &lt; 2 -&gt; ...).
local function migrate(raw)
	raw.ProfileVersion = tonumber(raw.ProfileVersion) or PROFILE_VERSION
	return raw
end

local function sanitize(raw)
	local d = ProfileService.defaultData()
	if type(raw) ~= "table" then
		return d
	end
	raw = migrate(raw)
	d.StarCoins = int(raw.StarCoins, 0)
	d.GenomeShards = int(raw.GenomeShards, 0)
	d.TrainingLevel = int(raw.TrainingLevel, 1, 1, GameConfig.Training.MaxLevel)
	d.TrainingXP = int(raw.TrainingXP, 0, 0, 1e9)
	for _, upgrade in GameConfig.Upgrades do
		d[upgrade.field] = int(raw[upgrade.field], upgrade.min, upgrade.min, upgrade.max)
	end
	for id, value in tbl(raw.UnlockedWorlds) do
		if value == true and WorldConfig.ById[id] then
			d.UnlockedWorlds[id] = true
		end
	end
	local best = tbl(raw.BestDistanceByWorld)
	for _, world in WorldConfig.List do
		d.BestDistanceByWorld[world.id] = int(best[world.id], 0, 0, world.length)
	end

	-- Pets: unknown species and duplicated uids are dropped, the cap is enforced
	local seen, maxUid = {}, 0
	for _, entry in ipairs(tbl(raw.OwnedPets)) do
		if
			type(entry) == "table"
			and type(entry.uniqueId) == "string"
			and Pets.ById[entry.petId]
			and not seen[entry.uniqueId]
			and #d.OwnedPets &lt; GameConfig.InventoryCap
		then
			seen[entry.uniqueId] = true
			local mutation = if GameConfig.MutationById[entry.mutation] then entry.mutation else "Normal"
			table.insert(d.OwnedPets, {
				uniqueId = entry.uniqueId,
				petId = entry.petId,
				level = int(entry.level, 1, 1, GameConfig.PetLevel.Max),
				xp = int(entry.xp, 0, 0, 1e9),
				mutation = mutation,
				unlocked = {},
			})
			for _, m in ipairs(tbl(entry.unlocked)) do
				if GameConfig.MutationById[m] then
					table.insert(d.OwnedPets[#d.OwnedPets].unlocked, m)
				end
			end
			maxUid = math.max(maxUid, tonumber(string.sub(entry.uniqueId, 2)) or 0)
		end
	end
	d.NextPetUid = math.max(int(raw.NextPetUid, 1, 1, 1e12), maxUid + 1)
	if type(raw.EquippedPetUniqueId) == "string" and seen[raw.EquippedPetUniqueId] then
		d.EquippedPetUniqueId = raw.EquippedPetUniqueId
	end
	for id, value in tbl(raw.Discovered) do
		if value == true and Pets.ById[id] then
			d.Discovered[id] = true
		end
	end
	for name, value in tbl(raw.OwnedTrails) do
		if value == true and type(name) == "string" and #name &lt;= 32 then
			d.OwnedTrails[name] = true
		end
	end
	if type(raw.EquippedTrail) == "string" and d.OwnedTrails[raw.EquippedTrail] then
		d.EquippedTrail = raw.EquippedTrail
	end
	local missions = tbl(raw.Missions)
	d.Missions.day = int(missions.day, -1, -1, 1e9)
	for _, mission in GameConfig.MissionPool do
		d.Missions.progress[mission.id] = int(tbl(missions.progress)[mission.id], 0, 0, 1e9)
		if tbl(missions.claimed)[mission.id] == true then
			d.Missions.claimed[mission.id] = true
		end
	end
	d.PrestigeCount = int(raw.PrestigeCount, 0, 0, GameConfig.Prestige.MaxStacks)
	local stats = tbl(raw.Stats)
	for key in d.Stats do
		d.Stats[key] = int(stats[key], 0, 0, 1e15)
	end
	local settings = tbl(raw.Settings)
	for key, default in GameConfig.DefaultSettings do
		if type(settings[key]) == type(default) then
			d.Settings[key] = settings[key]
		end
	end
	d.Tutorial = int(raw.Tutorial, 0, 0, 99)
	return d
end
ProfileService.sanitize = sanitize

-- Starter monster: granted only when the profile owns no pets at all (idempotent).
local function ensureStarter(data): boolean
	if #data.OwnedPets &gt; 0 then
		if data.EquippedPetUniqueId == "" then
			data.EquippedPetUniqueId = data.OwnedPets[1].uniqueId
		end
		return false
	end
	local uid = "p" .. data.NextPetUid
	data.NextPetUid += 1
	table.insert(
		data.OwnedPets,
		{ uniqueId = uid, petId = Pets.Starter, level = 1, xp = 0, mutation = "Normal", unlocked = {} }
	)
	data.EquippedPetUniqueId = uid
	data.Discovered[Pets.Starter] = true
	return true
end
ProfileService.ensureStarter = ensureStarter

------------------------------------------------------------------------
-- DataStore IO
------------------------------------------------------------------------
local function isStudioApiError(err): boolean
	local message = tostring(err)
	return RunService:IsStudio()
		and (
			message:find("StudioAccessToApisNotAllowed") ~= nil
			or message:find("publish") ~= nil
			or message:find("403") ~= nil
		)
end

-- Returns raw data (nil = new player), canSave, reason
local function loadAsync(player: Player)
	if not storeAvailable or not store then
		return nil, false, "studio"
	end
	local key = "u_" .. player.UserId
	for attempt = 1, MAX_LOAD_ATTEMPTS do
		if not player.Parent then
			return nil, false, "left"
		end
		local locked, loaded = false, nil
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				locked = false
				local record = if type(old) == "table" then old else {}
				local lock = record.lock
				local active = type(lock) == "table"
					and lock.job ~= JOB_ID
					and os.time() - (tonumber(lock.t) or 0) &lt; LOCK_TIMEOUT
				if active and attempt &lt; MAX_LOAD_ATTEMPTS then
					locked = true
					return nil -- cancel the write; another server still owns the session
				end
				record.lock = { job = JOB_ID, t = os.time() }
				loaded = record.data
				return record
			end)
		end)
		if ok and not locked then
			return loaded, true, "ok"
		end
		if not ok then
			warn(`[Profile] load attempt {attempt} for {player.Name} failed: {err}`)
			if isStudioApiError(err) then
				storeAvailable = false
				return nil, false, "studio"
			end
		end
		task.wait(math.min(2 ^ attempt, 12) + math.random())
	end
	return nil, false, "failed"
end

local function writeAsync(player: Player, profile, release: boolean): boolean
	if not store then
		return false
	end
	local key = "u_" .. player.UserId
	local snapshot = deepCopy(profile.data)
	for attempt = 1, MAX_SAVE_ATTEMPTS do
		local lostLock = false
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				local record = if type(old) == "table" then old else {}
				local lock = record.lock
				if type(lock) == "table" and lock.job ~= JOB_ID then
					lostLock = true
					return nil
				end
				record.data = snapshot
				record.lock = if release then nil else { job = JOB_ID, t = os.time() }
				record.savedAt = os.time()
				return record
			end)
		end)
		if ok then
			if lostLock then
				warn(`[Profile] {player.Name}'s session moved to another server; saving disabled here`)
				profile.canSave = false
				return false
			end
			return true
		end
		warn(`[Profile] save attempt {attempt} for {player.Name} failed: {err}`)
		task.wait(2 ^ attempt + math.random())
	end
	return false
end

-- Serialised per profile so writes never overlap.
function ProfileService.save(player: Player, release: boolean?)
	local profile = profiles[player]
	if not profile or not profile.canSave then
		return
	end
	while profile.saving do
		task.wait(0.2)
	end
	if not profile.canSave then
		return
	end
	profile.saving = true
	local ok, err = pcall(writeAsync, player, profile, release == true)
	profile.saving = false
	if not ok then
		warn("[Profile] save error: " .. tostring(err))
	end
end

------------------------------------------------------------------------
-- Access + replication
------------------------------------------------------------------------
function ProfileService.get(player: Player)
	local profile = profiles[player]
	return profile and profile.data
end

function ProfileService.profile(player: Player)
	return profiles[player]
end

function ProfileService.isReady(player: Player): boolean
	return profiles[player] ~= nil
end

function ProfileService.onLoaded(fn)
	table.insert(loadedCallbacks, fn)
end

function ProfileService.onLeaving(fn)
	table.insert(leavingCallbacks, fn)
end

-- Marks top-level keys for replication on the next flush.
function ProfileService.mark(player: Player, ...: string)
	local profile = profiles[player]
	if not profile then
		return
	end
	for i = 1, select("#", ...) do
		profile.dirty[select(i, ...)] = true
	end
end

function ProfileService.addCoins(player: Player, amount: number)
	local data = ProfileService.get(player)
	if not data or amount ~= amount or amount &lt;= 0 then
		return
	end
	data.StarCoins = math.min(GameConfig.MaxCurrency, data.StarCoins + math.floor(amount))
	ProfileService.mark(player, "StarCoins")
end

-- Atomic check-and-debit; never yields.
function ProfileService.spend(player: Player, field: string, amount: number): boolean
	local data = ProfileService.get(player)
	if not data or amount ~= amount or amount &lt; 0 or (data[field] or 0) &lt; amount then
		return false
	end
	data[field] -= amount
	ProfileService.mark(player, field)
	return true
end

local function bestOverall(data): number
	local best = 0
	for _, value in data.BestDistanceByWorld do
		best = math.max(best, value)
	end
	return best
end

local function updateLeaderstats(player: Player, data)
	local folder = player:FindFirstChild("leaderstats")
	if folder then
		folder.StarCoins.Value = data.StarCoins
		folder.BestDistance.Value = bestOverall(data)
		folder.Launches.Value = data.Stats.TotalLaunches
	end
end

local LEADERSTAT_KEYS = { StarCoins = true, BestDistanceByWorld = true, Stats = true }

local function flush()
	for player, profile in profiles do
		if next(profile.dirty) then
			local payload, touches = {}, false
			for key in profile.dirty do
				payload[key] = profile.data[key]
				touches = touches or LEADERSTAT_KEYS[key] == true
			end
			table.clear(profile.dirty)
			ReplicatedStorage.Remotes.Sync:FireClient(player, "patch", payload)
			if touches then
				updateLeaderstats(player, profile.data)
			end
		end
	end
end

------------------------------------------------------------------------
-- Lifecycle
------------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	local raw, canSave, reason = loadAsync(player)
	if not player.Parent then
		if canSave then
			profiles[player] = { data = sanitize(raw), canSave = true, dirty = {}, saving = false }
			ProfileService.save(player, true) -- release the lock we just took
			profiles[player] = nil
		end
		return
	end
	local data = sanitize(raw)
	local isNew = ensureStarter(data)
	local profile = { data = data, canSave = canSave, dirty = {}, saving = false, isNew = isNew, reason = reason }
	profiles[player] = profile

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	for _, name in { "StarCoins", "BestDistance", "Launches" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = leaderstats
	end
	leaderstats.Parent = player
	updateLeaderstats(player, data)

	ReplicatedStorage.Remotes.Sync:FireClient(player, "full", data, { canSave = canSave, reason = reason })
	if reason == "studio" then
		Net.notify(player, "Studio test: saving is OFF (enable API access to test saving).", "warn")
	elseif reason == "failed" then
		Net.notify(
			player,
			"Could not load your data. Progress will NOT be saved this session - please rejoin later.",
			"error"
		)
	end
	for _, fn in loadedCallbacks do
		task.spawn(fn, player, data, profile)
	end
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	for _, fn in leavingCallbacks do
		local ok, err = pcall(fn, player, profile.data)
		if not ok then
			warn("[Profile] leaving callback failed: " .. tostring(err))
		end
	end
	ProfileService.save(player, true)
	profiles[player] = nil
end

function ProfileService.start()
	Net.setReadyCheck(ProfileService.isReady)
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	task.spawn(function()
		while true do
			task.wait(0.1)
			flush()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE)
			for player in profiles do
				task.spawn(ProfileService.save, player, false)
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				onPlayerRemoving(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending &gt; 0 and os.clock() &lt; deadline do
			task.wait(0.1)
		end
	end)
end

return ProfileService
</ProtectedString>
              <string name="ScriptGuid">{5786C052-AD1B-496A-BAD6-DB5F61EFCAEA}</string>
              <BinaryString name="AttributesSerialize" />
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <bool name="DefinesCapabilities">false</bool>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <string name="Name">ProfileService</string>
              <BinaryString name="SerializedOverrides" />
              <int64 name="SourceAssetId">-1</int64>
              <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
              <UniqueId name="UniqueId">7b3034da324dfa3f0af65b5900000b2c</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBXDE7A93ABD60D47E3A2D60D371BA3849F">
            <Properties>
              <Content name="LinkedSource">
                <null />
              </Content>
              <ProtectedString name="Source">-- ProgressionService: upgrades, power training, daily missions, prestige, settings, tutorial.
-- Every handler validates input, checks state and debits atomically (handlers never yield).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Net = require(script.Parent.Net)
local ProfileService = require(script.Parent.ProfileService)
local FlightService = require(script.Parent.FlightService)
local Analytics = require(script.Parent.Analytics)

local ProgressionService = {}

local trainAims: { [Player]: { session: number, start: number, period: number } } = {}
local lastTrain: { [Player]: number } = {}

------------------------------------------------------------------------
-- Missions
------------------------------------------------------------------------
local function today(): number
	return math.floor(os.time() / 86400)
end

local function refreshMissions(player: Player, data)
	local day = today()
	if data.Missions.day ~= day then
		data.Missions.day = day
		table.clear(data.Missions.progress)
		table.clear(data.Missions.claimed)
		ProfileService.mark(player, "Missions")
	end
end

function ProgressionService.activeMissions(): { any }
	return GameConfig.missionsForDay(today())
end

-- Adds progress to every active mission tracking `stat` (bestToday keeps the max).
function ProgressionService.bump(player: Player, stat: string, amount: number)
	local data = ProfileService.get(player)
	if not data or amount &lt;= 0 then
		return
	end
	refreshMissions(player, data)
	local changed = false
	for _, mission in ProgressionService.activeMissions() do
		if mission.stat == stat and not data.Missions.claimed[mission.id] then
			local current = data.Missions.progress[mission.id] or 0
			local value = if stat == "bestToday" then math.max(current, amount) else current + amount
			value = math.min(value, mission.goal)
			if value ~= current then
				data.Missions.progress[mission.id] = value
				changed = true
			end
		end
	end
	if changed then
		ProfileService.mark(player, "Missions")
	end
end

------------------------------------------------------------------------
-- Training
------------------------------------------------------------------------
function ProgressionService.addTrainingXp(player: Player, xp: number)
	local data = ProfileService.get(player)
	if not data or data.TrainingLevel &gt;= GameConfig.Training.MaxLevel then
		return false
	end
	data.TrainingXP += xp
	local leveled = false
	while
		data.TrainingLevel &lt; GameConfig.Training.MaxLevel
		and data.TrainingXP &gt;= GameConfig.trainingXpForLevel(data.TrainingLevel)
	do
		data.TrainingXP -= GameConfig.trainingXpForLevel(data.TrainingLevel)
		data.TrainingLevel += 1
		leveled = true
	end
	if data.TrainingLevel &gt;= GameConfig.Training.MaxLevel then
		data.TrainingXP = 0
	end
	ProfileService.mark(player, "TrainingLevel", "TrainingXP")
	return leveled
end

------------------------------------------------------------------------
-- Flight results feed missions and stats
------------------------------------------------------------------------
local function onFlightFinished(player: Player, summary)
	ProgressionService.bump(player, "launches", 1)
	ProgressionService.bump(player, "rings", summary.rings)
	ProgressionService.bump(player, "perfectBounces", summary.perfectBounces)
	ProgressionService.bump(player, "bestToday", summary.distance)
	if summary.timing == "Perfect" then
		ProgressionService.bump(player, "perfectLaunches", 1)
	end
	if summary.boosted then
		ProgressionService.bump(player, "boosts", 1)
	end
end

function ProgressionService.init()
	FlightService.onFinished(onFlightFinished)

	ProfileService.onLoaded(function(player, data)
		refreshMissions(player, data)
	end)

	Net.handle("BuyUpgrade", function(player, id)
		local upgrade = type(id) == "string" and GameConfig.UpgradeById[id]
		if not upgrade then
			return { ok = false, msg = "Unknown upgrade" }
		end
		local data = ProfileService.get(player)
		local level = data[upgrade.field]
		local cost = GameConfig.upgradeCost(upgrade, level)
		if not cost then
			return { ok = false, msg = "Already maxed!" }
		end
		if not ProfileService.spend(player, "StarCoins", cost) then
			return { ok = false, msg = "Not enough Star Coins" }
		end
		data[upgrade.field] = level + 1
		ProfileService.mark(player, upgrade.field)
		if data.Tutorial &lt; 3 then
			data.Tutorial = 3
			ProfileService.mark(player, "Tutorial")
			Analytics.funnel(player, "first_upgrade")
		end
		return { ok = true, level = level + 1 }
	end, 6, 8)

	Net.handle("BeginTrain", function(player)
		if FlightService.isFlying(player) then
			return { ok = false, msg = "You're flying!" }
		end
		local data = ProfileService.get(player)
		local period = if data.Settings.slowTiming
			then GameConfig.Flight.MarkerPeriodSlow
			else GameConfig.Flight.MarkerPeriod
		local previous = trainAims[player]
		local aim = {
			session = (previous and previous.session or 0) + 1,
			start = workspace:GetServerTimeNow(),
			period = period,
		}
		trainAims[player] = aim
		return { ok = true, session = aim.session, start = aim.start, period = period }
	end, 2, 3)

	Net.handle("Train", function(player, payload)
		local aim = trainAims[player]
		if type(payload) ~= "table" or not aim or payload.session ~= aim.session then
			return { ok = false, msg = "Start training first" }
		end
		local now = os.clock()
		if now - (lastTrain[player] or 0) &lt; GameConfig.Training.Cooldown then
			return { ok = false, msg = "Catch your breath!" }
		end
		trainAims[player] = nil
		lastTrain[player] = now
		local data = ProfileService.get(player)
		if data.TrainingLevel &gt;= GameConfig.Training.MaxLevel then
			return { ok = false, msg = "Power is maxed!" }
		end
		local timing = GameConfig.timingFor(FlightService.verifyMarker(player, aim, payload.marker))
		local xp = GameConfig.Training.Xp[timing]
		local leveled = ProgressionService.addTrainingXp(player, xp)
		ProgressionService.bump(player, "trains", 1)
		return { ok = true, timing = timing, xp = xp, leveled = leveled, level = data.TrainingLevel }
	end, 2, 3)

	Net.handle("ClaimMission", function(player, id)
		local data = ProfileService.get(player)
		refreshMissions(player, data)
		for _, mission in ProgressionService.activeMissions() do
			if mission.id == id then
				if data.Missions.claimed[id] then
					return { ok = false, msg = "Already claimed" }
				end
				if (data.Missions.progress[id] or 0) &lt; mission.goal then
					return { ok = false, msg = "Not finished yet" }
				end
				data.Missions.claimed[id] = true -- mark before granting: one claim only
				ProfileService.mark(player, "Missions")
				ProfileService.addCoins(player, mission.reward)
				return { ok = true, reward = mission.reward }
			end
		end
		return { ok = false, msg = "Mission not active" }
	end, 4, 6)

	Net.handle("Prestige", function(player)
		local p = GameConfig.Prestige
		if not p.Enabled then
			return { ok = false, msg = "Coming soon" }
		end
		local data = ProfileService.get(player)
		if FlightService.isFlying(player) then
			return { ok = false, msg = "Land first!" }
		end
		if data.PrestigeCount &gt;= p.MaxStacks then
			return { ok = false, msg = "Max prestige reached" }
		end
		if not data.UnlockedWorlds.NebulaWilds or (data.BestDistanceByWorld.NebulaWilds or 0) &lt; p.MinWorld3Best then
			return { ok = false, msg = `Fly {p.MinWorld3Best} studs in Nebula Wilds first` }
		end
		if data.StarCoins &lt; p.Cost then
			return { ok = false, msg = "Not enough Star Coins" }
		end
		data.StarCoins = 0
		data.CannonLevel = 0
		data.PrestigeCount += 1
		ProfileService.mark(player, "StarCoins", "CannonLevel", "PrestigeCount")
		return { ok = true, count = data.PrestigeCount }
	end, 1, 1)

	Net.handle("SetSetting", function(player, payload)
		if type(payload) ~= "table" or type(payload.key) ~= "string" then
			return { ok = false }
		end
		local default = GameConfig.DefaultSettings[payload.key]
		if default == nil or type(payload.value) ~= type(default) then
			return { ok = false }
		end
		local data = ProfileService.get(player)
		data.Settings[payload.key] = payload.value
		ProfileService.mark(player, "Settings")
		return { ok = true }
	end, 8, 12)

	Net.handle("TutorialStep", function(player, step)
		local data = ProfileService.get(player)
		if type(step) == "number" and step == step and step &gt; data.Tutorial and step &lt;= 10 then
			data.Tutorial = math.floor(step)
			ProfileService.mark(player, "Tutorial")
		end
		return { ok = true }
	end, 4, 6)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		trainAims[player] = nil
		lastTrain[player] = nil
	end)
end

return ProgressionService
</ProtectedString>
