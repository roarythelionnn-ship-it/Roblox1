            <ProtectedString name="Source">--!strict
-- Launch: aim + power timing, the local flight (predicted with FlightSim, reconciled to
-- server snapshots), other players' flights (interpolated), flight camera, flight HUD and
-- the results window. Built on the LihFolk UI kit; one focal action per screen.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))
local Signal = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Signal"))
local UIKit = ReplicatedStorage:WaitForChild("LihFolkUI")
local Theme = require(UIKit:WaitForChild("LihFolkUITheme")) :: any
local C = require(UIKit:WaitForChild("LihFolkUIComponents")) :: any
local Icons = require(UIKit:WaitForChild("LihFolkUIIcons")) :: any
local Controller = require(UIKit:WaitForChild("LihFolkUIController")) :: any
local Game = ReplicatedStorage:WaitForChild("Game")
local GameConfig = require(Game:WaitForChild("GameConfig")) :: any
local WorldConfig = require(Game:WaitForChild("WorldConfig")) :: any
local FlightSim = require(Game:WaitForChild("FlightSim")) :: any
local Pets = require(Game:WaitForChild("PetDefinitions")) :: any
local Data = require(script.Parent.Data)
local Models = require(script.Parent.Models)
local Fx = require(script.Parent.Fx)
local UiFx = require(script.Parent.UiFx)
local RidingClient = require(script.Parent.RidingClient)
local Format = require(script.Parent.Format)

local player = Players.LocalPlayer
local F = GameConfig.Flight
local P = Theme.Palette
local SP = Theme.Space

local Launch = {}
Launch.mode = "idle" -- idle | aim | fly | results
Launch.ModeChanged = Signal.new()

local TRAIL = {
	Soft = { "8CCBFF", "FFFFFF" },
	Bubbles = { "3FD6C9", "D9FFFA" },
	Feathers = { "FF9C45", "FFE3C2" },
	Leaves = { "8BEA3C", "E8FFC9" },
	Sparks = { "FF5A3C", "FFD84D" },
	Starlight = { "FFFFFF", "C7A8FF" },
	Lightning = { "FFE45C", "496BFF" },
	Clouds = { "FFFFFF", "8FD9FF" },
	Crystal = { "A37CFF", "E9DDFF" },
	Rocket = { "FF4B4B", "FFC85B" },
	Aurora = { "2EC4B6", "9D5CFF" },
	Neon = { "C04BFF", "37F4FF" },
	Solar = { "FFC93C", "FF8A2B" },
	Quantum = { "38E8FF", "FF4FD8" },
	Cosmic = { "FFDE70", "5E64D9" },
}
local ELEMENT = { SunnySpringlands = "teal", CloudtopCircuit = "lightning", NebulaWilds = "violet" }

local ui: { [string]: any } = {}
local aim: { [string]: any }? = nil
local flight: { [string]: any }? = nil
local others: { [number]: any } = {}
local fxFolder: Folder
local savedMovement: { number }? = nil
local touchSteer = 0

local function setMode(mode: string)
	Launch.mode = mode
	Launch.ModeChanged:Fire(mode)
end

local function settings(): { [string]: any }
	local game = Data.game
	return if game then game.Settings else GameConfig.DefaultSettings
end

local function toWorld(world, x: number, y: number, z: number): Vector3
	return Vector3.new(world.origin[1] + x, world.origin[2] + y, world.origin[3] + z)
end

local function lockCharacter(lock: boolean)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if lock and not savedMovement then
		savedMovement = { humanoid.WalkSpeed, humanoid.JumpHeight }
		humanoid.WalkSpeed = 0
		humanoid.JumpHeight = 0
	elseif not lock and savedMovement then
		humanoid.WalkSpeed = savedMovement[1]
		humanoid.JumpHeight = savedMovement[2]
		savedMovement = nil
	end
end

local function restoreCamera()
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

------------------------------------------------------------------------
-- Launcher visuals (barrel pitch + recoil)
------------------------------------------------------------------------
local barrelBase: { [BasePart]: CFrame } = {}

local function barrelOf(worldId: string): BasePart?
	for _, model in CollectionService:GetTagged("LYM_Cannon") do
		if model:GetAttribute("World") == worldId then
			local barrel = model:FindFirstChild("barrel", true)
			if barrel and barrel:IsA("BasePart") then
				return barrel
			end
		end
	end
	return nil
end

local function aimBarrel(worldId: string, angle: number, recoil: number?)
	local barrel = barrelOf(worldId)
	if not barrel then
		return
	end
	local base = barrelBase[barrel]
	if not base then
		base = barrel.CFrame
		barrelBase[barrel] = base
	end
	-- Pitch around the barrel's rear (approximated as its centre minus half its length on the
	-- course axis), recoil straight back down the course.
	local pivot = base.Position - Vector3.new(0, barrel.Size.Y * 0.25, barrel.Size.Z * 0.35)
	local delta = math.rad(angle - 45)
	local rotated = CFrame.new(pivot) * CFrame.Angles(-delta, 0, 0) * CFrame.new(-pivot) * base
	local target = CFrame.new(0, -(recoil or 0) * 0.4, -(recoil or 0)) * rotated
	local assembly = barrel.Parent
	if assembly and assembly.Name == "BarrelAssembly" and assembly:IsA("Model") then
		local deltaCf = target * barrel.CFrame:Inverse()
		assembly:PivotTo(deltaCf * assembly:GetPivot())
	else
		barrel.CFrame = target
	end
end

------------------------------------------------------------------------
-- Monster visuals
------------------------------------------------------------------------
local function monsterModel(petId: string, variant: string, withTrail: boolean): Model
	local model = Models.clone("Monsters", petId) or Instance.new("Model")
	model.Name = "Flying_" .. petId
	local root = model.PrimaryPart
	if withTrail and root then
		local def = Pets.ById[petId]
		local colors = TRAIL[def and def.trail or "Soft"] or TRAIL.Soft
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 1, 1.4)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -1, 1.4)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.5
		trail.LightEmission = 0.8
		trail.LightInfluence = 0
		trail.FaceCamera = true
		trail.Color = ColorSequence.new(Color3.fromHex(colors[1]), Color3.fromHex(colors[2]))
		trail.Transparency =
			NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(1, 1) })
		trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.05) })
		trail.Parent = root
	end
	Models.applyVariant(model, variant)
	model.Parent = fxFolder
	return model
end

local function orient(position: Vector3, velocity: Vector3, wobble: number): CFrame
	local dir = if velocity.Magnitude &gt; 1 then velocity.Unit else Vector3.zAxis
	return CFrame.lookAt(position, position + dir) * CFrame.Angles(0, 0, math.sin(wobble) * 0.2)
end

------------------------------------------------------------------------
-- HUD layer: one UiFx scaled root (design units, shared HUD scale, 44 px touch floor).
-- Positions change only in layoutHud(); per-frame code writes the marker, the ring marker
-- and text that actually changed.
------------------------------------------------------------------------
local MARGIN = Theme.Size.screenMargin
local TIMING_COLOR = { Perfect = P.gold, Good = Theme.Roles.go.top, Miss = P.negative }

local function panel(parent: Instance, size: UDim2, position: UDim2, anchor: Vector2): Frame
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	frame.Size = size
	frame.Position = position
	frame.AnchorPoint = anchor
	frame.Parent = parent
	C.corner(frame, UDim.new(0, Theme.Radius.panel))
	C.outline(frame, Theme.Stroke.panel)
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(P.duskRaisedHi, P.dusk)
	g.Parent = frame
	return frame
end

-- A label whose size cap is raised past its style (hero numbers).
local function bigText(style: string, text: string, maxSize: number, props: { [string]: any }): TextLabel
	props.scaled = true
	local label = C.Text(style, text, props)
	local limit = label:FindFirstChildOfClass("UITextSizeConstraint")
	if limit then
		limit.MaxTextSize = maxSize
	end
	return label
end

-- Big centre callout ("PERFECT LAUNCH!", "BOOST!"): pops only when the text changes.
local function setHint(text: string, color: Color3?)
	local label = ui.hint
	label.TextColor3 = color or P.gold
	if label.Text ~= text then
		label.Text = text
		if text ~= "" then
			UiFx.pop(label, 1.35, 0.3)
		end
	end
end

local function chip(parent: Instance, icon: string, caption: string, order: number): TextLabel
	local frame = panel(parent, UDim2.fromOffset(196, 56), UDim2.new(), Vector2.zero)
	frame.LayoutOrder = order
	local iconFrame = Icons.make(icon, UDim2.fromOffset(40, 40))
	iconFrame.AnchorPoint = Vector2.new(0, 0.5)
	iconFrame.Position = UDim2.new(0, 8, 0.5, 0)
	iconFrame.Parent = frame
	C.Text("small", caption, {
		color = P.textMid,
		size = UDim2.fromOffset(80, 22),
		anchor = Vector2.new(1, 0.5),
		position = UDim2.new(1, -10, 0.5, 0),
		align = Enum.TextXAlignment.Right,
		parent = frame,
	})
	local value = C.Text("number", "", {
		size = UDim2.new(1, -144, 1, -10),
		position = UDim2.fromOffset(54, 5),
		align = Enum.TextXAlignment.Left,
		scaled = true,
		parent = frame,
	})
	value.FontFace = UiFx.NumberFont
	return value
end

local function buildAim(root: Frame)
	local layer = Instance.new("Frame")
	layer.Name = "Aim"
	layer.BackgroundTransparency = 1
	layer.Size = UDim2.fromScale(1, 1)
	layer.Visible = false
	layer.Parent = root
	ui.aim = layer

	-- Angle: right edge, out of the thumb's way of FIRE.
	local angleCard = panel(layer, UDim2.fromOffset(210, 196), UDim2.new(1, -MARGIN, 0, 84), Vector2.new(1, 0))
	ui.angleCard = angleCard
	C.Text(
		"small",
		"ANGLE",
		{ color = P.textMid, size = UDim2.new(1, 0, 0, 24), position = UDim2.fromOffset(0, 10), parent = angleCard }
	)
	ui.angleText = bigText(
		"display",
		"45°",
		54,
		{ color = P.gold, size = UDim2.new(1, -20, 0, 60), position = UDim2.fromOffset(10, 36), parent = angleCard }
	)
	ui.angleText.FontFace = UiFx.NumberFont
	C.Button({
		text = "-",
		role = "neutral",
		textStyle = "display",
		size = UDim2.fromOffset(82, 64),
		position = UDim2.new(0, 14, 1, -78),
		parent = angleCard,
		onActivated = function()
			Launch.adjustAngle(-5)
			UiFx.pop(ui.angleText, 1.2, 0.2)
		end,
	})
	C.Button({
		text = "+",
		role = "neutral",
		textStyle = "display",
		size = UDim2.fromOffset(82, 64),
		position = UDim2.new(1, -96, 1, -78),
		parent = angleCard,
		onActivated = function()
			Launch.adjustAngle(5)
			UiFx.pop(ui.angleText, 1.2, 0.2)
		end,
	})

	-- Power meter: green good zone, breathing gold perfect zone, chunky marker.
	local powerCard =
		panel(layer, UDim2.fromOffset(640, 112), UDim2.new(0.5, 0, 1, -(MARGIN + 88 + SP.md)), Vector2.new(0.5, 1))
	ui.powerCard = powerCard
	C.Text("title", "POWER", {
		size = UDim2.fromOffset(160, 30),
		position = UDim2.fromOffset(20, 8),
		align = Enum.TextXAlignment.Left,
		parent = powerCard,
	})
	C.Text("small", "STOP IN THE GOLD!", {
		color = P.gold,
		size = UDim2.new(1, -200, 0, 30),
		position = UDim2.new(1, -20, 0, 8),
		anchor = Vector2.new(1, 0),
		align = Enum.TextXAlignment.Right,
		parent = powerCard,
	})
	local track = Instance.new("Frame")
	track.Name = "Track"
	track.BackgroundColor3 = P.duskSunken
	track.Size = UDim2.new(1, -40, 0, 44)
	track.Position = UDim2.fromOffset(20, 50)
	track.Parent = powerCard
	C.corner(track, UDim.new(0, 12))
	C.outline(track, 3)
	local zones = Instance.new("Frame")
	zones.Name = "Zones"
	zones.BackgroundTransparency = 1
	zones.Size = UDim2.fromScale(1, 1)
	zones.ClipsDescendants = true
	zones.Parent = track
	C.corner(zones, UDim.new(0, 12))
	local function zone(from: number, to: number, color: Color3, transparency: number): Frame
		local frame = Instance.new("Frame")
		frame.BackgroundColor3 = color
		frame.BackgroundTransparency = transparency
		frame.BorderSizePixel = 0
		frame.Position = UDim2.fromScale(from, 0)
		frame.Size = UDim2.fromScale(to - from, 1)
		frame.Parent = zones
		return frame
	end
	zone(F.GoodZone[1], F.PerfectZone[1], Theme.Roles.go.bottom, 0.2)
	zone(F.PerfectZone[2], F.GoodZone[2], Theme.Roles.go.bottom, 0.2)
	local perfect = zone(F.PerfectZone[1], F.PerfectZone[2], P.gold, 0)
	UiFx.loop(perfect, 0.45, { BackgroundTransparency = 0.3 })
	C.Text("small", "PERFECT", {
		color = P.white,
		size = UDim2.fromScale(1, 0.7),
		position = UDim2.fromScale(0, 0.15),
		scaled = true,
		parent = perfect,
	})
	local marker = Instance.new("Frame")
	marker.Name = "Marker"
	marker.AnchorPoint = Vector2.new(0.5, 0.5)
	marker.BackgroundColor3 = P.white
	marker.Size = UDim2.new(0, 14, 1, 22)
	marker.Position = UDim2.fromScale(0, 0.5)
	marker.ZIndex = 5
	marker.Parent = track
	C.corner(marker, UDim.new(0, 4))
	C.outline(marker, 3)
	ui.marker = marker

	ui.fire = C.Button({
		text = "FIRE!",
		role = "go",
		icon = "boost",
		textStyle = "display",
		size = UDim2.fromOffset(320, 88),
		anchor = Vector2.new(0.5, 1),
		position = UDim2.new(0.5, 0, 1, -MARGIN),
		parent = layer,
		onActivated = function()
			Launch.fire()
		end,
	})
	ui.aimHint = C.Text(
		"small",
		"",
		{ color = P.textHi, size = UDim2.fromOffset(640, 24), anchor = Vector2.new(0.5, 1), parent = layer }
	)
	local cancel = C.CloseButton(function()
		Launch.cancelAim()
	end)
	cancel.root.AnchorPoint = Vector2.new(1, 0)
	cancel.root.Position = UDim2.new(1, -MARGIN, 0, MARGIN)
	cancel.root.Parent = layer
end

local function buildFlight(root: Frame)
	local layer = Instance.new("Frame")
	layer.Name = "Flight"
	layer.BackgroundTransparency = 1
	layer.Size = UDim2.fromScale(1, 1)
	layer.Visible = false
	layer.Parent = root
	ui.flight = layer

	-- Distance: the hero number, with a bar racing the personal best.
	local top = panel(layer, UDim2.fromOffset(360, 118), UDim2.new(0.5, 0, 0, MARGIN), Vector2.new(0.5, 0))
	ui.distancePanel = top
	ui.distance = bigText("display", "0", 60, {
		size = UDim2.new(1, -110, 0, 64),
		position = UDim2.fromOffset(16, 6),
		align = Enum.TextXAlignment.Right,
		parent = top,
	})
	ui.distance.FontFace = UiFx.NumberFont
	C.Text("title", "STUDS", {
		color = P.textMid,
		size = UDim2.fromOffset(86, 30),
		position = UDim2.new(1, -96, 0, 30),
		align = Enum.TextXAlignment.Left,
		parent = top,
	})
	ui.bestBar = C.ProgressBar({ role = "premium", text = "BEST 0", size = UDim2.new(1, -28, 0, 30), parent = top })
	ui.bestBar.root.Position = UDim2.new(0, 14, 1, -40)

	-- Combo + rings chips, top left.
	local chips = Instance.new("Frame")
	chips.Name = "Chips"
	chips.BackgroundTransparency = 1
	chips.Position = UDim2.fromOffset(MARGIN, MARGIN)
	chips.AutomaticSize = Enum.AutomaticSize.XY
	chips.Parent = layer
	local chipList = Instance.new("UIListLayout")
	chipList.SortOrder = Enum.SortOrder.LayoutOrder
	chipList.Padding = UDim.new(0, SP.sm)
	chipList.Parent = chips
	ui.chips = chips
	ui.combo = chip(chips, "boost", "COMBO", 1)
	ui.rings = chip(chips, "star", "RINGS", 2)

	ui.boost = C.Button({
		text = "BOOST",
		role = "info",
		round = true,
		depth = 2,
		textStyle = "display",
		size = UDim2.fromOffset(230, 88),
		anchor = Vector2.new(1, 1),
		position = UDim2.new(1, -MARGIN, 1, -MARGIN),
		parent = layer,
		onActivated = function()
			Launch.boost()
		end,
	})
	ui.boostKey = C.Text("small", "SHIFT / E", {
		color = P.textMid,
		size = UDim2.fromOffset(230, 22),
		anchor = Vector2.new(1, 1),
		position = UDim2.new(1, -MARGIN, 1, -(MARGIN + 92)),
		parent = layer,
	})
	ui.tap = C.Button({
		text = "TAP!",
		role = "go",
		textStyle = "display",
		size = UDim2.fromOffset(260, 92),
		anchor = Vector2.new(0.5, 0.5),
		position = UDim2.fromScale(0.5, 0.66),
		parent = layer,
		onActivated = function()
			Launch.tap()
		end,
	})
	local tapIdle = Instance.new("UIScale")
	tapIdle.Name = "Idle"
	tapIdle.Parent = ui.tap.root
	UiFx.loop(tapIdle, 0.25, { Scale = 1.08 })
	ui.tap.root.Visible = false

	-- Touch steering: two big pads side by side in the left thumb zone.
	for _, spec in { { text = "&lt;", dir = -1, slot = 0 }, { text = "&gt;", dir = 1, slot = 1 } } do
		local button = C.Button({
			text = spec.text,
			role = "neutral",
			textStyle = "display",
			size = UDim2.fromOffset(96, 96),
			anchor = Vector2.new(0, 1),
			position = UDim2.new(0, MARGIN + spec.slot * 108, 1, -MARGIN),
			parent = layer,
		})
		button.hit.InputBegan:Connect(function(input: InputObject)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				touchSteer = spec.dir
			end
		end)
		button.hit.InputEnded:Connect(function(input: InputObject)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				touchSteer = 0
			end
		end)
		button.root.Visible = false
		ui["steer" .. spec.dir] = button
	end
	ui.ridingCaption = C.Text("small", "NOW RIDING", {
		color = Theme.Roles.info.top, size = UDim2.fromOffset(280, 24),
		position = UDim2.new(0, MARGIN, 1, -180), align = Enum.TextXAlignment.Left, parent = layer,
	})
	ui.ridingName = bigText("display", "", 30, {
		size = UDim2.fromOffset(300, 40), position = UDim2.new(0, MARGIN, 1, -154),
		align = Enum.TextXAlignment.Left, parent = layer,
	})
	ui.hint = bigText("display", "", 44, {
		color = P.gold,
		size = UDim2.fromOffset(700, 50),
		anchor = Vector2.new(0.5, 0),
		position = UDim2.new(0.5, 0, 0, MARGIN + 128),
		parent = layer,
	})
	local ringMarker = Instance.new("Frame")
	ringMarker.Size = UDim2.fromOffset(26, 26)
	ringMarker.AnchorPoint = Vector2.new(0.5, 0.5)
	ringMarker.Rotation = 45
	ringMarker.BackgroundColor3 = P.gold
	ringMarker.Visible = false
	ringMarker.Parent = layer
	C.corner(ringMarker, UDim.new(0, 5))
	C.outline(ringMarker, 3)
	UiFx.loop(UiFx.popScale(ringMarker), 0.35, { Scale = 1.25 })
	ui.ringMarker = ringMarker
end

local function layoutHud(design: Vector2, compact: boolean)
	ui.compact = compact
	ui.angleCard.Size = UDim2.fromOffset(if compact then 190 else 210, if compact then 180 else 196)
	ui.angleCard.Position = UDim2.new(1, -MARGIN, 0, if compact then 80 else 96)
	ui.powerCard.Size = UDim2.fromOffset(math.min(design.X - 32, if compact then 520 else 640), if compact then 104 else 112)
	ui.fire.root.Size = UDim2.fromOffset(if compact then 280 else 320, if compact then 80 else 88)
	local fireTop = MARGIN + (if compact then 80 else 88) + SP.md
	ui.powerCard.Position = UDim2.new(0.5, 0, 1, -fireTop)
	ui.aimHint.Position = UDim2.new(0.5, 0, 1, -(fireTop + (if compact then 104 else 112) + SP.sm))
	ui.boost.root.Size = UDim2.fromOffset(if compact then 100 else 124, if compact then 100 else 124)
	ui.boostKey.Size = UDim2.fromOffset(if compact then 100 else 124, 22)
	ui.boostKey.Position = UDim2.new(1,-MARGIN,1,-(MARGIN + (if compact then 104 else 128)))
	ui.chips.Position = UDim2.fromOffset(MARGIN, if design.X &lt; 650 then 134 else MARGIN)
	ui.ridingCaption.Visible = design.X &gt;= 650
	ui.ridingName.Visible = design.X &gt;= 650
	ui.distancePanel.Size = UDim2.fromOffset(if compact then 320 else 360, if compact then 106 else 118)
	ui.hint.Size = UDim2.fromOffset(math.min(700, design.X - 32), 50)
	ui.hint.Position = UDim2.new(0.5, 0, 0, MARGIN + (if design.X &lt; 650 then 250 elseif compact then 114 else 128))
end

local function resultRow(parent: Instance, order: number, label: string, icon: string): TextLabel
	local row = C.Row({ height = 40, layoutOrder = order, parent = parent })
	local iconFrame = Icons.make(icon, UDim2.fromOffset(34, 34))
	iconFrame.LayoutOrder = 1
	iconFrame.Parent = row
	C.Text("body", label, {
		color = P.textMid,
		size = UDim2.fromScale(0.45, 1),
		align = Enum.TextXAlignment.Left,
		layoutOrder = 2,
		parent = row,
	})
	local value = C.Text("number", "", {
		size = UDim2.fromScale(0.45, 1),
		align = Enum.TextXAlignment.Right,
		scaled = true,
		layoutOrder = 3,
		parent = row,
	})
	value.FontFace = UiFx.NumberFont
	table.insert(ui.resultRows, row)
	return value
end

local function buildResults()
	local window =
		C.Window({ name = "Results", title = "Landed!", theme = "daily", icon = "star", size = Vector2.new(580, 600) })
	ui.resultsWindow = window
	ui.resultRows = {}
	ui.recordPill = C.Pill("NEW RECORD!", { role = "premium", rotation = -3, layoutOrder = 1, parent = window.body })
	local hero = Instance.new("Frame")
	hero.Name = "Hero"
	hero.BackgroundTransparency = 1
	hero.Size = UDim2.new(1, 0, 0, 96)
	hero.LayoutOrder = 2
	hero.Parent = window.body
	ui.resultBurst = C.Sunburst({ size = UDim2.fromOffset(260, 260), zIndex = 1, window = window, parent = hero })
	ui.resultDistance = bigText("display", "0", 84, { size = UDim2.fromScale(1, 1), zIndex = 3, parent = hero })
	ui.resultDistance.FontFace = UiFx.NumberFont
	C.Text(
		"small",
		"STUDS",
		{ color = P.textMid, size = UDim2.new(1, 0, 0, 24), layoutOrder = 3, parent = window.body }
	)
	local card = C.Card({ size = UDim2.new(1, 0, 0, 226), layoutOrder = 4, parent = window.body })
	ui.rBest = resultRow(card.content, 1, "Best", "star")
	ui.rCoins = resultRow(card.content, 2, "Star Coins", "coin")
	ui.rCombo = resultRow(card.content, 3, "Combo", "boost")
	ui.rPet = resultRow(card.content, 4, "Monster XP", "pet")
	ui.resultTags = C.Row({ height = 30, gap = SP.sm, layoutOrder = 5, parent = window.body })
	ui.resultTip =
		C.Text("small", "", { color = P.gold, size = UDim2.new(1, 0, 0, 24), layoutOrder = 6, parent = window.body })
	local buttons = C.Row({ height = 64, gap = 12, layoutOrder = 7, parent = window.body })
	ui.resultButtons = buttons
	ui.again = C.Button({
		text = "LAUNCH AGAIN",
		role = "go",
		icon = "boost",
		size = UDim2.fromOffset(300, 60),
		layoutOrder = 1,
		parent = buttons,
		onActivated = function()
			Launch.closeResults(true)
		end,
	})
	ui.toUpgrades = C.Button({
		text = "UPGRADES",
		role = "neutral",
		size = UDim2.fromOffset(190, 60),
		layoutOrder = 2,
		parent = buttons,
		onActivated = function()
			Launch.closeResults(false)
			Controller.open("Upgrades")
		end,
	})
	window.defaultSelection = ui.again.hit
	Controller.register(window)
	Controller.onChanged(function(name: string, isOpen: boolean)
		if name == "Results" and not isOpen and Launch.mode == "results" then
			Launch.closeResults(false)
		end
	end)
end

local function resultTag(text: string, color: Color3)
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = color
	frame.Size = UDim2.fromOffset(0, 30)
	frame.AutomaticSize = Enum.AutomaticSize.X
	frame.Parent = ui.resultTags
	C.corner(frame, Theme.Radius.pill)
	C.outline(frame, 2.5)
	C.pad(frame, 0, 12, 0, 12)
	local label = C.Text("small", text, { size = UDim2.fromScale(0, 1), parent = frame })
	label.AutomaticSize = Enum.AutomaticSize.X
	label.TextTruncate = Enum.TextTruncate.None
end

------------------------------------------------------------------------
-- Aim
------------------------------------------------------------------------
local function refreshAngle()
	if aim then
		ui.angleText.Text = aim.angle .. "°"
		aimBarrel(aim.world.id, aim.angle)
	end
end

function Launch.adjustAngle(delta: number)
	if aim then
		aim.angle = math.clamp(aim.angle + delta, F.MinAngle, F.MaxAngle)
		C.playSound("click")
		refreshAngle()
	end
end

function Launch.beginAim()
	if Launch.mode ~= "idle" or not Data.game or player:GetAttribute("Flying") then
		return
	end
	Controller.closeAll()
	local result = Net.Request("Flight.Aim")
	if not result.ok then
		UiFx.toast("info", if result.code == "NearCannon" then "Walk to your cannon to launch!" else "Launch unavailable. Try again shortly.")
		return
	end
	local world = WorldConfig.ById[Data.world()]
	aim = {
		session = result.data.session,
		start = result.data.start,
		period = result.data.period,
		angle = if aim then aim.angle else F.DefaultAngle,
		world = world,
	}
	setMode("aim")
	lockCharacter(true)
	ui.aim.Visible = true
	ui.aimHint.Text = if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		then "Tap FIRE when the marker is in the gold zone"
		else "SPACE / CLICK / (A) to fire  -  A / D to aim"
	UiFx.enter(ui.powerCard, 0, 0.7)
	UiFx.enter(ui.angleCard, 0.05, 0.7)
	UiFx.enter(ui.fire.root, 0.1, 0.6)
	refreshAngle()
	local equipped = Data.equipped()
	local petId = if equipped then equipped.item else Pets.Starter
	local loaded = aim :: any
	loaded.model = monsterModel(petId, if equipped then Data.monster(equipped.uid).Mutation else "Normal", false)
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	local muzzle = toWorld(world, world.muzzle[1], world.muzzle[2], world.muzzle[3])
	local tween = game:GetService("TweenService")
		:Create(camera, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			CFrame = CFrame.lookAt(muzzle + Vector3.new(20, 2, -18), muzzle + Vector3.new(0, 10, 70)),
			FieldOfView = 62,
		})
	tween:Play()
end

function Launch.cancelAim()
	if Launch.mode ~= "aim" then
		return
	end
	if aim and aim.model then
		aim.model:Destroy()
	end
	task.spawn(function() Net.Request("Flight.Cancel") end)
	aim = nil
	ui.aim.Visible = false
	lockCharacter(false)
	restoreCamera()
	setMode("idle")
end

local function markerNow(): number
	local current = aim :: any
	return GameConfig.markerAt(workspace:GetServerTimeNow() - current.start, current.period)
end

function Launch.fire()
	local current = aim
	if Launch.mode ~= "aim" or not current or current.firing then
		return
	end
	current.firing = true
	local result = Net.Request("Flight.Fire", current.session, current.angle, markerNow())
	if not result.ok then
		current.firing = false
		Launch.cancelAim()
		return
	end
	local timing = result.data.timing
	if timing == "Perfect" then
		C.playSound("success")
		Fx.impact(current.model:GetPivot().Position, Vector3.new(0, 1, 1), "holy", 1.2)
	end
	setHint(
		if timing == "Perfect" then "PERFECT LAUNCH!" elseif timing == "Good" then "GOOD!" else "MISS",
		TIMING_COLOR[timing]
	)
end

------------------------------------------------------------------------
-- Own flight
------------------------------------------------------------------------
local function startOwnFlight(payload)
	local world = WorldConfig.ById[payload.world]
	if aim and aim.model then
		aim.model:Destroy()
	end
	aim = nil
	ui.aim.Visible = false
	lockCharacter(true)
	local sim = FlightSim.new(world, payload.params)
	FlightSim.advance(sim, world, math.clamp(workspace:GetServerTimeNow() - payload.start, 0, 0.5))
	local game = Data.game
	flight = {
		id = payload.id,
		world = world,
		sim = sim,
		model = monsterModel(payload.petId, payload.mutation, true),
		history = {},
		offset = Vector3.zero,
		rings = 0,
		perfectBounces = 0,
		steerSent = 0,
		lastSteer = 0,
		wobble = 0,
		timing = payload.timing,
		best = if game then game.Best[world.id] or 0 else 0,
	}
	ui.bestBar.setValue(0, false)
	local best = if game then game.Best[world.id] or 0 else 0
	ui.bestBar.setText(if best &gt; 0 then "BEST " .. Format.comma(best) else "FIRST FLIGHT!")
	ui.ridingName.Text = string.upper((Pets.ById[payload.petId] and Pets.ById[payload.petId].name) or payload.petId)
	ui.distance.Text = "0"
	ui.distance.TextColor3 = P.textHi
	ui.recordShown = false
	ui.boost.setEnabled(true)
	ui.boost.setRole("info")
	ui.boost.setText("BOOST")
	ui.flight.Visible = true
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	ui["steer-1"].root.Visible = touch
	ui.steer1.root.Visible = touch
	ui.boostKey.Visible = not touch
	ui.combo.Text = string.format("x%.2f", GameConfig.comboFor(0, 0, payload.timing == "Perfect"))
	ui.rings.Text = "0"
	if ui.hint.Text ~= "" then
		UiFx.pop(ui.hint, 1.35, 0.3)
	end
	setMode("fly")

	local muzzle = toWorld(world, world.muzzle[1], world.muzzle[2], world.muzzle[3])
	local dir = Vector3.new(0, math.sin(math.rad(payload.params.angle)), math.cos(math.rad(payload.params.angle)))
	Fx.impact(muzzle, dir, "fire", 1.6)
	Fx.shake(0.6, 0.35, muzzle)
	C.playSound("open")
	task.spawn(function()
		for i = 0, 10 do
			aimBarrel(world.id, payload.params.angle, 2.4 * (1 - i / 10))
			task.wait(0.03)
		end
		aimBarrel(world.id, 45)
	end)
	if game and game.Tutorial &lt; 2 and settings().showTutorial then
		setHint(if touch then "Press BOOST once in the air!" else "Press SHIFT or BOOST once in the air!")
	end
end

-- Will the monster touch a bounce pad within `seconds`? (pure lookahead, no side effects)
local function padSoon(sim, world, seconds: number): boolean
	if sim.phase ~= "FLYING" or sim.vy &gt;= 0 then
		return false
	end
	local copy = table.clone(sim)
	copy.rings = table.clone(sim.rings)
	copy.acc = 0
	for _ = 1, math.floor(seconds / F.Step) do
		for _, e in FlightSim.advance(copy, world, F.Step) do
			if e.kind == "bounce" then
				return true
			end
		end
		if copy.phase ~= "FLYING" then
			return false
		end
	end
	return false
end

function Launch.boost()
	local f = flight
	if not f or f.sim.phase ~= "FLYING" or f.sim.boosted then
		return
	end
	FlightSim.boost(f.sim)
	Net.Send("Flight.Input", f.id, "boost")
	ui.boost.setEnabled(false)
	ui.boost.setRole("done")
	ui.boost.setText("USED")
	setHint("BOOST!", Theme.Roles.premium.top)
	local position = f.model:GetPivot().Position
	Fx.impact(position, Vector3.new(f.sim.vx, f.sim.vy, f.sim.vz).Unit, "violet", 1.3)
	Fx.shake(0.3, 0.2, position)
end

function Launch.tap()
	local f = flight
	if not f or f.sim.phase ~= "FLYING" then
		return
	end
	local predicted = FlightSim.tapBounce(f.sim)
	Net.Send("Flight.Input", f.id, "tap")
	if predicted then
		setHint("PERFECT BOUNCE!")
		Fx.impact(f.model:GetPivot().Position, Vector3.yAxis, "holy", 1.5)
	end
end

local function readSteer(): number
	if touchSteer ~= 0 then
		return -touchSteer
	end
	local value = 0
	if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		value -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		value += 1
	end
	for _, input in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		if input.KeyCode == Enum.KeyCode.Thumbstick1 and math.abs(input.Position.X) &gt; 0.25 then
			value = input.Position.X
		end
	end
	-- The camera looks down +Z from behind, so screen-right is world -X.
	return -math.clamp(value, -1, 1)
end

local function localEvents(events)
	local f = flight :: any
	local world = f.world
	for _, e in events do
		local position = if e.x then toWorld(world, e.x, e.y, e.z) else f.model:GetPivot().Position
		if e.kind == "ring" then
			Fx.impact(position, Vector3.zAxis, "holy", 1.1)
			C.playSound("success")
			for _, ring in CollectionService:GetTagged("LYM_Ring") do
				if ring:GetAttribute("World") == world.id and ring:GetAttribute("Index") == e.index then
					for _, part in ring:GetDescendants() do
						if part:IsA("BasePart") then
							part.LocalTransparencyModifier = 0.75
						end
					end
				end
			end
		elseif e.kind == "bounce" then
			Fx.impact(position, Vector3.yAxis, ELEMENT[world.id] or "teal", 1.3)
			Fx.shake(0.25, 0.2, position)
			f.squash = os.clock()
		elseif e.kind == "skip" or e.kind == "land" then
			Fx.impact(position, Vector3.yAxis, ELEMENT[world.id] or "teal", if e.kind == "land" then 1.2 else 0.8)
			if e.kind == "land" then
				Fx.shake(0.35, 0.25, position) -- light landing thump
			end
			f.squash = os.clock()
		end
	end
end

local function sampleHistory(history, t: number): Vector3?
	for i = #history, 2, -1 do
		local a, b = history[i - 1], history[i]
		if a.t &lt;= t and b.t &gt;= t then
			local k = if b.t &gt; a.t then (t - a.t) / (b.t - a.t) else 0
			return a.p:Lerp(b.p, k)
		end
	end
	return nil
end

local function reconcile(row)
	local f = flight :: any
	local sim = f.sim
	local server = Vector3.new(row[4], row[5], row[6])
	local client = sampleHistory(f.history, row[3])
	if not client then
		return
	end
	local err = server - client
	if err.Magnitude &gt; 12 and sim.phase ~= "DONE" then
		local before = Vector3.new(sim.x, sim.y, sim.z)
		local ahead = math.max(0, sim.t - row[3])
		sim.x, sim.y, sim.z = row[4], row[5], row[6]
		sim.vx, sim.vy, sim.vz = row[7], row[8], row[9]
		sim.t = row[3]
		sim.acc = 0
		if sim.phase == "SLIDING" and sim.y &gt; f.world.groundY + F.Radius + 0.5 then
			sim.phase = "FLYING"
		end
		local guard = 0
		while sim.t &lt; row[3] + ahead and sim.phase ~= "DONE" and guard &lt; 60 do
			guard += 1
			FlightSim.advance(sim, f.world, F.Step)
		end
		f.offset += before - Vector3.new(sim.x, sim.y, sim.z)
		table.clear(f.history)
	elseif err.Magnitude &gt; 0.5 then
		sim.x += err.X * 0.2
		sim.y += err.Y * 0.2
		sim.z += err.Z * 0.2
	end
end

local function updateOwnFlight(dt: number)
	local f = flight :: any
	local sim, world = f.sim, f.world
	local steer = readSteer()
	FlightSim.setSteer(sim, steer)
	local now = os.clock()
	if math.abs(steer - f.steerSent) &gt; 0.15 or (steer ~= 0 and now - f.lastSteer &gt; 0.2) then
		f.steerSent = steer
		f.lastSteer = now
		Net.Send("Flight.Input", f.id, "steer", steer)
	end
	localEvents(FlightSim.advance(sim, world, dt))
	table.insert(f.history, { t = sim.t, p = Vector3.new(sim.x, sim.y, sim.z) })
	if #f.history &gt; 150 then
		table.remove(f.history, 1)
	end
	f.offset *= 0.88
	local p = Vector3.new(sim.x, sim.y, sim.z) + f.offset
	local position = toWorld(world, p.X, p.Y, p.Z)
	local velocity = Vector3.new(sim.vx, sim.vy, sim.vz)
	f.wobble += dt * 7
	local cf = orient(position, velocity, f.wobble)
	if f.squash then
		local k = math.clamp((now - f.squash) / 0.3, 0, 1)
		cf *= CFrame.Angles(math.sin(k * math.pi * 3) * 0.35 * (1 - k), 0, 0)
	end
	f.model:PivotTo(cf)
	RidingClient.PoseFlight(player.Character, f.model, cf)

	local camera = workspace.CurrentCamera
	local speed = velocity.Magnitude
	local back = 26 + speed * 0.06
	local desired = CFrame.lookAt(position + Vector3.new(10, 8 + speed * 0.02, -back), position + Vector3.new(0, 2, 24))
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = camera.CFrame:Lerp(desired, math.clamp(dt * 7, 0, 1))
	local fov = if settings().reducedMotion then 70 else math.clamp(68 + speed * 0.07, 68, 86)
	camera.FieldOfView += (fov - camera.FieldOfView) * math.clamp(dt * 4, 0, 1)

	-- Distance HUD: text and bar written only when the whole-stud value changes.
	local distance = math.floor(FlightSim.distance(sim))
	if distance ~= f.shownDistance then
		f.shownDistance = distance
		ui.distance.Text = Format.comma(distance)
		if f.best &gt; 0 then
			ui.bestBar.setValue(math.min(distance / f.best, 1), false)
			if distance &gt; f.best and not ui.recordShown then
				ui.recordShown = true
				ui.distance.TextColor3 = P.gold
				ui.bestBar.setText("NEW RECORD!")
				UiFx.pop(ui.distancePanel, 1.12, 0.35)
				setHint("NEW RECORD!")
			end
		end
	end
	local soon = padSoon(sim, world, 0.25) or (not sim.bounceUpgraded and sim.t &lt;= sim.perfectUntil)
	ui.tap.root.Visible = soon
	if
		sim.phase == "FLYING"
		and not sim.boosted
		and settings().showTutorial
		and Data.game
		and Data.game.Tutorial &lt; 2
		and sim.vy &lt; 4
		and sim.vy &gt; -10
	then
		setHint("NOW! BOOST!")
	end

	local nextRing = nil
	for index, r in world.rings do
		if not sim.rings[index] and r.z &gt; sim.z and r.z - sim.z &lt; 260 then
			nextRing = r
			break
		end
	end
	if nextRing then
		local screen, onScreen = camera:WorldToScreenPoint(toWorld(world, nextRing.x, nextRing.y, nextRing.z))
		ui.ringMarker.Visible = onScreen
		if onScreen then
			local at = UiFx.toDesign(ui.flight, Vector2.new(screen.X, screen.Y))
			ui.ringMarker.Position = UDim2.fromOffset(at.X, at.Y)
		end
	else
		ui.ringMarker.Visible = false
	end
end

local function endOwnFlight()
	local f = flight
	if not f then
		return
	end
	local model = f.model
	task.delay(2, function()
		model:Destroy()
	end)
	ui.flight.Visible = false
	ui.tap.root.Visible = false
	ui.ringMarker.Visible = false
	ui.hint.Text = ""
	for _, ring in CollectionService:GetTagged("LYM_Ring") do
		for _, part in ring:GetDescendants() do
			if part:IsA("BasePart") then
				part.LocalTransparencyModifier = 0
			end
		end
	end
	flight = nil
end

------------------------------------------------------------------------
-- Results
------------------------------------------------------------------------
local resultToken = 0

local function showResults(summary)
	endOwnFlight()
	setMode("results")
	resultToken += 1
	local token = resultToken
	-- Beats: distance counts up -&gt; record payoff -&gt; rows stagger in with the coin
	-- count -&gt; buttons arrive last and accept input 0.3 s later.
	local window = ui.resultsWindow
	local record = summary.newRecord or summary.firstRecord
	window.setTitle(
		if summary.finished then "Course Complete!" elseif record then "New Record!" else "Landed!"
	)
	ui.recordPill.Visible = record
	ui.resultBurst.root.Visible = record
	ui.resultDistance.Text = "0"
	ui.resultDistance.TextColor3 = if record then P.gold else P.textHi
	ui.rBest.Text = Format.comma(summary.best)
	ui.rCoins.Text = "+0"
	ui.rCombo.Text = string.format("x%.2f", summary.combo)
	ui.rPet.Text = "+" .. summary.petXp .. (if summary.petLevelUp then "  LV UP!" else "")
	for _, child in ui.resultTags:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	if summary.timing then
		resultTag(string.upper(summary.timing) .. " LAUNCH", TIMING_COLOR[summary.timing] or P.textLow)
	end
	if (summary.rings or 0) &gt; 0 then
		resultTag(`{summary.rings} RINGS`, Theme.Roles.info.bottom)
	end
	if (summary.perfectBounces or 0) &gt; 0 then
		resultTag(`{summary.perfectBounces} PERFECT BOUNCES`, Theme.Roles.go.bottom)
	end
	local game = Data.game
	ui.resultTip.Text = if game and game.Tutorial &lt; 2 then "Spend your StarCoins on Upgrades to fly farther!" else ""
	for _, row in ui.resultRows do
		row.Visible = false
	end
	ui.resultButtons.Visible = true
	ui.again.setEnabled(true)
	ui.toUpgrades.setEnabled(true)
	Controller.open("Results")
	UiFx.countTo(ui.resultDistance, 0, summary.distance, Format.comma, function()
		if token ~= resultToken then
			return
		end
		UiFx.pop(ui.resultDistance, 1.25, 0.35)
		if record then
			UiFx.flash(P.white, 0.5)
			UiFx.confetti(Vector2.new(0.5, 0.3), 48)
			if summary.newRecord then
				Fx.levelUp(player.Character, "holy")
			end
		end
		for i, row in ui.resultRows do
			task.delay((i - 1) * 0.07, function()
				if token == resultToken then
					row.Visible = true
					UiFx.enter(row, 0, 0.6)
					if row == ui.rCoins.Parent then
						UiFx.countTo(ui.rCoins, 0, summary.coins, Format.gain)
					end
				end
			end)
		end
		task.delay(#ui.resultRows * 0.07 + 0.1, function()
			if token ~= resultToken then
				return
			end
			ui.resultButtons.Visible = true
			UiFx.enter(ui.resultButtons, 0, 0.6)
			task.wait(0.3)
			if token == resultToken then
				ui.again.setEnabled(true)
				ui.toUpgrades.setEnabled(true)
			end
		end)
	end)
	if game and game.Tutorial &lt; 2 then
		Net.Request("Tutorial.Step", 2)
	end
end

function Launch.closeResults(again: boolean)
	resultToken += 1
	if Launch.mode ~= "results" then
		return
	end
	setMode("idle")
	if Controller.isOpen("Results") then
		Controller.close("Results")
	end
	if again then
		Launch.beginAim()
	end
	if Launch.mode ~= "aim" then
		lockCharacter(false)
		restoreCamera()
	end
end

------------------------------------------------------------------------
-- Other players' flights
------------------------------------------------------------------------
local function startOther(payload)
	if settings().hideOthers then
		return
	end
	local entry = others[payload.owner]
	if entry then
		entry.model:Destroy()
	end
	others[payload.owner] = {
		id = payload.id,
		world = WorldConfig.ById[payload.world],
		model = monsterModel(payload.petId, payload.mutation, true),
		snaps = {},
		wobble = 0,
	}
end

local function endOther(owner: number)
	local entry = others[owner]
	if entry then
		others[owner] = nil
		task.delay(1, function()
			entry.model:Destroy()
		end)
	end
end

local function updateOthers(dt: number)
	local renderAt = os.clock() - 0.15
	for owner, entry in others do
		local snaps = entry.snaps
		while #snaps &gt; 2 and snaps[2].at &lt;= renderAt do
			table.remove(snaps, 1)
		end
		local a, b = snaps[1], snaps[2]
		if a then
			local p = a.p
			if b and b.at &gt; a.at then
				p = a.p:Lerp(b.p, math.clamp((renderAt - a.at) / (b.at - a.at), 0, 1))
			end
			entry.wobble += dt * 7
			local cf = orient(toWorld(entry.world, p.X, p.Y, p.Z), a.v, entry.wobble)
			entry.model:PivotTo(cf)
			local other = Players:GetPlayerByUserId(owner)
			if other then RidingClient.PoseFlight(other.Character, entry.model, cf) end
		end
	end
end

------------------------------------------------------------------------
-- Wiring
------------------------------------------------------------------------
function Launch.start()
	Data.Changed:Connect(function(key)
		if key == "world" and Launch.mode == "aim" then Launch.cancelAim() end
	end)
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "LYM_Flights"
	fxFolder.Parent = workspace
	local root = UiFx.scaledRoot("LaunchHUD", 2)
	buildAim(root)
	buildFlight(root)
	buildResults()
	UiFx.onLayout(layoutHud)

	Net.On("Flight.Event", function(kind: string, payload)
		if kind == "start" then
			if payload.owner == player.UserId then
				startOwnFlight(payload)
			else
				startOther(payload)
			end
		elseif kind == "event" then
			local f = flight
			if payload.owner == player.UserId and f and payload.id == f.id then
				if payload.kind == "ring" then
					f.rings += 1
				elseif payload.kind == "perfectBounce" then
					f.perfectBounces += 1
				end
				ui.rings.Text = tostring(f.rings)
				ui.combo.Text =
					string.format("x%.2f", GameConfig.comboFor(f.rings, f.perfectBounces, f.timing == "Perfect"))
				UiFx.pop(if payload.kind == "ring" then ui.rings.Parent else ui.combo.Parent, 1.15, 0.25)
			end
		elseif kind == "ended" then
			if payload.owner == player.UserId then
				if payload.cancelled and flight and payload.id == flight.id then
					endOwnFlight()
					lockCharacter(false)
					restoreCamera()
					setMode("idle")
				end
			else
				endOther(payload.owner)
			end
		end
	end)
	Net.On("Flight.Results", showResults)
	Net.OnUnreliable("Flight.Snap", function(rows)
		local now = os.clock()
		for _, row in rows do
			if row[1] == player.UserId then
				if flight and flight.id == row[2] then
					reconcile(row)
				end
			else
				local entry = others[row[1]]
				if entry and entry.id == row[2] then
					table.insert(
						entry.snaps,
						{ at = now, p = Vector3.new(row[4], row[5], row[6]), v = Vector3.new(row[7], row[8], row[9]) }
					)
				end
			end
		end
	end)

	RunService:BindToRenderStep("LYM_Flight", Enum.RenderPriority.Camera.Value, function(dt: number)
		if Launch.mode == "aim" and aim then
			local marker = markerNow()
			ui.marker.Position = UDim2.fromScale(marker, 0.5)
			if aim.model then
				local world = aim.world
				local muzzle = toWorld(world, world.muzzle[1], world.muzzle[2], world.muzzle[3])
				local t = os.clock()
				local dir = Vector3.new(0, math.sin(math.rad(aim.angle)), math.cos(math.rad(aim.angle)))
				aim.model:PivotTo(
					CFrame.lookAt(muzzle + dir * (0.6 + math.sin(t * 6) * 0.15), muzzle + dir * 10)
						* CFrame.Angles(0, 0, math.sin(t * 9) * 0.1)
				)
			end
		elseif Launch.mode == "fly" and flight then
			updateOwnFlight(dt)
		end
		updateOthers(dt)
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		local key = input.KeyCode
		if Launch.mode == "aim" then
			if
				key == Enum.KeyCode.Space
				or key == Enum.KeyCode.ButtonA
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				Launch.fire()
			elseif key == Enum.KeyCode.A or key == Enum.KeyCode.Left or key == Enum.KeyCode.DPadLeft then
				Launch.adjustAngle(-5)
			elseif key == Enum.KeyCode.D or key == Enum.KeyCode.Right or key == Enum.KeyCode.DPadRight then
				Launch.adjustAngle(5)
			elseif key == Enum.KeyCode.ButtonB or key == Enum.KeyCode.Backspace then
				Launch.cancelAim()
			end
		elseif Launch.mode == "fly" then
			if key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.E or key == Enum.KeyCode.ButtonX then
				Launch.boost()
			elseif
				key == Enum.KeyCode.Space
				or key == Enum.KeyCode.ButtonA
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				Launch.tap()
			end
		end
	end)

	player.CharacterAdded:Connect(function()
		savedMovement = nil
		if Launch.mode == "aim" then
			Launch.cancelAim()
		end
	end)
	player:GetAttributeChangedSignal("World"):Connect(function()
		if Launch.mode == "aim" then
			Launch.cancelAim()
		end
	end)
end

return Launch
</ProtectedString>
