          <ProtectedString name="Source">--!strict
-- LAUNCH YOUR MONSTER! client bootstrap: one entry point, fixed order.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Controller = require(ReplicatedStorage:WaitForChild("LihFolkUI"):WaitForChild("LihFolkUIController")) :: any
local Data = require(script.Data)
local Models = require(script.Models)
local Fx = require(script.Fx)
local Launch = require(script.Launch)
local Hud = require(script.Hud)
local Windows = require(script.Windows)
local WorldFX = require(script.WorldFX)
local RidingClient = require(script.RidingClient)

Controller.start()
Data.start()
Models.waitReady(40)
Fx.start()
Launch.start()
Hud.start()
Windows.start()
WorldFX.start()
RidingClient.Start()
Launch.ModeChanged:Connect(RidingClient.SetMode)

local function applyContrast(enabled: boolean)
	for _, object in Controller.getGui():GetDescendants() do
		if object:IsA("GuiObject") then
			local original = object:GetAttribute("LYM_BaseBackground") or object.BackgroundColor3
			if original.R + original.G + original.B &lt; 1.1 then
				object:SetAttribute("LYM_BaseBackground", original)
				object.BackgroundColor3 = if enabled then Color3.fromHex("080F20") else original
			end
		end
		if object:IsA("TextLabel") then
			local original = object:GetAttribute("LYM_BaseText") or object.TextColor3
			if math.abs(original.R - original.G) &lt; .13 and original.B &gt; .5 then
				object:SetAttribute("LYM_BaseText", original)
				object.TextColor3 = if enabled then Color3.new(1,1,1) else original
			end
		end
	end
end
local function applySettings(key: string)
	if key == "game" and Data.game then
		Fx.applySettings(Data.game.Settings)
		task.defer(applyContrast, Data.game.Settings.highContrast == true)
		Controller.setReducedMotion(if Data.game.Settings.reducedMotion then true else nil)
		require(script.UiFx).refreshMotion()
	end
end
Data.Changed:Connect(applySettings)
applySettings("game")
Controller.onChanged(function(_, isOpen)
	if isOpen and Data.game then task.defer(applyContrast, Data.game.Settings.highContrast == true) end
end)
</ProtectedString>
        </Properties>
        <Item class="ModuleScript" referent="RBX412E3A15CC15422E919C08A6817DBBA8">
          <Properties>
            <Content name="LinkedSource">
              <null />
            </Content>
            <string name="ScriptGuid">{6A5934F2-0E38-4510-8526-96AFE14B7756}</string>
            <BinaryString name="AttributesSerialize" />
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="DefinesCapabilities">false</bool>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <string name="Name">WorldFX</string>
            <BinaryString name="SerializedOverrides" />
            <int64 name="SourceAssetId">-1</int64>
            <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
            <UniqueId name="UniqueId">7b3034da324dfa3f0af65b5900000b55</UniqueId>
            <ProtectedString name="Source">--!strict
-- WorldFX: per-world sky + lighting (asset pack presets), spinning/bobbing decor,
-- one follower per player (the equipped monster), portal requirement labels.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Game = ReplicatedStorage:WaitForChild("Game")
local GameConfig = require(Game:WaitForChild("GameConfig")) :: any
local WorldConfig = require(Game:WaitForChild("WorldConfig")) :: any
local Look = require(Game:WaitForChild("Look")) :: any
local Data = require(script.Parent.Data)
local Models = require(script.Parent.Models)

local player = Players.LocalPlayer
local WorldFX = {}

local followers: { [Player]: { model: Model, key: string, bob: number } } = {}
local spinBase: { [Instance]: CFrame } = {}
local UNLOCK = { CloudtopCircuit = GameConfig.World2Unlock, NebulaWilds = GameConfig.World3Unlock }

local function refreshFollower(other: Player)
	local petId = other:GetAttribute("PetId")
	local variant = other:GetAttribute("PetMutation") or "Normal"
	local game = Data.game
	local hide = other ~= player and game ~= nil and game.Settings.hideOthers
	local entry = followers[other]
	local key = tostring(petId) .. variant .. tostring((ReplicatedStorage:FindFirstChild("AssetModels") and ReplicatedStorage.AssetModels:GetAttribute("CreatureArtRevision")) or 0)
	if not petId or hide then
		if entry then
			entry.model:Destroy()
			followers[other] = nil
		end
		return
	end
	if entry and entry.key == key then
		return
	end
	if entry then
		entry.model:Destroy()
	end
	local model = Models.clone("Monsters", petId, 0.85)
	if not model then
		return
	end
	Models.applyVariant(model, variant)
	model.Parent = workspace
	followers[other] = { model = model, key = key, bob = math.random() * 6 }
end

local function watch(other: Player)
	other:GetAttributeChangedSignal("PetId"):Connect(function()
		refreshFollower(other)
	end)
	other:GetAttributeChangedSignal("PetMutation"):Connect(function()
		refreshFollower(other)
	end)
	refreshFollower(other)
end

local function refreshPortals()
	local game = Data.game
	if not game then
		return
	end
	for _, holder in CollectionService:GetTagged("LYM_Portal") do
		local target = holder:GetAttribute("Target")
		local gui = holder:FindFirstChildOfClass("BillboardGui")
		-- lihfolk-ignore: findfirstchild-chain (cast only; nil-checked below)
		local label = gui and (gui:FindFirstChild("PortalLabel") or gui:FindFirstChild("Label")) :: TextLabel?
		local world = target and WorldConfig.ById[target]
		if label and world then
			if game.Unlocked[target] then
				label.Text = world.name:upper() .. "  &gt;  TRAVEL"
				label.TextColor3 = Color3.fromHex("7BF5A6")
			else
				local rule = UNLOCK[target]
				label.Text = `{world.name:upper()}\nFLY {rule.best} + {rule.cost} COINS`
				label.TextColor3 = Color3.fromHex("FF8FA8")
			end
		end
	end
end

function WorldFX.start()
	Look.apply(Lighting, Data.world())
	if Data.game then Look.applySettings(Lighting, Data.game.Settings) end
	Data.Changed:Connect(function(key: string)
		if key == "world" then
			Look.apply(Lighting, Data.world())
			if Data.game then Look.applySettings(Lighting, Data.game.Settings) end
		elseif key == "game" then
			if Data.game then Look.applySettings(Lighting, Data.game.Settings) end
			refreshPortals()
			for _, other in Players:GetPlayers() do
				refreshFollower(other)
			end
		end
	end)
	for _, other in Players:GetPlayers() do
		watch(other)
	end
	Players.PlayerAdded:Connect(watch)
	local templates = ReplicatedStorage:FindFirstChild("AssetModels")
	if templates then templates:GetAttributeChangedSignal("CreatureArtRevision"):Connect(function()
		for _, other in Players:GetPlayers() do refreshFollower(other) end
	end) end
	Players.PlayerRemoving:Connect(function(other: Player)
		local entry = followers[other]
		if entry then
			entry.model:Destroy()
			followers[other] = nil
		end
	end)
	CollectionService:GetInstanceAddedSignal("LYM_Portal"):Connect(refreshPortals)

	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt: number)
		for other, entry in followers do
			local character = other.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local hidden = other:GetAttribute("Flying") == true or other:GetAttribute("Riding") == true or root == nil
			for _, part in entry.model:GetDescendants() do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = if hidden then 1 else 0
				end
			end
			if root and root:IsA("BasePart") then
				entry.bob += dt * 3
				local target = root.CFrame * CFrame.new(3.4, -2.6 + math.sin(entry.bob) * 0.3, 2.6)
				local current = entry.model:GetPivot()
				entry.model:PivotTo(CFrame.new(current.Position:Lerp(target.Position, math.clamp(dt * 8, 0, 1))) * root.CFrame.Rotation)
			end
		end
		accumulator += dt
		if accumulator &lt; 1 / 30 then
			return
		end
		accumulator = 0
		local t = os.clock()
		local eye = workspace.CurrentCamera.CFrame.Position
		for _, model in CollectionService:GetTagged("LYM_Spin") do
			if model:IsA("Model") and model.Parent then
				local base = spinBase[model]
				if not base then
					base = model:GetPivot()
					spinBase[model] = base
				end
				if (base.Position - eye).Magnitude &lt; 350 then
					local angle = t * (model:GetAttribute("Speed") or 1) % (math.pi * 2)
					local bob = math.sin(t * 2 + base.Position.X) * (model:GetAttribute("Bob") or 0)
					model:PivotTo(base * CFrame.new(0, bob, 0) * CFrame.Angles(0, angle, 0))
				end
			end
		end
	end)
end

return WorldFX
</ProtectedString>
          </Properties>
        </Item>
