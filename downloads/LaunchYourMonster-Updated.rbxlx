            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="DefinesCapabilities">false</bool>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <string name="Name">Hud</string>
            <BinaryString name="SerializedOverrides" />
            <int64 name="SourceAssetId">-1</int64>
            <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
            <UniqueId name="UniqueId">381fa19eebc508c80af65c1f00000976</UniqueId>
            <ProtectedString name="Source">--!strict
-- Hud: the always-on layer, laid out in zones (vault: HUD Design):
--   top-left   currency stack (StarCoins, Genome Shards) with count-up + "+N" floaters
--   top-centre world pill (world, best, next-world goal bar) and the tutorial line under it
--   top-right  equipped monster card, secondary dock (Codes, Shop, Settings) below it
--   left edge  menu rail, 2 wide (Windows registers its launchers here)
--   bottom     the one focal action: LAUNCH (near the cannon only)
-- Everything sits in one UiFx scaled root (design units, 44 px touch floor). Positions
-- change only in layout() (resize / phone flag), never per frame. Hidden while aiming/flying;
-- everything but the currency hides while a menu is open.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UIKit = ReplicatedStorage:WaitForChild("LihFolkUI")
local Theme = require(UIKit:WaitForChild("LihFolkUITheme")) :: any
local Icons = require(UIKit:WaitForChild("LihFolkUIIcons")) :: any
local C = require(UIKit:WaitForChild("LihFolkUIComponents")) :: any
local Controller = require(UIKit:WaitForChild("LihFolkUIController")) :: any
local Game = ReplicatedStorage:WaitForChild("Game")
local GameConfig = require(Game:WaitForChild("GameConfig")) :: any
local WorldConfig = require(Game:WaitForChild("WorldConfig")) :: any
local Pets = require(Game:WaitForChild("PetDefinitions")) :: any
local Data = require(script.Parent.Data)
local Models = require(script.Parent.Models)
local Launch = require(script.Parent.Launch)
local UiFx = require(script.Parent.UiFx)
local Format = require(script.Parent.Format)

local player = Players.LocalPlayer
local P = Theme.Palette
local SP = Theme.Space
local MARGIN = Theme.Size.screenMargin

local Hud = {}
local ui: { [string]: any } = {}
local launchers: { [string]: any } = {}
local UNLOCK: { [string]: any } = { CloudtopCircuit = GameConfig.World2Unlock, NebulaWilds = GameConfig.World3Unlock }

------------------------------------------------------------------------
-- Building blocks
------------------------------------------------------------------------
-- Dusk slab with a glossy top band and a thick ink outline (the HUD's one surface).
local function slab(name: string, parent: Instance, radius: UDim?): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	frame.Parent = parent
	C.corner(frame, radius or UDim.new(0, Theme.Radius.panel))
	C.outline(frame, Theme.Stroke.panel)
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(P.duskRaisedHi, P.dusk)
	g.Parent = frame
	local gloss = Instance.new("Frame")
	gloss.Name = "Gloss"
	gloss.BackgroundColor3 = P.white
	gloss.BackgroundTransparency = 0.88
	gloss.Position = UDim2.fromOffset(10, 4)
	gloss.Size = UDim2.new(1, -20, 0.3, 0)
	gloss.Parent = frame
	C.corner(gloss, Theme.Radius.pill)
	return frame
end

-- Invisible full-size button that opens a window and gives the slab a press pop.
local function tapTarget(frame: GuiObject, window: string)
	local hit = Instance.new("TextButton")
	hit.Name = "Hit"
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 10
	hit.Parent = frame
	hit.Activated:Connect(function()
		C.playSound("click")
		UiFx.pop(frame, 0.92, 0.2)
		Controller.toggle(window)
	end)
end

type Pill = {
	root: Frame,
	label: TextLabel,
	icon: GuiObject,
	shown: number?,
	value: number,
	format: (number) -&gt; string,
	color: Color3,
}

-- Currency pill: icon overhangs the left end, chunky italic number.
local function pill(parent: Instance, icon: string, order: number, color: Color3): Pill
	local frame = slab("Pill_" .. icon, parent, Theme.Radius.pill)
	frame.LayoutOrder = order
	local iconFrame = Icons.make(icon, UDim2.fromOffset(60, 60))
	iconFrame.AnchorPoint = Vector2.new(0, 0.5)
	iconFrame.Position = UDim2.new(0, -14, 0.5, 0)
	iconFrame.ZIndex = 3
	iconFrame.Parent = frame
	local label = C.Text("number", "0", { align = Enum.TextXAlignment.Left, scaled = true, zIndex = 3, parent = frame })
	label.FontFace = UiFx.NumberFont
	return {
		root = frame,
		label = label,
		icon = iconFrame,
		shown = nil,
		value = 0,
		format = Format.short,
		color = color,
	}
end

local function sizePill(p: Pill, w: number, h: number)
	p.root.Size = UDim2.fromOffset(w, h)
	p.icon.Size = UDim2.fromOffset(h + 8, h + 8)
	p.label.Size = UDim2.new(1, -(h + 6), 1, -10)
	p.label.Position = UDim2.fromOffset(h - 2, 5)
	local limit = p.label:FindFirstChildOfClass("UITextSizeConstraint")
	if limit then
		limit.MaxTextSize = math.floor(h * 0.6)
	end
end

------------------------------------------------------------------------
-- Currency: count up when visible, hold the change while hidden
------------------------------------------------------------------------
local function playCurrency(p: Pill)
	local from = p.shown
	local to = p.value
	if from == to then
		return
	end
	p.shown = to
	if from == nil then
		p.label.Text = p.format(to)
		return
	end
	UiFx.countTo(p.label, from, to, p.format)
	if to &gt; from then
		UiFx.pop(p.root, 1.12, 0.3)
		local abs = p.root.AbsolutePosition + Vector2.new(p.root.AbsoluteSize.X + 10, p.root.AbsoluteSize.Y * 0.5)
		local at = UiFx.toDesign(ui.root, abs)
		UiFx.floater(ui.root, Format.gain(to - from), p.color, UDim2.fromOffset(at.X, at.Y))
	end
end

local function refreshCurrency()
	ui.coins.value = Data.coins()
	ui.shards.value = Data.shards()
	for _, p in { ui.coins, ui.shards } do
		if p.shown == nil or ui.root.Visible then
			playCurrency(p)
		end
	end
end

------------------------------------------------------------------------
-- World pill + monster card
------------------------------------------------------------------------
local function nextGoal(worldId: string): (number?, string)
	local game = Data.game
	if not game then
		return nil, ""
	end
	for _, world in WorldConfig.List do
		local rule = UNLOCK[world.id]
		if rule and rule.bestWorld == worldId and not game.Unlocked[world.id] then
			local best = game.Best[worldId] or 0
			return math.clamp(best / rule.best, 0, 1),
				`NEXT WORLD  {Format.comma(math.min(best, rule.best))}/{Format.comma(rule.best)}`
		end
	end
	return nil, ""
end

local function refreshWorld()
	local world = WorldConfig.ById[Data.world()]
	if not world then
		return
	end
	local game = Data.game
	ui.world.Text = world.name
	ui.best.Text = "BEST " .. Format.comma(if game then game.Best[world.id] or 0 else 0) .. " STUDS"
	local value, text = nextGoal(world.id)
	ui.goalValue = value
	if value then
		ui.goal.setValue(value)
		ui.goal.setText(text)
	end
	ui.goal.root.Visible = value ~= nil and not ui.compact
end

local function refreshMonster()
	local equipped = Data.equipped()
	if not equipped then
		return
	end
	local meta = Data.monster(equipped.uid)
	local def = Pets.ById[equipped.item]
	local key = equipped.item .. meta.Mutation
	if ui.monsterKey ~= key then
		local previous = ui.monsterKey
		ui.monsterKey = key
		for _, child in ui.monsterView:GetChildren() do
			if child:IsA("ViewportFrame") then
				child:Destroy()
			end
		end
		local view = Models.viewport(ui.monsterView, "Monsters", equipped.item)
		view.ZIndex = 3
		if previous ~= nil then
			UiFx.pop(ui.card, 1.1, 0.3)
		end
	end
	local color = UiFx.Rarity[def and def.rarity or "Common"] or P.textHi
	ui.monsterRing.Color = color
	ui.monsterName.Text = if def then def.name else equipped.item
	ui.monsterName.TextColor3 = color
	ui.monsterLevel.Text = `LV {meta.Level}`
	local game = Data.game
	ui.monsterPower.Text = `POWER {if game then game.TrainingLevel else 1}`
end

------------------------------------------------------------------------
-- Tutorial line + pointer (one step at a time; teaches the loop by doing)
------------------------------------------------------------------------
local function nearCannon(): boolean
	local character = player.Character
	-- lihfolk-ignore: findfirstchild-chain (cast only; nil-checked on the next line)
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local world = WorldConfig.ById[Data.world()]
	if not root or not world then
		return false
	end
	return (root.Position - Vector3.new(world.origin[1], world.origin[2], world.origin[3] - 12)).Magnitude &lt; 45
end

local function launcherHit(name: string): GuiObject?
	local launcher = launchers[name]
	return if launcher then launcher.button.root else nil
end

local function tutorialStep(): (string, GuiObject?)
	local game = Data.game
	if not game or not game.Settings.showTutorial or Launch.mode ~= "idle" or Controller.getCurrent() ~= nil then
		return "", nil
	end
	local near = nearCannon()
	if game.Launches == 0 then
		return if near then "Press LAUNCH!" else "Walk to the big cannon", if near then ui.launch.root else nil
	end
	local cannon = GameConfig.UpgradeById.Cannon
	local cost = GameConfig.upgradeCost(cannon, game.CannonLevel)
	if game.CannonLevel == 0 and cost then
		if Data.coins() &gt;= cost then
			return "Buy Cannon Power in Upgrades", launcherHit("Upgrades")
		end
		return "Launch again to earn StarCoins", if near then ui.launch.root else nil
	end
	local uniques = Data.inventory.uniques
	local egg = Pets.Eggs[1]
	if #uniques &lt;= 1 and egg then
		if Data.coins() &gt;= egg.price then
			return `Hatch a {egg.name}!`, launcherHit("Eggs")
		end
		return "Fly farther for more StarCoins", nil
	end
	local equipped = Data.equipped()
	if #uniques == 2 and equipped and equipped.item == Pets.Starter then
		return "Equip your new monster!", launcherHit("Monsters")
	end
	return "", nil
end

local function placePointer(target: GuiObject?)
	local pointer = ui.pointer
	if not target or not target.Visible then
		pointer.Visible = false
		ui.pointerTarget = nil
		return
	end
	local root = ui.root
	local topLeft = UiFx.toDesign(root, target.AbsolutePosition)
	local size = target.AbsoluteSize / UiFx.scale()
	local centre = topLeft + size / 2
	ui.ring.Size = UDim2.fromOffset(size.X + 18, size.Y + 18)
	ui.ring.Position = UDim2.fromOffset(centre.X, centre.Y)
	-- Targets on the left rail get the arrow on their right; everything else from above.
	local fromRight = centre.X &lt; ui.design.X * 0.3
	ui.arrow.Rotation = if fromRight then 90 else 0
	ui.arrow.Position = if fromRight
		then UDim2.fromOffset(topLeft.X + size.X + 34, centre.Y)
		else UDim2.fromOffset(centre.X, topLeft.Y - 34)
	if ui.pointerTarget ~= target then
		ui.pointerTarget = target
		UiFx.enter(ui.arrow, 0, 0.4)
	end
	pointer.Visible = true
end

local function refreshGuide()
	local text, target = tutorialStep()
	if ui.guide.Text ~= text then
		ui.guide.Text = text
		if text ~= "" then
			UiFx.enter(ui.guideFrame, 0, 0.5)
		end
	end
	ui.guideFrame.Visible = text ~= "" and ui.zonesOn
	placePointer(if ui.zonesOn then target else nil)
end

------------------------------------------------------------------------
-- Launchers (Windows registers them; Hud owns where they live)
------------------------------------------------------------------------
export type LauncherOptions = {
	window: string,
	label: string,
	icon: string,
	theme: string,
	layoutOrder: number?,
	dock: boolean?,
}

function Hud.addLauncher(options: LauncherOptions): any
	local button = C.HudButton({
		label = options.label,
		icon = options.icon,
		theme = options.theme,
		layoutOrder = options.layoutOrder,
		parent = if options.dock then ui.dock else ui.rail,
		onActivated = function()
			Controller.toggle(options.window)
		end,
	})
	launchers[options.window] = button
	return button
end

-- Red badge with a count (or "!" when count is nil); 0 hides it.
function Hud.setBadge(window: string, count: number?)
	local launcher = launchers[window]
	if not launcher then
		return
	end
	local visible = count == nil or count &gt; 0
	local badge = launcher.root:FindFirstChild("Badge")
	local label = badge and badge:FindFirstChildOfClass("TextLabel")
	if label then
		label.Text = if count == nil then "!" elseif count &gt; 9 then "9+" else tostring(count)
	end
	if visible and badge and not badge.Visible then
		launcher.setBadge(true)
		UiFx.pop(badge, 1.5, 0.35)
	else
		launcher.setBadge(visible)
	end
end

------------------------------------------------------------------------
-- Layout (runs on resize / phone flag only)
------------------------------------------------------------------------
local function layout(design: Vector2, compact: boolean)
	ui.design = design
	ui.compact = compact
	local list = ui.currencyList
	list.FillDirection = if compact then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	list.Padding = UDim.new(0, if compact then SP.xl else SP.sm)
	sizePill(ui.coins, if compact then 176 else 236, if compact then 50 else 60)
	sizePill(ui.shards, if compact then 150 else 196, if compact then 46 else 52)
	ui.currency.Position = UDim2.fromOffset(MARGIN + 14, MARGIN)
	local currencyBottom = MARGIN + (if compact then 50 else 60 + SP.sm + 52)

	-- World pill: shorter on phones, the goal bar folds away.
	local worldW = if compact then 240 else 340
	local worldH = if compact then 62 else (if ui.goalValue ~= nil then 108 else 78)
	local narrow = design.X &lt; 650
	worldW = math.min(worldW, design.X - 2 * MARGIN)
	ui.worldPill.Size = UDim2.fromOffset(worldW, worldH)
	ui.worldPill.Position = UDim2.new(0.5, 0, 0, if compact then MARGIN + 64 else MARGIN)
	ui.card.Visible = ui.zonesOn and not narrow
	ui.dock.Position = UDim2.new(1, -MARGIN, 0, if narrow then 150 else MARGIN + 110)
	ui.world.Size = UDim2.new(1, -24, 0, if compact then 30 else 36)
	ui.best.Position = UDim2.fromOffset(12, if compact then 34 else 42)
	ui.goal.root.Visible = ui.goalValue ~= nil and not compact

	-- Monster card: full card on PC/tablet, portrait chip on phones.
	local cardW = if compact then 88 else 264
	local cardH = if compact then 88 else 100
	ui.card.Size = UDim2.fromOffset(cardW, cardH)
	local portrait = cardH - 16
	ui.monsterView.Size = UDim2.fromOffset(portrait, portrait)
	for _, label in { ui.monsterName, ui.monsterPower } do
		label.Visible = not compact
	end
	ui.levelChip.Position = if compact then UDim2.new(0.5, 0, 1, -2) else UDim2.fromOffset(102, 70)
	ui.levelChip.AnchorPoint = if compact then Vector2.new(0.5, 0.5) else Vector2.new(0, 0.5)
	ui.dock.Position = UDim2.new(1, -MARGIN, 0, if narrow then 150 else MARGIN + cardH + SP.md)
	ui.dockList.FillDirection = if compact then Enum.FillDirection.Vertical else Enum.FillDirection.Horizontal

	-- Rail: under the currency stack, 2 wide.
	ui.rail.Position = UDim2.fromOffset(MARGIN, if compact then (if design.X &gt;= 650 then math.max(156, design.Y - 170) else 210) else currencyBottom + SP.xl)
	ui.rail.Size = UDim2.fromOffset(if compact then (if design.X &gt;= 650 then 248 else 124) else 144, 0)
	ui.railGrid.FillDirectionMaxCells = if compact and design.X &gt;= 650 then 4 else 2
	local cell = if compact then 54 else Theme.Size.hudButton
	ui.railGrid.CellSize = UDim2.fromOffset(cell, cell + 22)
	for _, launcher in launchers do
		launcher.button.root.Size = UDim2.fromOffset(cell, cell)
	end
	ui.railGrid.CellPadding = UDim2.fromOffset(SP.sm, if compact then 3 else SP.sm)

	-- LAUNCH: bottom centre; the guide line sits under the world pill.
	ui.launch.root.Size = UDim2.fromOffset(if compact then 290 else 340, if compact then 86 else 100)
	ui.guideFrame.Position = UDim2.new(0.5, 0, 0, MARGIN + worldH + SP.md + (if compact then 64 else 0))
	ui.guideFrame.Size = UDim2.fromOffset(math.min(design.X - 160, if compact then 380 else 520), if compact then 40 else 52)
	ui.launch.root.Size = UDim2.fromOffset(math.min(design.X - 160, if compact then 230 else 340), if compact then 64 else 100)
end

------------------------------------------------------------------------
-- Zones: everything but currency steps aside while a menu is open
------------------------------------------------------------------------
local function refreshZones()
	local on = Controller.getCurrent() == nil
	ui.zonesOn = on
	for _, zone in { ui.worldPill, ui.card, ui.dock, ui.rail } do
		zone.Visible = on
	end
	ui.launchSlot.Visible = on
	if ui.design then layout(ui.design, ui.compact) end
	refreshGuide()
end

------------------------------------------------------------------------
-- Start
------------------------------------------------------------------------
function Hud.start()
	local root = UiFx.scaledRoot("Hud", 0)
	ui.root = root
	ui.zonesOn = true

	-- Currency stack
	local currency = Instance.new("Frame")
	currency.Name = "Currency"
	currency.BackgroundTransparency = 1
	currency.AutomaticSize = Enum.AutomaticSize.XY
	currency.Parent = root
	local currencyList = Instance.new("UIListLayout")
	currencyList.SortOrder = Enum.SortOrder.LayoutOrder
	currencyList.Parent = currency
	ui.currency, ui.currencyList = currency, currencyList
	ui.coins = pill(currency, "coin", 1, P.gold)
	ui.shards = pill(currency, "gem", 2, Theme.Roles.info.top)

	-- World pill (tap: Worlds)
	local worldPill = slab("WorldPill", root)
	worldPill.AnchorPoint = Vector2.new(0.5, 0)
	worldPill.Position = UDim2.new(0.5, 0, 0, MARGIN)
	ui.worldPill = worldPill
	ui.world =
		C.Text("display", "", { position = UDim2.fromOffset(12, 4), scaled = true, zIndex = 3, parent = worldPill })
	ui.best = C.Text("small", "", { color = P.gold, size = UDim2.new(1, -24, 0, 22), zIndex = 3, parent = worldPill })
	ui.goal = C.ProgressBar({ role = "info", size = UDim2.new(1, -24, 0, 26), parent = worldPill })
	ui.goal.root.Position = UDim2.new(0, 12, 1, -34)
	ui.goal.root.ZIndex = 3
	tapTarget(worldPill, "Worlds")

	-- Monster card (tap: Monsters)
	local card = slab("MonsterCard", root)
	card.AnchorPoint = Vector2.new(1, 0)
	card.Position = UDim2.new(1, -MARGIN, 0, MARGIN)
	ui.card = card
	local view = Instance.new("Frame")
	view.Name = "Portrait"
	view.BackgroundColor3 = P.duskSunken
	view.Position = UDim2.fromOffset(8, 8)
	view.ZIndex = 2
	view.Parent = card
	C.corner(view, Theme.Radius.pill)
	ui.monsterRing = C.outline(view, 3, P.textLow)
	ui.monsterView = view
	ui.monsterName = C.Text("title", "", {
		size = UDim2.new(1, -112, 0, 34),
		position = UDim2.fromOffset(102, 10),
		align = Enum.TextXAlignment.Left,
		scaled = true,
		zIndex = 3,
		parent = card,
	})
	ui.monsterPower = C.Text("small", "", {
		color = P.textMid,
		size = UDim2.new(1, -116, 0, 24),
		position = UDim2.fromOffset(102, 44),
		align = Enum.TextXAlignment.Left,
		zIndex = 3,
		parent = card,
	})
	local levelChip = C.Pill("LV 1", { role = "info", zIndex = 4, parent = card })
	ui.levelChip = levelChip
	ui.monsterLevel = levelChip:FindFirstChildOfClass("TextLabel")
	tapTarget(card, "Monsters")

	-- Rail (left, 2 wide) and dock (right, one row)
	local rail = Instance.new("Frame")
	rail.Name = "Rail"
	rail.BackgroundTransparency = 1
	rail.Size = UDim2.fromOffset(Theme.Size.hudButton * 2 + SP.md, 0)
	rail.AutomaticSize = Enum.AutomaticSize.Y
	rail.Parent = root
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(Theme.Size.hudButton, Theme.Size.hudButton + 22)
	grid.CellPadding = UDim2.fromOffset(SP.md, SP.sm)
	grid.FillDirectionMaxCells = 2
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = rail
	ui.rail = rail
	ui.railGrid = grid
	local dock = Instance.new("Frame")
	dock.Name = "Dock"
	dock.BackgroundTransparency = 1
	dock.AnchorPoint = Vector2.new(1, 0)
	dock.AutomaticSize = Enum.AutomaticSize.XY
	dock.Parent = root
	local dockList = Instance.new("UIListLayout")
	dockList.FillDirection = Enum.FillDirection.Horizontal
	dockList.HorizontalAlignment = Enum.HorizontalAlignment.Right
	dockList.SortOrder = Enum.SortOrder.LayoutOrder
	dockList.Padding = UDim.new(0, SP.sm)
	dockList.Parent = dock
	ui.dock = dock
	ui.dockList = dockList

	-- LAUNCH: the focal action. Breathing gold ring + gentle idle bob (engine tweens).
	local slot = Instance.new("Frame")
	slot.Name = "LaunchSlot"
	slot.BackgroundTransparency = 1
	slot.Size = UDim2.fromScale(1, 1)
	slot.Parent = root
	ui.launchSlot = slot
	ui.launch = C.Button({
		text = "LAUNCH!",
		role = "go",
		icon = "boost",
		textStyle = "display",
		size = UDim2.fromOffset(320, 96),
		anchor = Vector2.new(0.5, 1),
		position = UDim2.new(0.5, 0, 1, -MARGIN),
		parent = slot,
		onActivated = function()
			Launch.beginAim()
		end,
	})
	local glow = Instance.new("Frame")
	glow.Name = "Glow"
	glow.BackgroundTransparency = 1
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromScale(0.5, 0.5)
	glow.Size = UDim2.new(1, 18, 1, 18)
	glow.ZIndex = 0
	glow.Parent = ui.launch.root
	C.corner(glow, UDim.new(0, Theme.Radius.button + 8))
	local glowStroke = C.outline(glow, 5, P.gold)
	UiFx.loop(glowStroke, 0.7, { Transparency = 0.8 })
	local idle = Instance.new("UIScale")
	idle.Name = "Idle"
	idle.Parent = ui.launch.root
	UiFx.loop(idle, 0.9, { Scale = 1.04 })
	ui.launch.root.Visible = false

	-- Tutorial line (top centre) and pointer (ring + arrow on the next target)
	local guideFrame = Instance.new("Frame")
	guideFrame.Name = "Guide"
	guideFrame.BackgroundColor3 = P.ink
	guideFrame.BackgroundTransparency = 0.35
	guideFrame.AnchorPoint = Vector2.new(0.5, 0)
	guideFrame.Visible = false
	guideFrame.Parent = root
	C.corner(guideFrame, Theme.Radius.pill)
	local bob = Instance.new("Frame")
	bob.Name = "Bob"
	bob.BackgroundTransparency = 1
	bob.Size = UDim2.fromScale(1, 1)
	bob.Parent = guideFrame
	UiFx.loop(bob, 0.55, { Position = UDim2.fromOffset(0, -5) })
	ui.guideFrame = guideFrame
	ui.guide = C.Text(
		"title",
		"",
		{ size = UDim2.new(1, -28, 1, -8), position = UDim2.fromOffset(14, 4), scaled = true, parent = bob }
	)

	local pointer = Instance.new("Frame")
	pointer.Name = "Pointer"
	pointer.BackgroundTransparency = 1
	pointer.Size = UDim2.fromScale(1, 1)
	pointer.ZIndex = 20
	pointer.Visible = false
	pointer.Parent = root
	ui.pointer = pointer
	local ring = Instance.new("Frame")
	ring.Name = "Ring"
	ring.BackgroundTransparency = 1
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.ZIndex = 20
	ring.Parent = pointer
	C.corner(ring, UDim.new(0, Theme.Radius.button + 8))
	UiFx.loop(C.outline(ring, 5, P.gold), 0.5, { Transparency = 0.7 })
	ui.ring = ring
	local arrow = Instance.new("Frame")
	arrow.Name = "Arrow"
	arrow.BackgroundTransparency = 1
	arrow.AnchorPoint = Vector2.new(0.5, 0.5)
	arrow.Size = UDim2.fromOffset(44, 56)
	arrow.ZIndex = 21
	arrow.Parent = pointer
	local arrowBob = Instance.new("Frame")
	arrowBob.BackgroundTransparency = 1
	arrowBob.Size = UDim2.fromScale(1, 1)
	arrowBob.Parent = arrow
	UiFx.loop(arrowBob, 0.4, { Position = UDim2.fromOffset(0, 8) })
	local stem = Instance.new("Frame")
	stem.BackgroundColor3 = P.gold
	stem.AnchorPoint = Vector2.new(0.5, 0)
	stem.Position = UDim2.fromScale(0.5, 0)
	stem.Size = UDim2.fromOffset(16, 26)
	stem.ZIndex = 21
	stem.Parent = arrowBob
	C.outline(stem, 3)
	local head = Instance.new("Frame")
	head.BackgroundColor3 = P.gold
	head.AnchorPoint = Vector2.new(0.5, 0.5)
	head.Position = UDim2.new(0.5, 0, 0, 30)
	head.Size = UDim2.fromOffset(30, 30)
	head.Rotation = 45
	head.ZIndex = 22
	head.Parent = arrowBob
	C.corner(head, UDim.new(0, 4))
	C.outline(head, 3)
	ui.arrow = arrow

	UiFx.onLayout(layout)

	Data.Changed:Connect(function(key: string)
		if key == "coins" or key == "shards" or key == "game" then
			refreshCurrency()
		end
		if key == "game" or key == "world" then
			local hadGoal = ui.goalValue ~= nil
			refreshWorld()
			if hadGoal ~= (ui.goalValue ~= nil) then
				layout(ui.design, ui.compact)
			end
		end
		if key == "inventory" or key == "game" then
			refreshMonster()
		end
		refreshGuide()
	end)
	Launch.ModeChanged:Connect(function(mode: string)
		local idleMode = mode == "idle"
		root.Visible = idleMode
		UiFx.block("flight", not idleMode)
		if idleMode then
			-- Gains earned in flight count up now that the pills are on screen again.
			task.defer(refreshCurrency)
		end
	end)
	Controller.onChanged(function()
		refreshZones()
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt: number)
		accumulator += dt
		if accumulator &lt; 0.25 then
			return
		end
		accumulator = 0
		local show = Launch.mode == "idle" and nearCannon() and not player:GetAttribute("Flying")
		if show ~= ui.launch.root.Visible then
			ui.launch.root.Visible = show
			if show then
				UiFx.enter(ui.launch.root, 0, 0.5)
			end
		end
		refreshGuide()
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		local holder = prompt.Parent
		local cannon = holder and holder.Parent
		if
			cannon
			and CollectionService:HasTag(cannon, "LYM_Cannon")
			and cannon:GetAttribute("World") == Data.world()
		then
			Launch.beginAim()
		end
	end)
	refreshCurrency()
	refreshWorld()
	refreshMonster()
	if ui.design then
		layout(ui.design, ui.compact)
	end
end

return Hud
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXDB8A91999EFE4F01A4840F7405C2CDEF">
          <Properties>
            <Content name="LinkedSource">
              <null />
            </Content>
            <string name="ScriptGuid">{07063025-4B42-4F28-AB17-A7A7687C71D0}</string>
            <BinaryString name="AttributesSerialize" />
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="DefinesCapabilities">false</bool>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <string name="Name">UiFx</string>
            <BinaryString name="SerializedOverrides" />
            <int64 name="SourceAssetId">-1</int64>
            <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
            <UniqueId name="UniqueId">381fa19eebc508c80af65c1f00000d45</UniqueId>
            <ProtectedString name="Source">--!strict
-- UiFx: shared HUD scaling and cheap UI juice for every client UI module.
--   scaledRoot / onLayout: one HUD scale (design canvas 1280 x 720, touch floor 44 px taps)
--   pop / loop / countTo / stagger: motion from LihFolkUITheme.Motion, Reduced Motion aware
--   floater / toast / reward / flash / confetti: transient feedback, queued and capped
--   spin: turns ViewportFrame models while they are on screen (one RenderStepped, only when needed)
-- Nothing here talks to the server.

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local UIKit = game:GetService("ReplicatedStorage"):WaitForChild("LihFolkUI")
local Theme = require(UIKit:WaitForChild("LihFolkUITheme")) :: any
local Icons = require(UIKit:WaitForChild("LihFolkUIIcons")) :: any
local C = require(UIKit:WaitForChild("LihFolkUIComponents")) :: any
local Controller = require(UIKit:WaitForChild("LihFolkUIController")) :: any

local P = Theme.Palette
local M = Theme.Motion
local S = Theme.Size

local UiFx = {}

------------------------------------------------------------------------
-- Game tuning of the kit's motion tokens (read by the kit at tween time).
-- Snappier press squash and window pop, lighter dim. Candidates to move into the kit Theme.
------------------------------------------------------------------------
M.hoverScale = 1.05
M.hoverTime = 0.08
M.pressScale = 0.92
M.openFrom = 0.8
M.openTime = 0.18
M.dimTransparency = 0.7

-- Heavy italic face for the big HUD numbers. If it ever renders as the default font in
-- Studio, set ITALIC_NUMBERS = false and the kit's Fredoka One is used instead.
local ITALIC_NUMBERS = true
UiFx.NumberFont = if ITALIC_NUMBERS
	then Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)
	else Theme.Fonts.display

UiFx.Rarity = {
	Common = Color3.fromHex("B0A9DD"),
	Uncommon = Color3.fromHex("7BF5A6"),
	Rare = Color3.fromHex("7CC8FF"),
	Epic = Color3.fromHex("CF9BFF"),
	Legendary = Color3.fromHex("FFD24A"),
}

------------------------------------------------------------------------
-- HUD scale
------------------------------------------------------------------------
local DESIGN = Vector2.new(1280, 720)
local started = false
local roots: { { frame: Frame, scale: UIScale } } = {}
local layoutListeners: { (design: Vector2, compact: boolean) -&gt; () } = {}
local current = { scale = 1, design = DESIGN, compact = false }
local overlay: ScreenGui? = nil

local function applyScale()
	local gui = Controller.getGui()
	if not gui then
		return
	end
	local area = gui.AbsoluteSize
	if area.X &lt;= 0 or area.Y &lt;= 0 then
		return
	end
	local kind = Controller.deviceKind()
	local touch = kind == "phone" or kind == "tablet" or Controller.preferredInput() == "Touch"
	local floor = if touch then S.touchDrawnMin / S.touchMin else 0.7
	local wanted = math.min(area.Y / DESIGN.Y, area.X / DESIGN.X) * Controller.getPlayerScale()
	if kind == "console" then
		wanted = math.max(wanted, 1.2)
	end
	local s = math.clamp(wanted, floor, 1.35)
	local design = Vector2.new(math.floor(area.X / s), math.floor(area.Y / s))
	local compact = design.Y &lt; 560 or design.X &lt; 1000
	local changed = s ~= current.scale or design ~= current.design or compact ~= current.compact
	current.scale, current.design, current.compact = s, design, compact
	for _, root in roots do
		root.frame.Size = UDim2.fromOffset(design.X, design.Y)
		root.scale.Scale = s
	end
	if changed then
		for _, fn in layoutListeners do
			task.spawn(fn, design, compact)
		end
	end
end

local function ensureStarted()
	if started then
		return
	end
	started = true
	Controller.start()
	local gui = Controller.getGui()
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyScale)
	game:GetService("UserInputService").LastInputTypeChanged:Connect(applyScale)
	-- Edge-to-edge layer for flashes and confetti (never takes input).
	local fx = Instance.new("ScreenGui")
	fx.Name = "LYM_Fx"
	fx.ResetOnSpawn = false
	fx.IgnoreGuiInset = true
	fx.ScreenInsets = Enum.ScreenInsets.None
	fx.SafeAreaCompatibility = Enum.SafeAreaCompatibility.None
	fx.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	fx.DisplayOrder = 60
	fx.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	overlay = fx
	applyScale()
end

-- A full-screen frame in the kit's safe-area gui, drawn at the shared HUD scale.
-- Children use design units; Scale positions still reach the real screen edges.
function UiFx.scaledRoot(name: string, zIndex: number?): Frame
	ensureStarted()
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.ZIndex = zIndex or 1
	local scale = Instance.new("UIScale")
	scale.Name = "HudScale"
	scale.Parent = frame
	frame.Size = UDim2.fromOffset(current.design.X, current.design.Y)
	scale.Scale = current.scale
	frame.Parent = Controller.getGui()
	table.insert(roots, { frame = frame, scale = scale })
	return frame
end

-- Called now and whenever the design canvas or the compact (phone) flag changes.
function UiFx.onLayout(fn: (design: Vector2, compact: boolean) -&gt; ())
	ensureStarted()
	table.insert(layoutListeners, fn)
	task.spawn(fn, current.design, current.compact)
end

function UiFx.isCompact(): boolean
	return current.compact
end

function UiFx.scale(): number
	return current.scale
end

-- Screen position (px) -&gt; design units inside a scaled root.
function UiFx.toDesign(root: GuiObject, screen: Vector2): Vector2
	return (screen - root.AbsolutePosition) / current.scale
end

------------------------------------------------------------------------
-- Motion helpers
------------------------------------------------------------------------
local function reduced(): boolean
	return Theme.isReducedMotion()
end
UiFx.reduced = reduced

local function tween(
	instance: Instance,
	time: number,
	style: Enum.EasingStyle,
	direction: Enum.EasingDirection,
	goals: { [string]: any }
): Tween
	local t = TweenService:Create(instance, TweenInfo.new(time, style, direction), goals)
	t:Play()
	return t
end
UiFx.tween = tween

-- The object's own pop UIScale (created once, reused).
function UiFx.popScale(object: GuiObject): UIScale
	local existing = object:FindFirstChild("Pop")
	if existing and existing:IsA("UIScale") then
		return existing
	end
	local scale = Instance.new("UIScale")
	scale.Name = "Pop"
	scale.Parent = object
	return scale
end

-- Emphasis kick: jump to `from` (default 1.18) and spring back to 1.
function UiFx.pop(object: GuiObject, from: number?, time: number?)
	if reduced() then
		return
	end
	local scale = UiFx.popScale(object)
	scale.Scale = from or 1.18
	tween(scale, time or 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = 1 })
end

-- Entrance: grow in from small (Back Out), optionally after a delay.
function UiFx.enter(object: GuiObject, delay: number?, from: number?)
	if reduced() then
		return
	end
	local scale = UiFx.popScale(object)
	scale.Scale = from or 0.6
	task.delay(delay or 0, function()
		if scale.Parent then
			tween(scale, 0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = 1 })
		end
	end)
end

-- "No" wiggle for a refused tap (Rotation only, so layouts never fight it).
function UiFx.nudge(object: GuiObject)
	if reduced() then
		return
	end
	task.spawn(function()
		for _, r in { -6, 6, -4, 4, 0 } do
			tween(object, 0.04, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Rotation = r }).Completed:Wait()
		end
	end)
end

-- Cards stagger in: first 8 only, 0.04 s apart (vault: UI Motion Language and Timing).
function UiFx.stagger(objects: { GuiObject }, step: number?)
	if reduced() then
		return
	end
	for i, object in objects do
		if i &gt; 8 then
			break
		end
		UiFx.enter(object, (i - 1) * (step or M.staggerStep), 0.7)
	end
end

local idleLoops = {}
function UiFx.refreshMotion()
	for i = #idleLoops, 1, -1 do
		local entry = idleLoops[i]
		if not entry.instance.Parent then
			entry.tween:Cancel(); table.remove(idleLoops, i)
		elseif reduced() then
			entry.tween:Pause()
			for key, value in entry.base do entry.instance[key] = value end
		else
			entry.tween:Play()
		end
	end
end

-- Idle life as an engine tween (Sine InOut, reversing, endless). nil under Reduced Motion.
function UiFx.loop(instance: Instance, period: number, goals: { [string]: any }): Tween?
	if reduced() then
		return nil
	end
	local t = TweenService:Create(
		instance,
		TweenInfo.new(period, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		goals
	)
	local base = {}
	for key in goals do base[key] = instance[key] end
	table.insert(idleLoops, { instance = instance, tween = t, base = base })
	t:Play()
	return t
end

-- Count a label from `from` to `to`. Duration grows with log10 of the gain
-- (0.35 s for +1, ~1 s for +1,000, capped at 1.4 s); text writes capped at 30 Hz.
local counters: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any

function UiFx.countTo(label: TextLabel, from: number, to: number, format: (number) -&gt; string, onDone: (() -&gt; ())?)
	local token = (counters[label] or 0) + 1
	counters[label] = token
	local gain = math.abs(to - from)
	if reduced() or gain &lt; 1 then
		label.Text = format(to)
		if onDone then
			onDone()
		end
		return
	end
	local duration = math.clamp(0.35 + 0.22 * math.log10(gain), 0.35, 1.4)
	task.spawn(function()
		local started = os.clock()
		while counters[label] == token do
			local k = math.clamp((os.clock() - started) / duration, 0, 1)
			local eased = 1 - (1 - k) * (1 - k)
			label.Text = format(math.floor(from + (to - from) * eased))
			if k &gt;= 1 then
				break
			end
			task.wait(1 / 30)
		end
		if counters[label] == token then
			label.Text = format(to)
			if onDone then
				onDone()
			end
		end
	end)
end

------------------------------------------------------------------------
-- Floaters: "+250" rising from a point (capped at 8 alive)
------------------------------------------------------------------------
local floaters = 0

function UiFx.floater(parent: GuiObject, text: string, color: Color3, position: UDim2)
	if floaters &gt;= 8 then
		return
	end
	floaters += 1
	local label = C.Text("number", text, {
		color = color,
		size = UDim2.fromOffset(220, 40),
		anchor = Vector2.new(0, 0.5),
		position = position,
		align = Enum.TextXAlignment.Left,
		zIndex = 30,
		parent = parent,
	})
	label.FontFace = UiFx.NumberFont
	local stroke = label:FindFirstChildOfClass("UIStroke")
	local rise = if reduced() then 0 else 46
	tween(
		label,
		0.9,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out,
		{ Position = position - UDim2.fromOffset(0, rise) }
	)
	task.delay(0.45, function()
		tween(label, 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { TextTransparency = 1 })
		if stroke then
			tween(stroke, 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { Transparency = 1 })
		end
	end)
	task.delay(0.95, function()
		floaters -= 1
		label:Destroy()
	end)
	UiFx.pop(label, 1.4, 0.3)
end

------------------------------------------------------------------------
-- Toast stack: max 3, above the LAUNCH slot, newest at the bottom; slides up, fades after 2.5 s
------------------------------------------------------------------------
local toastHolder: Frame? = nil
local toasts: { Frame } = {}
local toastOrder = 0

local function getToastHolder(): Frame
	local holder = toastHolder
	if holder then
		return holder
	end
	local root = UiFx.scaledRoot("LYM_Toasts", 70)
	local frame = Instance.new("Frame")
	frame.Name = "Stack"
	frame.BackgroundTransparency = 1
	frame.AnchorPoint = Vector2.new(0.5, 1)
	frame.Position = UDim2.new(0.5, 0, 1, -(S.screenMargin + 112))
	frame.Size = UDim2.fromOffset(460, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Padding = UDim.new(0, Theme.Space.sm)
	list.Parent = frame
	frame.Parent = root
	toastHolder = frame
	return frame
end

local function removeToast(slot: Frame, fade: boolean)
	local index = table.find(toasts, slot)
	if not index then
		return
	end
	table.remove(toasts, index)
	if not fade or reduced() then
		slot:Destroy()
		return
	end
	-- lihfolk-ignore: findfirstchild-chain (cast only; nil-checked on the next line)
	local inner = slot:FindFirstChild("Inner") :: Frame?
	if inner then
		tween(
			inner,
			0.18,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.In,
			{ Position = UDim2.fromOffset(0, -16), BackgroundTransparency = 1 }
		)
		for _, d in inner:GetDescendants() do
			if d:IsA("TextLabel") then
				tween(d, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { TextTransparency = 1 })
			elseif d:IsA("UIStroke") then
				tween(d, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { Transparency = 1 })
			end
		end
	end
	task.delay(0.2, function()
		slot:Destroy()
	end)
end

-- kind: "success" (green) | "error" (red) | "info" (blue)
function UiFx.toast(kind: string, text: string)
	local holder = getToastHolder()
	-- Merge: the same message already showing just pops again.
	for _, slot in toasts do
		if slot:GetAttribute("Text") == text then
			UiFx.pop(slot, 1.08, 0.2)
			return
		end
	end
	while #toasts &gt;= 3 do
		removeToast(toasts[1], false)
	end
	toastOrder += 1
	local role = if kind == "error" then "danger" elseif kind == "success" then "go" else "info"
	local swatch = Theme.role(role)
	local slot = Instance.new("Frame")
	slot.Name = "Toast"
	slot.BackgroundTransparency = 1
	slot.Size = UDim2.fromOffset(460, 52)
	slot.LayoutOrder = toastOrder
	slot:SetAttribute("Text", text)
	local inner = Instance.new("Frame")
	inner.Name = "Inner"
	inner.Size = UDim2.fromScale(1, 1)
	inner.Position = UDim2.fromOffset(0, if reduced() then 0 else 18)
	inner.BackgroundColor3 = swatch.bottom
	inner.Parent = slot
	C.corner(inner, Theme.Radius.pill)
	C.outline(inner, 3)
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = Theme.faceSequence(swatch)
	g.Parent = inner
	local icon = Icons.make(
		if kind == "error" then "close" elseif kind == "success" then "check" else "info",
		UDim2.fromOffset(34, 34)
	)
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.Position = UDim2.new(0, 10, 0.5, 0)
	icon.Parent = inner
	C.Text(
		"button",
		text,
		{ size = UDim2.new(1, -64, 1, -10), position = UDim2.fromOffset(50, 5), scaled = true, parent = inner }
	)
	slot.Parent = holder
	table.insert(toasts, slot)
	if not reduced() then
		tween(inner, 0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Position = UDim2.new() })
	end
	if kind == "error" then
		C.playSound("error")
	end
	task.delay(2.5, function()
		removeToast(slot, true)
	end)
end

------------------------------------------------------------------------
-- Flash + confetti (edge-to-edge layer)
------------------------------------------------------------------------
local CONFETTI =
	{ P.gold, Theme.Roles.go.top, Theme.Roles.info.top, Theme.Roles.danger.top, Theme.Menus.rebirth.top, P.white }
local confettiAlive = 0

function UiFx.flash(color: Color3?, strength: number?)
	ensureStarted()
	local layer = overlay
	if not layer then
		return
	end
	local frame = Instance.new("Frame")
	frame.Name = "Flash"
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = color or P.white
	-- Reduced Motion keeps a soft flash (well under photosensitivity limits either way).
	frame.BackgroundTransparency = if reduced() then 0.75 else 1 - (strength or 0.75)
	frame.Parent = layer
	tween(frame, 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { BackgroundTransparency = 1 })
	task.delay(0.45, function()
		frame:Destroy()
	end)
end

-- A burst of paper bits from a screen point (0..1 scale), capped at 80 alive.
function UiFx.confetti(origin: Vector2?, count: number?)
	ensureStarted()
	local layer = overlay
	if not layer or reduced() then
		return
	end
	local from = origin or Vector2.new(0.5, 0.35)
	local area = layer.AbsoluteSize
	for _ = 1, count or 36 do
		if confettiAlive &gt;= 80 then
			break
		end
		confettiAlive += 1
		local bit = Instance.new("Frame")
		bit.BorderSizePixel = 0
		bit.AnchorPoint = Vector2.new(0.5, 0.5)
		bit.Size = UDim2.fromOffset(math.random(8, 14), math.random(14, 22))
		bit.Position = UDim2.fromScale(from.X, from.Y)
		bit.Rotation = math.random(0, 360)
		bit.BackgroundColor3 = CONFETTI[math.random(1, #CONFETTI)]
		bit.Parent = layer
		local angle = math.random() * math.pi * 2
		local reach = 120 + math.random() * 260
		local dx = math.cos(angle) * reach / math.max(area.X, 1)
		local dy = (math.sin(angle) * reach * 0.6 + 140 + math.random() * 220) / math.max(area.Y, 1)
		local life = 0.9 + math.random() * 0.6
		tween(bit, life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
			Position = UDim2.fromScale(from.X + dx, from.Y + dy),
			Rotation = bit.Rotation + math.random(-540, 540),
		})
		task.delay(life * 0.55, function()
			tween(bit, life * 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { BackgroundTransparency = 1 })
		end)
		task.delay(life + 0.05, function()
			confettiAlive -= 1
			bit:Destroy()
		end)
	end
end

------------------------------------------------------------------------
-- Reward popup queue (one at a time; waits while blocked, at most 20 s)
------------------------------------------------------------------------
local blockers: { [string]: boolean } = {}
local rewardQueue: { { title: string, amount: string, icon: string, color: Color3? } } = {}
local rewardRunning = false
local rewardUi: { [string]: any }? = nil

function UiFx.block(reason: string, on: boolean)
	if on then
		blockers[reason] = true
	else
		blockers[reason] = nil
	end
end

local function buildReward(): { [string]: any }
	local root = UiFx.scaledRoot("LYM_Reward", 65)
	local stage = Instance.new("Frame")
	stage.Name = "Stage"
	stage.BackgroundTransparency = 1
	stage.AnchorPoint = Vector2.new(0.5, 0.5)
	stage.Position = UDim2.fromScale(0.5, 0.38)
	stage.Size = UDim2.fromOffset(380, 190)
	stage.Visible = false
	stage.Parent = root
	local scale = UiFx.popScale(stage)
	local burst = C.Sunburst({
		size = UDim2.fromOffset(460, 460),
		position = UDim2.fromScale(0.5, 0.42),
		zIndex = 0,
		parent = stage,
	})
	local card = C.Card({ size = UDim2.fromScale(1, 1), featured = true, layout = "none", parent = stage })
	card.root.ZIndex = 1
	local icon = Instance.new("Frame")
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.fromOffset(84, 84)
	icon.AnchorPoint = Vector2.new(0.5, 0)
	icon.Position = UDim2.new(0.5, 0, 0, 8)
	icon.ZIndex = 3
	icon.Parent = card.content
	local amount = C.Text("display", "", {
		size = UDim2.new(1, -20, 0, 50),
		position = UDim2.fromOffset(10, 92),
		scaled = true,
		zIndex = 3,
		parent = card.content,
	})
	amount.FontFace = UiFx.NumberFont
	local title = C.Pill("", {
		role = "premium",
		anchor = Vector2.new(0.5, 0.5),
		position = UDim2.fromScale(0.5, 0),
		rotation = -3,
		zIndex = 5,
		parent = stage,
	})
	return { root = root, stage = stage, scale = scale, burst = burst, icon = icon, amount = amount, title = title }
end

local function playReward(item)
	local r = rewardUi or buildReward()
	rewardUi = r
	for _, child in r.icon:GetChildren() do
		child:Destroy()
	end
	local icon = Icons.make(item.icon, UDim2.fromScale(1, 1))
	icon.ZIndex = 3
	icon.Parent = r.icon
	r.amount.Text = item.amount
	r.amount.TextColor3 = item.color or P.gold
	local titleLabel = r.title:FindFirstChildOfClass("TextLabel")
	if titleLabel then
		titleLabel.Text = item.title
	end
	r.stage.Visible = true
	C.playSound("success")
	if reduced() then
		r.scale.Scale = 1
	else
		r.scale.Scale = 0.5
		tween(r.scale, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out, { Scale = 1 })
		UiFx.confetti(Vector2.new(0.5, 0.38), 28)
	end
	task.wait(1.7)
	if not reduced() then
		local exit = tween(r.scale, 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In, { Scale = 0.4 })
		exit.Completed:Wait()
	end
	r.stage.Visible = false
end

-- Queue a celebration card ("DAILY REWARD", "+500", "coin"). Same title waiting = merged.
function UiFx.reward(title: string, amount: string, icon: string, color: Color3?)
	for _, waiting in rewardQueue do
		if waiting.title == title and waiting.amount == amount then
			return
		end
	end
	table.insert(rewardQueue, { title = title, amount = amount, icon = icon, color = color })
	if rewardRunning then
		return
	end
	rewardRunning = true
	task.spawn(function()
		while #rewardQueue &gt; 0 do
			local waited = 0
			while next(blockers) ~= nil and waited &lt; 20 do
				waited += task.wait(0.25)
			end
			local item = table.remove(rewardQueue, 1)
			if item then
				playReward(item)
			end
		end
		rewardRunning = false
	end)
end

------------------------------------------------------------------------
-- Viewport spin (only frames actually on screen are turned)
------------------------------------------------------------------------
local spinning: { { frame: ViewportFrame, model: Model, base: CFrame } } = {}
local spinConnection: RBXScriptConnection? = nil

local function onScreen(object: GuiObject): boolean
	local node: Instance? = object
	while node do
		if node:IsA("GuiObject") then
			if not node.Visible then
				return false
			end
		elseif node:IsA("LayerCollector") then
			return node.Enabled
		end
		node = node.Parent
	end
	return false
end

function UiFx.spin(frame: ViewportFrame)
	local model = frame:FindFirstChildOfClass("Model")
	if not model or reduced() then
		return
	end
	table.insert(spinning, { frame = frame, model = model, base = model:GetPivot() })
	if spinConnection then
		return
	end
	spinConnection = RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for i = #spinning, 1, -1 do
			local entry = spinning[i]
			if not entry.frame:IsDescendantOf(game) then
				table.remove(spinning, i)
			elseif onScreen(entry.frame) and not reduced() then
				entry.model:PivotTo(entry.base * CFrame.Angles(0, t * 0.9, 0))
			end
		end
		if #spinning == 0 and spinConnection then
			spinConnection:Disconnect()
			spinConnection = nil
		end
	end)
end

return UiFx
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="LYMNEW6">
          <Properties>
            <string name="Name">RidingClient</string>
            <ProtectedString name="Source">--!strict
-- One ride toggle and the normal Roblox movement controls (keyboard, stick or touch).
-- Input is a direction only. The server owns mount position, bounds and speed.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))
local UI = ReplicatedStorage:WaitForChild("LihFolkUI")
local C = require(UI:WaitForChild("LihFolkUIComponents")) :: any
local Controller = require(UI:WaitForChild("LihFolkUIController")) :: any
local UiFx = require(script.Parent.UiFx)
local player = Players.LocalPlayer
local RidingClient = {}
local mode = "idle"
local started = false
local busy = false
local controls: any = nil
local exactVisuals = {}
local button: any = nil

local function available(): boolean
 return mode == "idle" and not player:GetAttribute("Flying") and not player:GetAttribute("Traveling")
  and Controller.getCurrent() == nil and player:GetAttribute("DataReady") == true
end

local function refresh()
 if not button then return end
 button.root.Visible = available()
 local input = Controller.preferredInput()
 local hint = if input == "Gamepad" then " [Y]" elseif input == "Touch" then "" else " [R]"
 button.setText((if player:GetAttribute("Riding") then "DISMOUNT" else "RIDE") .. hint)
 button.setEnabled(not busy)
end

function RidingClient.SetMode(value: string)
 mode = value; refresh()
end

local function toggle()
 if busy or not available() then return end
 busy = true; refresh()
 local result = Net.Request("Mount.Toggle")
 busy = false; refresh()
 if not result.ok then
  UiFx.toast("info", if result.code == "MountHub" then "Return to the plaza to ride." else "Your mount is not ready yet. Try again shortly.")
 end
end

local function movement(): Vector3
 local vector = Vector3.zero
 if controls then
  local ok, value = pcall(function() return controls:GetMoveVector() end)
  if ok and typeof(value) == "Vector3" then vector = value end
 else
  local x = (if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then 1 else 0)
   - (if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then 1 else 0)
  local z = (if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then 1 else 0)
   - (if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then 1 else 0)
  vector = Vector3.new(x,0,z)
 end
 local camera = workspace.CurrentCamera
 if not camera then return Vector3.zero end
 local right = camera.CFrame.RightVector * Vector3.new(1,0,1)
 local back = camera.CFrame.ZVector * Vector3.new(1,0,1)
 if right.Magnitude &lt; .01 or back.Magnitude &lt; .01 then return Vector3.zero end
 local direction = right.Unit * vector.X + back.Unit * vector.Z
 return if direction.Magnitude &gt; 1 then direction.Unit else direction
end

-- Presentation only. Launch calls this after moving its predicted/interpolated pet.
-- The real character is also seated server-side by Riding.SetFlightPose.
function RidingClient.PoseFlight(character: Model?, model: Model, _cf: CFrame?)
 if not character then return end
 local root = character:FindFirstChild("HumanoidRootPart")
 local humanoid = character:FindFirstChildOfClass("Humanoid")
 if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health &lt;= 0 then return end
 local seat = model:FindFirstChild("RideSeat",true)
 root.CFrame = (if seat and seat:IsA("Attachment") then seat.WorldCFrame else model:GetPivot() * CFrame.new(0,3.5,0)) * CFrame.new(0,1.7,0)
 humanoid.Sit = true
end

-- EditableMesh Content is local to this client: never assume dynamic mesh replication.
local function refreshExactRides()
 local mounts = workspace:FindFirstChild("LYM_Mounts")
 local assets = ReplicatedStorage:FindFirstChild("AssetModels")
 if not mounts or not assets then return end
 local seen = {}
 for _, serverModel in mounts:GetChildren() do
  local owner = Players:GetPlayerByUserId(serverModel:GetAttribute("Owner") or 0)
  local pet = owner and owner:GetAttribute("RidingPet")
  local folder = assets:FindFirstChild("Monsters")
  local template = folder and pet and folder:FindFirstChild(pet)
  if owner and not owner:GetAttribute("Flying") and template and template:GetAttribute("ArtSource") == "OriginalThreeJSGeometry" then
   seen[serverModel] = true
   local entry = exactVisuals[serverModel]
   if entry and entry.pet ~= pet then entry.model:Destroy(); exactVisuals[serverModel] = nil; entry = nil end
   if not entry then
    local clone = template:Clone(); clone.Name = "OriginalRide_" .. owner.UserId; clone.Parent = workspace
    entry = {model=clone,pet=pet};exactVisuals[serverModel] = entry
    for _, part in serverModel:GetDescendants() do if part:IsA("BasePart") then part.LocalTransparencyModifier = 1 end end
   end
   entry.model:PivotTo(serverModel:GetPivot())
   RidingClient.PoseFlight(owner.Character, entry.model)
  end
 end
 for serverModel, entry in exactVisuals do
  if not seen[serverModel] then
   entry.model:Destroy(); exactVisuals[serverModel] = nil
   if serverModel.Parent then
    for _, part in serverModel:GetDescendants() do if part:IsA("BasePart") then part.LocalTransparencyModifier = 0 end end
   end
  end
 end
end

function RidingClient.Start()
 if started then return end
 started = true
 task.spawn(function()
  local assets = ReplicatedStorage:WaitForChild("AssetModels",40)
  local geometry = ReplicatedStorage:WaitForChild("ExactCreatureGeometry",10)
  if assets and geometry then
   local loader = require(ReplicatedStorage:WaitForChild("Game"):WaitForChild("ExactCreatureLoader"))
   loader.Upgrade(assets, geometry)
  end
 end)
 RunService.RenderStepped:Connect(refreshExactRides)
 local root = UiFx.scaledRoot("RideHUD", 3)
 button = C.Button({ text="RIDE [R]", role="info", size=UDim2.fromOffset(190,56),
  anchor=Vector2.new(0,1),position=UDim2.new(0,16,1,-20),parent=root,
  onActivated=function() task.spawn(toggle) end,
 })
 UiFx.onLayout(function(_design, compact)
  button.root.Size = UDim2.fromOffset(if compact then 154 else 190,56)
  button.root.Position = UDim2.new(0,16,1,if compact then -104 else -20)
 end)
 task.spawn(function()
  local scripts = player:WaitForChild("PlayerScripts")
  local module = scripts:WaitForChild("PlayerModule",15)
  if module then
   local ok, result = pcall(function() return require(module):GetControls() end)
   if ok then controls = result end
  end
 end)
 for _, attribute in {"Riding","Flying","Traveling","DataReady"} do player:GetAttributeChangedSignal(attribute):Connect(refresh) end
 Controller.onChanged(refresh)
 UserInputService.LastInputTypeChanged:Connect(refresh)
 UserInputService.InputBegan:Connect(function(input, processed)
  if not processed and (input.KeyCode == Enum.KeyCode.R or input.KeyCode == Enum.KeyCode.ButtonY) then task.spawn(toggle) end
 end)
 local accumulator = 0
 RunService.Heartbeat:Connect(function(dt)
  accumulator += dt
  if accumulator &lt; .1 then return end
  accumulator = 0
  if player:GetAttribute("Riding") and not player:GetAttribute("Flying") then
   local direction = if available() then movement() else Vector3.zero
   Net.Send("Mount.Input",direction.X,direction.Z)
  end
 end)
 refresh()
end
return RidingClient
</ProtectedString>
