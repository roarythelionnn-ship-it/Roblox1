            <ProtectedString name="Source">--!strict
-- Windows: every menu, built from the LihFolk UI kit (one go slab per screen, server owns
-- every value). Bodies rebuild only while open and only when their data changed.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))
local Feedback = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Feedback")) :: any
local UIKit = ReplicatedStorage:WaitForChild("LihFolkUI")
local Theme = require(UIKit:WaitForChild("LihFolkUITheme")) :: any
local Icons = require(UIKit:WaitForChild("LihFolkUIIcons")) :: any
local C = require(UIKit:WaitForChild("LihFolkUIComponents")) :: any
local Controller = require(UIKit:WaitForChild("LihFolkUIController")) :: any
local Config = require(ReplicatedStorage:WaitForChild("LihFolkConfig")) :: any
local Game = ReplicatedStorage:WaitForChild("Game")
local GameConfig = require(Game:WaitForChild("GameConfig")) :: any
local WorldConfig = require(Game:WaitForChild("WorldConfig")) :: any
local Pets = require(Game:WaitForChild("PetDefinitions")) :: any
local Data = require(script.Parent.Data)
local Models = require(script.Parent.Models)
local Launch = require(script.Parent.Launch)
local Fx = require(script.Parent.Fx)
local UiFx = require(script.Parent.UiFx)
local Hud = require(script.Parent.Hud)

local player = Players.LocalPlayer
local P = Theme.Palette
local SP = Theme.Space

local Windows = {}
local windows: { [string]: any } = {}
local builders: { [string]: (any) -&gt; () } = {}
local watch: { [string]: { [string]: boolean } } = {}
local selectedUid: string? = nil

local RARITY = {
	Common = Color3.fromHex("B0A9DD"),
	Uncommon = Color3.fromHex("7BF5A6"),
	Rare = Color3.fromHex("7CC8FF"),
	Epic = Color3.fromHex("CF9BFF"),
	Legendary = Color3.fromHex("FFD24A"),
}

local function clear(window)
	for _, child in window.body:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function rebuild(name: string)
	local window = windows[name]
	if window and Controller.isOpen(name) then
		clear(window)
		builders[name](window)
	end
end

local function request(name: string, ...: any): boolean
	local result = Net.Request(name, ...)
	if not result.ok and result.code ~= "Busy" then
		Feedback.Show("Oops", Feedback.Text(result.code))
	end
	return result.ok
end

local function make(name: string, title: string, theme: string, icon: string, keys: { string }, build: (any) -&gt; (), hudOrder: number?)
	local window = C.Window({ name = name, title = title, theme = theme, icon = icon })
	windows[name] = window
	builders[name] = build
	watch[name] = {}
	for _, key in keys do
		watch[name][key] = true
	end
	Controller.register(window)
	if hudOrder then
		Hud.addLauncher({ window = name, label = title, icon = icon, theme = theme, layoutOrder = hudOrder, dock = name == "Codes" or name == "Shop" or name == "Settings" })
	end
end

local function grid(parent: Instance, cell: Vector2, order: number): Frame
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 0)
	holder.AutomaticSize = Enum.AutomaticSize.Y
	holder.LayoutOrder = order
	holder.Parent = parent
	C.Grid(holder, cell, SP.md)
	return holder
end

------------------------------------------------------------------------
-- Monsters
------------------------------------------------------------------------
local function buildMonsters(window)
	local uniques = table.clone(Data.inventory.uniques)
	table.sort(uniques, function(a, b)
		local ra, rb = Pets.ById[a.item], Pets.ById[b.item]
		if a.equipped ~= b.equipped then
			return a.equipped
		end
		return (ra and ra.order or 0) &gt; (rb and rb.order or 0)
	end)
	local selected = nil
	for _, unique in uniques do
		if unique.uid == selectedUid then
			selected = unique
		end
	end
	selected = selected or Data.equipped() or uniques[1]
	if selected then
		local def = Pets.ById[selected.item]
		local meta = Data.monster(selected.uid)
		C.SectionHeader(def.name, "rebirth", 1, window.body)
		local card = C.Card({ size = UDim2.new(1, 0, 0, 200), featured = def.rarity == "Legendary", layout = "none", layoutOrder = 2, parent = window.body })
		local view = Instance.new("Frame")
		view.BackgroundTransparency = 1
		view.Size = UDim2.fromOffset(96, 106)
		view.Parent = card.content
		Models.viewport(view, "Monsters", selected.item, { spin = true })
		C.Pill(def.rarity:upper(), { position = UDim2.fromOffset(112, 4), parent = card.content })
		C.Text("body", `Level {meta.Level}/{GameConfig.PetLevel.Max}  -  +{math.floor(Pets.speedBonus(selected.item, meta.Level, GameConfig.PetLevel.SpeedPerLevel) * 1000) / 10}% launch speed`, { size = UDim2.new(1, -116, 0, 48), position = UDim2.fromOffset(112, 38), wrap = true, scaled = true, align = Enum.TextXAlignment.Left, parent = card.content })
		local bar = C.ProgressBar({ value = if meta.Level &gt;= GameConfig.PetLevel.Max then 1 else meta.Xp / GameConfig.petXpForLevel(meta.Level), role = "go", text = "XP", size = UDim2.new(1, -116, 0, 26), parent = card.content })
		bar.root.Position = UDim2.fromOffset(112, 88)
		local equip = C.Button({ text = if selected.equipped then "EQUIPPED" else "EQUIP", role = if selected.equipped then "done" else "go", size = UDim2.new(0.5, -6, 0, 56), position = UDim2.fromOffset(0, 122), parent = card.content, onActivated = function()
			request("Monsters.Equip", selected.uid)
		end })
		equip.setEnabled(not selected.equipped)
		local copies = 0
		for _, u in uniques do
			if u.item == selected.item then
				copies += 1
			end
		end
		local fuse
		local confirmUntil = 0
		fuse = C.Button({ text = `FUSE x{math.max(copies - 1, 0)}`, role = "neutral", size = UDim2.new(0.5, -6, 0, 56), position = UDim2.new(0.5, 6, 0, 122), parent = card.content, onActivated = function()
			if os.clock() &gt; confirmUntil then
				confirmUntil = os.clock() + 5
				fuse.setText("CONFIRM FUSE")
				fuse.setRole("danger")
				task.delay(5, function()
					if fuse.root.Parent and os.clock() &gt;= confirmUntil then
						fuse.setText(`FUSE x{math.max(copies - 1, 0)}`)
						fuse.setRole("neutral")
					end
				end)
				return
			end
			confirmUntil = 0
			request("Monsters.Fuse", selected.item)
		end })
		fuse.setEnabled(copies &gt; 1)
		-- Variants (cosmetic): preview colour + cost; unlocked ones apply for free
		local variants = grid(window.body, Vector2.new(128, 56), 3)
		for i, id in { "Normal", "Neon", "Frost", "Golden", "Celestial" } do
			local rule = GameConfig.MutationById[id]
			local unlocked = id == "Normal" or meta.Unlocked[id] == true
			local label = if meta.Mutation == id then "ON" elseif unlocked then id elseif rule then `{id} {rule.shards}` else id
			local b = C.Button({ text = label, role = if meta.Mutation == id then "done" elseif unlocked then "info" else "locked", size = UDim2.fromOffset(118, 52), layoutOrder = i, parent = variants, onActivated = function()
				request("Monsters.Variant", selected.uid, id)
			end })
			b.setEnabled(meta.Mutation ~= id and (unlocked or (rule ~= nil and meta.Level &gt;= rule.minLevel and Data.shards() &gt;= rule.shards)))
		end
	end
	C.SectionHeader(`Collection {#uniques}/{Config.Inventory.uniqueCapacity}`, "rebirth", 4, window.body)
	local cards = grid(window.body, Vector2.new(128, 150), 5)
	for index, unique in uniques do
		local def = Pets.ById[unique.item]
		local card = C.Card({ size = UDim2.fromOffset(128, 150), featured = unique.equipped, layout = "none", layoutOrder = index, parent = cards })
		local view = Instance.new("Frame")
		view.BackgroundTransparency = 1
		view.Size = UDim2.new(1, 0, 0, 100)
		view.Parent = card.content
		if index &lt;= 40 then
			Models.viewport(view, "Monsters", unique.item)
		end
		local name = C.Text("small", def and def.name or unique.item, { color = RARITY[def and def.rarity or "Common"], size = UDim2.new(1, 0, 0, 22), position = UDim2.fromOffset(0, 104), scaled = true, parent = card.content })
		local _ = name
		local hit = Instance.new("TextButton")
		hit.BackgroundTransparency = 1
		hit.Text = ""
		hit.Size = UDim2.fromScale(1, 1)
		hit.ZIndex = 10
		hit.Parent = card.root
		hit.Activated:Connect(function()
			selectedUid = unique.uid
			C.playSound("click")
			rebuild("Monsters")
		end)
	end
end

------------------------------------------------------------------------
-- Eggs + hatch reveal
------------------------------------------------------------------------
local reveal: { [string]: any } = {}
local revealToken = 0
local hatchBusy = false

local function showReveal(eggId: string, petId: string)
	if Launch.mode ~= "idle" then
		UiFx.toast("info", "Hatched " .. Pets.ById[petId].name .. "! Check your inventory.")
		return
	end
	revealToken += 1
	local token = revealToken
	local def = Pets.ById[petId]
	local overlay = reveal.root
	overlay.Visible = true
	for _, child in reveal.stage:GetChildren() do
		child:Destroy()
	end
	reveal.name.Text = ""
	reveal.rarity.Text = ""
	local eggView = Models.viewport(reveal.stage, "Eggs", eggId)
	local started = os.clock()
	local reduced = Theme.isReducedMotion()
	while os.clock() - started &lt; 1.4 do
		if token ~= revealToken or not overlay.Visible then return end
		local t = os.clock() - started
		eggView.Rotation = if reduced then 0 else math.sin(t * (10 + t * 16)) * (6 + t * 10)
		RunService.RenderStepped:Wait()
	end
	eggView:Destroy()
	C.playSound("success")
	Models.viewport(reveal.stage, "Monsters", petId, { spin = true })
	reveal.name.Text = def.name
	reveal.name.TextColor3 = RARITY[def.rarity]
	reveal.rarity.Text = `{def.rarity:upper()}  -  {def.weight}%`
	reveal.glow.BackgroundColor3 = RARITY[def.rarity]
	if def.rarity == "Legendary" or def.rarity == "Epic" then
		Fx.levelUp(player.Character, "holy")
	end
end

local function buildEggs(window)
	local game = Data.game
	local narrow = window.root.Size.X.Offset &lt; 620
	for order, egg in Pets.Eggs do
		local unlocked = game ~= nil and game.Unlocked[egg.world] == true
		C.SectionHeader(egg.name, "daily", order * 10, window.body)
		local card = C.Card({ size = UDim2.new(1, 0, 0, if narrow then 370 else 236), featured = order == 1 and unlocked, layout = "none", layoutOrder = order * 10 + 1, parent = window.body })
		local view = Instance.new("Frame")
		view.BackgroundTransparency = 1
		view.Size = UDim2.fromOffset(if narrow then 110 else 150, if narrow then 110 else 150)
		view.Parent = card.content
		Models.viewport(view, "Eggs", egg.id, { spin = true })
		local hatch = C.CurrencyButton({ price = egg.price, currency = "coin", size = UDim2.fromOffset(150, 56), position = UDim2.fromOffset(if narrow then 128 else 0, if narrow then 30 else 160), parent = card.content, onActivated = function()
			if hatchBusy or reveal.root.Visible then return end
			hatchBusy = true
			local result = Net.Request("Eggs.Hatch", egg.id, 1)
			hatchBusy = false
			if result.ok and result.data and result.data[1] then
				task.spawn(showReveal, egg.id, result.data[1].item)
			elseif not result.ok then
				Feedback.Show("Oops", Feedback.Text(result.code))
			end
		end })
		hatch.button.setEnabled(unlocked and Data.coins() &gt;= egg.price)
		if not unlocked then
			hatch.button.setRole("locked")
			hatch.button.setText("LOCKED")
		end
		-- Exact odds for every outcome (the roll uses the same table on the server)
		for i, def in egg.pets do
			local row = Instance.new("Frame")
			row.BackgroundTransparency = 1
			row.Size = UDim2.new(1, if narrow then 0 else -170, 0, 40)
			row.Position = UDim2.fromOffset(if narrow then 0 else 166, (if narrow then 122 else 0) + (i - 1) * 44)
			row.Parent = card.content
			local thumb = Instance.new("Frame")
			thumb.BackgroundTransparency = 1
			thumb.Size = UDim2.fromOffset(40, 40)
			thumb.Parent = row
			local discovered = game ~= nil and game.Discovered[def.id] == true
			Models.viewport(thumb, "Monsters", def.id, { silhouette = not discovered })
			C.Text("body", if discovered then def.name else "???", { color = RARITY[def.rarity], scaled = true, size = UDim2.new(0.7, -54, 1, 0), position = UDim2.fromOffset(48, 0), align = Enum.TextXAlignment.Left, parent = row })
			C.Text("number", `{def.weight}%`, { size = UDim2.new(0.3, 0, 1, 0), position = UDim2.fromScale(0.7, 0), align = Enum.TextXAlignment.Right, scaled = true, parent = row })
		end
	end
	C.Text("caption", "Exact odds. Eggs only cost Star Coins earned by flying.", { color = P.textLow, size = UDim2.new(1, 0, 0, 22), layoutOrder = 99, parent = window.body })
end

------------------------------------------------------------------------
-- Upgrades + training
------------------------------------------------------------------------
local NEXT = {
	Cannon = function(l)
		return `+{8 * l} speed`, `+{8 * (l + 1)} speed`
	end,
	Boost = function(l)
		return `Boost {GameConfig.boostImpulse(l)}`, `Boost {GameConfig.boostImpulse(l + 1)}`
	end,
	Bounce = function(l)
		return `+{3 * l}% bounce`, `+{3 * (l + 1)}% bounce`
	end,
	Magnet = function(l)
		return `+{1.5 * l} reach`, `+{1.5 * (l + 1)} reach`
	end,
}

local training: { [string]: any } = {}

local function buildUpgrades(window)
	local game = Data.game
	if not game then
		return
	end
	C.SectionHeader("Launcher", "shop", 1, window.body)
	local cards = grid(window.body, Vector2.new(280, 196), 2)
	for index, upgrade in GameConfig.Upgrades do
		local level = game[upgrade.field]
		local cost = GameConfig.upgradeCost(upgrade, level)
		local card = C.Card({ size = UDim2.fromOffset(280, 196), featured = index == 1, layoutOrder = index, parent = cards })
		C.Text("title", upgrade.name, { size = UDim2.new(1, 0, 0, 30), align = Enum.TextXAlignment.Left, layoutOrder = 1, parent = card.content })
		local now, nextText = NEXT[upgrade.id](level)
		C.Text("body", if cost then `{now}  -&gt;  {nextText}` else `{now}  (MAX)`, { color = P.textMid, size = UDim2.new(1, 0, 0, 24), align = Enum.TextXAlignment.Left, layoutOrder = 2, parent = card.content })
		C.ProgressBar({ value = (level - upgrade.min) / (upgrade.max - upgrade.min), role = "info", text = `LV {level}/{upgrade.max}`, layoutOrder = 3, parent = card.content })
		local buy = C.CurrencyButton({ price = cost or "MAX", currency = "coin", size = UDim2.new(1, 0, 0, Theme.Size.buttonH), layoutOrder = 4, parent = card.content, onActivated = function()
			if request("Upgrades.Buy", upgrade.id) then
				C.playSound("success")
			end
		end })
		buy.button.setEnabled(cost ~= nil and Data.coins() &gt;= cost)
		if not cost then
			buy.button.setRole("done")
		end
	end
	C.SectionHeader("Power Training", "shop", 3, window.body)
	local card = C.Card({ size = UDim2.new(1, 0, 0, 150), layoutOrder = 4, parent = window.body })
	C.Text("body", `Power level {game.TrainingLevel}/{GameConfig.Training.MaxLevel}  -  +2.6 launch speed each`, { size = UDim2.new(1, 0, 0, 26), align = Enum.TextXAlignment.Left, layoutOrder = 1, parent = card.content })
	C.ProgressBar({ value = game.TrainingXP / GameConfig.trainingXpForLevel(game.TrainingLevel), role = "premium", text = "XP", layoutOrder = 2, parent = card.content })
	C.Button({ text = "TRAIN", role = "neutral", size = UDim2.fromOffset(200, 52), layoutOrder = 3, parent = card.content, onActivated = function()
		Controller.close("Upgrades")
		Windows.openTraining()
	end })
end

function Windows.openTraining()
	if Launch.mode ~= "idle" or training.root.Visible then
		return
	end
	local result = Net.Request("Training.Aim")
	if not result.ok then
		return
	end
	training.session = result.data
	training.root.Visible = true
end

local function trainHit()
	local session = training.session
	if not session then
		return
	end
	training.session = nil
	local marker = GameConfig.markerAt(workspace:GetServerTimeNow() - session.start, session.period)
	local result = Net.Request("Training.Hit", session.session, marker)
	if result.ok then
		training.status.Text = `{string.upper(result.data.timing)}!  +{result.data.xp} XP` .. (if result.data.leveled then `  -  POWER {result.data.level}!` else "")
		C.playSound(if result.data.timing == "Perfect" then "success" else "click")
	else
		training.status.Text = Feedback.Text(result.code)
	end
	task.wait(GameConfig.Training.Cooldown)
	if training.root.Visible then
		local again = Net.Request("Training.Aim")
		training.session = if again.ok then again.data else nil
	end
end

local function buildTrainingPanel(gui: Instance)
	local root = Instance.new("Frame")
	root.Name = "Training"
	root.BackgroundColor3 = P.dusk
	root.AnchorPoint = Vector2.new(0.5, 1)
	root.Position = UDim2.new(0.5, 0, 1, -Theme.Size.screenMargin)
	root.Size = UDim2.fromOffset(620, 240)
	root.Visible = false
	root.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, Theme.Radius.panel)
	corner.Parent = root
	local stroke = Instance.new("UIStroke")
	stroke.Color = P.ink
	stroke.Thickness = 4
	stroke.Parent = root
	C.Text("display", "POWER TRAINING", { color = P.gold, size = UDim2.new(1, -80, 0, 44), position = UDim2.fromOffset(20, 8), scaled = true, parent = root })
	training.status = C.Text("body", "Hit when the marker is in the gold zone", { color = P.textMid, size = UDim2.new(1, -40, 0, 24), position = UDim2.fromOffset(20, 56), parent = root })
	local track = Instance.new("Frame")
	track.BackgroundColor3 = P.duskSunken
	track.Size = UDim2.new(1, -40, 0, 30)
	track.Position = UDim2.fromOffset(20, 92)
	track.Parent = root
	local tc = Instance.new("UICorner")
	tc.CornerRadius = UDim.new(0, 10)
	tc.Parent = track
	local zone = Instance.new("Frame")
	zone.BackgroundColor3 = P.gold
	zone.BorderSizePixel = 0
	zone.Position = UDim2.fromScale(GameConfig.Flight.PerfectZone[1], 0)
	zone.Size = UDim2.fromScale(GameConfig.Flight.PerfectZone[2] - GameConfig.Flight.PerfectZone[1], 1)
	zone.Parent = track
	local marker = Instance.new("Frame")
	marker.AnchorPoint = Vector2.new(0.5, 0.5)
	marker.BackgroundColor3 = P.white
	marker.Size = UDim2.new(0, 10, 1, 16)
	marker.Parent = track
	local ms = Instance.new("UIStroke")
	ms.Color = P.ink
	ms.Thickness = 3
	ms.Parent = marker
	C.Button({ text = "HIT!", role = "go", size = UDim2.fromOffset(240, 64), anchor = Vector2.new(0.5, 1), position = UDim2.new(0.5, 0, 1, -16), parent = root, onActivated = function()
		task.spawn(trainHit)
	end })
	local close = C.CloseButton(function()
		root.Visible = false
	end)
	close.root.AnchorPoint = Vector2.new(1, 0)
	close.root.Position = UDim2.new(1, -10, 0, 10)
	close.root.Parent = root
	training.root = root
	RunService.RenderStepped:Connect(function()
		local session = training.session
		if root.Visible and session then
			marker.Position = UDim2.fromScale(GameConfig.markerAt(workspace:GetServerTimeNow() - session.start, session.period), 0.5)
		end
	end)
end

------------------------------------------------------------------------
-- Worlds
------------------------------------------------------------------------
local UNLOCK = { CloudtopCircuit = GameConfig.World2Unlock, NebulaWilds = GameConfig.World3Unlock }

function Windows.travel(worldId: string)
	local character = player.Character
	local from = character and character:GetPivot()
	if request("Worlds.Travel", worldId) and from then
		task.wait(0.15)
		local now = player.Character
		if now then
			Fx.teleport(from, now:GetPivot(), "teal")
		end
	end
end

local function buildWorlds(window)
	local game = Data.game
	if not game then
		return
	end
	for order, world in WorldConfig.List do
		local unlocked = game.Unlocked[world.id] == true
		local here = Data.world() == world.id
		C.SectionHeader(world.name, "codes", order * 10, window.body)
		local card = C.Card({ size = UDim2.new(1, 0, 0, 150), featured = here, layoutOrder = order * 10 + 1, parent = window.body })
		C.Text("body", `{Theme.formatComma(world.length)} stud course  -  {Pets.EggById[world.egg].name}  -  best {Theme.formatComma(game.Best[world.id] or 0)}`, { color = P.textMid, size = UDim2.new(1, 0, 0, 24), align = Enum.TextXAlignment.Left, layoutOrder = 1, parent = card.content })
		local rule = UNLOCK[world.id]
		if rule and not unlocked then
			local best = game.Best[rule.bestWorld] or 0
			C.ProgressBar({ value = best / rule.best, role = "info", text = `FLY {Theme.formatComma(rule.best)} IN {string.upper(WorldConfig.ById[rule.bestWorld].name)}`, layoutOrder = 2, parent = card.content })
			local unlock = C.CurrencyButton({ price = rule.cost, currency = "coin", size = UDim2.new(1, 0, 0, Theme.Size.buttonH), layoutOrder = 3, parent = card.content, onActivated = function()
				if request("Worlds.Unlock", world.id) then
					Fx.levelUp(player.Character, "holy")
				end
			end })
			unlock.button.setEnabled(best &gt;= rule.best and Data.coins() &gt;= rule.cost)
			if best &lt; rule.best then
				unlock.button.setRole("locked")
				unlock.button.setText("FLY FARTHER")
			end
		else
			local travel = C.Button({ text = if here then "YOU ARE HERE" else "TRAVEL", role = if here then "done" else "go", size = UDim2.new(1, 0, 0, Theme.Size.buttonH), layoutOrder = 2, parent = card.content, onActivated = function()
				Controller.close("Worlds")
				Windows.travel(world.id)
			end })
			travel.setEnabled(not here)
		end
	end
end

------------------------------------------------------------------------
-- Missions (Quests), Daily, Codes, Settings, Shop
------------------------------------------------------------------------
local function buildMissions(window)
	C.SectionHeader("Missions", "daily", 1, window.body)
	if #Data.quests == 0 then
		C.Text("body", "All missions complete!", { size = UDim2.new(1, 0, 0, 30), layoutOrder = 2, parent = window.body })
	end
	for index, quest in Data.quests do
		local card = C.Card({ size = UDim2.new(1, 0, 0, 160), featured = quest.complete, layoutOrder = index + 1, parent = window.body })
		C.Text("title", quest.title, { size = UDim2.new(1, 0, 0, 30), align = Enum.TextXAlignment.Left, layoutOrder = 1, parent = card.content })
		for i, objective in quest.objectives do
			C.ProgressBar({ value = objective.current / objective.amount, role = "go", text = `{objective.text}  {objective.current}/{objective.amount}`, layoutOrder = 1 + i, parent = card.content })
		end
		local claim = C.StateButton({ state = if quest.complete then "claim" else "locked", texts = { claim = `CLAIM {quest.reward}`, locked = quest.reward }, size = UDim2.new(1, 0, 0, Theme.Size.buttonH), layoutOrder = 9, window = window, parent = card.content, onActivated = function(state)
			if state == "claim" then
				request("Quests.Claim", quest.id)
			end
		end })
		local _ = claim
	end
end

local function buildDaily(window)
	local status = Net.Request("Daily.Status")
	C.SectionHeader("Daily Rewards", "daily", 1, window.body)
	local cards = grid(window.body, Vector2.new(150, 190), 2)
	if not status.ok then
		return
	end
	local info = status.data
	for day, reward in Config.Daily.track do
		local amount = if reward.kind == "currency" then reward.amount else 1500
		local current = info.rewardIndex or 1
		local state = if info.canClaim and day == current then "claim" elseif day &lt; current or (not info.canClaim and day == current) then "claimed" else "locked"
		C.RewardCard({ title = `DAY {day}`, amount = `x{Theme.formatComma(amount)}`, icon = "coin", state = state, featured = day == 7, tag = if day == 7 then "BIG REWARD" else nil, size = UDim2.fromOffset(150, 190), layoutOrder = day, window = window, parent = cards, onActivated = function(s)
			if s == "claim" and request("Daily.Claim") then
				rebuild("Daily")
			end
		end })
	end
	C.Text("caption", "Claim once per day (UTC). Miss one day and your streak is safe.", { color = P.textLow, size = UDim2.new(1, 0, 0, 22), layoutOrder = 3, parent = window.body })
end

local function buildCodes(window)
	C.Text("body", "Enter a code to get free rewards.", { color = P.textMid, size = UDim2.new(1, 0, 0, 28), layoutOrder = 1, parent = window.body })
	local input = C.TextInput({ placeholder = "CODE", maxLength = 24, layoutOrder = 2, parent = window.body })
	local redeem
	redeem = C.Button({ text = "REDEEM", role = "go", size = UDim2.new(1, 0, 0, Theme.Size.buttonH), layoutOrder = 3, parent = window.body, onActivated = function()
		redeem.setText("CHECKING...")
		local result = Net.Request("Codes.Redeem", input.getText())
		redeem.setText("REDEEM")
		if result.ok then
			input.setStatus("success", "Code redeemed!")
			input.clear()
		else
			input.setStatus("error", Feedback.Text(result.code))
			input.shake()
		end
	end })
end

local SETTINGS = {
	{ "music", "Music", "Background music", "music" },
	{ "sfx", "Sound effects", "Clicks, launches and impacts", "sound" },
	{ "cameraShake", "Camera shake", "Shake on launch and bounces", "motion" },
	{ "reducedMotion", "Reduced motion", "Fewer flashes and calmer camera", "motion" },
	{ "bloom", "Glow effects", "Turn off bloom for a clearer view", "eye" },
	{ "highContrast", "High contrast", "Darker panels and brighter body text", "eye" },
	{ "slowTiming", "Slow timing bar", "Easier timing, same rewards", "timer" },
	{ "hideOthers", "Hide other flights", "Hide other players' monsters", "eye" },
	{ "showTutorial", "Tutorial hints", "Show the next step on screen", "info" },
}

local function buildSettings(window)
	local game = Data.game
	if not game then
		return
	end
	for index, row in SETTINGS do
		C.SettingRow({ label = row[2], description = row[3], icon = row[4], value = game.Settings[row[1]] == true, layoutOrder = index, parent = window.body, onChanged = function(value: boolean)
			Net.Request("Settings.Set", row[1], value)
			if row[1] == "reducedMotion" then
				Controller.setReducedMotion(value)
			end
		end })
	end
end

local function buildCollection(window)
	local state = Data.game
	local discovered = if state then state.Discovered else {}
	local total = 0
	for _, def in Pets.List do if discovered[def.id] then total += 1 end end
	C.SectionHeader(`Monster Collection {total}/{#Pets.List}`, "rebirth", 1, window.body)
	local cards = grid(window.body, Vector2.new(148, 184), 2)
	for order, def in Pets.List do
		local owned = discovered[def.id] == true
		local card = C.Card({size = UDim2.fromOffset(148,184), layout = "none", layoutOrder = order, parent = cards})
		local view = Instance.new("Frame"); view.BackgroundTransparency = 1
		view.Size = UDim2.new(1,0,0,108); view.Parent = card.content
		Models.viewport(view, "Monsters", def.id, {silhouette = not owned})
		C.Text("small", if owned then def.name else "UNDISCOVERED", {size=UDim2.new(1,0,0,24),position=UDim2.fromOffset(0,110),scaled=true,parent=card.content})
		C.Text("caption", def.rarity, {color=RARITY[def.rarity],size=UDim2.new(1,0,0,20),position=UDim2.fromOffset(0,136),parent=card.content})
	end
end

local function buildShop(window)
	C.SectionHeader("Cosmetics", "shop", 1, window.body)
	local cards = grid(window.body, Vector2.new(220, 220), 2)
	for index, pass in GameConfig.Passes do
		local card = C.Card({ size = UDim2.fromOffset(220, 220), layoutOrder = index, parent = cards })
		local icon = Icons.make("star", UDim2.fromOffset(64, 64))
		icon.LayoutOrder = 1
		icon.Parent = card.content
		C.Text("title", pass.name, { size = UDim2.new(1, 0, 0, 52), wrap = true, layoutOrder = 2, parent = card.content })
		local soon = C.Button({ text = "COMING SOON", role = "locked", size = UDim2.new(1, 0, 0, Theme.Size.buttonH), layoutOrder = 3, parent = card.content })
		soon.setEnabled(false)
	end
	C.Text("caption", "Cosmetic only - never power, luck or worlds. Purchases open after the owner approves them.", { color = P.textLow, size = UDim2.new(1, 0, 0, 40), wrap = true, layoutOrder = 3, parent = window.body })
end

function Windows.start()
	make("Monsters", "Monsters", "rebirth", "pet", { inventory = true, game = true, shards = true }, buildMonsters, 1)
	make("Eggs", "Eggs", "daily", "gift", { coins = true, game = true }, buildEggs, 2)
	make("Upgrades", "Upgrades", "shop", "boost", { coins = true, game = true }, buildUpgrades, 3)
	make("Worlds", "Worlds", "codes", "star", { coins = true, game = true, world = true }, buildWorlds, 4)
	make("Missions", "Missions", "daily", "check", { quests = true }, buildMissions, 5)
	make("Collection", "Collection", "rebirth", "pet", { game = true, inventory = true }, buildCollection, 7)
	make("Daily", "Daily", "daily", "daily", {}, buildDaily, 6)
	make("Codes", "Codes", "codes", "codes", {}, buildCodes, 7)
	make("Shop", "Shop", "shop", "shop", {}, buildShop, 8)
	make("Settings", "Settings", "settings", "settings", { game = true }, buildSettings, 9)

	-- Hatch reveal overlay (above windows)
	local gui = Controller.getGui()
	local revealLayer = UiFx.scaledRoot("RevealLayer", 50)
	local root = Instance.new("Frame")
	root.Name = "HatchReveal"
	root.Active = true
	root.BackgroundColor3 = P.backdrop
	root.BackgroundTransparency = 0.15
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = 50
	root.Visible = false
	root.Parent = revealLayer
	local glow = Instance.new("Frame")
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromScale(0.5, 0.42)
	glow.Size = UDim2.fromOffset(380, 380)
	glow.BackgroundTransparency = 0.8
	glow.ZIndex = 50
	glow.Parent = root
	local gcorner = Instance.new("UICorner")
	gcorner.CornerRadius = UDim.new(0.5, 0)
	gcorner.Parent = glow
	local stage = Instance.new("Frame")
	stage.AnchorPoint = Vector2.new(0.5, 0.5)
	stage.Position = UDim2.fromScale(0.5, 0.42)
	stage.Size = UDim2.fromOffset(340, 340)
	stage.BackgroundTransparency = 1
	stage.ZIndex = 51
	stage.Parent = root
	reveal.root, reveal.stage, reveal.glow = root, stage, glow
	reveal.name = C.Text("display", "", { size = UDim2.fromOffset(600, 56), anchor = Vector2.new(0.5, 0), position = UDim2.new(0.5, 0, 0.74, 0), scaled = true, parent = root })
	reveal.rarity = C.Text("title", "", { color = P.textMid, size = UDim2.fromOffset(600, 32), anchor = Vector2.new(0.5, 0), position = UDim2.new(0.5, 0, 0.74, 60), parent = root })
	C.Button({ text = "AWESOME!", role = "go", size = UDim2.fromOffset(240, 60), anchor = Vector2.new(0.5, 1), position = UDim2.new(0.5, 0, 1, -24), parent = root, onActivated = function()
		revealToken += 1
		root.Visible = false
	end })
	local trainingLayer = UiFx.scaledRoot("TrainingLayer", 15)
	buildTrainingPanel(trainingLayer)
	UiFx.onLayout(function(design, _compact)
		training.root.Size = UDim2.fromOffset(math.min(620, design.X - 32), 240)
		stage.Size = UDim2.fromOffset(math.min(340, design.X - 48, design.Y * 0.5), math.min(340, design.X - 48, design.Y * 0.5))
		reveal.name.Size = UDim2.new(1, -32, 0, 48)
		reveal.rarity.Size = UDim2.new(1, -32, 0, 28)
	end)

	Controller.onChanged(function(name: string, isOpen: boolean)
		if isOpen and builders[name] then
			clear(windows[name])
			builders[name](windows[name])
		end
	end)
	Data.Changed:Connect(function(key: string)
		for name, keys in watch do
			if keys[key] then
				rebuild(name)
			end
		end
	end)
	Launch.ModeChanged:Connect(function(mode: string)
		if mode ~= "idle" then
			revealToken += 1
			reveal.root.Visible = false
			training.root.Visible = false
		end
	end)

	-- World prompts open the matching window
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		local node: Instance? = prompt.Parent
		while node and node ~= workspace do
			if CollectionService:HasTag(node, "LYM_EggStand") then
				Controller.open("Eggs")
				return
			elseif CollectionService:HasTag(node, "LYM_Kiosk") then
				Controller.open("Upgrades")
				return
			elseif CollectionService:HasTag(node, "LYM_Training") then
				Windows.openTraining()
				return
			elseif CollectionService:HasTag(node, "LYM_Portal") then
				local target = node:GetAttribute("Target")
				local game = Data.game
				if game and target and game.Unlocked[target] then
					Windows.travel(target)
				else
					Controller.open("Worlds")
				end
				return
			end
			node = node.Parent
		end
	end)
end

return Windows
