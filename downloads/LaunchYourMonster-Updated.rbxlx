          <Item class="ModuleScript" referent="RBX2266E7017F664E598C9FD85805559CAD">
            <Properties>
              <Content name="LinkedSource">
                <null />
              </Content>
              <ProtectedString name="Source">-- FlightService: server-authoritative launches.
-- IDLE -&gt; AIMING (BeginAim) -&gt; FLYING (Fire) -&gt; RESULTS (rewards once per flightId) -&gt; IDLE.
-- The client only sends aim angle, its observed power-marker value and short-lived inputs;
-- distance, rings, bounces and rewards are computed here with FlightSim.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local WorldConfig = require(Shared.WorldConfig)
local FlightSim = require(Shared.FlightSim)
local Pets = require(Shared.PetDefinitions)
local Net = require(script.Parent.Net)
local ProfileService = require(script.Parent.ProfileService)
local Analytics = require(script.Parent.Analytics)

local F = GameConfig.Flight

local FlightService = {}

local aims: { [Player]: { session: number, start: number, period: number } } = {}
local flights: { [Player]: any } = {}
local nextId = 0
local snapshotTimer = 0
local hooks = { onFinished = {} }

local function isFinite(n): boolean
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

function FlightService.isFlying(player: Player): boolean
	return flights[player] ~= nil
end

function FlightService.onFinished(fn)
	table.insert(hooks.onFinished, fn)
end

local function currentWorld(player: Player)
	return WorldConfig.ById[player:GetAttribute("World") or WorldConfig.Home] or WorldConfig.ById[WorldConfig.Home]
end

local function equippedPet(data)
	for _, entry in data.OwnedPets do
		if entry.uniqueId == data.EquippedPetUniqueId then
			return entry
		end
	end
	return data.OwnedPets[1]
end

-- Launch parameters from verified profile data + accepted timing.
function FlightService.paramsFor(data, timing: string, angle: number)
	local pet = equippedPet(data)
	local petBonus = if pet then Pets.speedBonus(pet.petId, pet.level, GameConfig.PetLevel.SpeedPerLevel) else 0
	local def = pet and Pets.ById[pet.petId]
	return {
		speed = GameConfig.launchSpeed(data.TrainingLevel, data.CannonLevel, petBonus, F.Timing[timing]),
		angle = math.clamp(angle, F.MinAngle, F.MaxAngle),
		boostLevel = data.BoostLevel,
		bounceLevel = data.BounceLevel,
		magnetLevel = data.MagnetLevel,
		petBounce = if def then def.bounceBonus else 0,
	},
		pet
end

-- Accepts the client's marker only if the server's own marker passed that value
-- within the player's latency window; otherwise uses the server's marker.
local function verifyMarker(player: Player, aim, claimed): number
	local now = workspace:GetServerTimeNow()
	local lag = math.clamp(player:GetNetworkPing() * 1.2 + 0.12, 0.12, 0.6)
	local fallback = GameConfig.markerAt(now - aim.start - lag / 2, aim.period)
	if not isFinite(claimed) or claimed &lt; 0 or claimed &gt; 1 then
		return fallback
	end
	for i = 0, 24 do
		local t = now - aim.start - lag * (i / 24)
		if math.abs(GameConfig.markerAt(t, aim.period) - claimed) &lt;= 0.03 then
			return claimed
		end
	end
	return fallback
end
FlightService.verifyMarker = verifyMarker

local function focusPart(player: Player): BasePart
	local part = Instance.new("Part")
	part.Name = "FlightFocus_" .. player.UserId
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.Parent = workspace:FindFirstChild("ActiveFlights") or workspace
	return part
end

local function worldPosition(world, x, y, z): Vector3
	return Vector3.new(world.origin[1] + x, world.origin[2] + y, world.origin[3] + z)
end

-- Starts a flight. Used by the Fire request and by the Studio debug hook.
function FlightService.start(player: Player, timing: string, angle: number)
	local data = ProfileService.get(player)
	if not data or flights[player] or player:GetAttribute("Traveling") then
		return nil
	end
	local world = currentWorld(player)
	local params, pet = FlightService.paramsFor(data, timing, angle)
	nextId += 1
	local flight = {
		id = nextId,
		player = player,
		world = world,
		state = FlightSim.new(world, params),
		timing = timing,
		petId = pet and pet.petId or Pets.Starter,
		petUid = pet and pet.uniqueId,
		mutation = pet and pet.mutation or "Normal",
		focus = focusPart(player),
		granted = false,
		boostsUsed = 0,
		startedAt = workspace:GetServerTimeNow(),
	}
	flight.focus.Position = worldPosition(world, world.muzzle[1], world.muzzle[2], world.muzzle[3])
	player.ReplicationFocus = flight.focus
	flights[player] = flight
	player:SetAttribute("Flying", true)
	Net.flightAll("start", {
		owner = player.UserId,
		id = flight.id,
		world = world.id,
		params = params,
		timing = timing,
		petId = flight.petId,
		mutation = flight.mutation,
		start = flight.startedAt,
	})
	if data.Stats.TotalLaunches == 0 then
		Analytics.funnel(player, "tutorial_launch_started")
	end
	return flight
end

local function cleanup(player: Player, flight)
	if flights[player] == flight then
		flights[player] = nil
	end
	if flight.focus then
		flight.focus:Destroy()
		flight.focus = nil
	end
	if player.Parent then
		player.ReplicationFocus = nil
		player:SetAttribute("Flying", false)
	end
end

-- Grants rewards exactly once per flight id.
local function complete(player: Player, flight)
	if flight.granted then
		return
	end
	flight.granted = true
	cleanup(player, flight)
	local data = ProfileService.get(player)
	if not data then
		return
	end
	local state = flight.state
	local world = flight.world
	local distance = FlightSim.distance(state)
	local combo = GameConfig.comboFor(state.ringCount, state.perfectBounces, flight.timing == "Perfect")
	local coins = GameConfig.coinsFor(distance, combo, data.PrestigeCount)
	local previousBest = data.BestDistanceByWorld[world.id] or 0
	local newRecord = distance &gt; previousBest
	if newRecord then
		data.BestDistanceByWorld[world.id] = distance
	end
	ProfileService.addCoins(player, coins)
	local firstLaunch = data.Stats.TotalLaunches == 0
	data.Stats.TotalLaunches += 1
	data.Stats.TotalFlightDistance += distance
	data.Stats.TotalRings += state.ringCount
	ProfileService.mark(player, "BestDistanceByWorld", "Stats")

	local summary = {
		id = flight.id,
		world = world.id,
		distance = distance,
		best = math.max(previousBest, distance),
		previousBest = previousBest,
		newRecord = newRecord and previousBest &gt; 0,
		firstRecord = newRecord and previousBest == 0,
		coins = coins,
		combo = combo,
		rings = state.ringCount,
		perfectBounces = state.perfectBounces,
		bounces = state.bounces,
		timing = flight.timing,
		boosted = state.boosted,
		reason = state.endReason,
		finished = state.endReason == "finish",
		petUid = flight.petUid,
	}
	for _, fn in hooks.onFinished do
		local ok, err = pcall(fn, player, summary, data)
		if not ok then
			warn("[Flight] finish hook failed: " .. tostring(err))
		end
	end
	if firstLaunch then
		Analytics.funnel(player, "first_launch_completed")
	else
		Analytics.event(player, "repeat_launch")
	end
	Analytics.event(player, "distance_earned", distance)
	Net.flight(player, "results", summary)
	Net.flightAll("ended", { owner = player.UserId, id = flight.id, x = state.x, y = state.y, z = state.z })
end

-- Ends a flight without rewards (death, travel, reset, invalid state).
function FlightService.cancel(player: Player, reason: string)
	local flight = flights[player]
	if not flight then
		return
	end
	flight.granted = true
	cleanup(player, flight)
	Analytics.event(player, "flight_cancel")
	if player.Parent then
		Net.flight(player, "cancelled", { id = flight.id, reason = reason })
	end
	Net.flightAll("ended", { owner = player.UserId, id = flight.id })
end

-- Disconnect recovery: finish the flight without further input and grant once.
local function recoverOnLeave(player: Player)
	local flight = flights[player]
	if not flight then
		return
	end
	local guard = 0
	while flight.state.phase ~= "DONE" and guard &lt; 5000 do
		guard += 1
		FlightSim.advance(flight.state, flight.world, F.Step)
	end
	complete(player, flight)
end

local function forwardEvents(flight, events)
	local player = flight.player
	for _, e in events do
		if e.kind == "end" then
			continue
		end
		Net.flightAll(
			"event",
			{
				owner = player.UserId,
				id = flight.id,
				kind = e.kind,
				index = e.index,
				perfect = e.perfect,
				x = e.x,
				y = e.y,
				z = e.z,
			}
		)
	end
end

local function step(dt: number)
	for player, flight in flights do
		local events = FlightSim.advance(flight.state, flight.world, dt)
		if #events &gt; 0 then
			forwardEvents(flight, events)
		end
		local s = flight.state
		if flight.focus then
			flight.focus.Position = worldPosition(flight.world, s.x, s.y, s.z)
		end
		if s.phase == "DONE" then
			complete(player, flight)
		end
	end

	snapshotTimer += dt
	if snapshotTimer &gt;= 1 / F.SnapshotRate then
		snapshotTimer = 0
		local packet = {}
		for player, flight in flights do
			local s = flight.state
			-- owner, id, t, x, y, z, vx, vy, vz (rounded to keep the packet well under 1 KB)
			table.insert(
				packet,
				{
					player.UserId,
					flight.id,
					math.floor(s.t * 1000) / 1000,
					math.floor(s.x * 10) / 10,
					math.floor(s.y * 10) / 10,
					math.floor(s.z * 10) / 10,
					math.floor(s.vx * 10) / 10,
					math.floor(s.vy * 10) / 10,
					math.floor(s.vz * 10) / 10,
				}
			)
		end
		if #packet &gt; 0 then
			ReplicatedStorage.Remotes.FlightSnapshot:FireAllClients(packet)
		end
	end
end

function FlightService.applyInput(player: Player, payload)
	local flight = flights[player]
	if not flight or type(payload) ~= "table" or payload.id ~= flight.id then
		return
	end
	local kind = payload.kind
	if kind == "boost" then
		if FlightSim.boost(flight.state) then
			Net.flightAll("event", { owner = player.UserId, id = flight.id, kind = "boost" })
		end
	elseif kind == "tap" then
		-- Grace for the player's latency so a tap on the visible contact still counts
		local s = flight.state
		local grace = math.clamp(player:GetNetworkPing(), 0, 0.15)
		s.perfectUntil += grace
		local perfect = FlightSim.tapBounce(s)
		s.perfectUntil -= grace
		if perfect then
			Net.flightAll(
				"event",
				{ owner = player.UserId, id = flight.id, kind = "perfectBounce", x = s.x, y = s.y, z = s.z }
			)
		end
	elseif kind == "steer" then
		local value = payload.value
		if isFinite(value) then
			FlightSim.setSteer(flight.state, value)
		end
	end
end

function FlightService.init()
	Net.handle("BeginAim", function(player)
		if flights[player] then
			return { ok = false, msg = "Already flying!" }
		end
		local data = ProfileService.get(player)
		local period = if data.Settings.slowTiming then F.MarkerPeriodSlow else F.MarkerPeriod
		local previous = aims[player]
		local aim = {
			session = (previous and previous.session or 0) + 1,
			start = workspace:GetServerTimeNow(),
			period = period,
		}
		aims[player] = aim
		return { ok = true, session = aim.session, start = aim.start, period = period }
	end, 3, 4)

	Net.handle("Fire", function(player, payload)
		local aim = aims[player]
		if type(payload) ~= "table" or not aim or payload.session ~= aim.session then
			return { ok = false, msg = "Aim first!" }
		end
		aims[player] = nil
		if workspace:GetServerTimeNow() - aim.start &gt; F.AimTimeout then
			return { ok = false, msg = "Aim timed out" }
		end
		local angle = if isFinite(payload.angle) then payload.angle else F.DefaultAngle
		local marker = verifyMarker(player, aim, payload.marker)
		local timing = GameConfig.timingFor(marker)
		local flight = FlightService.start(player, timing, angle)
		if not flight then
			return { ok = false, msg = "Can't launch right now" }
		end
		return { ok = true, id = flight.id, timing = timing, marker = marker }
	end, 2, 3)

	Net.handle("CancelFlight", function(player)
		FlightService.cancel(player, "player")
		return { ok = true }
	end, 2, 3)

	Net.on("FlightInput", FlightService.applyInput, 30, 40)

	RunService.Heartbeat:Connect(step)

	Players.PlayerRemoving:Connect(function(player)
		aims[player] = nil
	end)
	ProfileService.onLeaving(recoverOnLeave)
	ProfileService.onLoaded(function(player)
		Analytics.funnel(player, "session_start")
		local function cancelIfStillHere(reason: string)
			local flight = flights[player]
			-- Leaving players are handled by recoverOnLeave (rewards granted once)
			task.delay(0.1, function()
				if player.Parent and flights[player] == flight then
					FlightService.cancel(player, reason)
				end
			end)
		end
		player.CharacterRemoving:Connect(function()
			cancelIfStillHere("character")
		end)
		player.CharacterAdded:Connect(function(character)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if humanoid then
				humanoid.Died:Connect(function()
					cancelIfStillHere("died")
				end)
			end
		end)
	end)
end

return FlightService
</ProtectedString>
              <string name="ScriptGuid">{E5FA9E9C-74C6-4235-96A6-F7F55544DF7F}</string>
              <BinaryString name="AttributesSerialize" />
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <bool name="DefinesCapabilities">false</bool>
              <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
              <string name="Name">FlightService</string>
              <BinaryString name="SerializedOverrides" />
              <int64 name="SourceAssetId">-1</int64>
              <SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
              <UniqueId name="UniqueId">7b3034da324dfa3f0af65b5900000b29</UniqueId>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="RBX90360D7AF9FB43E39EC579D257441803">
            <Properties>
              <Content name="LinkedSource">
                <null />
              </Content>
              <ProtectedString name="Source">-- Net: central remote router. Every client request passes through validation and
-- per-player token-bucket rate limiting before a service sees it.
-- Handlers never yield, so each request is applied atomically.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Net = {}
Net.Remotes = Remotes

local requestHandlers = {}
local eventHandlers = {}
local buckets: { [Player]: { [string]: { tokens: number, last: number } } } = {}
local readyCheck: ((Player) -&gt; boolean)? = nil

-- Token bucket: refills `rate` tokens per second up to `burst`
function Net.allow(player: Player, key: string, rate: number, burst: number): boolean
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end
	local now = os.clock()
	local bucket = playerBuckets[key]
	if not bucket then
		bucket = { tokens = burst, last = now }
		playerBuckets[key] = bucket
	end
	bucket.tokens = math.min(burst, bucket.tokens + (now - bucket.last) * rate)
	bucket.last = now
	if bucket.tokens &gt;= 1 then
		bucket.tokens -= 1
		return true
	end
	return false
end

function Net.setReadyCheck(fn: (Player) -&gt; boolean)
	readyCheck = fn
end

-- RemoteFunction request with a response table
function Net.handle(name: string, fn: (Player, any) -&gt; any, rate: number?, burst: number?)
	requestHandlers[name] = { fn = fn, rate = rate or 4, burst = burst or 6 }
end

-- Fire-and-forget RemoteEvent action
function Net.on(name: string, fn: (Player, any) -&gt; (), rate: number?, burst: number?)
	eventHandlers[name] = { fn = fn, rate = rate or 10, burst = burst or 15 }
end

function Net.notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function Net.flight(player: Player, kind: string, payload: any)
	Remotes.Flight:FireClient(player, kind, payload)
end

function Net.flightAll(kind: string, payload: any)
	Remotes.Flight:FireAllClients(kind, payload)
end

function Net.start()
	Remotes.Request.OnServerInvoke = function(player: Player, name: any, payload: any)
		if typeof(name) ~= "string" then
			return { ok = false, msg = "Invalid request" }
		end
		local handler = requestHandlers[name]
		if not handler then
			return { ok = false, msg = "Unknown request" }
		end
		if readyCheck and not readyCheck(player) then
			return { ok = false, msg = "Your data is still loading..." }
		end
		if not Net.allow(player, "rq:" .. name, handler.rate, handler.burst) then
			return { ok = false, msg = "Slow down!" }
		end
		local ok, result = pcall(handler.fn, player, payload)
		if not ok then
			warn(`[Net] request {name} from {player.Name} failed: {result}`)
			return { ok = false, msg = "Something went wrong" }
		end
		return result or { ok = true }
	end

	Remotes.Action.OnServerEvent:Connect(function(player: Player, name: any, payload: any)
		if typeof(name) ~= "string" then
			return
		end
		local handler = eventHandlers[name]
		if not handler then
			return
		end
		if readyCheck and not readyCheck(player) then
			return
		end
		if not Net.allow(player, "ev:" .. name, handler.rate, handler.burst) then
			return
		end
		local ok, err = pcall(handler.fn, player, payload)
		if not ok then
			warn(`[Net] action {name} from {player.Name} failed: {err}`)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

return Net
</ProtectedString>
