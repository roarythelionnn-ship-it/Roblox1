            <ProtectedString name="Source">--!strict
-- Models: client copies of the generated art in ReplicatedStorage.AssetModels
-- (built by the server's AssetLoader), ViewportFrame previews and cosmetic variants.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Models = {}

local VARIANT_COLOR = {
	Neon = Color3.fromHex("37F4FF"),
	Frost = Color3.fromHex("CFF4FF"),
	Golden = Color3.fromHex("FFD24A"),
	Celestial = Color3.fromHex("B48CFF"),
}
Models.VariantColor = VARIANT_COLOR

local function assets(): Folder?
	-- lihfolk-ignore: findfirstchild-chain (type cast only; callers nil-check the result)
	return ReplicatedStorage:FindFirstChild("AssetModels") :: Folder?
end

function Models.waitReady(timeout: number?): boolean
	return ReplicatedStorage:WaitForChild("AssetModels", timeout or 30) ~= nil
end

function Models.template(category: string, key: string): Model?
	local root = assets()
	local folder = root and root:FindFirstChild(category)
	local model = folder and folder:FindFirstChild(key)
	return if model and model:IsA("Model") then model else nil
end

-- Variant look on a world model: tinted outline + matching sparkle aura (cosmetic only).
function Models.applyVariant(model: Model, variant: string?)
	local old = model:FindFirstChild("VariantLook")
	if old then
		old:Destroy()
	end
	local color = variant and VARIANT_COLOR[variant]
	if not color then
		return
	end
	local look = Instance.new("Folder")
	look.Name = "VariantLook"
	local highlight = Instance.new("Highlight")
	highlight.FillColor = color
	highlight.FillTransparency = 0.72
	highlight.OutlineColor = color
	highlight.OutlineTransparency = 0.1
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Adornee = model
	highlight.Parent = look
	local primary = model.PrimaryPart
	if primary then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkle.Color = ColorSequence.new(color)
		sparkle.LightEmission = 1
		sparkle.LightInfluence = 0
		sparkle.Rate = 5
		sparkle.Lifetime = NumberRange.new(0.6, 1)
		sparkle.Speed = NumberRange.new(0.5, 1.5)
		sparkle.Size = NumberSequence.new(0.35, 0)
		sparkle.Parent = primary
		sparkle:SetAttribute("Variant", true)
	end
	look.Parent = model
end

-- A fresh copy (anchored, non-colliding). Uniform `scale` keeps proportions.
function Models.clone(category: string, key: string, scale: number?): Model?
	local template = Models.template(category, key)
	local stand_in = false
	if not template and category == "Monsters" then
		-- shortcut: art not generated yet -&gt; tinted Mallow stand-in; replace when the manifest has it
		template = Models.template("Monsters", "Mallow")
		stand_in = true
	end
	if not template then
		return nil
	end
	local model = template:Clone()
	if stand_in then
		local tint = Instance.new("Highlight")
		tint.FillColor = Color3.fromHex("FFD24A")
		tint.FillTransparency = 0.45
		tint.OutlineTransparency = 1
		tint.Parent = model
	end
	if scale and scale ~= 1 then
		model:ScaleTo(scale)
	end
	return model
end

-- Square 3D preview with a camera framing the model's 3/4 front (front faces -Z).
function Models.viewport(parent: Instance, category: string, key: string, options: { spin: boolean?, silhouette: boolean? }?): ViewportFrame
	local frame = Instance.new("ViewportFrame")
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 1)
	frame.Ambient = Color3.fromRGB(200, 200, 215)
	frame.LightColor = Color3.new(1, 1, 1)
	frame.LightDirection = Vector3.new(-1, -1.5, 1)
	local model = Models.clone(category, key)
	if model then
		model:PivotTo(CFrame.Angles(0, math.rad(-25), 0))
		if options and options.silhouette then
			for _, d in model:GetDescendants() do
				if d:IsA("MeshPart") then
					d.TextureID = ""
					d.Color = Color3.fromHex("1F1B3D")
				end
			end
		end
		model.Parent = frame
		local cf, size = model:GetBoundingBox()
		local distance = size.Magnitude * 1.55
		local camera = Instance.new("Camera")
		camera.FieldOfView = 32
		camera.CFrame = CFrame.lookAt(cf.Position + Vector3.new(distance * 0.3, distance * 0.22, -distance), cf.Position)
		camera.Parent = frame
		frame.CurrentCamera = camera
		if options and options.spin then
			frame:SetAttribute("Spin", true)
		end
	end
	frame.Parent = parent
	if options and options.spin then require(script.Parent.UiFx).spin(frame) end
	return frame
end

return Models
</ProtectedString>
