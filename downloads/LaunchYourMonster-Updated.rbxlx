        <ProtectedString name="Source">--!strict
-- LAUNCH YOUR MONSTER! - display-safe config for the LihFolk systems.
-- Install: ReplicatedStorage/LihFolkConfig. The server reads its own copy to decide
-- outcomes; the client reads it only to draw UI. Codes live in ServerStorage/LihFolkSecrets.
-- Monster stats, worlds and flight numbers live in ReplicatedStorage/Game.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Pets = require(ReplicatedStorage:WaitForChild("Game"):WaitForChild("PetDefinitions")) :: any

local Config = {}

Config.PlayerData = {
	storeName = "LYM_PlayerData_v1", -- never rename after launch
	schemaVersion = 1,
	migrations = {},
}

-- Both currencies are earned only. Nothing in V1 can be bought with Robux, so eggs
-- are not paid random items (odds are still shown on every egg).
Config.Currency = {
	currencies = {
		StarCoins = { start = 0, paid = false, leaderstat = true },
		GenomeShards = { start = 0, paid = false },
	},
	maxMultiplier = 10,
}

-- Every monster is a unique, equippable, non-tradable item (no trading in V1).
local items = {}
for _, def in Pets.List do
	items[def.id] = { name = def.name, stackable = false, equippable = true, tradable = false }
end
Config.Inventory = {
	uniqueCapacity = 150,
	maxEquipped = 1, -- one monster is launched at a time
	items = items,
}

-- Egg tiers are built from PetDefinitions so the shown odds and the roll share one table.
local eggs = {}
for _, egg in Pets.Eggs do
	local tiers = {}
	for _, def in egg.pets do
		table.insert(tiers, {
			name = def.rarity,
			weight = def.weight,
			lucky = def.rarity ~= "Common",
			items = { { id = def.id, weight = 1 } },
		})
	end
	eggs[egg.id] = {
		name = egg.name,
		price = { currency = "StarCoins", amount = egg.price },
		hatchCounts = { 1 },
		tiers = tiers,
	}
end
Config.Eggs = {
	maxLuck = 1, -- no luck boosts in V1: displayed odds are the base odds
	eggs = eggs,
}

Config.Shop = {
	items = {},
	passes = {
		-- Cosmetic only. id 0 = never prompted; the owner supplies real ids after approval.
		RainbowTrail = { id = 0 },
		GalaxyCannon = { id = 0 },
		Celebrations = { id = 0 },
	},
}

Config.Receipts = {
	products = {}, -- no developer products in V1
}

Config.Daily = {
	resetOffsetHours = 0,
	graceDays = 1,
	track = {
		{ kind = "currency", currency = "StarCoins", amount = 100 },
		{ kind = "currency", currency = "StarCoins", amount = 150 },
		{ kind = "currency", currency = "StarCoins", amount = 250 },
		{ kind = "currency", currency = "StarCoins", amount = 350 },
		{ kind = "currency", currency = "StarCoins", amount = 500 },
		{ kind = "currency", currency = "StarCoins", amount = 750 },
		{
			kind = "bundle",
			rewards = {
				{ kind = "currency", currency = "StarCoins", amount = 1500 },
				{ kind = "currency", currency = "GenomeShards", amount = 25 },
			},
		},
	},
}

local function coins(amount: number)
	return { kind = "currency", currency = "StarCoins", amount = amount }
end

-- Missions: progress is reported only by server systems (Flight, Upgrades, Worlds, EggHatch).
Config.Quests = {
	quests = {
		{ id = "FirstLaunch", title = "First Flight", objectives = { { kind = "Launch", target = "*", amount = 1, text = "Launch your monster" } }, reward = coins(150) },
		{ id = "FirstUpgrade", title = "More Power", requires = { "FirstLaunch" }, objectives = { { kind = "Upgrade", target = "*", amount = 1, text = "Buy any upgrade" } }, reward = coins(200) },
		{ id = "FirstHatch", title = "New Friend", requires = { "FirstUpgrade" }, objectives = { { kind = "Hatch", target = "*", amount = 1, text = "Hatch an egg" } }, reward = coins(300) },
		{ id = "Reach600", title = "Going Places", requires = { "FirstLaunch" }, objectives = { { kind = "Reach", target = "600", amount = 1, text = "Fly 600 studs" } }, reward = coins(400) },
		{ id = "Rings10", title = "Ring Hunter", requires = { "Reach600" }, objectives = { { kind = "Ring", target = "*", amount = 10, text = "Fly through 10 rings" } }, reward = coins(500) },
		{ id = "Perfect5", title = "Sharp Shooter", requires = { "Reach600" }, objectives = { { kind = "Perfect", target = "Launch", amount = 5, text = "Get 5 Perfect launches" } }, reward = coins(600) },
		{ id = "Reach1100", title = "Sky Ticket", requires = { "Rings10", "Perfect5" }, objectives = { { kind = "Reach", target = "1100", amount = 1, text = "Fly 1,100 studs" } }, reward = coins(1000) },
		{ id = "Cloudtop", title = "Above the Clouds", requires = { "Reach1100" }, objectives = { { kind = "Unlock", target = "CloudtopCircuit", amount = 1, text = "Unlock Cloudtop Circuit" } }, reward = coins(1500) },
		{ id = "Bounce10", title = "Bounce Master", requires = { "Cloudtop" }, objectives = { { kind = "Perfect", target = "Bounce", amount = 10, text = "Get 10 Perfect Bounces" } }, reward = coins(2500) },
		{ id = "Reach2200", title = "Star Chaser", requires = { "Bounce10" }, objectives = { { kind = "Reach", target = "2200", amount = 1, text = "Fly 2,200 studs" } }, reward = coins(4000) },
		{ id = "Nebula", title = "Into the Nebula", requires = { "Reach2200" }, objectives = { { kind = "Unlock", target = "NebulaWilds", amount = 1, text = "Unlock Nebula Wilds" } }, reward = coins(8000) },
		{ id = "Reach3500", title = "Legend of Launch", requires = { "Nebula" }, objectives = { { kind = "Reach", target = "3500", amount = 1, text = "Fly 3,500 studs" } }, reward = coins(15000) },
	},
}
-- Distance thresholds the Flight service reports for "Reach" objectives.
Config.ReachMarks = { 600, 1100, 2200, 3500 }

Config.Leaderboard = {
	writeSeconds = 120,
	refreshSeconds = 120,
	boards = {
		BestDistance = { storeName = "LYM_LB_BestDistance_v1", period = "all" }, -- source set in Main
		WeeklyLaunches = { storeName = "LYM_LB_WeeklyLaunches_v1", period = "weekly" },
	},
}

return Config
</ProtectedString>
