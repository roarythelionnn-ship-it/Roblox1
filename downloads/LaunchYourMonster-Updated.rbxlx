              <ProtectedString name="Source">-- Analytics: privacy-safe funnel + custom events through Roblox AnalyticsService only.
-- Never sends data to external services. Failures are swallowed (analytics must not break play).
local AnalyticsService = game:GetService("AnalyticsService")

local Analytics = {}

local FUNNEL = {
	session_start = 1,
	tutorial_launch_started = 2,
	first_launch_completed = 3,
	first_upgrade = 4,
	first_egg = 5,
	world_unlock = 6,
}

function Analytics.funnel(player: Player, step: string)
	local index = FUNNEL[step]
	if index then
		pcall(AnalyticsService.LogOnboardingFunnelStepEvent, AnalyticsService, player, index, step)
	end
end

function Analytics.event(player: Player, name: string, value: number?)
	pcall(AnalyticsService.LogCustomEvent, AnalyticsService, player, name, value or 1)
end

return Analytics
