            <ProtectedString name="Source">--!strict
-- Format: the one place UI turns numbers and times into text. Pure functions, no state.
-- short() truncates (never rounds up) to one decimal and drops a trailing ".0".

local Format = {}

local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 999 -&gt; "999", 1234 -&gt; "1.2K", 1999 -&gt; "1.9K", 160000000 -&gt; "160M"
function Format.short(n: number): string
	local value = math.abs(n)
	if value &lt; 1000 then
		return tostring(math.floor(n))
	end
	local index = 0
	while value &gt;= 1000 and index &lt; #SUFFIXES do
		value /= 1000
		index += 1
	end
	local text: string
	if value &gt;= 100 then
		text = tostring(math.floor(value))
	else
		local tenths = math.floor(value * 10 + 1e-9)
		text = if tenths % 10 == 0 then tostring(tenths // 10) else string.format("%d.%d", tenths // 10, tenths % 10)
	end
	return (if n &lt; 0 then "-" else "") .. text .. SUFFIXES[index]
end

-- 1234567 -&gt; "1,234,567"
function Format.comma(n: number): string
	local digits = tostring(math.floor(math.abs(n)))
	local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return if n &lt; 0 then "-" .. out else out
end

-- Gain popups: "+1.2K"
function Format.gain(n: number): string
	return (if n &gt;= 0 then "+" else "") .. Format.short(n)
end

-- 344 -&gt; "5m 44s", 34 -&gt; "34s", 3720 -&gt; "1h 2m" (no zero padding)
function Format.timer(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	if s &lt; 60 then
		return `{s}s`
	elseif s &lt; 3600 then
		return `{s // 60}m {s % 60}s`
	end
	return `{s // 3600}h {(s % 3600) // 60}m`
end

-- Timers turn red in their last 30 seconds.
function Format.timerUrgent(seconds: number): boolean
	return seconds &lt;= 30
end

-- "300 StarCoins" (Rewards.Describe) -&gt; 300, "coin"
function Format.reward(description: string): (number?, string)
	local amount, currency = description:match("^(%d+) (%a+)$")
	if amount then
		return tonumber(amount), if currency == "GenomeShards" then "gem" else "coin"
	end
	return nil, "gift"
end

return Format
</ProtectedString>
