            <ProtectedString name="Source">-- PetDefinitions: all 16 original monsters and the three earnable eggs.
-- Validated on load: unique ids, every egg's weights sum to exactly 100.
-- `look` drives the procedural model builder (PetModels).

local PetDefinitions = {}

local function pet(id, name, rarity, egg, weight, speed, look, extra)
	local def = {
		id = id,
		name = name,
		rarity = rarity,
		egg = egg,
		weight = weight, -- percent inside its egg
		speedBonus = speed, -- fraction, e.g. 0.06 = +6%
		bounceBonus = extra and extra.bounce or 0,
		special = extra and extra.special or nil,
		trail = look.trail or "Soft",
		look = look,
		lore = extra and extra.lore or "",
		maxLevel = 25,
	}
	return def
end

-- look fields: body, belly, accent, eye, shape (round|long|flat|serpent|hydra), ears, wings, tail, extra
PetDefinitions.List = {
	pet("Mallow", "Mallow", "Common", nil, 0, 0, {
		body = "8CCBFF",
		belly = "FFFFFF",
		accent = "5AA8F0",
		shape = "round",
		ears = "horns",
		wings = "stubby",
		tail = "nub",
		trail = "Soft",
	}, { lore = "A marshmallow dragon who dreams of touching the clouds." }),

	pet("PuddlePup", "Puddle Pup", "Common", "MeadowEgg", 55, 0.02, {
		body = "3FD6C9",
		belly = "D9FFFA",
		accent = "2AA79D",
		shape = "round",
		ears = "floppy",
		wings = "none",
		tail = "nub",
		trail = "Bubbles",
	}, { lore = "Half puppy, half otter, all splash." }),
	pet("AeroKitty", "Aero Kitty", "Uncommon", "MeadowEgg", 28, 0.04, {
		body = "FF9C45",
		belly = "FFE3C2",
		accent = "E06E1F",
		shape = "round",
		ears = "pointy",
		wings = "feather",
		tail = "long",
		trail = "Feathers",
	}, { lore = "Its feather ears catch every breeze." }),
	pet("LeafGecko", "Leaf Gecko", "Rare", "MeadowEgg", 12, 0.06, {
		body = "8BEA3C",
		belly = "E8FFC9",
		accent = "4FAE1E",
		shape = "long",
		ears = "none",
		wings = "none",
		tail = "leaf",
		trail = "Leaves",
	}, { special = "LeafBurst", lore = "Its tail is a real, living leaf." }),
	pet("EmberChick", "Ember Chick", "Epic", "MeadowEgg", 4, 0.09, {
		body = "FFB33B",
		belly = "FFE9A8",
		accent = "FF5A3C",
		shape = "round",
		ears = "tuft",
		wings = "stubby",
		tail = "flame",
		trail = "Sparks",
	}, { special = "Sparks", lore = "Warm, fluffy and always a little on fire." }),
	pet("StarBunny", "Star Bunny", "Legendary", "MeadowEgg", 1, 0.12, {
		body = "F7F2FF",
		belly = "FFFFFF",
		accent = "C7A8FF",
		shape = "round",
		ears = "long",
		wings = "none",
		tail = "star",
		extra = "halo",
		trail = "Starlight",
	}, { special = "Starlight", lore = "Wherever it lands, stars follow." }),

	pet("StormFox", "Storm Fox", "Common", "StormEgg", 50, 0.08, {
		body = "3155D6",
		belly = "DDE6FF",
		accent = "FFE45C",
		shape = "round",
		ears = "pointy",
		wings = "none",
		tail = "bushy",
		extra = "brows",
		trail = "Lightning",
	}, { lore = "Its eyebrows flicker before every storm." }),
	pet("CloudSerpent", "Cloud Serpent", "Uncommon", "StormEgg", 27, 0.10, {
		body = "8FD9FF",
		belly = "FFFFFF",
		accent = "E9F7FF",
		shape = "serpent",
		ears = "fins",
		wings = "fins",
		tail = "none",
		trail = "Clouds",
	}, { lore = "A noodle dragon that swims through the sky." }),
	pet("CrystalOtter", "Crystal Otter", "Rare", "StormEgg", 15, 0.12, {
		body = "A37CFF",
		belly = "E9DDFF",
		accent = "D9C7FF",
		shape = "long",
		ears = "round",
		wings = "none",
		tail = "long",
		extra = "spikes",
		trail = "Crystal",
		glass = true,
	}, { bounce = 0.03, lore = "Its crystal spikes ring like bells when it bounces." }),
	pet("RocketRaccoon", "Rocket Raccoon", "Epic", "StormEgg", 7, 0.14, {
		body = "8E8A94",
		belly = "E6E1E8",
		accent = "FF4B4B",
		shape = "round",
		ears = "round",
		wings = "none",
		tail = "rocket",
		extra = "mask",
		trail = "Rocket",
	}, { special = "RocketBoost", lore = "Built its own tail thruster from scrap." }),
	pet("AuroraLynx", "Aurora Lynx", "Legendary", "StormEgg", 1, 0.17, {
		body = "2EC4B6",
		belly = "E2FFFB",
		accent = "9D5CFF",
		shape = "round",
		ears = "tufted",
		wings = "none",
		tail = "nub",
		extra = "mantle",
		trail = "Aurora",
	}, { special = "Aurora", lore = "Wears the northern lights like a cape." }),

	pet("NeonWyvern", "Neon Wyvern", "Common", "CosmicEgg", 50, 0.15, {
		body = "22163D",
		belly = "3B2A63",
		accent = "C04BFF",
		shape = "round",
		ears = "horns",
		wings = "membrane",
		tail = "long",
		trail = "Neon",
		glow = true,
	}, { lore = "Its wings hum with stored starlight." }),
	pet("SolarManta", "Solar Manta", "Uncommon", "CosmicEgg", 28, 0.17, {
		body = "FFC93C",
		belly = "FFF2C2",
		accent = "FF8A2B",
		shape = "flat",
		ears = "none",
		wings = "manta",
		tail = "long",
		trail = "Solar",
		glow = true,
	}, { lore = "Glides on solar wind and smiles at everyone." }),
	pet("ThunderHydra", "Thunder Hydra", "Rare", "CosmicEgg", 15, 0.19, {
		body = "3A63FF",
		belly = "CFE0FF",
		accent = "FFE45C",
		shape = "hydra",
		ears = "none",
		wings = "stubby",
		tail = "nub",
		trail = "Lightning",
	}, { special = "ElectricHit", lore = "Three heads, one very loud opinion." }),
	pet("QuantumPhoenix", "Quantum Phoenix", "Epic", "CosmicEgg", 6, 0.22, {
		body = "38E8FF",
		belly = "FFFFFF",
		accent = "FF4FD8",
		shape = "round",
		ears = "crest",
		wings = "feather",
		tail = "plume",
		trail = "Quantum",
		glow = true,
	}, { special = "QuantumTrail", lore = "Exists in two places until you look at it." }),
	pet("CosmicLeviathan", "Cosmic Leviathan", "Legendary", "CosmicEgg", 1, 0.25, {
		body = "2B2F8F",
		belly = "5E64D9",
		accent = "FFDE70",
		shape = "long",
		ears = "fins",
		wings = "fins",
		tail = "whale",
		extra = "constellation",
		trail = "Cosmic",
		glow = true,
	}, { special = "CosmicBurst", lore = "A space whale-dragon carrying a map of the stars." }),
}

PetDefinitions.ById = {}
for index, def in PetDefinitions.List do
	assert(PetDefinitions.ById[def.id] == nil, "duplicate pet id " .. def.id)
	def.order = index
	PetDefinitions.ById[def.id] = def
end

PetDefinitions.Starter = "Mallow"

PetDefinitions.Eggs = {
	{
		id = "MeadowEgg",
		name = "Meadow Egg",
		price = 250,
		world = "SunnySpringlands",
		color = "8FDB72",
		accent = "FFC85B",
	},
	{
		id = "StormEgg",
		name = "Storm Egg",
		price = 6000,
		world = "CloudtopCircuit",
		color = "496BFF",
		accent = "28D7F4",
	},
	{
		id = "CosmicEgg",
		name = "Cosmic Egg",
		price = 90000,
		world = "NebulaWilds",
		color = "6536CD",
		accent = "EB62FF",
	},
}
PetDefinitions.EggById = {}
for _, egg in PetDefinitions.Eggs do
	egg.pets = {}
	for _, def in PetDefinitions.List do
		if def.egg == egg.id then
			table.insert(egg.pets, def) -- deterministic order (definition order)
		end
	end
	local total = 0
	for _, def in egg.pets do
		total += def.weight
	end
	assert(total == 100, egg.id .. " odds must sum to 100, got " .. total)
	assert(#egg.pets == 5, egg.id .. " must have 5 outcomes")
	PetDefinitions.EggById[egg.id] = egg
end

-- Weighted pick. `roll` is in [0, 100); the server passes Random:NextNumber(0, 100).
function PetDefinitions.pick(eggId: string, roll: number)
	local egg = PetDefinitions.EggById[eggId]
	local cumulative = 0
	for _, def in egg.pets do
		cumulative += def.weight
		if roll &lt; cumulative then
			return def
		end
	end
	return egg.pets[#egg.pets]
end

function PetDefinitions.speedBonus(petId: string, level: number, perLevel: number): number
	local def = PetDefinitions.ById[petId]
	if not def then
		return 0
	end
	return def.speedBonus + perLevel * (math.clamp(level, 1, def.maxLevel) - 1)
end

return PetDefinitions
