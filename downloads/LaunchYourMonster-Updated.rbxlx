            <ProtectedString name="Source">--!strict
-- Data: the client's read-only view of server state. Server pushes are the only writer:
-- Game.State (slice), Inventory.Changed (snapshot), Quests.Changed (list),
-- currency balances from player attributes (StarCoins, GenomeShards).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))
local Signal = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Signal"))

local player = Players.LocalPlayer

local Data = {}
Data.Changed = Signal.new() -- (key) "game" | "inventory" | "quests" | "coins" | "shards" | "world"
Data.game = nil :: { [string]: any }?
Data.inventory = { stacks = {}, uniques = {} } :: { [string]: any }
Data.quests = {} :: { any }

function Data.coins(): number
	return player:GetAttribute("StarCoins") or 0
end

function Data.shards(): number
	return player:GetAttribute("GenomeShards") or 0
end

function Data.world(): string
	return player:GetAttribute("World") or "SunnySpringlands"
end

-- The equipped monster's inventory entry ({ uid, item, equipped }) or nil.
function Data.equipped(): { [string]: any }?
	for _, unique in Data.inventory.uniques do
		if unique.equipped then
			return unique
		end
	end
	return nil
end

-- Level/xp/variant for a monster uid (defaults until the server creates the entry).
function Data.monster(uid: string): { [string]: any }
	local game = Data.game
	local meta = game and game.Monsters[uid]
	return meta or { Level = 1, Xp = 0, Mutation = "Normal", Unlocked = {} }
end

function Data.start()
	Net.On("Game.State", function(state)
		Data.game = state
		Data.Changed:Fire("game")
	end)
	Net.On("Inventory.Changed", function(snapshot)
		Data.inventory = snapshot
		Data.Changed:Fire("inventory")
	end)
	Net.On("Quests.Changed", function(list)
		Data.quests = list
		Data.Changed:Fire("quests")
	end)
	player:GetAttributeChangedSignal("StarCoins"):Connect(function()
		Data.Changed:Fire("coins")
	end)
	player:GetAttributeChangedSignal("GenomeShards"):Connect(function()
		Data.Changed:Fire("shards")
	end)
	player:GetAttributeChangedSignal("World"):Connect(function()
		Data.Changed:Fire("world")
	end)

	-- Initial pulls once the profile is ready (pushes keep it fresh afterwards).
	task.spawn(function()
		while not player:GetAttribute("DataReady") do
			player:GetAttributeChangedSignal("DataReady"):Wait()
		end
		for _, pull in { { "Game.GetState", "game" }, { "Inventory.Snapshot", "inventory" }, { "Quests.Get", "quests" } } do
			local result = Net.Request(pull[1])
			if result.ok then
				if pull[2] == "game" then
					Data.game = result.data
				elseif pull[2] == "inventory" then
					Data.inventory = result.data
				else
					Data.quests = result.data
				end
				Data.Changed:Fire(pull[2])
			end
		end
	end)
end

return Data
