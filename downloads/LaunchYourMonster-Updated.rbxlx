        <ProtectedString name="Source">--!strict
-- LAUNCH YOUR MONSTER! - server-only config (ServerStorage never replicates).
-- Codes are normalised: A-Z and 0-9 only, 3-24 characters. Times are unix seconds (UTC).

local Secrets = {}

Secrets.Codes = {
	codes = {
		LAUNCH = { reward = { kind = "currency", currency = "StarCoins", amount = 500 } },
		MALLOW = { reward = { kind = "currency", currency = "GenomeShards", amount = 10 } },
	},
	maxMisses = 5,
	missWindowSeconds = 120,
	lockoutSeconds = 300,
}

return Secrets
</ProtectedString>
